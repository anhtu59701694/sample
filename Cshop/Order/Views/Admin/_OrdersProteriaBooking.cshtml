@using System.Text.RegularExpressions
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@using Proteria = Eshop.Shipping.Proteria;
@model ProteriaBookingModel
@{
    var settings = (SettingsBiz)ViewBag.Settings;
    var errMsg = (string)ViewBag.ErrorMsg;
    var pickUpPoints = (Proteria.PickUpPoint[])ViewBag.PickUpPoints;
    var printers = (Proteria.Printer[])ViewBag.Printers;

    if (Model.CarrierName.IsNullOrEmpty())
    {
        Model.CarrierName = "BringV2";
    }


    var api = new Proteria.CloudConnect(settings.Display.Admin.Proteria.ApiKey);
    var shippingMethods = api.GetShippingMethodsForCustomer();
    //var shippingMethods = api.GetShippingMethods();
        
    var carriers = shippingMethods.Select(m => m.Carrier).Distinct(m => m.ToLower()).Select(m => new { CarrierName = m }).ToArray();
    var products = shippingMethods.Where(m => m.Carrier.EqualsIgCase(Model.CarrierName))
        .Select(m => new { Id = m.Id, Type = m.Carrier, Name = m.DisplayText }).ToArray();
        
        
}

@functions{
    public static Proteria.PickUpPoint[] GetPickUpPointsEx(string countryCode, string postCode, ref string errorMsg, string carrier = "Bring")
    {                          
		if(carrier.InList("BringV2")) { carrier = "Bring"; } 
		
        if ((!carrier.InList("Bring", "BringV2") || !countryCode.InList("SE", "NO", "DK", "FI")) &&
            (!carrier.InList("PostNord") || !countryCode.InList("SE", "NO", "DK", "FI", "DE", "BE", "NL", "LU")))
            return new Proteria.PickUpPoint[0];

        try
        {
            var settings = SettingsBiz.GetSettings().Display.Admin.Proteria;
            var api = new Proteria.CloudConnect(settings.ApiKey);
            return api.GetPickUpPoints(countryCode, postCode, carrier) ?? new Proteria.PickUpPoint[0];
        }
        catch (Exception err)
        {
            if (errorMsg.IsNullOrEmpty()) errorMsg = err.Message;
            return new Proteria.PickUpPoint[0];
        }
    }
}

<style type="text/css">
    .booking-service{ display: inline-block; margin-right: 15px; min-width: 170px}
    #proteria-booking-form .right { margin-top: 3px; margin-left: 2%; width: 72%; }
    #proteria-booking-form .right.link { margin-top: 7px;height: 2em;overflow: hidden;border: 1px solid #ccc;padding-left: 5px; }
    #proteria-booking-form .left { width: 22%; text-align: right; }
    #proteria-booking-form .item { margin: 0;  }
