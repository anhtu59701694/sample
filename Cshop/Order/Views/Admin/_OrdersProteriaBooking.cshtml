            <div class="item" style="display: none">
                <div class="left">@Html.LocalizeNameFor(m => m.Amount):</div>
                <div class="right">
                    @Html.LocalizeTextBoxFor(m => m.Amount, new { @style = "width: 150px !important;min-width: 0;" })
                    <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Amount)</div>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            var proteriaHolder = '#proteria-booking-form';
            var productId = $('#@Html.IdFor(m => m.ProductId)', proteriaHolder);

            formUpdateValidRules($('#proteria-booking-form'));

            productId.change(function () {
                var kdNode = $(this).data("kendoDropDownList");
                $('#@Html.IdFor(m => m.ProductName)', proteriaHolder).val(kdNode.text());
            });

            $('#@Html.IdFor(m => m.ServiceCod)', proteriaHolder).change(function () {

                var amountBox = $('#@Html.IdFor(m => m.Amount)', proteriaHolder).closest('.item').hide();
                var codAccountBox = $('#@Html.IdFor(m => m.CodAccountNumber)', proteriaHolder).closest('.item').hide();

                if ($(this).prop('checked')) { amountBox.show(); codAccountBox.show(); }

                formDisableValidation(amountBox.find('input'), !amountBox.is(':visible'));
                formDisableValidation(codAccountBox.find('input'), !codAccountBox.is(':visible'));
            }).change();

            setTimeout(function () {
                kendoDropDownHideProducts();
                if (productId.val()) productId.change();
            }, 1000);

            function kendoDropDownHideProducts() {
                var nodeKd = $('#@Html.IdFor(m => m.ProductId)').data('kendoDropDownList'), carrier = $('#@Html.IdFor(m => m.CarrierName)').val(), idx = 0;

                $('li.k-item', nodeKd.ul).each(function () {
                    if (!idx) { idx++; return; }

                    var liCarrier = $(this).attr('data-carrier')
                    if (!liCarrier) {
                        var row = nodeKd.dataSource.data()[idx - 1];
                        $(this).attr('data-carrier', liCarrier = row.Model.Type);
                    };

                    if (liCarrier == carrier) $(this).show();
                    else $(this).hide();
                    idx++;
                });
            }

        </script>
    }
    else
    {
        <div class="result-form">
            <div class="item">
                <div class="left">@Html.LocalizeNameFor(m => m.BookingShipmentId):</div>
                <div class="right">@Html.LocalizeTextBoxFor(m => m.BookingShipmentId, new { @readonly = "readonly", @style = "width: 150px !important;min-width: 0;" })</div>
            </div>
            <div class="item">
                <div class="left">@Html.LocalizeNameFor(m => m.BookingTrackingNumber):</div>
                <div class="right">@Html.LocalizeTextBoxFor(m => m.BookingTrackingNumber, new { @readonly = "readonly", @style = "width: 150px !important;min-width: 0;" })</div>
            </div>
            <div class="item">
                <div class="left">@Html.LocalizeNameFor(m => m.BookingCreatedAt):</div>
                <div class="right">@Html.LocalizeTextBoxFor(m => m.BookingCreatedAt.TextF, new { @readonly = "readonly", @style = "width: 150px !important;min-width: 0;" })</div>
            </div>
            <div class="item">
                <div class="left">@Html.LocalizeNameFor(m => m.BookingLabelPdf):</div>
                <div class="right link">
                    @if (!Model.BookingTrackingNumber.IsNullOrEmpty())
                    {
                        <a href="@ModuleUrl.AdminUrl(Html.GetController(), "DownloadPdf", new RouteValueDictionary(new {@shipmentId = Model.BookingShipmentId}))" target="_blank">
                            @StringTable.DownLoadA
                        </a>
                    }
                </div>
            </div>
            <div class="item">
                <div class="left">@Html.LocalizeNameFor(m => m.BookingTrackingUrl):</div>
                <div class="right link">
                    <a href="@Model.BookingTrackingUrl" target="_blank">@Model.BookingTrackingUrl</a>
                </div>
            </div>
            @if (printers != null && !Model.BookingTrackingNumber.IsNullOrEmpty())
            {
                <div class="item" >
                    <div class="left">@Html.LocalizeNameFor(m => m.BookingPrinter):</div>
                    <div class="right">
                        @Html.LocalizeDropDownListKendoFor(m => m.BookingPrinter, printers.Where(x => x.State.IsNullOrEmpty() || x.State.EqualsIgCase("online")).Select((x,idx) => new DDListItem()
                        {
                            Text = x.Name + (x.Type.IsNullOrEmpty() ? "" : " (" + x.Type + ")"),
                            Value = (idx + 1).ToString(), Active = true, LangVisible = true, Model = x, id = idx + 1,
                        }), m => m.Value, m => m.Text, null, new { @style = "min-width:100px" })
                        @if(printers.SafeCount() != 0) {
                            <input onclick="printBooking()" class="btn" style="margin: 0;width: 40px !important;" type="button" value="@StringTable.BookingPrint" />
                        }
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.BookingPrinter)</div>
                    </div>
                </div>
            }
        </div>

        <script type="text/javascript">

            function printBooking() {
                var trackingNumber = $('#@Html.IdFor(m => m.BookingTrackingNumber)');
                var shipmentId = $('#@Html.IdFor(m => m.BookingShipmentId)');
                var printer = $('#@Html.IdFor(m => m.BookingPrinter)');
                var printerKd = printer.data('kendoDropDownList');

                if (!printer.valid() || !trackingNumber.val()) return;

                var row = printerKd.dataSource.get(printer.val());

                ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "PrintBooking")', {
                    shipmentId: shipmentId.val(), printId: row.Model.Id, printType: row.Model.Type, printName: row.Model.Name
                }, function () {
                    if (window.ProteriaBookingForm) window.ProteriaBookingForm.find(".btn_cancel").click();
                });
            }

        </script>

        if (QParam.GetField<bool?>("checkbooking", false, true) == true)
        {
            <script type="text/javascript">

                function checkBookingResult(counter) {

                    if (!window.ProteriaBookingForm) return;

                    if (!counter) admincommon.showMessage('@("check Booking Result waiting".ModLocalize("Waiting for the result"))');

                    counter = counter || 1;

                    var interval = 1500;

                    if (counter > (120000 / interval)) {
                        admincommon.showMessage('@("check Booking Result timed out".ModLocalize("Timed out"))', 1);
                        $('#booking-loading').hide();
                        return;
                    }

                    $('#booking-loading').show();

                    ajaxREST('@ModuleUrl.AdminUrl(Html.GetController(), "GetShippingState", Model.OrderId)', 'GET', {}, 'booking-loading-fake',
                        function (result) {
                            if (result && result.Data && (result.Data.TrackingNumber || result.Data.Error || result.Data.Valid == false)) {
                                $('#booking-loading').hide(); openProteriaBookingForm(true);
                            }
                            else setTimeout(function () { checkBookingResult(counter + 1); }, interval);
                        });
                }

                $(function () { checkBookingResult(); })

            </script>
        }

    }
</div>

<script type="text/javascript">
    var errMsg = '@Regex.Replace(errMsg ?? "","\\s"," ")';

    setTimeout(function () {
        if (errMsg) admincommon.showMessage(errMsg, 'Error');
    }, 500);

</script>
