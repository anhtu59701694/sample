                    <section class="clo_left txt_align_r" style="width: 100% !important; text-align: left !important;">
                        <h2>@StringTable.CustomerDiscountInfo</h2>
                    </section>
                    <section class="controls" style="margin-left: 10px;">
                        <span class="text-eshop">@Html.LocalizeNameFor(x => x.DiscountRate)</span>
                        <section>
                            <section>
                                @Html.LocalizeTextBoxFor(m => m.DiscountRate, new { @class = "kendo-numeric", @style = "float:left" })&nbsp;%
                            </section>
                            <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(x => x.DiscountRate)</section>
                        </section>
                    </section>
                    <section class="controls" style="margin-left: 10px;">
                        <span class="text-eshop">@Html.LocalizeNameFor(x => x.CustCategories)</span>
                        <section class="cate-discount-box" style="float: left;clear: both;">
                            <section>
                                <ul>
                                    @for (var i = 0; i < Model.CustCategories.Count; i++)
                                    {
                                        var idx = i;
                                        <li>
                                            <section>
                                                @Html.HiddenFor(m => m.CustCategories[idx].CategoryId, new { databind = "CategoryId" })
                                                @Html.LocalizeTextBoxFor(m => m.CustCategories[idx].DiscountRate, new { databind = "DiscountRate", placeholder = new OFloat(0).Text }) % - 
                                                <a class="name form-link" href="@ModuleUrl.AdminUrl("Category", "Edit", Model.CustCategories[idx].CategoryId)">@Model.CustCategories[idx].UpPath</a>
                                                <a class="delete" title="@StringTable.Delete" onclick="deleteCate(this)" href="javascript:void(0);">X</a>
                                                <br/>
                                                @Html.LocalizeTextBoxFor(m => m.CustCategories[idx].Notes, new { databind = "Notes", style = "width: 98%;", placeholder = Html.LocalizeNameFor(x => x.CustCategories[idx].Notes) })
                                            </section>
                                            <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.CustCategories[idx].DiscountRate)</section>
                                            <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.CustCategories[idx].Notes)</section>
                                        </li>
                                    }
                                </ul>
                                <div><button class="btn" href="javascript:;" onclick="openAssignCates($(this))" style="margin: 3px 0 0 10px;" type="button">@StringTable.Edit</button></div>
                            </section>
                            <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(x => x.CustCategories)</section>
                        </section>
                    </section>
                </section>
            </section>
        }
        <section class="row_content_box">
            <section class="clo_right col-right-eshop">
                <section class="wr-line-eshop"></section>
                <section class="clo_left txt_align_r" style="width: 100% !important; text-align: left !important;">
                    <h2>@Html.LocalizeNameFor(x => x.Comments)</h2>
                </section>
                <section class="controls" style="margin-left: 10px;">
                    <span class="text-eshop"></span>
                    <section>
                        <section>
                            @Html.LocalizeTextAreaFor(m => m.Comments, new { @class = "", @style = "float:left", @rows=5 })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(x => x.Comments)</section>
                    </section>
                </section>
            </section>
        </section>
        
    </section>
    <section class="wr-line-eshop"></section>
}

<script type="text/javascript">

    $(function () {
        initKendoNumeric('input.kendo-numeric', { format: "n2", min: 0.0, max: 100.0, step: 1.0 });

        $('.btn_add_order').unbind('click').click(function () { window.location = '@ModuleUrl.AdminUrl("Order", "Input", 0)?customerId=@(Model.Id)'; })
    })

    var form = $('#editForm')[0];

    form.customValidFields = function () {
        return true;
    };

    form.CustomLangFormSwitch = function (langcode, node, senderuid) {
        var ownerbox = node.closest('.row_content_box');
    };


    function dropdownGetData(node) {
        return node.data("kendoDropDownList").dataSource.get(node.val());
    }

    function validPostalCodeBilling() {
        return validPostalCode('@Html.IdFor(m => m.BillingPostnr)', '@Html.IdFor(m => m.BillingPosted)',
            '@Html.IdFor(m => m.BillingCountryId)', 'CheckingBillingPostnr');
    }

    function validPostalCodeDeliver(node) {
        if (node) {
            var form = node.closest('li');
            return validPostalCode($('.Postnr', form).attr('id'), $('.Posted', form).attr('id'), $('.CountryId[id]', form).attr('id'), $('.LoadingImg', form).attr('id'));
        }
        else return validPostalCode('@Html.IdFor(m => m.DeliverPostnr)', '@Html.IdFor(m => m.DeliverPosted)',
            '@Html.IdFor(m => m.DeliverCountryId)', 'CheckingDeliverPostnr');
    }

    function validPostalCode(postnrid, cityid, countryid, waitingId) {

        var postalCode = $('#' + postnrid), postalVal = $.trim(postalCode.val());
        var countryVal = safeProp(dropdownGetData($('#' + countryid)), 'Code');

        if (countryVal == '' || postalVal == '') return true;
        if (!postalCode[0].validPnr) postalCode[0].validPnr = {};

        var key = countryVal + '&' + postalVal;

        if (postalCode[0].validPnr.key == key && postalCode[0].validPnr.value) {
            //console.log('cached:', key, postalCode[0].validPnr);
            if (postalCodeOnResult(postnrid, cityid, postalCode[0].validPnr.value)) return true;
            else {
                postalCode.focus();
                return false;
            }
        }

        ajaxREST('/modules/eshop/BringShippingGuide/GetPostalCode', 'GET',
            { clientUrl: window.location.host, country: countryVal, pnr: postalVal }, waitingId,
            function (result) {
                if (result) {
                    if (!result.valid) result.result = '';
                    result.pnr = postalVal;
                    result.country = countryVal;
                    postalCode[0].validPnr = { key: key, value: result };
                    postalCodeOnResult(postnrid, cityid, result);
                }
            }, function (e) { console.log(e); });

        return true;
    }

    function postalCodeOnResult(postnrid, cityid, result) {
        var actCity = $('#' + cityid);
        var curCity = $.trim(actCity.val());

        if (curCity == '' || actCity.attr('bak-val') == curCity) {
            actCity.val(result.result);
            actCity.attr('bak-val', result.result);
            actCity.change();
        }
        
        formShowErrorMsg($('#' + postnrid).attr('name'), result.valid ? null : '@StringTable.ErrMsgInvalidPostalCode');
        return result.valid;
    }


    function deleteCate(node) {
        console.log('deleteCate', $(node), $(node).closest('li'));
        $(node).closest('li').hide().find('input[databind="DiscountRate"]').val("0");
    }

    function openAssignCates(node) {

        if ('@(ViewBag.PermissionEdit ? 0 : 1)' == '1') return;

        var cateIds = [];
        $('.cate-discount-box li input[databind="CategoryId"]').each(function () {
            var discountRate = $(this).closest('li').find('input[databind="DiscountRate"]').val();
            if (discountRate && discountRate != '0') cateIds.push($(this).val());
        });

        ajaxCmdHtml('@ModuleUrl.AdminUrl("Product", "GetAssignForm")', { id: '@Model.Id', categoryIds: cateIds.join(', ') },
            function (result, customTag) {
                openAssignCate('@Model.Id', null, result);
            });
    }

    function buildCateList(cates) {

        var cateIds = [];

        $('.cate-discount-box li').each(function () {

            var id = $(this).find('input[databind="CategoryId"]').val();

            if (cates.find(function (itm) { return itm.Id == id; }))
                cateIds.push({
                    Id: id,
                    Rate: localizeParseFloat($(this).find('input[databind="DiscountRate"]').val()),
                    Notes: $(this).find('input[databind="Notes"]').val()
                });
        });

        cates.forEach(function (itm) {
            if (!cateIds.find(function (x) { return itm.Id == x.Id; }))
                cateIds.push({ Id: itm.Id, Rate: null, Notes: null });
        });

        ajaxCmdHtml('@ModuleUrl.AdminUrl(Html.GetController(), "Input")', { id: '@Model.Id', categories: JSON.stringify(cateIds) },
            function (result) {
                $('.cate-discount-box ul').html($('.cate-discount-box ul', result).html());
                formUpdateValidRules($('.cate-discount-box'));
            }, null, 'GET');
    }

    function openAssignCate(id, actionurl, formHtml) {
        var width = Math.max(200, Math.min(600, $(window).width() - 50));
        var height = Math.max(200, Math.min(300, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popup = new ClawModal("", "modal-mask");
        var popTemplate = $('<div>').html($("#assign-cate-templ").html());
        popTemplate.find('#form-html').html(formHtml);

        var formTitle = '@StringTable.CustomerDiscountSelectCate';

        var windowModal = popup.showCustomModal("#window", formTitle, popTemplate.html(), width, height, [], null,
            function (modal) {
                var treeview = modal.find("#catetree");

                modal.find(".btn_save").click(function () {
                    var selectedList = getSelectedIds(treeview);

                    console.log(selectedList);

                    buildCateList(selectedList.Jsons);

                    popup.close(); $(window).scrollTop(scrollTop);
                    $('#editform-change-state').val(1).change();
                });

                modal.find(".btn_cancel").click(function () { popup.close(); $(window).scrollTop(scrollTop); });
            });
    }

    $('.btn_resetpassword').click(function () {

        var width = Math.max(200, Math.min(400, $(window).width() - 50));
        var height = Math.max(200, Math.min(230, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popup = new ClawModal("", "modal-mask");
        var formTitle = '@StringTable.ResetPassword';

        var windowModal = popup.showCustomModal("#window", formTitle, $("#reset-password-templ").html(), width, height, [], null,
            function (modal) {

                modal.find('#err-message-holder').append($('#massage.show_massage'));
                admincommon.hideMessage();
                formUpdateValidRules(modal.find('.wcontent'));

                modal.find(".btn_save").click(function () {
                    if (!modal.find('form').valid()) return;

                    if ($('#NewPassword', modal).val() != $('#ConfirmPassword', modal).val()) {
                        admincommon.showMessage('@(StringTable.PasswordMismatch)', 'Error'); return;
                    }

                    ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "ResetPassword")', { id: '@Model.Id', newPassword: $('#NewPassword', modal).val() },
                         function (result) {

                             $('#input-err-msg-box').append(modal.find('#massage.show_massage'));
                             popup.close(); $(window).scrollTop(scrollTop);
                         });
                });

                modal.find(".btn_cancel").click(function () {
                    $('#input-err-msg-box').append(modal.find('#massage.show_massage'));
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });
    })

    function addAddress() {
        var holder = $('.addresses-box'), templ = $('li[data-index="0"]', holder), count = parseInt(holder.attr('data-count'));

        if (count == 0) templ.show();
        else {
            var node = $('<li>').attr('data-index', count);
            node.html(templ.html().replace(/\_0\_\_/gi, '_' + count + '__').replace(/\[0\]\./gi, '[' + count + '].'));
            $('input:not([type="hidden"])', node).val('');
            $('input.CountryId[id]', node).val('1');
            $('input.Id', node).val('0');
            $('input.custaddr-default', node).attr('data-id', '0').prop('checked', false).val('True');
            $('input.custaddr-default', node).attr('data-id', '0').val('True');
            holder.append(node);
            formUpdateValidRules(node);
        } 

        holder.attr('data-count', count + 1);
    }
    
    function removeAddress(node) {
        node.closest('li').hide().find('input').val('');
        formDisableValidation(node.closest('li').find('input'), true);
    }
    
    function defaultAddressesChange(node) {
        if (node.prop('checked')){
            $('input.css-checkbox.custaddr-default:checked').prop('checked', false);
            node.prop('checked', true);
        }
        $('#@Html.IdFor(m => m.AddressId)').val($('input.css-checkbox.custaddr-default:checked').attr('data-id') || '');
    }

    $(function () {
        if (!window.formUpdateValidRulesBak) {
            window.formUpdateValidRulesBak = window.formUpdateValidRules;
            window.formUpdateValidRules = function (node) {
                window.formUpdateValidRulesBak(node);
                formDisableValidation($('li:not(:visible) input', '.addresses-box,.cate-discount-box'), true);
            }
            formDisableValidation($('li:not(:visible) input', '.addresses-box,.cate-discount-box'), true);
        }
    })
</script>
<script id="assign-cate-templ" type="text/kendo-template">
    <div class="popupBody">
        <section id="err-message-holder"></section>
        <section class="row_content_box kpopup-content">
            <section class="wr_clo1" style="margin: 20px 20px 10px 20px;background-color: #f7f7f7;border: 1px solid #ccc;">
                <div class="wcontent">
                    <div class="htmlcontent">
                        <div id="form-html"></div>
                    </div>
                </div>
            </section>
            <section class="clear"></section>
            <ul class="wr_submit_top form-action-menu" style="position:relative; padding:5px 0;">
                <li><input type="button" value="@StringTable.Done" class="btn_save"></li>
                <li style="margin-right:20px;"><input type="button" value="@StringTable.Cancel" class="btn_cancel"></li>
            </ul>
        </section>
    </div>
</script>

