@using System.Linq
@using System.Web.UI.WebControls
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@model CustomerModel

@{
    Layout = "Layout/Input.cshtml";

    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.OrderEdit;
    ViewBag.Title = StringTable.AddEditCustomer(Model.Id);
    ViewBag.ShowDeleteBtn = (Model != null && Model.Id > 0);

    //ViewBag.UseCKEditor = true;
    //ViewBag.UseDatePicker = true;
    //ViewBag.UseDropZone = true;

    ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/customer";
    ViewBag.ParentBreadcrumbTitle = StringTable.Customers;

    var settings = (SettingsBiz)ViewBag.Settings;
    var countries = (List<Claw.Modules.Eshop.Domain.Country>)ViewBag.Countries;
    var langOpt = LanguageMgr.ValidOptLang(Model.Id);
    var langCode = langOpt.LanguageCode;
    var loginAsCust = QParam.GetField<bool>("loginascust", false, true);

    if (loginAsCust) 
    {
        var customer = CustomerMgr.GetDom(new DefaultDb(), Model.Id);
        var usrlogin = new UserInfoDTO(customer)
        {
            Email = customer.Email,
            ContactName = customer.ContactName.IfNull(customer.DeliverName),
            UserId = customer.Id,
            ShowPrice = customer.IsShowPrice(),
        };

        SessionHelper.Add(SessionKey.Claw3UserInfoDTO, usrlogin);

        Response.Redirect(EShopHelper.GetUrlFE(ConstantPageName.MyAccount));
    }
}

@section MainTitleSection {
    @(StringTable.ManageCustomers)
}

@section CurrentTitleSection {
    <a href="/admin/modules/eshop/customer/">@(StringTable.ManageCustomers)</a>
}

@section TabTitleSection {
