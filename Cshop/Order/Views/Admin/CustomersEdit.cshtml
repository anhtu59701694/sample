                        </section>
                    </section>
                    <section class="controls">
                        <span class="text-eshop">Confirm password:</span>
                        <input name="ConfirmPassword" id="ConfirmPassword" type="password" data-val="true" maxlength="110" data-val-length-max="100"
                               data-val-length="@string.Format(StringTable.ErrMsgLengthLimit.ModErrLocalize(), "", 100)"
                               data-val-required="@(StringTable.ErrMsgRequiredField.ModErrLocalize())" />
                        <section class="field-valid-msg">
                            <span class="field-validation-valid error" data-valmsg-for="ConfirmPassword" data-valmsg-replace="true"></span>
                        </section>
                    </section>
                </div>
            </section>
            <section class="clear"></section>
            <ul class="wr_submit_top form-action-menu" style="position:relative; padding:5px 0;margin-right: 10px;">
                <li><input type="button" value="@StringTable.Done" class="btn_save"></li>
                <li style="margin-right:20px;"><input type="button" value="@StringTable.Cancel" class="btn_cancel"></li>
            </ul>
        </section>
    </form>

</script>