@using System.Linq
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@model OrderModel
@{
    //var langCode = (string)ViewData["LangCode"];
    var settings = (SettingsBiz)ViewBag.Settings;
    var noteHtml = Html.GetHtmlHelper<OrderNoteModel>();

    var paydata = Model.Id != 0 && Model.GetRaw() != null && Model.GetRaw().OrderDetails.SafeCount() == 0 ? Model.GetRaw().SafeProp(m => m.PaymentData).SafeProp(m => m.IsNullOrEmpty() ? null : Eshop.Payments.BasePayment.PaymentData.Deserialize(m)) : null;
    var payPostData = paydata.SafeInvokeProperty<string>("PostData");
}

@if (paydata != null)
{
    var db = new Claw.Modules.Eshop.DAL.DefaultDb();
    var payType = paydata.GetType();
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var odItems = new[] { new { item = new { product = new Claw.Modules.Eshop.Domain.ProductBase(), variant = new Claw.Modules.Eshop.Domain.VariantBase(), sourceId = 0 }, name = "", quantity = 0, unitPrice = 0, incVat = false } }.Take(0).ToList();
    Func<string, System.Tuple<int, int, int>> fGetProdId = x =>
    {
        var arr = x.Split('-');
        return new System.Tuple<int, int, int>(arr[1].TryParseInt() ?? 0, arr.Length == 3 ? arr[2].TryParseInt() ?? 0 : 0, arr[0].TryParseInt() ?? 0);
    };
    if (payType == typeof(Eshop.Payment.DIBS.DIBSPaymentData))
    {
        var order = Newtonsoft.Json.JsonConvert.DeserializeAnonymousType(payPostData, new { order = new { items = new Eshop.Payment.DIBS.Data.OrderItem[0] } });
        odItems = order.order.items.Where(m => !m.reference.InList("PAYEMNT", "SHIPPING"))
            .Select(m => new { item = fGetProdId(m.reference).SafeProp(z => new { product = db.DataService.GetObject<Claw.Modules.Eshop.Domain.ProductBase>(z.Item1), variant = z.Item2 == 0 ? null : db.DataService.GetObject<Claw.Modules.Eshop.Domain.VariantBase>(z.Item2), sourceId = z.Item3 }), m.name, m.quantity, m.unitPrice, incVat = false }).ToList();
    }
    else if (payType == typeof(Eshop.Payments.Svea.SveaPaymentData))
    {
        var order = Newtonsoft.Json.JsonConvert.DeserializeAnonymousType(payPostData, new { cart = new { Items = new Eshop.Payments.Svea.OrderRow[0] } });
        odItems = order.cart.Items.Where(m => !m.ArticleNumber.InList("PAYMENT", "SHIPPING"))
            .Select(m => new { item = fGetProdId(m.ArticleNumber).SafeProp(z => new { product = db.DataService.GetObject<Claw.Modules.Eshop.Domain.ProductBase>(z.Item1), variant = z.Item2 == 0 ? null : db.DataService.GetObject<Claw.Modules.Eshop.Domain.VariantBase>(z.Item2), sourceId = z.Item3 }), name = m.Name, quantity = (int)m.Quantity / 100, unitPrice = (int)m.UnitPrice, incVat = true }).ToList();
    }
    else if (payType == typeof(Eshop.Payments.Vipps.VippsPaymentData))
    {
        var orderItems = paydata.SafeInvokeProperty<List<Eshop.Payments.Vipps.ItemDescription>>("Items") ?? new List<Eshop.Payments.Vipps.ItemDescription>();
        odItems = orderItems.Where(m => !m.reference.InList("PAYEMNT", "SHIPPING"))
            .Select(m => new { item = fGetProdId(m.reference).SafeProp(z => new { product = db.DataService.GetObject<Claw.Modules.Eshop.Domain.ProductBase>(z.Item1), variant = z.Item2 == 0 ? null : db.DataService.GetObject<Claw.Modules.Eshop.Domain.VariantBase>(z.Item2), sourceId = z.Item3 }), name = m.product, m.quantity, m.unitPrice, incVat = false }).ToList();
    }
    else if (payType == typeof(Eshop.Payments.KlarnaPayments.KlarnaPaymentData))
    {
        var order = Newtonsoft.Json.JsonConvert.DeserializeAnonymousType(payPostData, new { order_lines = new Eshop.Payments.KlarnaPayments.OrderLine[0] });
        odItems = order.order_lines.Where(m => !m.reference.InList("PAYEMNT", "SHIPPING"))
            .Select(m => new { item = fGetProdId(m.reference).SafeProp(z => new { product = db.DataService.GetObject<Claw.Modules.Eshop.Domain.ProductBase>(z.Item1), variant = z.Item2 == 0 ? null : db.DataService.GetObject<Claw.Modules.Eshop.Domain.VariantBase>(z.Item2), sourceId = z.Item3 }), m.name, m.quantity, unitPrice = m.unit_price, incVat = true }).ToList();
    }
    else if (payType == typeof(Eshop.Payments.KlarnaCheckout.KlarnaCheckoutPaymentData))
    {
        var order = Newtonsoft.Json.JsonConvert.DeserializeAnonymousType(payPostData, new { order_lines = new Eshop.Payments.KlarnaCheckout.OrderLine[0] });
        odItems = order.order_lines.Where(m => !m.reference.InList("PAYEMNT", "SHIPPING"))
            .Select(m => new { item = fGetProdId(m.reference).SafeProp(z => new { product = db.DataService.GetObject<Claw.Modules.Eshop.Domain.ProductBase>(z.Item1), variant = z.Item2 == 0 ? null : db.DataService.GetObject<Claw.Modules.Eshop.Domain.VariantBase>(z.Item2), sourceId = z.Item3 }), m.name, m.quantity, unitPrice = m.unit_price, incVat = true }).ToList();
    }

    var items = odItems.Select(m => string.Format("({0}, {1}, '{2}', {3}, {4}, {5}, 0, 0, 0, {6}, {7}, {8}, {9}, {10}, {11}, {12}, {13})",
                Model.Id, m.item.product.Id, m.item.product.GetName(m.item.variant), m.quantity, ((double?)m.item.product.CombinedSalePrice(m.item.variant) ?? 0).ToString(culture),
                ((double)m.item.product.Vat.Value).ToString(culture), m.item.product.ShippingType, ((double)m.item.product.Weight).ToString(culture),
                ((object)m.item.product.CombinedCostPrice(m.item.variant)).SafeProp(z => ((double)(decimal)z).ToString(culture), "null"), m.item.product.WUnit, m.item.product.SKU.SafeProp(z => "'" + z + "'", "null"),
                (m.unitPrice / ((1 + (double)(m.incVat ? m.item.product.Vat.Value : 0)) * 100.0)).ToString(culture), m.item.sourceId, ((double?)m.item.product.CombinedPrice(m.item.variant) ?? 0).ToString(culture))).ToList();

    if (items.Count != 0)
    {
        <div style="margin-bottom: 10px;">
            <button onclick="$(this).parent().find('pre').toggle()" type="button">Show sql</button>
            <pre style="display:none;">

        INSERT eshop.OrderDetails(OrderId, ProductId, ProductName, Quantity, Price, Vat, DiscountValue, CouponValue, Delivered,
               ProductShippingType, ProductWeight, CostPrice, ProductWUnit, ProductSKU, PriceFE, SourceId, PriceOrigin) VALUES
        @(items.ToString(", \r\n        "))
        </pre>
        </div>
    }
}

@if (Model.Id != 0 && !Model.OrderStatus.InList(OrderStatus.Cancelled, OrderStatus.New, OrderStatus.PaymentWaiting))
{
    <div style="margin-bottom: 10px;">
        <button onclick="tripletexRePush()" type="button">@("Re-push to tripletex".ModLocalize())</button>
    </div>
 }
