            grid.Col(m => m.Message)
                .SetTemplate("<div class='subject'>#=Subject#</div><div class='body'>#=Body#</div><div class='body'>#=AuditInfo#</div>"),
            grid.Col(m => m.Subject),
            grid.Col(m => m.Body)
