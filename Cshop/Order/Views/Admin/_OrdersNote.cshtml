}
<div class="wr_table_all" id="order-notes" style="float: left; width: 100%; margin-bottom: 5px;">
    @(noteHtml.LocalizeGridFor<OrderNoteModel>("gridordernote", "OrderNote", "Delete", null, null, null,
        null, null, grid =>
        {
            grid.ButtonDelBigClass += "_note";
            grid.ButtonAddNewClass += "_note";
            grid.CheckBoxSelAllCss += "_note";
            grid.CheckBoxRowCssClass += "_note";
        })
        .DataSource(m => m.Id, "List", null, null, "gridOrderNoteGetParams")
        .Paging(10, new[] { 10, 20, 30, 50, 100 })
        //.ColumnCheckBox(m => m.Id)
        .Columns(grid => new[]
        {
            grid.Col(m => m.CreatedDate, false, 150)
                .SetTemplate(orderedDateTempl).SetCssClass("td-center"),
            grid.Col(m => m.NoticeCustomer)
                .SetTemplate(StringTable.BoolTempl)
                .SetCssClass("td-center  k-grid-status"),
            grid.Col(m => m.OrderStatusTxt)
                .SetTemplate(OrderStatusTxtTempl)
