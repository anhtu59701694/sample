<script type="text/javascript">

    function showSendDlg(ids) {

        var scrollTop = $(window).scrollTop();
        var dialog = new ClawDialog('modal-mask');
        var content = $('<div>').html($("#confirm-dialog-templ").html());

        content.find('.prompt-mess').html('@StringTable.OrderSendConfirmMsg'.replace('&lt;br&gt;', '<br>'));
        content.find('#err-message-holder').append($('#massage.show_massage'));

        var kendoWindow = dialog.showDialog('@StringTable.SendOrder', content.html(), 550, 200);
        var promptMsg = kendoWindow.find('.prompt-mess'), orderList = kendoWindow.find('.order-list');

        admincommon.hideMessage();

        var cmdUrl = '@ModuleUrl.AdminUrl(Html.GetController(), "Send")/';
        var items = [], itemsForced = [], results = [], gridData = grid.data('kendoGrid');

        if(ids && ids.length != 0) {
            ids.forEach(function(id){
                items.push({ order: gridData.dataItem($('#grid_rwcbox_' + id, grid).closest('tr')), checkResult: null});
            });
        }
        else
            gridData.tbody.find('input:checked').closest('tr').each(function () {
                items.push({ order: gridData.dataItem($(this)), checkResult: null});
            });

        kendoWindow.find('.btn_yes').click(function () {
            $(this).closest('.wr_btn_pp').hide(); promptMsg.hide(); orderList.show();
            kendoWindow.find('.btn_no').html('@StringTable.Cancel');
            checkOrder();
        });

        kendoWindow.find('.btn_no').click(function () {
            $('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
            $(window).scrollTop(scrollTop); admincommon.hideMessage();
            dialog.close();
        });

        function checkOrder() {

            if (items.length == 0) {
                var itemsErr = results.filter(function(ord) { return !ord.statusResult || !(ord.statusResult.Status == 0); });

                console.log('checkOrder done', itemsErr, results);

                if (itemsErr.length != 0) {
                    itemsForced = results.filter(function(ord) { return ord.captureResult && !(ord.captureResult.Status == 0); });
                    if (itemsForced.length != 0) {
                        kendoWindow.find('.btn_yes').click(function() {
                            $(this).closest('.wr_btn_pp').hide();
                            itemsForced.forEach(function(item) { doStatus(null, item.element, true); });
                        }).html('@StringTable.ForceSendOrder').closest('.wr_btn_pp').show();
                    }
                }

                doComplete(results.length - itemsErr.length, results.length, itemsErr.length == 0);

                return;
            }

            var itm = items.pop();
            var iEle = itm.element = $('<tr><td>' + itm.order.id + '</td><td class="msg">@StringTable.OrderCheckTransactionMsg</td></tr>')
                .attr({ id: 'order-msg-' + itm.order.id })
                .data('clawData', itm);

            orderList.append(iEle);

            adjustPopup( $('#modal').closest('.k-window'), '.order-list', '.dlg_body', null, null, 60, 45);
            
            if((itm.order.Flags & (@(Claw.Modules.Eshop.Domain.Interfaces.OrderFlagType.Custom0.Val()) | @(Claw.Modules.Eshop.Domain.Interfaces.OrderFlagType.Custom1.Val()))))
            {
                var result = {Status: 2, Message: '@("no send for order flag custom".ModLocalize("Send is disabled for custom flags"))'};

                iEle.find('.msg').append($('<div class="error">').html(result.Message));
                itm.checkResult = result;
                results.push(itm);
                setTimeout( checkOrder, 10);
            }
            else ajaxCmd(cmdUrl + itm.order.id, { action: 'check' }, function (result) {
                itm.checkResult = result; results.push(itm);

                if (result.Status == 0) {
                    if (result.NeedCapture) doCapture(itm.order.id, iEle);
                    else doStatus(itm.order.id, iEle);
                } else {
                    checkOrder();

                    if (result.Message)
                        iEle.find('.msg').append($('<div class="error">').html(result.Message));
                }

                $('.dlg_body', kendoWindow).scrollTop($('.order-list', kendoWindow).height());
            }, false, false);
        };

        function doCapture(orderId, iEle) {
            iEle.find('.msg').html('@StringTable.OrderCaptureTransactionMsg');
        ajaxCmd(cmdUrl + orderId, { action: 'capture' }, function (result) {
            iEle.data('clawData').captureResult = result;

            if (result.Status == 0) doStatus(orderId, iEle);
            else {
                iEle.find('.msg').append($('<div class="error">').html('@StringTable.ErrMsgOrderCaptureFailed'.replace('&lt;br&gt;', '<br>').replace('{0}', result.Message)));

                checkOrder();
            }
        }, false, false);
    };

    function doStatus(orderId, iEle, force) {

        if (force && itemsForced.length == 0) {
            var itemsErr = results.filter(function(ord) { return !ord.statusResult || !(ord.statusResult.Status == 0); });

            console.log('doStatus forced done', results);

            doComplete(results.length - itemsErr.length, results.length, itemsErr.length == 0);

            return;
        }

        var itm = force ? itemsForced.pop() : { order: { id: orderId }, captureResult: { Message: null} };

        iEle.find('.msg').html('@StringTable.OrderChangeStatusMsg');
        ajaxCmd(cmdUrl + itm.order.id, { action: 'status', force: force, message: itm.captureResult.Message },
            function(result) {
                iEle.data('clawData').statusResult = result;

                if (force) doStatus(null, iEle, true); //next
                else checkOrder();

                if (result.Message)
                    iEle.find('.msg').append($('<div class="' + (result.Status == 0 ? 'succeeded' : 'error') + '">').html(result.Message));

            }, false, false);
    };

    function doComplete(nSucceeded, nTotal, closeDlg) {

        if (closeDlg) {
            $('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
            $(window).scrollTop(scrollTop);
            dialog.close();
        }
        else kendoWindow.find('.btn_no').html('@StringTable.Close');

        if (nSucceeded == nTotal)admincommon.showMessage('@StringTable.SendOrdersResult(true)'.replace('{0}', nTotal));
        else admincommon.showMessage('@StringTable.SendOrdersResult(false)'.replace('{0}', nTotal).replace('{1}', nSucceeded), 2);

        grid.data('kendoGrid').clawSkipHideMsg = true;
        grid.data('kendoGrid').dataSource.read();
    }
    }

    //adjustPopup( $('#modal').closest('.k-window'), '.order-list', '.dlg_body', null, null, 60, 45);
    function adjustPopup(kendoWindow, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY) {

        cmdBoxHeight = cmdBoxHeight || 30; adjustY = adjustY || 10;
        minHeight = minHeight || 200; maxHeight = maxHeight || 2048;

        var holderNode = kendoWindow.find(holder), scrollNode = holderNode.closest(scrollBox);
        var recHeight = Math.max(minHeight, Math.min(maxHeight, $(window).height() - 50));
        var height = Math.min(recHeight, Math.max(minHeight, holderNode.height() + cmdBoxHeight + 30 + adjustY));

        scrollNode.closest('.k-widget.k-window').css({
            'height': height + 'px',
            'top': ($(window).height() - height - 30) / 2 + 'px',
        });
        scrollNode.css({ 'max-height': (height - cmdBoxHeight - 30) + 'px', 'overflow': 'auto' });
    }

</script>

@{ var optLang = LanguageMgr.OptLang(0);}

<script type="text/javascript">

    function ajaxCmd2(actionUrl, params, resultHandler, tag, method) {
        $.ajax({
            url: (params && params['lang'] ? actionUrl : urlInjectFocusLang(actionUrl)),
            type: method || 'POST',
            data: params,
            beforeSend: function () { admincommon.hideMessage(); admincommon.showMask(); },
            success: function (result) {
                resultHandler(result, tag);
            },
            error: function (e) { 
				var errMsg = e.responseText ? $(e.responseText).find('.wr_content_error .error_message').html() : null;
				admincommon.showMessageDefault(errMsg || '@StringTable.AjaxCommandErrorMessage', 'Fail'); 
			},
            complete: function () { admincommon.hideMask(); }
        });
    }

    function ajaxREST(actionUrl, type, params, imgLoading, resultHandler, errorHandler, tag, dataType, contentType) {
        $.ajax({
            url: urlInjectFocusLang(actionUrl),
            type: type,
            data: params,
            dataType: dataType || 'json',
            contentType: contentType || 'application/x-www-form-urlencoded; charset=UTF-8',
            beforeSend: function () {
                if (imgLoading) $('#' + imgLoading).show();
                else { admincommon.hideMessage(); admincommon.showMask(); }
            },
            success: function (result) {
                resultHandler(result, tag);
            },
            error: function (e) {
                if (errorHandler) errorHandler(e);
                else admincommon.showMessageDefault('@(StringTable.AjaxCommandErrorMessage)', '@(ActionResultStatus.Fail)');
            },
            complete: function () { if (imgLoading) $('#' + imgLoading).hide(); else admincommon.hideMask(); }
        });
    }

    function formDisableValidation(inputs, isDisabled) {
        inputs.each(function () {
            var dataKey = 'backupValidRule';
            var dataVal = $(this).data(dataKey);
            if (isDisabled) {
                formShowErrorMsg($(this).attr('name'), null);
                //$(this).closest('section').find('.error').hide();
                var rule = $(this).rules('remove');
                if (Object.keys(rule).length != 0 || !dataVal) $(this).data(dataKey, rule);
            } else if (dataVal && Object.keys(dataVal).length != 0) $(this).rules('add', dataVal);
        });
    }

    function formShowErrorMsg(fieldName, errMessage, form) {
        var validObj = $(form || '#popup-form').validate();

        if (!validObj.settings.rules[fieldName]) {
            console.log(fieldName + ' not found!'); return;
        }
        else {
            var errors = {}; errors[fieldName] = errMessage;
            validObj.showErrors(errors);
        }
    }

    $.validator.methods.number = function (value, element) {
        if (!value || $.trim(value) == '') return this.optional(element);
        var regex = new RegExp('@(LanguageMgr.GetNumberRegex(optLang).Replace("\\", "\\\\"))');
        return regex.test(value);
    };

    $.validator.methods.range = (function (value, element, param) {
        param[0] = localizeParseFloat($(element).attr('data-val-range-min'));
        param[1] = localizeParseFloat($(element).attr('data-val-range-max'));
        var newval = localizeParseFloat(value);
        //console.log('range', value, element, param, newval, value);
        return this.optional(element) || (newval >= param[0] && newval <= param[1]);
    });

    $.fn.getFormFields = function (selector) {
        if ($(this).is('form')) {
            if (selector) return $(this).find(selector);
            var fields = [], form = $(this)[0];
            for (var i = 0; i < form.length; i++) {
                fields.push(form[i]);
            }
            return $(fields);
        }
        else return $(this).find('input,select,textarea');
    };

    function validateSubmit(formNode) {

        $('.field-validation-error:parent', formNode || $('#popup-form')).html('');

        firstErrorInputElement = null;

        var editForm = $('#popup-form');
        var arrInputs = (formNode ? formNode.find('input:text,textarea') : editForm.getFormFields('input:text,textarea'));

        arrInputs.each(function () {
            trimInputVal($(this));
            inputCopyValid($(this), true);
        });

        var langFormValid = null, activeForm = null, dataForm = null, emptyLangForms = [];
        var arrForms = (formNode ? formNode : $('#lang-form-list .lang_form'));
        arrForms.each(function () {
            var zeroId = $(this).find('.lang_form_id').val() == '0'; var count = 0;
            var isActiveForm = ($(this).attr('active-lang') == '1');

            $(this).find('.js-required').each(function () {
                $(this).attr('datavalid', count == 0 && !isActiveForm && !formNode ? 0 : (zeroId ? 2 : 1));
            });

            if ($(this).is(':visible')) activeForm = $(this);

            if (count != 0) {
                if (zeroId) dataForm = $(this);
                else langFormValid = $(this);
            } else {
                $(this).find('.field-validation-error:parent').html('');
                if (!formNode) emptyLangForms.push(this);
            }
        });

        if (!langFormValid && (dataForm || activeForm)) {
            (dataForm ? dataForm : activeForm).find('.js-required').each(function () {
                $(this).attr('datavalid', 2);
            });
        }

        var valid = true; var form = editForm[0]; var lastErrInput = null, lastErrRequiredField = false, firstErrInput = null;
        var arrRequire = (formNode ? formNode.find('.js-required') : editForm.getFormFields('.js-required'));
        arrRequire.each(function () {
            var datavalid = $(this).attr('datavalid');
            if (getInputVal($(this)).length == 0 && (!datavalid || datavalid != '0')) {
                //showRequireAsterisk($(this), true, false);
                lastErrRequiredField = true; valid = false;
                if (!lastErrInput || $(this).closest('.lang_form').css('display') != 'none') {
                    lastErrInput = $(this); if (!firstErrInput) firstErrInput = $(this);
                }
            } //else showRequireAsterisk($(this), false);
        });

        if (!formNode && form.customValidFields) valid = form.customValidFields() && valid;

        var chkForm = (formNode ? formNode : $(form));
        var arrFValidPar = (formNode ? formNode.find('.field-validation-error:parent') : $('.field-validation-error:parent'));

        if (chkForm.length != 0) {
            var fields = chkForm.getFormFields();
            for (var i = 0; i < fields.length; i++) {
                var element = $(fields[i]), datavalid = element.attr('datavalid');
                var optField = !element.hasClass('js-required') && element.is('input:text,textarea,input[type=number]');
                var optFHasVal = optField && element.val().length > 0;
                if (!element.is('form') && (!datavalid || datavalid != '0' || optFHasVal) && !element.valid()) {
                    valid = false; //showRequireAsterisk(element, true, false);
                    if (!lastErrInput || element.closest('.lang_form').css('display') != 'none') {
                        lastErrInput = element; if (!firstErrInput) firstErrInput = element;
                    }
                }
            }
        }

        arrInputs.each(function () { inputCopyValid($(this), false); });

        enableRemoteValidate = true;

        if (valid && arrFValidPar.find('span').length == 0) {
            return 1; //true
        }
        else {
            showFailedValidMsg(lastErrRequiredField);
            if (!lastErrInput && arrFValidPar.length > 0) {
                lastErrInput = inputFromErrSpan($(arrFValidPar[0]));
            }
            console.log('valid-failed', lastErrRequiredField, lastErrInput);

            firstErrorInputElement = lastErrInput = firstErrInput || lastErrInput;

            //if (lastErrInput) setTimeout(function () { focusInput(lastErrInput); }, 2000);

            return 0;//false;
        }
    }

    function showFailedValidMsg(requiredField) {
        admincommon.showMessageDefault(requiredField ? '@(StringTable.ErrValidateRequireFieldMsg)' : '@StringTable.ErrValidateFailedMessage', '@(ActionResultStatus.Fail)');
    }

    function inputFromErrSpan(node) {
        return $('#' + node.attr('data-valmsg-id'));
    }

    function trimInputVal(node) {

        if (node.is('input:text,textarea')) {
            node.val($.trim(node.val()));
        }
    }

    function inputCopyValid(node, isCopy) {
        if (node.is('textarea') && isNodeCKEditor(node)) {
            if (isCopy) {
                node.attr('valid-origin-val', node.val());
                node.val(getInputVal(node));
            } else node.val(node.attr('valid-origin-val'));
        }
    }

</script>

<script type="text/javascript">

    function markDropShip() {
        var ids = '', idx = 0, gridData = grid.data('kendoGrid');
        var rows = gridData.tbody.find('input:checked').closest('tr');
        rows.each(function () {
            var datarw = gridData.dataItem($(this));
            ids += (idx == 0 ? '?' : '&') + 'ids[' + idx + ']=' + datarw.id; idx++;
        });

        if(!ids) return;

        //console.log('markDropShip', ids);

        ajaxCmd('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateDropShip")' + (ids || ''), { id: (ids && ids.length ? 0 : id), value: true, checkPostalCode: true },
            function (result) { grid.data('kendoGrid').dataSource.read(); }, null, "POST");
    }

    function openShippingBookingBundle(){
        var ids = '', idx = 0, gridData = grid.data('kendoGrid');
        var rows = gridData.tbody.find('input:checked').closest('tr');
        rows.each(function () {
            var datarw = gridData.dataItem($(this));
            ids += (idx == 0 ? '?' : '&') + 'ids[' + idx + ']=' + datarw.id; idx++;
        });

        if(!ids) return;

        //console.log('openBringShippingBookingForm', ids);

        switch('@settings.Display.Admin.Shipping.ShippingBundleBookingProvider') {
            case '@ShippingServiceType.Bring.Val()':
                openBringShippingBookingForm(0, ids);
                break;
            case '@ShippingServiceType.Logistra.Val()':
                openLogistraBookingForm(0, ids);
                break;
            case '@ShippingServiceType.Proteria.Val()':
                alert('Not implemented');
                break;
            default:
                alert('No provider');
        }
    }

    function openBringShippingBookingForm(id, ids) {
        ajaxCmd2('@ModuleUrl.AdminUrl("BringShipping", "Booking")' + (ids || ''), { id: (ids && ids.length ? 0 : id) },
            function (result) { doOpenBringShippingBookingForm(result, false, id); }, null, "GET");
    }

    function doOpenBringShippingBookingForm(html, mailbox, id) {
        var width = Math.max(200, Math.min(700, $(window).width() - 50));
        var height = Math.max(200, Math.min(450, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#booking-popup-form-templ").html());
        popTemplate.find('.htmlcontent').html(html);
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));
        
        window.refreshGrid = null;

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.BringBooking ' + (id > 0  ? '- @Html.Raw(StringTable.Order) ' + id : '- @Html.Raw(StringTable.Bundle)'), popTemplate.html(),
            width, height, [], null,
            function(modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var popupForm = $('#popup-form', modal), btnSave = modal.find(".btn_save");
                var fDone = function(saveTracking) {
                    var trackingNumber = modal.find("#ConsignmentNumber").val();
                    var mailboxId = modal.find("#MailboxId").val();
                    var isbundle = modal.find('.order-item-list:visible').length != 0;
                    if (trackingNumber || mailboxId || isbundle) {
                        btnSave.closest('li').hide();
                        modal.find(".btn_cancel").val('@StringTable.Close');
                        
                        var ids = getBookingOrderIds(modal, true);
                        if(isbundle && ids && ids.length)
                            modal.find('.btn_sent,.btn_print_Packingslips').closest('li').show();
                    }
                    else btnSave.prop('disabled', false);
                };

                fDone(false);
                admincommon.hideMessage();

                modal.find(".btn_save").click(function() {

                    if (validateSubmit(popupForm)) {
                        admincommon.hideMessage();
                        btnSave.prop('disabled', true);
                        ajaxCmdHtml(mailbox ? '@ModuleUrl.AdminUrl("BringShipping", "MailBox")/' + id :'@ModuleUrl.AdminUrl("BringShipping", "Booking")/' + id, popupForm.serialize(),
                            function (result) {
                                $('.htmlcontent', modal).html(result);
                                fDone(true && !mailbox);
                            });
                    }
                });

                modal.find(".btn_print_Packingslips").click(function () {
                    var ids = getBookingOrderIds(modal);
                    if(ids) location.href = "@ModuleUrl.FrontUrl("Pdf",0, "PackingSlips")?" + getBookingOrderIds(modal);
                    else console.log(ids);
                });
                
                modal.find(".btn_sent").click(function () {
                    var ids = getBookingOrderIds(modal, true);
                    if(ids.length != 0){
                        inputErrBox.append(msgBox); admincommon.hideMessage();
                        popup.close(); $(window).scrollTop(scrollTop);

                        showSendDlg(ids);
                    }
                });

                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                    if(window.refreshGrid) window.refreshGrid();
                });
            });
    }
    
    function getBookingOrderIds(modal, returnArray){
        var ids = '', ret = [], idx = 0;
        var rows = modal.find('input.order-item-orderid[data-consignment=1]');
        rows.each(function () {
            ids += (idx == 0 ? '' : '&') + 'ids[' + idx + ']=' + $(this).val(); 
            ret.push($(this).val()); idx++;
        });
        return returnArray ? ret : ids;
    }

</script>

<script type="text/javascript">

    function openLogistraBookingForm(id, ids) {
        ajaxCmd2('@ModuleUrl.AdminUrl("Logistra", "Booking")' + (ids || ''), { id: (ids && ids.length ? 0 : id), transportName: 'PostNord' },
            function (result) { doOpenLogistraBookingForm(result, id, ids); }, null, "GET");
    }

    function doOpenLogistraBookingForm(html, id, ids) {
        var width = Math.max(200, Math.min(700, $(window).width() - 50));
        var height = Math.max(200, Math.min(400, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#booking-popup-form-templ").html());
        popTemplate.find('.htmlcontent').html(html);
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.ShippingBooking ' + (id > 0  ? '- @Html.Raw(StringTable.Order) ' + id : '- @Html.Raw(StringTable.Bundle)'), popTemplate.html(),
            width, height, [], null,
            function(modal) {

                window.LogistraBookingForm = modal;
                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var popupForm = $('#popup-form', modal), btnSave = modal.find(".btn_save");
                var fDone = function(saveTracking) {
                    var trackingNumber = modal.find("#BookingNumber").val();
                    var isbundle = modal.find('.order-item-list:visible').length != 0;
                    if (trackingNumber || isbundle) {
                        btnSave.closest('li').hide();
                        modal.find(".btn_cancel").val('@StringTable.Close');
                        
                        var ids = getBookingOrderIds(modal, true);
                        if(isbundle && ids && ids.length) {
                            modal.find('.btn_sent,.btn_print_Packingslips').closest('li').show();
                            modal.find('.printer-box').show();
                        
                            if(window.printBooking && $('#BookingPrinter', modal).length)
                                modal.find('.btn_print_label').closest('li').show();
                        }
                    }
                    else btnSave.prop('disabled', false);
                };

                var fCarrier = function() {
                    ajaxCmd2('@ModuleUrl.AdminUrl("Logistra", "Booking")' + (ids || ''), { id: (ids && ids.length ? 0 : id), transportName: $('#CarrierName', modal).val() },
                        function (result) {
                            modal.find('.htmlcontent').html(result);
                            $('#CarrierName', modal).change(fCarrier);
                        }, null, "GET");
                };

                fDone(false); admincommon.hideMessage();

                $('#CarrierName', modal).change(fCarrier);

                modal.find(".btn_save").click(function() {

                    if (validateSubmit(popupForm)) {
                        admincommon.hideMessage();
                        btnSave.prop('disabled', true);
                        ajaxCmdHtml('@ModuleUrl.AdminUrl("Logistra", "Booking")/' + id, popupForm.serialize(),
                            function (result) {
                                $('.htmlcontent', modal).html(result);
                                fDone(true);
                                //inputErrBox.append(msgBox); popup.close(); $(window).scrollTop(scrollTop);
                            });
                    }
                });

                modal.find(".btn_print_Packingslips").click(function () {
                    var ids = getBookingOrderIds(modal);
                    if(ids) location.href = "@ModuleUrl.FrontUrl("Pdf",0, "PackingSlips")?" + getBookingOrderIds(modal);
                    else console.log(ids);
                });

                modal.find(".btn_sent").click(function () {
                    var ids = getBookingOrderIds(modal, true);
                    if(ids.length != 0){
                        inputErrBox.append(msgBox); admincommon.hideMessage();
                        popup.close(); $(window).scrollTop(scrollTop);

                        showSendDlg(ids);
                    }
                });

                modal.find(".btn_print_label").click(function () {
                    var bookingNumbers = getBookingNumbers(modal);
                    if(window.printBooking && bookingNumbers && bookingNumbers.length) window.printBooking(bookingNumbers, function(result) {
                        if(result.Message) admincommon.showMessageDefault(result.Message, result.Status);
                    });
                });

                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                    if(window.refreshGrid) window.refreshGrid();
                });
            });
    }

</script>

<script type="text/javascript">

    function openProteriaBookingForm(reload, id) {

        var carrierName = $('#CarrierName').val();

        if(reload && window.ProteriaBookingForm)
            window.ProteriaBookingForm.find(".btn_cancel").click();

        ajaxCmd2('@ModuleUrl.AdminUrl("Proteria", "Booking")', { id: id, transportName: carrierName || 'BringV2' },
            function (result) { doOpenProteriaBookingForm(result, reload, id); }, null, "GET");
    }

    function doOpenProteriaBookingForm(html, reload, id) {
        var width = Math.max(200, Math.min(700, $(window).width() - 50));
        var height = Math.max(200, Math.min(500, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#booking-popup-form-templ").html());
        popTemplate.find('.htmlcontent').html(html);
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.ProteriaBooking - @Html.Raw(StringTable.Order) ' + id, popTemplate.html(),
            width, height, [], null,
            function(modal) {
                window.ProteriaBookingForm = modal;
                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var popupForm = $('#popup-form', modal), btnSave = modal.find(".btn_save");
                var fDone = function(saveTracking) {
                    var trackingNumber = modal.find("#BookingTrackingNumber").val();
                    var oldTrackingUrl = $('input.txt-show-tracking').val();
                    if (trackingNumber && !oldTrackingUrl) {
                        $('input.txt-show-tracking').attr('data-service', '@ShippingServiceType.Proteria.Val()').val(trackingNumber);
                        if(saveTracking) $('input.update-tracking').click();
                        btnSave.closest('li').hide();
                        modal.find(".btn_cancel").val('@StringTable.Close');
                    }
                    else {
                        if(modal.find("#BookingTrackingNumber").length == 0) btnSave.prop('disabled', false);
                        else {
                            btnSave.closest('li').hide();
                            modal.find(".btn_cancel").val('@StringTable.Close');
                        }
                    }
                };

                fDone(true); admincommon.hideMessage();

                $('#CarrierName', modal).change(function() {
                    openProteriaBookingForm(true);
                });

                modal.find(".btn_save").click(function() {

                    if (validateSubmit(popupForm)) {
                        admincommon.hideMessage();
                        btnSave.prop('disabled', true);
                        ajaxCmdHtml('@ModuleUrl.AdminUrl("Proteria", "Booking")/' + id +'?checkbooking=true', popupForm.serialize(),
                            function (result) {
                                $('.htmlcontent', modal).html(result);fDone(false);
                                //inputErrBox.append(msgBox); popup.close(); $(window).scrollTop(scrollTop);
                            });
                    }
                });
                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                    window.ProteriaBookingForm = null;
                });
            });
    }

</script>

