    .Paging(10, new[] { 10, 20, 30, 50, 100 }, offer ? StringTable.Offers : StringTable.Orders)
    .ColumnCheckBox(m => m.Key)
    .Columns(grid => new[]
    {
        offer ? grid.Col(m => m.CartOrderId,"Input", m => m.CartOrderId, false, 120)
                .SetCssClass("td-center") 
           : grid.Col(m => m.Id, StringTable.OrderNo, false, 90)
            .SetCssClass("td-center")
            .SetTemplate("<a class='grid-row-edit'>#:Id#</a>"),
        offer ? null : grid.Col(m => m.InvoiceId, StringTable.InvoiceNo, false, 90)
           .SetCssClass("td-center"),
        offer ? null : grid.Col(m => m.Id, StringTable.OrderNo, false, 210)
            .SetCssClass("wr-txt-order-tb")
            .SetTemplate(idTemp),
        grid.Col(m => m.Id, StringTable.Customer, false)
            .SetCssClass("wr-txt-order-tb")
            .SetTemplate(customerTempl),
        //grid.Col(m => m.DeliverInfo)
        //    .SetCssClass("wr-txt-order-tb")
        //    .SetTemplate(deliverTempl),
        //grid.Col(m => m.FinalTotal, false, 120)
        //    .SetCssClass("td-right td-nowrap")
        //    .SetTemplate("#:localizeCurrencyToString(safeProp(FinalTotal,'Value') || 0, Currency)#"),
       offer ? grid.Col(m => m.CreatedDate, StringTable.CreatedDate, true, 120)
            .SetCssClass("td-center")
            .SetTemplate(offerDateTempl)
            : grid.Col(m => m.CreatedDate, true, 90)
                .SetCssClass("td-center")
                .SetTemplate(orderedDateTempl),
       offer || cart || backorder2 != null ? null : grid.Col(m => m.DeliveredDate, true, 90)
        .SetTemplate("#:safeProp(DeliveredDate, 'TextF')#"),
        offer ? grid.Col(m => m.OfferExpiredDate, "View", m => m.CartOrderId, true, 90)
            .SetCssClass("td-center")
            .SetTemplate("#:safeProp(OfferExpiredDate, 'Text')#<br/><a class='grid-row-edit' target='_blank'>" + ("Preview").ModLocalize() + "</a><div class='email_sent'>#:(OfferEmailSent == null || OfferEmailSent ? '&#9993;':'')#</div>") : null,
        grid.Col(m => m.OrderStatusTxt, false, 90)
            .SetCssClass("td-center"),
        //grid.Col(m => m.Id, StringTable.PaymentAndShipping, false, 250)
        //    .SetCssClass("wr-txt-order-tb last")
        //    .SetTemplate(payShipTempl),
    }.Where(m => m != null).ToArray())
    .ColumnCommand(grid => new[]
    {
        offer ? grid.Cmd(m => m.CartOrderId, "Input", "Edit", "edit_fr") : null,
        offer ? grid.Cmd(m => m.CartOrderId, "Delete2", "Delete", "delete_fr", true) : null
    }.Where(x => x != null).ToArray(), 90)
    .Sortable(true)
    .Config(grid => { grid.CustomScript = "gridCustom"; kgrid = grid; })
    .ToMvcHtmlString())

<div style="display: none">
    @Html.LocalizeDropDownListKendo("status-ddlist-templ", null,
        typeof(OrderStatus).LocalizeEnumValues<byte>(null, x => x.ToString()),
        StringTable.SelectStatus, new { })
</div>
<script type='text/javascript'> var gridEagerItems = @Html.Raw(Json.Encode(kgrid.GetEagerData(ViewBag.EagerData))); </script>
<script type='text/javascript'> var currencies = @Html.Raw(Json.Encode(ViewBag.Currencies)); </script>

<script type="text/javascript">
    var dateInput = $('#@htmlAdvSearch.IdFor(m => m.FromDate.Value)');
    var advSearchFrm = $('#search-form .wr-search-adv');

    function adjustPrintButtons() {
        setTimeout(function() {
            if (advSearchFrm.is(':visible')) {
                $('.multi-select-action').addClass('advanced-search-visible');
                var obj = $("#search-form").find("fieldset");
                if (!obj.hasClass("scheduler-border")) obj.addClass("scheduler-border");
            }
            else $('.multi-select-action').removeClass('advanced-search-visible');
        }, 600);
    }

    if ('@(searchInfo.IsDataModelEmpty ? 1 : 0)' == '1') {
        advSearchFrm.show(); $('#formSearch').hide();
        adjustPrintButtons();
    }

    var grid = $('#grid');

    initCurrencies(currencies);
    gridInit('#grid', true, function(params) {return gridEagerLoadConfig(params, gridEagerItems);});

    function gridCustom(grid) {
        $('input.row-checkbox', grid.element).each(function(){
            var rw = grid.dataItem($(this).closest('tr'));
            if(rw && [@(OrderStatus.Cancelled.Val()), @(OrderStatus.Credit.Val()), @(OrderStatus.PaymentWaiting.Val())].includes(rw.OrderStatus))
                $(this).prop('disabled', true);
        })
    }

    function gridDoBigCmd(url, type, cmdAction) {
        var ids = '', idx = 0, gridData = grid.data('kendoGrid');
        var rows = gridData.tbody.find('input:checked').closest('tr');
        rows.each(function () {
            var datarw = gridData.dataItem($(this));
            ids += (idx == 0 ? '?' : '&') + 'ids[' + idx + ']=' + datarw.id; idx++;
        });
        if (type)ids = ids + "&type=" + type;
        if (ids) {
            if (cmdAction) ajaxCmd(url + ids, {}, function(result) {grid.data('kendoGrid').dataSource.page(1);});
            else location.href = url + ids;
        }
    }

    function safeProp(obj, propName) {
        if (obj == null) return '';
        return obj[propName] || '';
    }

    @{
        string sortField;
        System.ComponentModel.ListSortDirection sortDir;
        QParam.GetGridSort<OrderModel>(out sortField, out sortDir);
    }

    function gridGetParams(grid, e) {
        var backorder = '@backorder'.toLowerCase(), backproductId = '@backproductId', customerId = '@customerId', recurOrderId='@ViewBag.RecurOrderId';
        var pendingMailbox = @(pendingMailbox ? "true" : "false");
        var bringShipping = @(bringShipping ? "true" : "false");
        var porterbuddy = '@(QParam.GetField<string>("porterbuddy", false))';
        var tilRegnskap = '@(tilRegnskap == null ? "" : (tilRegnskap == true ? "true" : "false"))';
        var renewpayment = '@(renewpayment == null ? "" : (renewpayment == true ? "true" : "false"))';   
        var dropship = '@(dropship == null ? "" : (dropship == true ? "true" : "false"))';
        var sortField = '@sortField', sortDir = '@(sortDir == System.ComponentModel.ListSortDirection.Ascending ? "asc" : "desc")';

        if (advSearchFrm.is(':visible')) {
            return urlToJSON('?' + advSearchFrm.closest('form').serialize() + '&backorder=' + backorder + '&backproductid=' + backproductId + '&customerid=' + customerId + '&recurOrderId=' + recurOrderId + '&status=@searchInfo.Status' + '&pendingMailbox=' + pendingMailbox + '&bringShipping=' + bringShipping + '&tilRegnskap=' + tilRegnskap + '&dropship=' + dropship +'&sort=' + sortField + '&dir=' + sortDir + '&porterbuddy=' + porterbuddy + '&renewpayment=' + renewpayment);
        }
        else return { refid: $('#inputSearch').val(), status: '@searchInfo.Status', backorder: backorder, backproductid: backproductId, customerid: customerId, recurOrderId: recurOrderId, pendingMailbox: pendingMailbox, bringShipping: bringShipping, tilRegnskap: tilRegnskap, sort: sortField, dir: sortDir, porterbuddy: porterbuddy, renewpayment: renewpayment, dropship: dropship };
    }

    $(".adv-search").click(function () {
        var obj = $("#search-form").find("fieldset");
        if (obj.hasClass("scheduler-border")) obj.removeClass("scheduler-border");
        else obj.addClass("scheduler-border");

        advSearchFrm.slideToggle(500);
        $('#formSearch').slideToggle(500);
        adjustPrintButtons();
    });

    $('#search-form').submit(function () {
        if ($(this).valid()) grid.data('kendoGrid').dataSource.page(1);
        return false;
    });

    $('#special-search .close-2').click(function () {
        location.href = '@ModuleUrl.AdminUrl(Html.GetController(), "Index")';
    });

    //print EDI
    $('.btn_print_EDI').unbind('click').click(function () {
        var theUrl = "@ModuleUrl.AdminUrl("Order", "PrintListEDIOrProteria")";
        gridDoBigCmd(theUrl, "EDI");
    });

    $('#FlagCustom0_Yes,#FlagCustom0_No').change(function () {
        var flagCustom = $('#@htmlAdvSearch.IdFor(m => m.FlagCustom0)');
        if ($(this).prop('checked')) {
            if ($(this).is('#FlagCustom0_Yes')) {
                flagCustom.val('true');
                $('#FlagCustom0_No').prop('checked', false);
            } else {
                flagCustom.val('false');
                $('#FlagCustom0_Yes').prop('checked', false);
            }
        } else flagCustom.val('');
    }).change();

    $('#FlagCustom1_Yes,#FlagCustom1_No').change(function () {
        var flagCustom = $('#@htmlAdvSearch.IdFor(m => m.FlagCustom1)');
        if ($(this).prop('checked')) {
            if ($(this).is('#FlagCustom1_Yes')) {
                flagCustom.val('true');
                $('#FlagCustom1_No').prop('checked', false);
            } else {
                flagCustom.val('false');
                $('#FlagCustom1_Yes').prop('checked', false);
            }
        } else flagCustom.val('');
    }).change();

    $('#FlagDropShip_Yes,#FlagDropShip_No').change(function () {
        var flagDropShip = $('#@htmlAdvSearch.IdFor(m => m.FlagDropShip)');
        if ($(this).prop('checked')) {
            if ($(this).is('#FlagDropShip_Yes')) {
                flagDropShip.val('true');
                $('#FlagDropShip_No').prop('checked', false);
            } else {
                flagDropShip.val('false');
                $('#FlagDropShip_Yes').prop('checked', false);
            }
        } else flagDropShip.val('');
    }).change();

    //print Proteria
    $('.btn_print_Proteria').unbind('click').click(function () {
        var theUrl = "@ModuleUrl.AdminUrl("Order", "PrintListEDIOrProteria")";
        gridDoBigCmd(theUrl, "Proteria");
    });

    //print list PackingSlips
    $('.btn_print_Packingslips').unbind('click').click(function () {
        var theUrl = "@ModuleUrl.FrontUrl("Pdf",0, "PackingSlips")";
        gridDoBigCmd(theUrl, null);
    });

    $('.btn_export_excel').unbind('click').click(function () {
        gridDoBigCmd('@ModuleUrl.AdminUrl("Order", "Export")');
    });

    $('.btn_submit_mailbox').unbind('click').click(function () {
        gridDoBigCmd('@ModuleUrl.AdminUrl("BringShipping", "MailBoxCommit")', null, true);
    });

    $('.btn_sent').unbind('click').click(function() {
        showSendDlg();
    });

    $(function () { initDatePicker(dateInput); if (window.showSummary) window.showSummary(); });

    //function onFilterChange() {
    //    grid.data('kendoGrid').dataSource.page(1);
    //}

</script>

