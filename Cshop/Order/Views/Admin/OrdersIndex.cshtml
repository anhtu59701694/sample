@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@model IEnumerable<OrderModel>
@{
    Layout = "Layout/List.cshtml";

    var ctx = ClawContext.Current;
    var pendingMailbox = QParam.GetField<bool?>("pendingMailbox", false) ?? false;
    var bringShipping = QParam.GetField<bool?>("bringShipping", false) ?? false;
    var shippingService = QParam.GetField<bool?>("shippingService", false);
    var tilRegnskap = QParam.GetField<bool?>("tilRegnskap", false);
    var renewpayment = QParam.GetField<bool?>("renewpayment", false);
    var backorder2 = QParam.GetField<bool?>("backorder", false);
    var dropship = QParam.GetField<bool?>("dropship", false);
    var offer = Html.GetController().InList("Offer");
    var cart = Html.GetController().InList("Cart");

    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.OrderEdit;
    ViewBag.Title = offer ? StringTable.ManageOffers : StringTable.ManageOrders;
    ViewBag.AddAction = pendingMailbox || shippingService == true || QParam.GetField<int?>("status", false, true) == 3 && !offer ? null : "Add";
    ViewBag.UseInlineEdit = true;
    ViewBag.UseDatePicker = true;
    ViewBag.ShowSearchBox = !Html.GetController().InList("Cart", "Offer");
    ViewBag.ShowFilterBox = true;
    ViewBag.SearchPlaceHolder = StringTable.SearchOrderPlaceHolder;
    ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/order";
    ViewBag.ParentBreadcrumbTitle = StringTable.Order;
    ViewBag.UseImgPreview = true;

    var settings = (SettingsBiz)ViewBag.Settings;
    var searchInfo = (OrderModel.AdvSearchModel)ViewBag.SearchInfo;
    var paymentMethods = (List<PaymentMethodModel>)ViewBag.PaymentMethods;
    var shippings = (List<ShippingModel>)ViewBag.Shippings;
    var htmlAdvSearch = Html.GetHtmlHelper(searchInfo);
    var backorder = (bool?)ViewBag.Backorder;
    var backproduct = (ProductModel)ViewBag.BackProduct;
    var backproductId = backproduct == null ? (int?)null : backproduct.Id;
    var customer = (CustomerModel)ViewBag.Customer;
    var customerId = customer == null ? (int?)null : customer.Id;

    var companyNameText = StringTable.CompanyName;
    var orgNumText = StringTable.OrgNumber.Replace("#", "");
    var totalText = "eshop_adm_order_finaltotal, eshop".Localize();

    if (false && Claw.Modules.Eshop.DAL.OrderMgr.FuncSaveorUpdate == null)
    {
        Claw.Modules.Eshop.DAL.OrderMgr.FuncSaveorUpdate = (orderModel, order, sess) => {

            if (order == null) return true;

            var changed = false;
            order.OrderDetails.Action(m =>
            {
                var newSku = m.Product.CombinedSKU(m.Variant);
                if (!newSku.IsNullOrEmpty() && newSku.InList(m.ProductSKU ?? "")) {
                    m.ProductSKU = newSku; changed = true;
                }
            });

            if (changed) sess.Update(order);

            return true;
        };
    }
    
    if (false && Claw.Modules.Eshop.DAL.RecurOrderMgr.FuncRecur == null)
    {
        Claw.Core.Logs.LogHelper.EventLog("FuncRecur.Hook");

        Claw.Modules.Eshop.DAL.RecurOrderMgr.FuncRecur = (db, order) => {

            if (order == null) return;
                                     
            Claw.Core.Logs.LogHelper.EventLog(string.Format("FuncRecur. OrderId = {0}", order.Id));

            order.OrderDetails.Action(m =>
            {
                var newSku = m.Product.CombinedSKU(m.Variant);
                if (!newSku.IsNullOrEmpty() && !newSku.InList(m.ProductSKU ?? "")) {                    
                    Claw.Core.Logs.LogHelper.EventLog(string.Format("FuncRecur. OrderId = {0}, Sku {1} -> {2}", order.Id, m.ProductSKU, newSku));
                    m.ProductSKU = newSku; 
                }
            });

        };
    }
}

<script>
    function increment(n) { return n + 1; }
</script>
