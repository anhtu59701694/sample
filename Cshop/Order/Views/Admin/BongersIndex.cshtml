@using Claw.Modules.Eshop;
@using Claw.Modules.Eshop.Controllers.Admin
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@model IEnumerable<BongerModel>
@{
    Layout = "Layout/List.cshtml";

    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.OrderEdit;
    ViewBag.Title = StringTable.ManageBongers;
    //ViewBag.AddAction = "Add";
    ViewBag.UseInlineEdit = true;
    ViewBag.AutoAddNewHandler = false;
    ViewBag.ShowSearchBox = true;
    ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/Bonger";
    ViewBag.ParentBreadcrumbTitle = StringTable.Orders;
    
    var settings = (SettingsBiz)ViewBag.Settings;
}

@section MainTitleSection {
    @(StringTable.ManageBongers)
}

@section CurrentTitleSection {
    @(StringTable.ManageBongers)
}

@Html.AntiForgeryToken()
@{ KendoGrid<BongerModel> kgrid = null; }
@(Html.LocalizeGridFor("grid", Html.GetController())
    .DataSource(m => m.Id, "List", null, null, null)
    .Paging(10, new int[] { 10, 20, 30, 50, 100 })
    //.ColumnCheckBox(m => m.Id)
    .Columns(grid => new[]
    {
        grid.Col(m => m.Name, "Edit", m => m.Id, true),
        
        grid.Col(m => m.Phone, true),
        
        grid.Col(m => m.Email, true),
        
        grid.Col(m => m.Status, false, 120)
            .SetTemplate("#:StatusTxt#"),
            
        grid.Col(m => m.ModifiedDate, true, 160)
            .SetTemplate("#:safeProp(ModifiedDate, 'TextF')#"),
            
        grid.Col(m => m.CreatedDate, true, 160)
            .SetTemplate("#:safeProp(CreatedDate, 'TextF')#"),
    })
    .ColumnCommand(grid => new[]
    {
        ViewBag.PermissionEdit ? grid.Cmd(m => m.Id, "Edit", "Edit", "edit_fr") : null,
        //ViewBag.PermissionEdit ? grid.Cmd(m => m.Id, "Delete", "Delete", "delete_fr", true) : null
    }.Where(x => x != null).ToArray(), 120)
    .Sortable(true)
    .Config(grid => { grid.CustomScript = "gridCustom"; kgrid = grid; })
    .ToMvcHtmlString())
<script type='text/javascript'> var gridEagerItems = @Html.Raw(Json.Encode(kgrid.GetEagerData(ViewBag.EagerData))); </script>
<script type="text/javascript">

    var grid = $('#grid'), permEdit = '@(ViewBag.PermissionEdit ? 1 : 0)' == '1';

    gridInit('#grid', true, function(params) {return gridEagerLoadConfig(params, gridEagerItems);});

    function gridCustom(grid) {

    }

    //function gridGetParams(grid, e) {
    //    return { propertyid: $('#propertyid').val() };
    //}

    //function onFilterChange() {
    //    grid.data('kendoGrid').dataSource.page(1);
    //}

</script>
