    function odetailFormatBundle(items){
        if (!items || !items.length) return '';

        var ret = [];
        items.forEach(function (itm) {
            ret.push('<span class="qty">' + itm.Quantity + ' </span> x <a class="name" href="/admin/modules/eshop/Product/Input/' 
                + itm.ProductId +'" title="@StringTable.Edit" target="_blank">' + itm.ProductName + '</a>'
                + (itm.ProductSKU ? ' (<span class="sku">' + itm.ProductSKU + '</span>)' : '')
                + (itm.SerialNumber ? '<br/><span class="serial">' + itm.SerialNumber + '</span>' : ''));
        });
        return ret.length == 0 ? '' : '<ul><li>' + ret.join('</li><li>') + '</li></ul>';
    }

    function odetailGetPriceDisc(price, discountValue, vat){
        return safeProp(price,'Value') - (safeProp(discountValue,'Value')) / (1 + safeProp(vat,'Value'));
