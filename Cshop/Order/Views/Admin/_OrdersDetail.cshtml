            .SetTemplate(vatTempl),

        offer
        ? grid.Col(m => m.CostPriceInc).SetTemplate("#:odetailCurrencyToString(safeProp(CostPriceInc, 'Value'))#").SetCssClass("td-right")
        : null,

        editMode
        ? grid.Col(m => m.OriginPriceInc, Html.LocalizeName(new OrderDetailModel(), m => m.PriceInc), false, 120).SetTemplate(originPriceIncTempl).SetCssClass("td-right")
        : null,

        grid.Col(m => m.PriceInc, StringTable.DiscountPriceInc, false, 120).SetTemplate(priceIncTempl),
        grid.Col(m => m.Price, false, 120).SetTemplate(priceExcTempl).SetCssClass("td-right"),

        grid.Col(m => m.Quantity, false, 80)
