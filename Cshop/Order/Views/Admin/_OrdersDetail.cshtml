    <div class='odetail-discount' data-val='#: safeProp(DiscountValue,'Value') ? 1 : 0 #'>(#:odetailCurrencyToString(-1*Quantity*safeProp(DiscountValue,'Value'))#)</div></div>";

    //var nameTempl = "<div class='odetail-view'>#:ProductName# <div class='odetail-coupon'>#:ProductShippingTypeText#</div></div>";
