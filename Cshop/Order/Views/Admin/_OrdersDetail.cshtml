@using System.Dynamic
@using Claw.Controls.DifferText
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@using Domain = Claw.Modules.Eshop.Domain
@model OrderModel
@{
    var langCode = (string)ViewData["LangCode"];
    var offer = Html.GetController().InList("Offer");
    var settings = (SettingsBiz)ViewBag.Settings;
    var templOrderDetail = (OrderDetailModel)ViewBag.TemplOrderDetail;
    var editMode = Model.Id == 0 || offer || (Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing) && Model.GetRaw().CanUpdateOrder());
    var dataJsonDic = new Dictionary<string, string>();

    if (settings.Hidden.OrderDetailDataJson && Model.OrderDetails.Any(m => m.DataExp != null))
    {
        foreach (IDictionary<string, object> itm in Model.OrderDetails.Where(m => m.DataExp != null).Select(m => m.DataExp))
        {
            foreach (var k in itm.Keys)
            {
                if (!dataJsonDic.ContainsKey(k)) { dataJsonDic.Add(k, ("odetail_datajson_" + k).ModLocalize(k)); }
            }
        }
    }

    Dictionary<string, Dictionary<string, object>> odetailDataDic = null;
    var offerView = offer && Model.CartOrderId > 0 && (Model.OfferEmailSent ?? true);

    if (offerView)
    {
        var db = new DefaultDb();
        odetailDataDic = new Dictionary<string, Dictionary<string, object>>();
        Model.OrderDetails.Action(m =>
        {
            var prod = Claw.Modules.Eshop.Product.DAL.ProductMgr.GetDom(db, m.ProductId ?? 0);
            var vari = Claw.Modules.Eshop.Product.DAL.VariantMgr.GetDom(db, m.VariantId ?? 0);
            var itm = new Dictionary<string, object>();
            odetailDataDic[m.Key] = itm;
            itm["ProductQty"] = vari == null ? prod.SafeProp(z => z.Quantity) : vari.Quantity;
            itm["ProductStatusName"] = vari == null
                ? (prod != null && (m.VariantId ?? 0) == 0 ? prod.ProductStatus.Name : string.Format("<span style='color:red'>{0}</span>", "Deleted".ModLocalize()))
                : vari.ProductStatus.Name;
            itm["AllowBackorder"] = prod.SafeProp(z => z.AllowBackorder);
            itm["VisibleWeb"] = prod == null || 0 != (prod.Visibility & (byte)VisibilityType.Web) ? (vari == null || vari.Active ? "1" : "") : "";
        });
    }
}

