    var imgTemplatePopup = "<a href='#:safePropImg(Image,\"FsUrl\")#' class='preview'><img id='sel_thumb_#:Id#' src='#:safePropImg(Image,\"Thumb\")#'/></a>";
    var imgVariantTempl = "<a href='#:ImageFsUrl#' class='preview'><img id='vari_thumb_#:Id#' src='#:ImageThumb#'/></a>";

