                <div class=borderstatus>#=odetailDataDic[Key]['AllowBackorder'] ? '<span class=backorder>" + "Backorder".ModLocalize() + @"</span>' : '' #
                #=odetailDataDic[Key]['VisibleWeb'] ? '': '<span class=prodstatus>" + "Inactive".ModLocalize() + "</span>' #</div>")
        : grid.Col(m => m.ProductQty, false, 80)
            .SetCssClass("k-grid-ProductQty")
            .SetTemplate(string.Format(@"<div data-backqty='#:(ProductBackQty ? 1 : 0)#' data-shoppingqty='#:(ProductShopQty ? 1 : 0)#'>
            <input value='#:ifnull(ProductQty)#' class='od-qty' type='text' disabled=disabled />
            <input value='- #:ifnull(ProductBackQty)#' class='od-backqty' type='text' disabled=disabled />
            <div class='shoppingqty'>#:ProductShopQty# {0}</div>
            </div>", Html.LocalizeName(templOrderDetail, m => m.ProductShopQty))),
          
        //grid.Col(m => m.ProductStatusName, false, 80)
        //    .SetCssClass("k-grid-ProductStatus"),
            
        Model.Id == 0 || offer
        ? null
        : grid.Col(m => m.Tags, false, 120)
            .SetCssClass("k-grid-Tags")
            .SetTemplate("<input name='Tags#:Id#' id='Tags-#:Id#' value='#:(Tags || \"\")#' class='odetail-cell odetail-tags' data-bind='Tags' maxlength='500' type='text' />"),

        offer ? null : grid.Col(m => m.Total_Exc, false, 140)
            .SetTemplate(totalExcTempl)
            .SetCssClass("td-right"),

        grid.Col(m => m.Total_Inc, false, 140)
            .SetTemplate(totalIncTempl)
            .SetCssClass("td-right"),

        //grid.Col(m => m.CouponCode)
        //    .SetTemplate(editMode?couponcodeTempl:"#:ifnull(CouponCode)#"),
        //grid.Col(m => m.CouponValue)
        //    .SetTemplate("#:safeProp(CouponValue,'Text')#"),
        //grid.Col(m => m.DiscountId),
            //.SetTemplate("#:safeProp(DiscountValue,'Text')#"),
        //Model.Id == 0 ? null : grid.Col(m => m.Delivered)
        //    .SetCssClass("k-grid-delivered")
        //    .SetTemplate(StringTable.BoolTempl),
    }.Where(x => x != null).ToArray())
    .ColumnCommand(grid => new[]
    {
        editMode && !offer && Model.Id != 0 ? grid.Cmd(m => m.Id, "(function(uid){ odetailMakeRowEditable(uid); })", "Edit", "edit_fr", false, null, true) : null,
        editMode && !offer? grid.Cmd(m => m.Id, "gridorderdetailOnDelete", "Delete", "delete_fr", false, null, true) : null
