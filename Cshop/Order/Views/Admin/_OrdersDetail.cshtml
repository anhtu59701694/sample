    function gridOrderDetailRowCellChange(grid, node, row, odetailForm) {
        if (node.is('input, textarea, select')) {
            if (node.valid()) {
                var field = node.attr('data-bind').replace('_', '.'), vatCoef = 1 + row.Vat.Value, refreshGrid = false;
                console.log('change', node.isEmptyVal(), field, node.val(), node, row);
                if (field) {
                    if (node.hasClass('odetail-couponcode')) {
                        if (node.isEmptyVal()) {
                            //changeOrderTotal(row.Quantity * row.CouponValue.Value * vatCoef);
                            row.FinalPrice = setOMoneyVal(Math.max(0, row.FinalPrice.Value + row.CouponValue.Value * vatCoef));
                            row.CouponValue = setOMoneyVal(0.0);
                            refreshGrid = true;
                        } else {
                            var couponCode = node.val(), delta = grid.dataSource.data().filter(function (itm) { return itm.Key != row.Key && itm.CouponCode == couponCode; }).length;
                            console.log('gridOrderDetailRowCellChange', delta + 1);
                            @*couponGetApplyInfo(couponCode, custEmail.val(), delta + 1, orderTotal.val(), row.ProductId, row.VariantId, 'checking-couponcode-' + row.Key,
                                function (result) {
                                    //changeOrderTotal(row.Quantity * (row.CouponValue.Value - result.Amount) * vatCoef);
                                    bindInputField(odetailForm, row, 'CouponValue.Text', localizeMoneyToString(result.Amount));
                                    bindInputField(odetailForm, row, 'CouponId', result.CouponId);
                                    row.FinalPrice = setOMoneyVal(Math.max(0, row.FinalPrice.Value + (row.CouponValue.Value - result.Amount) * vatCoef));
                                    row.CouponValue = setOMoneyVal(result.Amount);
                                    grid.refresh({ action: 'rebind', items: [row] });
                                }, function (result) { formShowErrorMsg(node.attr('name'), '@StringTable.CouponContextError'); });*@
                        }
                    }
                    else if (node.hasClass('odetail-quantity') || node.hasClass('odetail-priceinc') || node.hasClass('odetail-vat')) {
                        //var newQuantity = node.clawGetFloat(0);
                        bindInputField(odetailForm, row, field, node.val());

                        var nWidth = 0, nHeight = 30;
                        $('.orderdetail-box').each(function(){
                            nWidth = Math.max(nWidth,$(this).width());
                            nHeight += $(this).height();
                        });
                        var loadingMask = $('.orderdetail-mask').css({width: nWidth, height: nHeight});
                        orderRefresh(null, null, function (order, result) {
                            var rws = order.OrderDetails.filter(function (itm) { return itm.Key == row.Key; });
                            bindInputField(odetailForm, row, 'Price.Text', rws[0].Price.Text);
                            bindInputField(odetailForm, row, 'PriceInc.Text', rws[0].PriceInc.Text);
                            bindInputField(odetailForm, row, 'Vat.Text', rws[0].Vat.Text);
                            loadingMask.hide();
                            if(result && result.Message)
                                gridShowMessage(gridorderdetail.data('kendoGrid'), '#grid-odetail-massage', result.Message, 'Error');
                            else $('#grid-odetail-massage a:visible').click();
                        }, function(init){ if(init)loadingMask.show(); else loadingMask.hide(); });
                        //changeOrderTotal(row.FinalPrice.Value * (newQuantity - row.Quantity));
                        //changeShippingTotal(row, row.Quantity, newQuantity);
                        //gridOrderDetailProcessDiscount(grid, newQuantity, row, odetailForm);
                    }
                    bindInputField(odetailForm, row, field, node.val());
                    if (refreshGrid) grid.refresh({ action: 'rebind', items: [row] });
                }
            } else $(this).focus();
        }
    }

    function gridOrderDetailCustom(grid) {

        var offer = @(offer && (Model.Id == 0 || Model.OfferEmailSent == false) ? 1 :  0);
        var viewMode = viewModeOrderDetail, orderStatus = '@Model.OrderStatus', recurringOrder = '@(Model.Recurring != null ? 1 : 0)' == '1', anyRowEditable = false;
        var notEditStatus = recurringOrder || orderStatus != '@OrderStatus.New.Val()' && orderStatus != '@OrderStatus.RestOrder.Val()' && orderStatus != '@OrderStatus.PayBeforeDelivery.Val()';

        if(!viewMode || grid.element.attr('PriceInc') == '1') {
            grid.hideColumn('Price');  grid.showColumn('PriceInc');
        }
        else { grid.hideColumn('PriceInc');  grid.showColumn('Price');}

        gridHideCell(grid, '.k-hierarchy-cell .k-icon.k-plus', function (row) { return row.OrderDetailGifts.length == 0; });

        gridHideCell(grid, '.claw-action .k-grid-Delete', function (row) { return row.Id > 0 && offer == 0; });

        //$('.preview[href=""]', grid.element).hide();

        $('.k-grid-Tags input', grid.element).unbind('click').click(function () {
            var node = $(this);
            if(!node.data('kendoComboBox'))
                node.kendoComboBox({
                    dataSource: [ '@("Restnotert".ModLocalize())', '@("Bestilt".ModLocalize())', '@("Mottatt".ModLocalize())', '@("Ettersendes".ModLocalize())', '@("Sendt".ModLocalize())', '@("Fjern tag".ModLocalize())' ],
                    change: function(e) {
                        var row = grid.dataItem(node.closest('tr'));
                        if(row.Id)
                            ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateOrderDetailTags")', { id: row.Id, tags: this.value() },
                                function (result) { grid.showMessage(result.Message, result.Status); });
                    }
                });
        });

        $('.delete_big_odetail').unbind('click').click(function () {
            var arrRws = [], rows = grid.tbody.find('input:checked').closest('tr');
            rows.each(function () { arrRws.push(grid.dataItem($(this))); });

            arrRws.forEach(function (item) {
                odetailFormRemove(item);
                grid.dataSource.data().remove(item);
            });

            if (arrRws.length > 0) orderRefresh();
        });

        if (viewMode && notEditStatus && offer == 0) {
            $('.js-add-new-selector_odetail').hide();
            $('.row-checkbox_odetail', grid.element).prop('disabled', true);
            grid.showMessage = function (message, status) { gridShowMessage(grid, '#grid-odetail-massage', message, status); };
        }

        //$('tr', grid.element).each(function() { grid.expandRow($(this)); });

        $('#orderdetail-form-list > .orderdetail-form[data-valid=1]').each(function () {
            var odetailForm = $(this), row = gridGetRow(grid, $(this).attr('data-id'), $(this).attr('data-key'));
            if (row) {
                var rowEle = $('tr[data-uid=' + row.uid + ']', grid.element);
                $('.odetail-cell', rowEle).change(function () { gridOrderDetailRowCellChange(grid, $(this), row, odetailForm); });
                $(this).attr('data-uid', row.uid);
                row.OrderDetailForm = odetailForm;
                if (row.FirstInit == false) {
                    //gridOrderDetailProcessDiscount(grid, 1, row, odetailForm);
                    $('.orderdetail-form-field[binding=CouponId]', odetailForm).val(row.CouponId);
                    $('.orderdetail-form-field[binding=CouponCode]', odetailForm).val(row.CouponCode);
                    $('.orderdetail-form-field[binding=CouponValue_Text]', odetailForm).val(safeProp(row.CouponValue, 'Text'));
                    $('.orderdetail-form-field[binding=Price_Text]', odetailForm).val(safeProp(row.Price, 'Text'));
                    $('.orderdetail-form-field[binding=PriceInc_Text]', odetailForm).val(safeProp(row.PriceInc, 'Text'));
                    $('.orderdetail-form-field[binding=OriginPriceInc_Text]', odetailForm).val(safeProp(row.OriginPriceInc, 'Text'));
                    $('.orderdetail-form-field[binding=OriginSalePriceInc_Text]', odetailForm).val(safeProp(row.OriginSalePriceInc, 'Text'));
                    row.FirstInit = true;
                }
                $('.odetail-couponcode,.odetail-quantity,.odetail-priceinc', rowEle).each(function () {
                    var name = ($(this).attr('name') || '').substring(1), msg = modelState[name];
                    if (name && msg) {
                        $(this).closest('td').find('span.error')
                            .removeClass('field-validation-valid')
                            .addClass('field-validation-error').append($('<span>').html(msg));
                        delete modelState[name];
                        if (!firstErrorInputElement) {
                            firstErrorInputElement = $(this);
                            setTimeout(function () { firstErrorInputElement.focus(); }, 2000);
                        };
                    } else $(this).removeClass('input-validation-error');
                });

                if(row.Id && (!viewMode || !notEditStatus)) $('.row-checkbox_odetail', rowEle).prop('disabled', true);
                if(row && rowEle && row.AllowEdit) {
                    anyRowEditable = true;
                    $('.odetail-edit', rowEle).show().closest('td').find('.odetail-view').hide();
                    $('.odetail-edit .odetail-quantity', rowEle).attr('data-val-range-min', 0);
                    if(row.ProductId > 1) $('.odetail-edit .odetail-vat', rowEle).hide().closest('td').find('.odetail-view').show();
                }
                if(row && !row.Id && rowEle) $('.odetail-edit .odetail-quantity', rowEle).attr('data-val-range-max', '1000000');
            }
        });

        if(anyRowEditable || ((!viewMode || !notEditStatus) &&
            $('input.row-checkbox_odetail:not(:disabled)', grid.element).length != 0)) $(".js-save-selector_odetail").show();
        else $(".js-save-selector_odetail").hide();

        if ($('.odetail-cell[dataid=0]', grid.element)
            .closest('.odetail-edit').show()
