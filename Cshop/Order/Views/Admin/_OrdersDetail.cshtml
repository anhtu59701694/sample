           <span class='odetail-view line-through'>#:odetailCurrencyToString(safeProp(PriceOriginExInc,'Value'))#</span>
           <span class='odetail-view'>#:odetailCurrencyToString(safeProp(OriginSalePriceInc,'Value'))#</span> 
           # }  else{#<span class='odetail-view'>#:odetailCurrencyToString(safeProp(PriceOriginExInc,'Value'))#</span>#} #"
