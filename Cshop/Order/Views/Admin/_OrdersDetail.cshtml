        if(orderGiftCards)
            orderGiftCards.forEach(function (itm) {
                ret2.push('<a href="@(ModuleUrl.AdminUrl("Giftcard", "Input"))/'+ itm.Item1 +'">' + itm.Item2 + '</a>');
            });

        return (ret.length == 0 ? '' : '<ul class="data"><li>' + ret.join('</li>, <li>') + '</li></ul>')
            + (ret2.length == 0 ? '' : '<ul class="giftcard"><li>' + ret2.join('</li>, <li>') + '</li></ul>')
