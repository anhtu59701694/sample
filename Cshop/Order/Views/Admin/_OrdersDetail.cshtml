    + Html.LocalizeImageLoading(new { @id = "checking-couponcode-#:Key#" });

    var nameTempl = "<div class='odetail-view'><a class='grid-row-edit #:ProductDeleted ? 'deleted': '' # ' productid='#:ProductId#' href='javascript:void(0)' recontroller='Order' title='" + StringTable.Edit + "' target='_blank'>#:ProductName#</a> <span class='odetail-sku' data-sku='#:(ProductSKU||'')#'>("
        + Html.LocalizeNameFor(m => m.OrderDetails[0].ProductSKU)
        + "\\: #:(ProductSKU||'')#)</span> <div class='odetail-datajson'>#=odetailFormatData(DataExp, OrderGiftCards, SerialNumber, OrderDetailBundles)#</div> <div class='odetail-bundle'>#=odetailFormatBundle(OrderDetailBundles)#</div> <div class='odetail-coupon'>#:ProductShippingTypeText#</div></div>"
        + "<div class='odetail-edit'>"
        + Html.LocalizeTextBoxFor(m => m.OrderDetails[0].ProductName, new
        {
            @id = "productname-#:Key#",
            @dataid = "#:Id#",
            @class = "odetail-cell odetail-productname",
            @data_bind = "ProductName",
            @style = "width:100% !important"
        }).Replace(new { @name = "_OrderDetails[#:Iseq#].ProductName", @value = "#:ifnull(ProductName)#" })
        + "<span class='error' data-valmsg-for='_OrderDetails[#:Iseq#].ProductName' data-valmsg-replace='true'></span>"
        + "</div>";

