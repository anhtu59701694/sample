        @Html.SimpleHiddenFor(m => m.OrderDetails[idx].OrderDetailGifts[kidx].Id, new { @class = "orderdetailgift-form-field" })
        @Html.SimpleHiddenFor(m => m.OrderDetails[idx].OrderDetailGifts[kidx].ProductId, new { @class = "orderdetailgift-form-field", @binding = "ProductId" })
        @Html.SimpleHiddenFor(m => m.OrderDetails[idx].OrderDetailGifts[kidx].VariantId, new { @class = "orderdetailgift-form-field", @binding = "VariantId" })
        @Html.SimpleHiddenFor(m => m.OrderDetails[idx].OrderDetailGifts[kidx].Quantity, new { @class = "orderdetailgift-form-field", @binding = "Quantity" })
    </div>
}

