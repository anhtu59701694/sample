    function orderdetailAdd(id, variantId, name, image, salePrice, salePriceInc, vat, discountId, shippingType, weight, productQty, productBackQty, discountRate, originSalePriceInc, isProfitPerProd, costPriceInc, costPrice, product, variant) {
        //(salePrice.Value - DiscountValue - CouponValue) * (1.0 + Vat)
        var finalPrice = setOMoneyVal(1.0 * salePriceInc.Value), timestamp = Date.now();
        var row = {
            CategoryId: '@Model.Id', ProductId: id, VariantId: variantId,
            Key: id + '_' + (variantId || '0') + (id == 1 ? ('_' + timestamp) : '_0'), Timestamp: timestamp,
            ProductName: name, ProductImage: image, Quantity: 1, ProductShippingType: shippingType, ProductWeight: weight,
            DiscountId: discountId, Delivered: false,
            DiscountValue: setOMoneyVal(0.0), DiscountValue_Text: '0',
            CouponValue: setOMoneyVal(0.0), CouponValue_Text: '0',
            Vat: vat, Vat_Text: safeProp(vat, 'Text'),
            Price: {Value: salePrice.Value, Text: salePrice.Text}, Price_Text: safeProp(salePrice, 'Text'),
            PriceInc: {Value: salePriceInc.Value, Text: salePriceInc.Text}, PriceInc_Text: safeProp(salePriceInc, 'Text'),
            OriginPriceInc: salePriceInc, OriginPriceInc_Text: safeProp(salePriceInc, 'Text'),
            OriginSalePriceInc: originSalePriceInc,
            FinalPrice: finalPrice, FinalPrice_Text: finalPrice.Text,
            ProductQty: productQty, ProductBackQty: productBackQty,
            FirstInit: false, 
        };

        if (discountRate) {
            if (isProfitPerProd) {
                row.Price.Value = safeProp(costPriceInc, 'Value') > 0 ? safeProp(costPrice, 'Value') * (1 + discountRate) : null;
                row.FinalPrice.Value = row.PriceInc.Value = safeProp(costPriceInc, 'Value') * (1 + discountRate);
            }
            else {
                row.Price.Value = row.Price.Value * (1 - discountRate);
                row.FinalPrice.Value = row.PriceInc.Value = row.PriceInc.Value * (1 - discountRate);
            }

            row.Price.Text = row.Price_Text = localizeMoneyToString(row.Price.Value);
            row.FinalPrice.Text = row.FinalPrice_Text = row.PriceInc.Text = row.PriceInc_Text = localizeMoneyToString(row.PriceInc.Value);
        }

        console.log('orderdetailAdd', product, variant);

        if(window.odetailDataDic)
            window.odetailDataDic[row.Key] = product 
            ? { 
                AllowBackorder: safeProp(product, 'AllowBackorder') || false, 
                ProductQty: safeProp(product, 'Quantity') || 0, 
                ProductStatusName: safeProp(product, 'ProductStatusName') || '', 
                VisibleWeb: safeProp(product, 'VisibleWeb') == true ? '1' : ''
            }
            : { 
                AllowBackorder: safeProp(variant, 'AllowBackorder') || false, 
                ProductQty: safeProp(variant, 'Quantity') || 0, 
                ProductStatusName: safeProp(variant, 'ProductStatusName') || '', 
                VisibleWeb: safeProp(variant, 'ProductVisibleWeb') == true && variant.Active ? '1' : ''
            };

        var newRow = orderdetailAddRaw(row);

        //itemTotal.clawChangeInt(1);
        //console.log('orderdetailAdd', finalPrice,orderTotal.val());
        //changeOrderTotal(finalPrice.Value);
        //changeShippingTotal(newRow, 0, newRow.Quantity);
    }

    function orderdetailAddRaw(fieldVals) {

        var gridData = gridorderdetail.data('kendoGrid');
        var newRow = $.extend(true, {}, templOrderDetail);

        for (var prop in fieldVals) {
            var pval = fieldVals[prop];
            newRow[prop] = pval;
        }

        console.log('orderdetailAdd', newRow);

        odetailFormAdd(fieldVals, newRow);
        gridData.dataSource.data().push(newRow);

        return newRow;
    }

    function odetailFormAdd(fieldVals, newRow) {
        var lst = $('#orderdetail-form-list'), idx = newRow.Iseq = parseInt(lst.attr('count'));
        lst.attr('count', idx + 1);
        var newForm = $('<div>').html($('#orderdetail-form-template').html()).find('.orderdetail-form');
        newForm.attr('data-key', fieldVals['Key']);
        newForm.find('input,textarea,select').each(function () {
            $(this).attr('id', $(this).attr('id').replace('_0_', '_' + idx + '_'));
            $(this).attr('name', $(this).attr('name').replace('[0]', '[' + idx + ']'));

            if ($(this).attr('binding')) {
                if ($(this).is('textarea')) $(this).html('');
                else $(this).val('');
            }
        });

        if (fieldVals)
            for (var field in fieldVals) {
                var fVal = fieldVals[field];//if (!fVal && field.indexOf('_') != -1) { eval('fVal = fieldVals.' + field.replace('_', '.')); }
                var node = newForm.find('.orderdetail-form-field[binding=' + field + ']');
                if (node.is('textarea')) $(this).html(fVal);
                else node.val(fVal);//console.log('odetailFormAdd', node, fVal);
            }

        newForm.attr({ 'data-id': 0, 'data-valid': 1 });
        lst.append(newForm);
        //console.log(newForm.html());
        return newForm;
    }

    function odetailFormRemove(row) {
        console.log('odetailFormRemove', row, row.OrderDetailForm);
        row.OrderDetailForm.attr('data-valid', 0);
        row.OrderDetailForm.find('input,textarea,select').val('').attr('datavalid', 0);
        //itemTotal.clawChangeInt(-1);
        //changeOrderTotal(0 - row.Quantity * row.FinalPrice.Value);
        //changeShippingTotal(row, row.Quantity, 0);
    }

    function odetailgiftFormAdd(odetailForm, fieldVals, newRow, odetailIndex) {
        var lst = $('.orderdetailgift-form-list', odetailForm), idx = parseInt(lst.attr('count'));
        var newForm = $('.orderdetailgift-form[data-key=' + fieldVals['Key'] + ']', lst);

        if (newForm.length != 0) {
            console.log('odetailgiftFormAdd.exist', newForm);
        }
        else {
            newForm = $('<div>').html($('#orderdetailgift-form-template').html()).find('.orderdetailgift-form');
            newRow.Iseq = idx; lst.attr('count', idx + 1);
            newForm.attr('data-key', fieldVals['Key']);
            newForm.find('input,textarea,select').each(function () {
                $(this).attr('id', $(this).attr('id').replace('OrderDetails_0_', 'OrderDetails_' + odetailIndex + '_'));
                $(this).attr('name', $(this).attr('name').replace('OrderDetails[0]', 'OrderDetails[' + odetailIndex + ']'));

                $(this).attr('id', $(this).attr('id').replace('_0_', '_' + idx + '_'));
                $(this).attr('name', $(this).attr('name').replace('[0]', '[' + idx + ']'));

                if ($(this).attr('binding')) {
                    if ($(this).is('textarea')) $(this).html('');
                    else $(this).val('');
                }
            });

            newForm.attr({ 'data-id': 0, 'data-valid': 1 });
            lst.append(newForm);
            //console.log('odetailgiftFormAdd', newForm);
        }

        if (fieldVals)
            for (var field in fieldVals) {
                var fVal = fieldVals[field];
                var node = newForm.find('.orderdetailgift-form-field[binding=' + field + ']');
                if (node.is('textarea')) $(this).html(fVal);
                else node.val(fVal);
            }

        return newForm;
    }

    function bindInputField(odetailForm, row, field, newVal) {
        var inputField;

        if (field.indexOf('.') != -1) eval('row.' + field + ' = newVal');
        else row[field] = newVal;
        inputField = odetailForm.find('.orderdetail-form-field[binding=' + field.replace('.', '_') + ']');
        inputField.val(newVal); console.log(inputField, newVal, row);
    }

    function safePropImg(obj, propName) {
        return safeProp(obj, propName) || '@ImageModel.NoImg';
    }

    function safeProp(obj, propName) {
        if (obj == null) return '';
        if (typeof (obj) != 'object') return obj;
        return obj[propName] == null ? '' : obj[propName];
    }

    $.fn.getRemoteValidArgs = function (args) {//may be used in email valid
        //console.log('getRemoteValidArgs', args);
        //args.data = { Id: 0, CouponCode: $(this).val() };
        return args;
    };

