        if($('.orderdetail-form[data-valid=1][data-key="1_0_0"]', '#orderdetail-form-list').length == 0)
            orderdetailAdd(1, null, '', null, {Text:'0', Value: 0}, {Text:'0', Value: 0}, @Html.Raw(Claw.Modules.Eshop.Product.DAL.ProductMgr.Get(new DefaultDb() ,1).SafeProp(m => m.Vat).ToJsonEx()), null, 2, 0, 1, 0);
