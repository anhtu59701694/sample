            $('#odetailcomment-box,.btn-save', '#order-details').show();
            $('.odetail-cell[dataid=0].odetail-vat:not([productid=1])', grid.element).hide().closest('td').find('.odetail-view').show();
        } else $('#odetailcomment-box,.btn-save', '#order-details').hide();

        dropDownClone('.odetail-edit:visible .odetail-vat[productid=1]', '#temp-vat', grid.element);

        $('.odetail-view a.grid-row-edit', grid.element).each(function() {
            if (parseInt($(this).attr('productid')) < 0) $(this).unbind('mousedown').removeAttr('href').css('cursor','default');
        });

        initGridStatusAction(grid, '.k-grid-delivered',
            function (node, row) {
                bindInputField(row.OrderDetailForm, row, 'Delivered', row.Delivered);
                if (viewMode) gridorderdetailSetDelivered(grid, row);
            },
            function (row) { return row.Delivered; }, function (row, status) { row.Delivered = status; });

        initImagePreview(false, grid.element);
        formUpdateValidRules(grid.element);

        if (window.onFormUpdateValidRules) window.onFormUpdateValidRules();

        //if ($('.table_all > tbody:parent').length == 0) $(".wr_table_all").css('border', 'none');
        //else $('.wr_table_all').removeAttr("style");

        $('.btn_save', '.js-save-selector_odetail').unbind('click').click(function () {
            if (validateSubmit($('.odetail-quantity:visible', '#gridorderdetail').closest('tr')) && $('#odetailcomment').valid())
                showConfirmDialog('@StringTable.EditOrderDetails', '@StringTable.OrderDetailSaveConfirmMsg',
                    function (dialog, kendoWindow, scrollTop) {
                        addEditOrderDetails();
                        $('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
                        dialog.close(); $(window).scrollTop(scrollTop);
                    });
        });

        if($('.orderdetail-form[data-valid=1][data-key="1_0_0"]', '#orderdetail-form-list').length == 0)
            $('.js-add-new-open-selector_odetail').show();
        else $('.js-add-new-open-selector_odetail').hide();

        if(viewMode) $('.js-add-new-open-selector_odetail').closest('ul').hide();
        else $('.js-add-new-open-selector_odetail').closest('ul').show();

        if(viewMode) $('.claw-action a.k-grid-Edit').hide();

        if(offer == 1){
            $('.wr_submit_top,.js-add-new-selector_odetail', '.orderdetail-box').show();
            formDisableValidation($('.no-valid-fields input'), true);
        }

        if(@(offer ? 1 : 0) == 1) DisplayProfit(grid);
    }

    function updateCustomDiscount() {
        var grid = $('#gridorderdetail').data('kendoGrid');
        var customDiscountRate = $('#@Html.IdFor(m => m.CustomDiscountRate)');
        var isProfitPerProd = $('#OfferProfitPerProd').prop('checked');

        customDiscountRate.attr('placeholder', isProfitPerProd ? '@("profit per product rate".ModLocalize("% profit per product"))':'@Html.LocalizeNameFor(m => m.CustomDiscountRate)');

        if(!customDiscountRate.is(':visible') || !customDiscountRate.valid()) return;

        var rate = (localizeParseFloat(customDiscountRate.val()) || 0) / 100;

        grid.dataSource.data().forEach(function (row) {
            if (isProfitPerProd)
                row.PriceInc.Value = /*!row.FakeCostPrice &&*/ safeProp(row.CostPriceInc, 'Value') > 0 ? safeProp(row.CostPriceInc, 'Value') * (1 + rate) : row.PriceInc.Value;
            else row.PriceInc.Value = (safeProp(row.PriceOriginInc, 'Value') || row.OriginPriceInc.Value) * (1 - (isProfitPerProd ? 0 : rate));

            row.PriceInc.Text = localizeMoneyToString(row.PriceInc.Value);

            bindInputField(row.OrderDetailForm, row, 'PriceInc.Text', row.PriceInc.Text);
        })

        orderRefresh();
    }

