    function odetailFormatData(dataExp, orderGiftCards, serialNumber, odetailBundles) {
        //if (!dataExp || !dataExp.length) return '';

        var ret = [], ret2 = [];
        if(dataExp)
            dataExp.forEach(function (itm) {
                if(itm.Key != 'bundlevariantids' && itm.Key != 'bundleaccessoryids') ret.push('<span class="name">' + dataJsonDic[itm.Key] + ':</span> <span class="value">' + itm.Value + ' </span>');
