<script type="text/javascript">

    function DisplayProfit(grid){

        var box = $('.profit-box'), costPriceVal = 0, costPriceIncVal = 0, priceVal = 0, priceIncVal = 0;

        grid.dataSource.data().forEach(function(row){

            if(!row.Price || !row.PriceInc || !row.CostPrice || !row.CostPrice.Value || !row.CostPriceInc || !row.CostPriceInc.Value || costPriceVal == null) {
                console.log('DisplayProfit.0', costPriceVal, row)
                costPriceVal = null; return;
            }

            priceIncVal += row.PriceInc.Value * row.Quantity;
            priceVal += row.Price.Value * row.Quantity;
            costPriceVal += row.CostPrice.Value * row.Quantity;
            costPriceIncVal += row.CostPriceInc.Value * row.Quantity;
        })

        var profitExc = priceVal - costPriceVal;
        var profitInc = priceIncVal - costPriceIncVal;

        if(costPriceVal > 0){
            $('.profit-exc-money', box).html(localizeMoneyToString(profitExc));
            $('.profit-exc-percent', box).html(localizeFloatToString(100*profitExc/costPriceVal) + ' %');
            $('.profit-inc-money', box).html(localizeMoneyToString(profitInc));
            $('.profit-inc-percent', box).html(localizeFloatToString(100*profitInc/priceIncVal) + ' %');
            box.show();
        } else box.hide();

        console.log('DisplayProfit',costPriceVal, costPriceIncVal, priceVal, priceIncVal)
    }

    function dropDownClone(selector, dropdownSelector, holder) {
        var dropdown = $(dropdownSelector).data('kendoDropDownList');
