    function openODetailAssignForm() {
        var width = Math.max(200, Math.min(890, $(window).width() - 50));
        var height = Math.max(200, Math.min(2048, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#prodsel-popup-form-templ").html());
        popTemplate.find('.htmlcontent .wr_table_all').html($('#gridprodsel-templ').clone().attr('id', 'gridprodsel').wrap('<p>').parent().html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.AssignProduct', popTemplate.html(),
            width, height, [], null,
            function (modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');

                $('#gridprodsel #SelectAll', modal).attr('id', 'SelectAll_prodsel').closest('div')
                    .find('label').attr('for', 'SelectAll_prodsel');

                admincommon.hideMessage();
                gridProdSelFirstRun();

                var gridProdSel = $('#gridprodsel').data('kendoGrid');

                modal.find(".btn_save").click(function () {

                    var selCBox = $('.row-checkbox_prosel:checked,.row-checkbox_varsel:checked', gridProdSel.element);
                    var customDiscountRate = $('#@Html.IdFor(m => m.CustomDiscountRate)');
                    var isProfitPerProd = $('#OfferProfitPerProd').prop('checked');
                    var discountRate = (customDiscountRate.is(':visible') && customDiscountRate.valid() ? 1 : 0) * (localizeParseFloat(customDiscountRate.val()) || 0) / 100;
                    var offer = @(offer ? 1 : 0);

                    selCBox.each(function () {
                        var owner = $(this).closest('div.k-grid').data('kendoGrid');
                        var row = owner.dataItem($(this).closest('tr'));

                        if (row.ProductId)
                            orderdetailAdd(row.ProductId, row.Id, row.VariantName, row.CombinedImage, offer ? row.Price : row.CombinedSalePrice, offer ? row.PriceInc : row.CombinedSalePriceInc, row.ProdVat, null, row.ProductShippingType, row.Weight || row.ProductWeight, row.Quantity, row.BackOrderQty, discountRate, row.SalePriceInc, isProfitPerProd, row.CostPriceInc, row.CostPrice, null, row);
                        else
                            orderdetailAdd(row.Id, row.VariantId, row.Name, row.Image, offer ? row.Price : row.CombinedSalePrice, offer ? row.PriceInc : row.CombinedSalePriceInc, row.Vat, null, row.ShippingType, row.Weight, row.Quantity, row.BackOrderQty, discountRate, row.SalePriceInc, isProfitPerProd, row.CostPriceInc, row.CostPrice, row);//discountId

                        console.log('save', row, discountRate);
                    });

                    if (selCBox.length > 0) {
                        gridorderdetail.attr({ 'PriceInc': 1})
                        orderRefresh();
                    }

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
                modal.find(".btn_cancel").click(function () {

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });
    }

