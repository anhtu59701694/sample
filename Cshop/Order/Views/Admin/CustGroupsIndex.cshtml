@using Claw.Modules.Eshop;
@using Claw.Modules.Eshop.Controllers.Admin
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@model IEnumerable<CustGroupModel>
@{
    Layout = "Layout/List.cshtml";

    var groupDiscount = Html.GetController().InList("GroupDiscount");
    
    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.OrderEdit;
    ViewBag.Title = StringTable.ManageCustomerGroups;
    ViewBag.AddAction = "Add";
    ViewBag.UseInlineEdit = !groupDiscount;
    ViewBag.AutoAddNewHandler = false;
    ViewBag.ParentBreadcrumbLink = groupDiscount ? "/admin/modules/eshop/custgroup" : "/admin/modules/eshop/customer";
    ViewBag.ParentBreadcrumbTitle = groupDiscount ? StringTable.CustomerGroups : StringTable.Customers;
    
    var settings = (SettingsBiz)ViewBag.Settings;
}

@section MainTitleSection {
    @(groupDiscount ? StringTable.ManageGroupDiscounts : StringTable.ManageCustomerGroups)
}

@section CurrentTitleSection {
    @(groupDiscount ? StringTable.ManageGroupDiscounts : StringTable.ManageCustomerGroups)
}
<style type="text/css">
    #grid .k-grid-AnyCategory a{cursor:default;}
</style>
@Html.AntiForgeryToken()
@{ KendoGrid<CustGroupModel> kgrid = null; }
@(groupDiscount
    ? Html.LocalizeGridFor("grid", Html.GetController(), "Delete", "Input", "Input")
        .DataSource(m => m.Id, "List", null, null, null)
        .Paging(10, new int[] { 10, 20, 30, 50, 100 })
        .ColumnCheckBox(m => m.Id)
        .Columns(grid => new[]
    {
        grid.Col(m => m.Name, "Edit", m => m.Id, true)
            .SetDefaultSort(true),
            
        grid.Col(m => m.AnyCategory, false, 80)
            .SetTemplate(StringTable.BoolTempl)
            .SetCssClass("k-grid-AnyCategory"),
            
        grid.Col(m => m.DiscountRate, true, 150)
            .SetTemplate("#:safeProp(DiscountRate, 'Text')# #:safeProp(DiscountRate, 'Text') ? '%' : '' #")
            .SetCssClass("td-center"),
            
        grid.Col(m => m.Customers, "ListCust", m => m.Id, false, 150)
            .SetTemplate("<a class='grid-row-edit'>#:(Customers || 0)#</a>")
            .SetCssClass("td-center"),
            
    }.Where(m => m != null).ToArray())
        .ColumnCommand(grid => new[]
    {
        ViewBag.PermissionEdit ? grid.Cmd(m => m.Id,"Edit", "Edit", "edit_fr", false) : null,
    }.Where(x => x != null).ToArray(), 120)
        .Sortable(true)
        .Config(grid => { grid.CustomScript = "gridCustom"; kgrid = grid; })
        .ToMvcHtmlString()
    : Html.LocalizeGridFor("grid", Html.GetController(), "Delete", "Input", "Input",
        "(function(e){gridOnInlineEditCustom(e);gridOnInlineEdit(e, null, gridRefreshRow);})")
        .DataSource(m => m.Id, "List", null, null, null)
        .Paging(10, new int[] { 10, 20, 30, 50, 100 })
        .ColumnCheckBox(m => m.Id)
        .Columns(grid => new[]
        {
            grid.Col(m => m.Name, true)
                .SetInlineEdit(true)
                .SetDefaultSort(true)
                .SetHtmlAttributes(new{ @title = StringTable.InlineEditHint}),
            grid.Col(m => m.Customers, "ListCust", m => m.Id)
                .SetTemplate("<a class='grid-row-edit'>#:(Customers || 0)#</a>")
                .SetCssClass("td-center"),
            grid.Col(m => m.Discounts, "ListDiscount", m => m.Id)
                .SetTemplate("<a class='grid-row-edit'>#:(Discounts || 0)#</a>")
                .SetCssClass("td-center"),
            
            !settings.Hidden.EnableCustomerDiscount || !settings.Hidden.CustomerDiscountByGroup ? null : grid.Col(m => m.Discount, false, 180)
                .SetTemplate(StringTable.BoolTempl)
                .SetCssClass("k-grid-Discount"),
            
            !settings.Hidden.Price4LoginOnly || settings.Hidden.Price4LoginAnyGroup ? null : grid.Col(m => m.Price4Login, false, 180)
                .SetTemplate(StringTable.BoolTempl)
                .SetCssClass("k-grid-Price4Login"),
        }.Where(m => m != null).ToArray())
        .ColumnCommand(grid => new[]
        {
            ViewBag.PermissionEdit ? grid.Cmd(m => m.Id, "(function(uid){ gridCmdInlineEdit('grid',uid); })", "Edit", "edit_fr", false, null, true) : null,
            ViewBag.PermissionEdit ? grid.Cmd(m => m.Id, "Delete", "Delete", "delete_fr", true) : null
        }.Where(x => x != null).ToArray(), 120)
        .Sortable(true)
        .Config(grid => { grid.CustomScript = "gridCustom"; kgrid = grid; })
        .ToMvcHtmlString())
<script type='text/javascript'> var gridEagerItems = @Html.Raw(Json.Encode(kgrid.GetEagerData(ViewBag.EagerData))); </script>
<script type="text/javascript">

    var grid = $('#grid'), permEdit = '@(ViewBag.PermissionEdit ? 1 : 0)' == '1';
    var price4LoginActUrl = '@(ModuleUrl.AdminUrl(Html.GetController(), "Price4Login"))';
    var discountActUrl = '@(ModuleUrl.AdminUrl(Html.GetController(), "Discount"))';
    
    $(function(){
        gridInit('#grid', true, function(params) {return gridEagerLoadConfig(params, gridEagerItems);});

        grid.data("kendoGrid").bind("save", function(e) {
            if (!e.model.id && e.model.Default) setTimeout(function () { e.sender.dataSource.read(); }, 1000);
        });
    });

    function gridOnInlineEditCustom(e) {
        e.model.InlineEdit = e.model.QuickAdd = true;
    }

    function gridCustom(grid) {
        var groupDiscount = '@(groupDiscount ? "1" : "")';

        initGridStatusAction(grid, '.k-grid-AnyCategory', null,
           function (row) { return row.AnyCategory; }, function (row, status) { row.AnyCategory = status; },
           function (row) { return { id: row.Id, value: row.AnyCategory }; });
        
        initGridStatusAction(grid, '.k-grid-Price4Login', price4LoginActUrl,
           function (row) { return row.Price4Login; }, function (row, status) { row.Price4Login = status; },
           function (row) { return { id: row.Id, value: row.Price4Login }; });
        
        initGridStatusAction(grid, '.k-grid-Discount', discountActUrl,
           function (row) { return row.Discount; }, function (row, status) { row.Discount = status; },
           function (row) { return { id: row.Id, value: row.Discount }; });

        //gridMarkLangDisabled(grid, '.k-grid-name', function (row) { return !row.LangVisible; });

        gridHideCell(grid, '.k-grid-Delete', function (row) { return row.Id == 1 || row.Customers > 0 || row.Discounts > 0; });

        gridDisableCheckBox(grid, function (row) { return row.Id == 1 || row.Customers > 0 || row.Discounts > 0; });

        if (permEdit)
            $('tr', grid.element).each(function() {
                $(this).dblclick(function(e) {
                    if (!grid.editable) grid.editRow($(this));
                });
            });

        setTimeout(function() {
            $('.js-add-new-selector').unbind('click').click(function() {
                if(groupDiscount) window.location.pathname = '@ModuleUrl.AdminUrl("CustGroup","Index")'; 
                else grid.addRow();
            }).attr('type', 'button');
        }, 1);
    }

    function gridRefreshRow(grid, rowEle) {

        initGridStatusAction(grid, rowEle.find('.k-grid-Price4Login'), price4LoginActUrl,
           function (row) { return row.Price4Login; }, function (row, status) { row.Price4Login = status; },
           function (row) { return { id: row.Id, value: row.Price4Login }; });
        
        initGridStatusAction(grid, rowEle.find('.k-grid-Discount'), discountActUrl,
           function (row) { return row.Discount; }, function (row, status) { row.Discount = status; },
           function (row) { return { id: row.Id, value: row.Discount }; });

        gridHideCell(grid, rowEle.find('.k-grid-Delete'), function (row) { return row.Id == 1 || row.Customers > 0 || row.Discounts > 0; });

        gridDisableCheckBox(grid, function (row) { return row.Id == 1 || row.Customers > 0 || row.Discounts > 0; }, rowEle.find('.row-checkbox'));

        if (permEdit)
            rowEle.dblclick(function(e) {
                if (!grid.editable) grid.editRow($(this));
            });
    }

    function safeProp(obj, propName) {
        if (obj == null) return '';
        if (typeof (obj) != 'object')return obj;
        return (obj[propName] || '');
    }

    //function gridGetParams(grid, e) {
    //    return { propertyid: $('#propertyid').val() };
    //}

    //function onFilterChange() {
    //    grid.data('kendoGrid').dataSource.page(1);
    //}

</script>
