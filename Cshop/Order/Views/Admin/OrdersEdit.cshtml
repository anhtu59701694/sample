@if (Model.Id == 0)
{           
    @section MainTitleSection {
        @(offer ? StringTable.ManageOffers : StringTable.ManageOrders)
    }

    @section CurrentTitleSection {
        <a href="/admin/modules/eshop/@(Html.GetController())/">@(offer ? StringTable.ManageOffers : StringTable.ManageOrders)</a>
    }

    @section TabTitleSection {
        @(offer ? StringTable.AddEditOffer(Model.Id) : StringTable.AddEditOrder(Model.Id))
    }

    @section ExtraButtonSection
    {
        @if (Model.Type == (int)OrderType.Web && offer)
        {
            <li><input type="button" id="btn_save_offer_only" class="btn_save no-sendemail" value="@StringTable.Save"></li>
        }
    }
}
else
{
    ViewBag.OrderDetail = true;
    @section TabOrderDetail
    {
        <section class="wr-top-eshop" style="min-height:35px;">
            @if (viewMode && !offer)
            {
                <ul class="wr_submit_top left-btn">
                    <li><input type="button" value="@StringTable.OrderPrev" data-previous="true" class="btn-prev"></li>
                    <li><input type="button" value="@StringTable.OrderNext" data-previous="false" class="btn-next"></li>
                </ul>
            }
            <ul class="wr_submit_top">
                <li><input type="submit" class="btn_back" value="@StringTable.Back"></li>
                @if (Model.Type == (int)OrderType.Web && viewMode && offer)
                {
                    if (Model.OfferEmailSent == false) 
                    {                                        
                        <li><input type="button" id="btn_save_offer_only" class="btn_save no-sendemail" value="@StringTable.Save"></li>
                        <li><input type="button" id="btn_save_offer_send" class="btn_save" value="@StringTable.SaveOffer"></li>
                        <li><input type="button" class="btn_sendEmail" value="@StringTable.SentEmail"></li>
                        <li><input type="button" class="btn_cloneoffer" value="@StringTable.Clone"></li>
                    }
                    else
                    {
                        <li><input type="submit" class="btn_updateoffer" value="@StringTable.Save"></li>
                        <li><input type="button" class="btn_sendEmail" value="@StringTable.SentEmail"></li>
                        <li><input type="button" class="btn_cloneoffer" value="@StringTable.Clone"></li> 
                    }
                }
                @if (Model.Type == (int)OrderType.Pos && viewMode && !offer && Model.PaymentMethodId.InList(21) && Model.GetRaw().CanReturn()) 
                { 
                    <li><input type="submit" class="btn_return" value="@StringTable.Return"></li>
                }
                @if (Model.Type == (int)OrderType.Web && viewMode && !offer)
                {
                    var dropShipMark = 0 != (Model.Flags & (int)Domain.Interfaces.OrderFlagType.DropShipMark);
                    <li><input type="submit" class="btn_sendEmail" value="@StringTable.SentEmail"></li>
                    if (settings.Hidden.EnableDirectSMS)
                    {
                        <li><input type="submit" class="btn_sendSMS" value="@StringTable.SentSMS"></li>
                    }
                    <li><input type="submit" class="btn_sent" value="@StringTable.SendOrder"></li>
                    <li><input type="button" class="btn_register_rest" value="@StringTable.RegisterRestorder"></li>
                    <li><input type="submit" class="btn_cancel" value="@StringTable.CancelOrder"></li>
                    <li><input type="submit" class="btn_return" value="@StringTable.Return"></li>
                    if (settings.Hidden.LogistraShipping && !dropShipMark)
                    {
                        <li><input type="button" class="btn_booking" value="@StringTable.ShippingBooking"></li>
                    }
                    if (settings.Hidden.BringBooking && !dropShipMark)
                    {
                        <li><input type="button" class="btn_bringbooking" value="@StringTable.BringBooking"></li>
                        @*<li><input type="button" class="btn_bringmailbox" value="@StringTable.BringMailBox"></li>*@
                    }
                    if (settings.Hidden.ProteriaShipping && !dropShipMark)
                    {
                        <li><input type="button" class="btn_proteriabooking" value="@StringTable.ProteriaBooking"></li>
                    }
                    if (settings.Hidden.PorterBuddyShipping && !dropShipMark)
                    {
                        <li><input type="button" class="btn_porterbuddybooking" value="@("PorterBuddy booking".ModLocalize())"></li>
                    }
                    if (settings.Hidden.PostnordShipping && !dropShipMark)
                    {
                        <li><input type="button" class="btn_postnordbooking" value="@StringTable.PostnordBooking"></li>
                    }
                    if (wePack && wePackActive)
                    {
                        <li><input type="button" class="btn_wepackbooking" value="@("WePack booking")"></li>
                    }
                }
                @if (Model.Id > 0 && Model.Type == (int)OrderType.Pos && Model.GetRaw().SafeProp(m => m.OrderDetails.Any(z => z.Product.IsSerial())))
                {
                    <li><input type="button" class="btn_updateserial" onclick="updateSerialData()" value="@("Update serial number".ModLocalize())"></li>
                }
            </ul>
        </section>
    }
}

@using (@Html.BeginForm("Input", Html.GetController(), FormMethod.Post, new { @id = "editForm", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.CouponId, new { @databind = "CouponId" })
    @Html.HiddenFor(x => x.CouponCode, new { @databind = "CouponCode" })
    @Html.HiddenFor(x => x.PaymentVat, new { @databind = "PaymentVat.Text" })
    @Html.HiddenFor(x => x.ShippingVat, new { @databind = "ShippingVat.Text" })
    @Html.HiddenFor(x => x.DiscountId, new { @databind = "DiscountId" })
    @Html.HiddenFor(x => x.DiscountValue, new { @databind = "DiscountValue.Text" })
    @Html.HiddenFor(x => x.ShipOrderTotal, new { @databind = "ShipOrderTotal.Text" })
    @Html.HiddenFor(x => x.ShipWeightTotal, new { @databind = "ShipWeightTotal.Text" })
    @Html.HiddenFor(x => x.RawOrderTotal, new { @databind = "RawOrderTotal.Text" })
    @Html.HiddenFor(x => x.OrderTotal, new { @databind = "OrderTotal.Text" })
    @Html.HiddenFor(x => x.VatTotal, new { @databind = "VatTotal.Text" })
    @Html.HiddenFor(x => x.TotalCoupon, new { @databind = "TotalCoupon.Text" })
    @Html.HiddenFor(x => x.TotalDiscount, new { @databind = "TotalDiscount.Text" })
    @Html.HiddenFor(x => x.FinalTotal, new { @databind = "FinalTotal.Text" })
    @Html.HiddenFor(x => x.ItemTotal, new { @databind = "ItemTotal" })
    @Html.Hidden("OverridePayCost", "false")
    @Html.Hidden("OverrideShipCost", "false")

    if (offer)
    {
        @Html.HiddenFor(x => x.BillingCountryId, new { @databind = "BillingCountryId" })
        @Html.HiddenFor(x => x.DeliverCountryId, new { @databind = "DeliverCountryId" })

        <div class="no-valid-fields">
            @Html.SimpleHiddenFor(x => x.BillingName, new { @databind = "BillingName" })
            @Html.SimpleHiddenFor(x => x.BillingAddress, new { @databind = "BillingAddress" })
            @Html.SimpleHiddenFor(x => x.BillingPostnr, new { @databind = "BillingPostnr" })
            @Html.SimpleHiddenFor(x => x.BillingPosted, new { @databind = "BillingPosted" })
            @Html.SimpleHiddenFor(x => x.BillingMobile, new { @databind = "BillingMobile" })

            @*@Html.SimpleHiddenFor(x => x.DeliverName, new { @databind = "DeliverName" })*@
            @Html.SimpleHiddenFor(x => x.DeliverAddress, new { @databind = "DeliverAddress" })
            @Html.SimpleHiddenFor(x => x.DeliverPostnr, new { @databind = "DeliverPostnr" })
            @Html.SimpleHiddenFor(x => x.DeliverPosted, new { @databind = "DeliverPosted" })
            @*@Html.SimpleHiddenFor(x => x.DeliverMobile, new { @databind = "DeliverMobile" })*@   
            @Html.SimpleHiddenFor(x => x.OfferEmailSent, new { @databind = "OfferEmailSent" })   
            @Html.SimpleHiddenFor(x => x.CartId, new { @databind = "CartId" })
            @Html.Hidden("OfferSkipSend", "false") 
        </div>
    }

    if (viewMode)
    {
        <h2 class="title_top icon-order-dt" style="padding: 10px 0 5px 30px!important; background-position: inherit;">
            @(offer ? StringTable.Offer : StringTable.Order) #@Model.Id <span> @Model.CreatedDate.TextF</span>
        </h2>
    }

    if (Model.Type == (int)OrderType.Web && viewMode && !offer)
    {
        <section class="wr-top-eshop mt20">
            <ul class="wr_submit_top">
                @if (Model.Id > 0 && Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing, OrderStatus.RestOrder))
                {
                    <li><input type="button" class="btn_updateconfirm" onclick="updateConfirmData()" @(0 != (Model.Flags & (int)Claw.Modules.Eshop.Domain.Interfaces.OrderFlagType.Confirmed) ? "disabled": "") value="@(StringTable.ConfirmPackage)"></li>
                }
                @if (Model.Id != 0 && !Model.Sent2PickupPoint && !Model.ShippingPickupPoint.IsNullOrEmpty() && Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing, OrderStatus.RestOrder))
                {
                    <li>
						<input type="button" style="margin:0;" class="btn_update_sent2pickuppoint" value="@StringTable.OrderFlagSent2PickupPoint">
						<script>$(function(){$('.wr_submit_top .btn_sent').closest('li').attr('sent2pickuppoint', 1);})</script>
					</li>
                }
                @if (Model.Id != 0 && settings.Hidden.OrderStatusTilRegnskap && Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing, OrderStatus.RestOrder))
                {
                    <li><input type="button" @(0 != (Model.Flags & (int)Domain.Interfaces.OrderFlagType.TilRegnskap) ? "disabled=disabled" : "") style="margin:0;" class="btn_update_tilregnskap" value="@StringTable.OrderTilRegnskap"></li>
                }
                @if (Model.Id != 0 && settings.Hidden.OrderFlagCustom0 && Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing, OrderStatus.RestOrder))
                {
                    <li><input type="button" style="margin:0;" data-flag="@Domain.Interfaces.OrderFlagType.Custom0.Val()" class="btn_update_custom0 @(0 != (Model.Flags & (int)Domain.Interfaces.OrderFlagType.Custom0) ? "active" : "")" value="@StringTable.OrderFlagCustom((int)Domain.Interfaces.OrderFlagType.Custom0)"></li>
                }
                @if (Model.Id != 0 && settings.Hidden.OrderFlagCustom1 && Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing, OrderStatus.RestOrder))
                {
                    <li><input type="button" style="margin:0;" data-flag="@Domain.Interfaces.OrderFlagType.Custom1.Val()" class="btn_update_custom1 @(0 != (Model.Flags & (int)Domain.Interfaces.OrderFlagType.Custom1) ? "active" : "")" value="@StringTable.OrderFlagCustom((int)Domain.Interfaces.OrderFlagType.Custom1)"></li>
                }                 
                @if (Model.Id != 0 && settings.Hidden.DropShip && Model.OrderStatus.InList(OrderStatus.New, OrderStatus.Processing, OrderStatus.RestOrder))
                {
                    <li><button type="button" style="margin:0;" data-flag="@Domain.Interfaces.OrderFlagType.DropShipMark.Val()" class="btn_update_dropship @(0 != (Model.Flags & (int)Domain.Interfaces.OrderFlagType.DropShipMark) ? "active" : "")" ><span class="inactive">@StringTable.DropShip</span><span class="active">@StringTable.RemoveDropShip</span></button></li>
                }
                @if (Model.Id != 0)
                {
                    <li><input type="button" class="btn_print btn_print_invoice" value="@StringTable.PrintInvoice"></li>
                    @*<li><input type="button" class="btn_print btn_print_delivery" value="@StringTable.PrintDelivery"></li>*@
                }
                <li><input type="button" class="btn_print btn_print_packingslip" value="@StringTable.PrintPackingslip"></li>
                <li><input type="button" class="btn_print btn_print_delivery" value="@StringTable.PrintAddressLabel"></li>
                <li><input type="button" class="btn_print btn_print_Edi" value="@StringTable.PrintEDI"></li>
                <li><input type="button" class="btn_print btn_print_Proteria" value="@StringTable.PrintProteria"></li>
            </ul>
        </section>
    }
<section class="row_content row_content-eshop out-order-dt-page mt20">
    <section class="wr_column2">
        <section class="wr_box_cube">
            <section class="ui-widget">
                <section class="ui-widget-content wr-box-new">
                    <div class="wr-content-ordt">
                        @RenderGeneral(viewMode, currencies, languages, offer)
                        @RenderCustomer(offer)
                        @if (offer)
                        {
                            <div class="row_content">
                                <div class="wr_clo2">@Html.LocalizeNameFor(m => m.OfferExpiredDate) (*)</div>
                                <div class="wr_clo2">
                                    <section>
                                        @Html.LocalizeDateTextBoxFor(m => m.OfferExpiredDate, Model.Id, new { @class = "", @style = "" })
                                    </section>
                                    <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.OfferExpiredDate)</div>
                                </div>
                            </div>
                            <script type="text/javascript">
                                    $(function () { formDisableValidation($('.no-valid-fields input'), true); })

