    function LoadButtonAction(status, order) {

        status = (status || 0) + '';

        //Print invoice: enable send|return
        $('.btn_print_invoice').attr("disabled", true).css("background-color", "#ccc");
        if (status === '@OrderStatus.Sent.Val()' || status === '@OrderStatus.Credit.Val()' @*|| status === '@OrderStatus.Hent.Val()'*@) {
            $('.btn_print_invoice').removeAttr("disabled").removeAttr("style");
        }
        //send: enable new|Restorder
        $('.btn_sent').removeAttr("disabled").removeAttr("style");
        if (status === '@OrderStatus.Sent.Val()' @*|| status === '@OrderStatus.Hent.Val()'*@ || status === '@OrderStatus.Cancelled.Val()' || status === '@OrderStatus.Credit.Val()' || status === '@OrderStatus.PaymentWaiting.Val()') {
            $('.btn_sent').attr("disabled", true).css("background-color", "#ccc");
        }

        //Register restorder : enable New|PaymentWaiting
        $('.btn_register_rest').removeAttr("disabled").removeAttr("style");
        if (!order || !order.CanMakeRest) {
            $('.btn_register_rest').attr("disabled", true).css("background-color", "#ccc");
        }

        //Cancel : enable New|PaymentWaiting|RestOrder|
        $('.wr-top-eshop .btn_cancel').removeAttr("disabled").removeAttr("style");
        if (status === '@OrderStatus.Sent.Val()' || status === '@OrderStatus.Cancelled.Val()' || status === '@OrderStatus.Credit.Val()' || status === '@OrderStatus.RestOrder.Val()') {
            if (!order || !(order.CanCancel == true))
                $('.wr-top-eshop .btn_cancel').attr("disabled", true).css("background-color", "#ccc");
        }

        //return : enable Send
        $('.btn_return').attr("disabled", true).css("background-color", "#ccc");
        if (status === '@OrderStatus.Sent.Val()') {
            if (!order || order.CanReturn == true)
                $('.btn_return').removeAttr("disabled").removeAttr("style");
        }

        $('.btn_booking,.btn_bringbooking,.btn_bringmailbox,.btn_proteriabooking,.btn_porterbuddybooking,.btn_wepackbooking,.btn_postnordbooking').attr("disabled", true).css("background-color", "#ccc");
        if (status === '@OrderStatus.Sent.Val()' ||status === '@OrderStatus.New.Val()' || status === '@OrderStatus.RestOrder.Val()' ||
            status === '@OrderStatus.PayBeforeDelivery.Val()' || status === '@OrderStatus.Processing.Val()') {
            $('.btn_booking,.btn_bringbooking,.btn_bringmailbox,.btn_proteriabooking,.btn_porterbuddybooking,.btn_wepackbooking,.btn_postnordbooking').removeAttr("disabled").removeAttr("style");
        }
    }

