            $('.prompt-mess', kendoWindow).html('@StringTable.OrderCaptureTransactionMsg');
            ajaxCmd(cmdUrl, { action: 'capture' }, function (result) {
                clearTimeout(timerid);
                if (result.Status == 0) doStatus(dialog, kendoWindow, scrollTop, false);
                else {
                    $('.prompt-mess', kendoWindow)
                        .html((result.NoForceStatus ? (result.EmailSent ? (result.OrderCanceled ? '@StringTable.ErrMsgOrderCaptureFailedWEmailNoti' : '@StringTable.ErrMsgOrderCaptureFailedWEmailNotiRecurOneTime') : '@StringTable.ErrMsgOrderCaptureFailedNoAttempt') : '@StringTable.ErrMsgOrderCaptureFailed').replace('&lt;br&gt;', '<br>')
                            .replace('{0}', result.Message));

                    if(/*true*/result.Message.indexOf('Code = 1001, Message = ') == -1 || result.NoForceStatus || (result.Message && (result.Message.indexOf('Code = 1010, Message = ') != -1 || result.Message.indexOf('Code = CAPTURE_NOT_ALLOWED, Message = ') != -1)))
                    {
                        kendoWindow.find('.btn_yes').hide();
                    }
                    else {
                        var btnYes = kendoWindow.find('.btn_yes').unbind('click').click(function () {
                            $(this).closest('.wr_btn_pp').hide();
