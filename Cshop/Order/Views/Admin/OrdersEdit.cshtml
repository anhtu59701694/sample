                    <div class="wr_clo2" style="">
                        <section style="">
                            <div>
                                <div>
                                    @Html.LocalizeTextBoxFor(m => m.Opt.PaymentMethodName, new
                                    {
                                        @class = "field-name reduced-size",
                                        @datavalid = 0,
                                        @qaddbind = "Name",
                                        @placeholder = Html.LocalizeNameFor(m => m.Opt.PaymentMethodName),
                                    })
                                </div>
                                <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Opt.PaymentMethodName)</div>
                                <div style="margin-top:3px">
                                    @Html.LocalizeDropDownListKendoFor(m => m.Opt.PaymentMethodGetwayId, PaymentSettingMgr.GetAll(new DefaultDb())
                                    .Where(x => x.Type == (int)PaymentType.Manual).ToList().ToDropList(),
                                    Html.LocalizeNameFor(m => m.Opt.PaymentMethodGetwayId), new
                                    {
                                        @class = "field-gateway reduced-size",
                                        @datavalid = 0,
                                        @qaddbind = "GetwayId",
                                    })
                                </div>
                                <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Opt.PaymentMethodGetwayId)</div>
                                <div style="margin-top:3px">
                                    @Html.LocalizeDropDownListKendoFor(m => m.Opt.PaymentMethodVatId, VatMgr.GetAll(new DefaultDb(), true)
                                     .OrderBy(x => x.Value)
                                     .Select(x => new SelectListItem { Value = x.Id.ToString(), Text = (x.Value.Value * 100) + " %" }),
                                     Html.LocalizeNameFor(m => m.Opt.PaymentMethodVatId), new
                                     {
                                         @class = "field-vat reduced-size",
                                         @datavalid = 0,
                                         @qaddbind = "TaxRateId",
                                     })
                                </div>
                                <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Opt.PaymentMethodVatId)</div>
                                <div style="margin-top:3px">
                                    @Html.LocalizeTextBoxFor(m => m.Opt.PaymentMethodFee, new
                                    {
                                        @class = "field-fee custom-price-number kendo-numeric reduced-size",
