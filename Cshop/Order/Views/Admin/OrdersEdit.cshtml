    function doOpenCreditOrderForm(html) {
        var width = Math.max(200, Math.min(750, $(window).width() - 50));
        var height = Math.max(200, Math.min(2048, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#creditorder-popup-form-templ").html());
        popTemplate.find('.htmlcontent .credit-grid').html(html);
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.Return', popTemplate.html(),
            width, height, [], null,
            function (modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var popupForm = $('#popup-form', modal), statusComment = $('#textarea-comment');

                $('#gridcreditodetail #SelectAll', modal).attr('id', 'SelectAll_creditod').closest('div')
                    .find('label').attr('for', 'SelectAll_creditod');

                $('#creditcomment').val(statusComment.val());

                if ('@(Model.Type.InList(OrderType.Pos) ? 1 : 0)' == '1') $('.skip-refund', modal).hide();

                gridcreditodetailInit('#gridcreditodetail', true);
                formUpdateValidRules(modal.find('.htmlcontent'));

                modal.find(".btn_save").click(function () {
                    var vaidQtyLst = $('.creditorder-quantity', popupForm).filter(function (i, itm) { return $(itm).val() != '0'; });
                    if (vaidQtyLst.length == 0) {
                        admincommon.showMessageDefault('@StringTable.ErrMsgRequireAtleastOneItem', '@ActionResultStatus.Fail.Val()');
                        return;
                    }
                    if (popupForm.valid()) {
                        var doCredit = function () {
                            var btnCmd = modal.find(".btn_save").closest('ul').hide();
                            ajaxCmd('@ModuleUrl.AdminUrl(Html.GetController(), "Credit", Model.Id)',
                                popupForm.serialize(), function (result) {
                                    console.log('savecreditorder', result);
                                    if (result.Status == 0) {
                                        inputErrBox.append(msgBox); admincommon.hideMessage();
                                        popup.close(); $(window).scrollTop(scrollTop);
                                        gridordernote.data('kendoGrid').dataSource.page(1);
                                        rebindView(result.Order); statusComment.val('');
                                    } else btnCmd.show().find('.btn_save').closest('li').hide();
                                    if (result.Message) admincommon.showMessageDefault(result.Message, result.Status);
                                    if (result.Errors)
                                        result.Errors.forEach(function (err) { formShowErrorMsg('_' + err.Field, err.ErrorMsg, modal.find('form')); });
                                });
                        };

                        showConfirmDialog('@StringTable.Return', '@StringTable.OrderCreditConfirmMsg',
                            function (dialog, kendoWindow, scrollTop) {
                                dialog.close(); $(window).scrollTop(scrollTop);
                                doCredit();
                            }, null, 440, 200, false);
                    }
                });
                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });
    }

    function openBackOrderForm() {
        ajaxCmdHtml('@ModuleUrl.AdminUrl(Html.GetController(), "Rest")', { id: '@Model.Id' },
            function (result) { doOpenBackOrderForm(result); });
    }

    function doOpenBackOrderForm(html) {
        var width = Math.max(200, Math.min(700, $(window).width() - 50));
        var height = Math.max(200, Math.min(2048, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#backorder-popup-form-templ").html());
        popTemplate.find('.htmlcontent').html(html);
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.RegisterRestorder', popTemplate.html(),
            width, height, [], null,
            function (modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');

                $('#gridbackodetail #SelectAll', modal).attr('id', 'SelectAll_backod').closest('div')
                    .find('label').attr('for', 'SelectAll_backod');

                gridbackodetailInit('#gridbackodetail', true);

                modal.find(".btn_save").click(function () {
                    var vaidQtyLst = $('.backorder-quantity', modal).filter(function (i, itm) { return $(itm).val() != '0'; });
                    if (vaidQtyLst.length == 0) {
                        admincommon.showMessageDefault('@StringTable.ErrMsgRequireAtleastOneItem', '@ActionResultStatus.Fail.Val()');
                        return;
                    }
                    if ($('#popup-form', modal).valid()) {
                        var btnSave = $(this);
                        showConfirmDialog('@StringTable.RegisterRestorder', '@StringTable.OrderCreateRestConfirmMsg',
                            function (dialog, kendoWindow, scrollTop) {
                                dialog.close(); btnSave.prop('disabled', true);
                                ajaxCmd('@ModuleUrl.AdminUrl(Html.GetController(), "EditBlock", Model.Id)',
                                    $('#backorder-form-list').find('input').serialize(), function (result) {
                                        console.log('saveBackorder', result);
                                        if (result.Status == 0) {
                                            inputErrBox.append(msgBox); admincommon.hideMessage(); popup.close();
                                            $(window).scrollTop(scrollTop);
                                            gridordernote.data('kendoGrid').dataSource.page(1);
                                            rebindView(result.Order);

                                            var odGrid = gridorderdetail.data('kendoGrid');
                                            odGrid.dataSource.transport.data = result.Order.OrderDetails;
                                            odGrid.dataSource.read();
                                        }
                                        if (result.Message) admincommon.showMessageDefault(result.Message, result.Status);
                                        if (result.Errors)
                                            result.Errors.forEach(function (err) { formShowErrorMsg('_' + err.Field, err.ErrorMsg, modal.find('form')); });
                                        btnSave.prop('disabled', false);
                                    });
                            }, null, 440, 200, false);
                    }
                });
                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });
    }

    function showConfirmDialog(title, confirmMessage, okHandler, initHandler, width, height, moveErMsgHolder) {

        var scrollTop = $(window).scrollTop();
        var dialog = new ClawDialog('modal-mask');
        var content = $('<div>').html($("#confirm-dialog-templ").html());

        moveErMsgHolder = moveErMsgHolder == null ? true : moveErMsgHolder;

        content.find('.prompt-mess').html(confirmMessage.replace('&lt;br&gt;', '<br>'));
        if (moveErMsgHolder) content.find('#err-message-holder').append($('#massage.show_massage'));

        var kendoWindow = dialog.showDialog(title, content.html(), width || 440, height || 200);

        if (moveErMsgHolder) admincommon.hideMessage();

        if (initHandler) initHandler(dialog, kendoWindow, scrollTop);

        if (okHandler) {
            kendoWindow.find('.btn_yes').click(function () {
                okHandler(dialog, kendoWindow, scrollTop);
            });
        }

        kendoWindow.find('.btn_no').click(function () {
            if (moveErMsgHolder) {
                $('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
                $(window).scrollTop(scrollTop); admincommon.hideMessage();
            }
            dialog.close();
        });
    }

    function orderRefresh(oDetails, resetOverShipCost, resultHandler, loadingHandler) {

        if (resetOverShipCost == null || resetOverShipCost) $('#OverrideShipCost').val('false');

        if (@(offer ? 1 : 0) == 0 && (!$('#@Html.IdFor(m => m.ShippingId)').valid() || !$('#@Html.IdFor(m => m.PaymentMethodId)').valid()))return;

        if (window.clawOrderRefreshTimerId) clearTimeout(window.clawOrderRefreshTimerId);

        if(loadingHandler)loadingHandler(true);

        window.clawOrderRefreshTimerId = setTimeout(function() {
            window.clawOrderRefreshTimerId = null;

            ajaxREST('@ModuleUrl.AdminUrl(Html.GetController(), "Refresh", Model.Id)', 'POST',
                $('#editForm').serialize(), 'refresh-loading-image',
                function(result) {
                    if(result.Status == 0) {
                        rebindView(result.Order);
                        if (resultHandler)resultHandler(result.Order, result);
                        if (oDetails == null || oDetails) {
                            result.Order.OrderDetails.forEach(function(itm) {
                                itm.FirstInit = false;
                                if(@(offer ? 1 : 0) == 1 && safeProp(itm.PriceOriginInc, 'Value') > 0){
                                    itm.OriginPriceInc = itm.PriceOriginInc;
                                }
                            });

                            var odGrid = gridorderdetail.data('kendoGrid');
                            odGrid.dataSource.transport.data = result.Order.OrderDetails;
                            odGrid.dataSource.read();

                        }

                        if (result.Errors) result.Errors.forEach(function (err) {
                            formShowErrorMsg('_' + err.Field, err.ErrorMsg);
                        });

                        if (@(offer ? 1 : 0) == 1) $('.form-action-menu .btn_save').prop('disabled', result.Errors && result.Errors.length);
                    }

                    if(loadingHandler)loadingHandler(false);
                });
        }, 1000);
    }

    function orderPrefill() {
        var holder = $('#billing-info-block,#delivery-info-block,#cust-orgnumber,#cust-companyname,.no-valid-fields,.wr-offer-prefill');

        if (0 != holder.find('input:text:visible').filter(function(i, itm) { return $.trim($(itm).val()) != ''; }).length) {
            return;
        }

        if (window.clawOrderPrefillTimerId) clearTimeout(window.clawOrderPrefillTimerId);

        window.clawOrderPrefillTimerId = setTimeout(function() {
            window.clawOrderPrefillTimerId = null;

            ajaxREST('@ModuleUrl.AdminUrl(Html.GetController(), "GetPrefillInfo", Model.Id)', 'GET',
                { email: custEmail.val() }, 'prefill-loading-image',
                function(result) {
                    if(result.Status == 0) {
                        rebindView(result.Order, holder);
                        $('input[id]', '#cust-orgnumber,#cust-companyname').each(function() {
                            var hasVal = $.trim($(this).val()) != '';
                            if (hasVal) $('#IsCustIndividualFalse').prop('checked', true).change();
                        });
                        $('#DeliverMobile').change();
                    }
                });
        }, 1000);
    }

    $(function(){
        var oldGetRemoteValidArgs = $.fn.getRemoteValidArgs;

        $.fn.getRemoteValidArgs = function (args) {
            console.log('getRemoteValidArgs', args);

            if(oldGetRemoteValidArgs) args = oldGetRemoteValidArgs(args);

            if(args.url.indexOf('ValidateCouponCode') != -1) {
                args.data.OrderDetails = [];
                $('#gridorderdetail').data('kendoGrid').dataSource.data().forEach(function(rw){
                    args.data.OrderDetails.push({ProductId : rw.ProductId, VariantId : rw.VariantId});
                });
            }

            return args;
        };
    })

</script>

