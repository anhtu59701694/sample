                        var popupForm = $("#sendSMS"), bodyNode = $('#SendSMSMessage', popupForm);

                        var max = $("#order-sendsms-templ").data('max');
                        var tmpl = $("#order-sendsms-templ").data('tmpl');

                        if (max <= 0)
                            modal.find(".btn_save").prop('disabled', true);

                        var html = tmpl.replace("{0}", max);
                        modal.find("#smsLeft").html(html);

                        modal.find("#SendSMSTo").trigger('blur');

                        admincommon.hideMessage();
                        formUpdateValidRules(popupForm.find('.htmlcontent'));

                        modal.find(".btn_save").click(function () {
                            trimInputVal(bodyNode); inputCopyValid(bodyNode, true);

                            if (popupForm.valid() && bodyNode.valid()) {

                                ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "SendSMSToCustomer", Model.Id)', popupForm.serialize(),
                                    function (result) {
                                        inputErrBox.append(msgBox);

                                        var max = $('#order-sendsms-templ').data('max');
                                        max--;
                                        $('#order-sendsms-templ').data('max', max);

                                        gridordernote.data('kendoGrid').dataSource.page(1);
                                        popup.close();
                                        $(window).scrollTop(scrollTop);

                                    });
                            }
                        });

                        modal.find(".btn_cancel").click(function () {
                            inputErrBox.append(msgBox); admincommon.hideMessage();
                            popup.close(); $(window).scrollTop(scrollTop);
                        });
                    });
            });


        })

        function orderSmsPackage(sender){
            $(sender).closest('#sendSMS').find('.btn_cancel').click();

            var width = Math.max(200, Math.min(600, $(window).width() - 50));
            var height = Math.max(150, Math.min(100, $(window).height() - 50));
            var scrollTop = $(window).scrollTop();

            var popup = new ClawModal("", "modal-mask");
            var popTemplate = $('<div>').html($("#order-sms-package").html());
            var formTitle = '@Html.Raw(StringTable.OrderSmsPackage)';

            popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

            var windowModal = popup.showCustomModal("#window", formTitle, popTemplate.html(), width, height, [], null,
                function (modal) {
                    var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                    var popupForm = $("#frmOrderSmsPackage"), bodyNode = $('#amount', popupForm);

                    admincommon.hideMessage();
                    formUpdateValidRules(popupForm.find('.htmlcontent'));

                    modal.find(".btn_save").click(function () {

                        if (popupForm.valid() && bodyNode.valid()) {

                            ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "OrderSmsPackage", Model.Id)', popupForm.serialize(),
                                function (result) {
                                    
                                    if (result.Status == 0){
                                        $('#order-sendsms-templ').data('max', result.amount);

                                        setTimeout(function(){
                                            $('.btn_sendSMS').eq(0).click();
                                        }, 1000);

                                        inputErrBox.append(msgBox);
                                        popup.close();
                                        $(window).scrollTop(scrollTop);
                                    }
                                });
                        }
                    });

                    modal.find(".btn_cancel").click(function () {
                        inputErrBox.append(msgBox);
                        admincommon.hideMessage();
                        popup.close();
                        $(window).scrollTop(scrollTop);

                        setTimeout(function(){
                            $('.btn_sendSMS').eq(0).click();
                        }, 100);

                    });
                });
        }

        function smsPackageChange(sender){
            var obj = $(sender);
            var objHtml = obj.closest('.htmlcontent');
            
            var amount = obj.val();
            var price = obj.find('option:selected').data('price');

            objHtml.find('.sms-amount').val(amount);
            objHtml.find('.sms-price').val(price);
        }

        function validPhoneNr(sender) {
            var code = '@settings.Hidden.SmsCountryCode';
            var codeNoPlus = code.replace('+', '');
            var value = $(sender).val().trim();
            var phone = '';

            if (value.indexOf(code) >= 0 || value.indexOf('+') >= 0)
                phone = value;

            else if (value.indexOf(codeNoPlus) >= 0)
                phone = '+' + value;
            else
                phone = code + value;

            phone = phone.replace(/[^\+0-9]/g, '');

            $(sender).val(phone);
        }

    </script>
}

