    $(".btn_update_custom0,.btn_update_custom1").bind("click", function () {
        var node = $(this), active = node.hasClass('active'), flag = node.attr('data-flag');
		
		var funcUpdate = function(smsMsg, fDone){
			ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateFlagCustom", Model.Id)', { flag: flag, value: !active, smsMsg: smsMsg }, 
				function (result) { 
					var lst = $('.btn_update_custom0[data-flag=' + flag + '],.btn_update_custom1[data-flag=' + flag + ']');
					lst.removeClass('active'); if(!active) lst.addClass('active'); flagCustom(true);
					if(fDone) fDone();
				});
		};
		
		if(node.hasClass('btn_update_custom1') && '@(settings.Hidden.OrderFlagC1SendSms ? 1 : 0)' == '1')
		{ 
			if(active) return;
			
			@{
                var smsDataFlagCustom1 = new { Order = Model, shop_url = ClawContext.Current.CurrentSite.SiteUrl, shop_name = settings.General.StoreName };		
				var smsPhoneFc1 = string.Format("{0}: {1}", "Send sms to".ModLocalize(), Model.DeliverMobile.IfNull(Model.DeliverPhone));
				var smsMsgFc1 = "OrderFlagCustom1_msg".ModLocalize("Hei, din ordre {{Order.Id}} er nå klar for opphent hos {{shop_name}}").Replace("'","&#39;").ReplaceEx(smsDataFlagCustom1);	
			}
			showConfirmDialog('@(StringTable.OrderFlagCustom((int)Domain.Interfaces.OrderFlagType.Custom1))', 
				'<div style="width:80%;margin-left: 20px;"><div style="margin-bottom: 5px;">@smsPhoneFc1</div><textarea rows="3" id="flag-sms-msg">@smsMsgFc1</textarea></div>', 
				function(dialog, kendoWindow){ 
					$('.btn_yes', kendoWindow).prop('disabled', true); 
					funcUpdate($('#flag-sms-msg', kendoWindow).val(), function(){ $('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage')); dialog.close(); flagCustomDisable(); });
				});
		}
		else funcUpdate();
    });
     
    $(".btn_update_sent2pickuppoint").bind("click", function () {
        var node = $(this);
        ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateFlagSent2PickupPoint", Model.Id)', { }, 
            function (result) { 
                $('.btn_update_sent2pickuppoint').hide();
				$('.wr_submit_top .btn_sent').closest('li').attr('sent2pickuppoint', null);
				if(result.OrderStatusTxt) $('.field-view[databind="OrderStatusTxt"]', '#general-block').html(result.OrderStatusTxt);
            });
    });
	
	function flagCustomDisable() {
		if('@(settings.Hidden.OrderFlagC1SendSms ? 1 : 0)' == '1'){
			$(".btn_update_custom1.active").prop('disabled', true);
		}
    }
    
    function flagCustom(enable) {
		if('@(settings.Hidden.OrderFlagC1SendSms ? 1 : 0)' == '1') {
			if($(".btn_update_custom0.active").length)
				$('.wr_submit_top .btn_sent:not(:disabled)').prop('disabled', true);
		}
		else {
			if($(".btn_update_custom0.active,.btn_update_custom1.active").length)
				$('.wr_submit_top .btn_sent:not(:disabled)').prop('disabled', true);
			else if(enable) $('.wr_submit_top .btn_sent:disabled').prop('disabled', false);
		}
    }
    
    setTimeout(flagCustom, 500);
	setTimeout(flagCustomDisable, 500);

</script>

