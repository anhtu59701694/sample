<script type="text/javascript">
    function initBlockUpdateCmd(holder) {

        $('.btn_save', holder).unbind('click').click(function () {
            if (validateSubmit(holder)) {
                ajaxCmd('@ModuleUrl.AdminUrl(Html.GetController(), "EditBlock", Model.Id)',
                    holder.find('input').serialize(), function (result) {
                        //console.log('result', result);
                        if (result.Status == 0) {
                            holder.find('.order-view,.btn_edit').show();
                            holder.find('.order-edit,.btn_save,.btn_cancel,.hide-btn').hide();
                            $('.order-view .field-view[databind]', holder).each(function () {
                                var field = $(this).attr('databind'), newVal = getObjectProperty(result.Order, field);//result.Order[field];
                                //console.log(field, result.Order[field]);
                                if (newVal != null) $(this).html(kendo.htmlEncode(newVal));
                            });
                            gridordernote.data('kendoGrid').dataSource.page(1);
                        }
                        if (result.Message) admincommon.showMessageDefault(result.Message, result.Status);
                        if (result.Errors)
                            result.Errors.forEach(function (err) {
                                formShowErrorMsg(err.Field, err.ErrorMsg);
                            });
                    });
            }
        });

        $('.btn_cancel', holder).unbind('click').click(function () {
            holder.find('.order-view,.btn_edit').show();
            holder.find('.order-edit,.btn_save,.btn_cancel,.hide-btn').hide();
            holder.find('input[val-bak]').each(function () {
                if ($(this).data('kendoDropDownList')) $(this).data('kendoDropDownList').value($(this).attr('val-bak'));
                else $(this).val($(this).attr('val-bak'));
            });
        });
    }

    $(function () {
        $('.info-section-block .btn_edit').click(function () {
            var holder = $(this).closest('.info-section-block');
            holder.find('.order-view,.btn_edit').hide();
            holder.find('.order-edit,.btn_save,.btn_cancel,.hide-btn').show();
            initBlockUpdateCmd(holder);
            holder.find('input').each(function () {
                $(this).attr('val-bak', $(this).val());
            });
        });
    });
</script>

