<script type="text/javascript">

    window.onFormUpdateValidRules = function() {
        var paymentForm = $('#payment-method-form');

        $('#IsCustIndividualTrue').change();

        if (!paymentForm.is(':visible'))formDisableValidation($('input[id]', paymentForm), true);
    };

    function DropDownHideItems(status, order) {

        status = (status || 0) + '';

        kendoDropDownHideItems($('#dropNote', null));

        var editBtnSelector = '.btn_edit_product,#billing-info-block .btn_edit,#delivery-info-block .btn_edit, #customer-block .btn_edit';

        $(editBtnSelector).removeAttr("disabled").parent().parent().removeAttr("style");

        @{
            Func<OrderStatus[], string> fHideStatuses = (statuses) => typeof (OrderStatus)
                .LocalizeEnumValues<byte>(m => !m.InList(statuses))
                .Select(m => m.Text).ToString("','");
        }

        switch (status) {
            case '@OrderStatus.Processing.Val()'://[Cancelled,New,Sent,Processing]
                kendoDropDownHideItems($('#dropNote'), ['@Html.Raw(fHideStatuses(new[] { OrderStatus.Processing, OrderStatus.Cancelled, OrderStatus.New, OrderStatus.Sent, OrderStatus.Processing }))']);
                break;
            case '@OrderStatus.PayBeforeDelivery.Val()'://[Cancelled,New,Sent,Processing]
                kendoDropDownHideItems($('#dropNote'), ['@Html.Raw(fHideStatuses(new[] { OrderStatus.PayBeforeDelivery, OrderStatus.Cancelled, OrderStatus.New, OrderStatus.Sent, OrderStatus.Processing }))']);
                break;
            case '@OrderStatus.New.Val()'://[Cancelled,Sent,Processing]
                kendoDropDownHideItems($('#dropNote'), ['@Html.Raw(fHideStatuses(new[] { OrderStatus.New, OrderStatus.Cancelled, OrderStatus.Sent, OrderStatus.Processing }))']);
                break;
            case '@OrderStatus.Sent.Val()'://[Credit]
                var hidArr = ['@Html.Raw(fHideStatuses(new[] { OrderStatus.Sent }))'];
                if (order && order.CanReturn) hidArr = ['@Html.Raw(fHideStatuses(new[] { OrderStatus.Sent, OrderStatus.Credit }))'];
                kendoDropDownHideItems($('#dropNote'), hidArr);
                if('@(Model.Recurring.SafeProp(m => m.OrderId ?? 0))' != '@(Model.Id)')
                    $(editBtnSelector).attr("disabled", true).parent().parent().css("display", "none");
                break;
            case '@OrderStatus.Cancelled.Val()':
                kendoDropDownHideItems($('#dropNote'), ['@(Html.Raw(fHideStatuses(new[] { OrderStatus.Cancelled })))']);
                if('@(Model.Recurring.SafeProp(m => m.OrderId ?? 0))' != '@(Model.Id)')
                    $(editBtnSelector).attr("disabled", true).parent().parent().css("display", "none");
                break;
            case '@OrderStatus.Credit.Val()':
                kendoDropDownHideItems($('#dropNote'), ['@(Html.Raw(fHideStatuses(new[] { OrderStatus.Credit })))']);
                $(editBtnSelector).attr("disabled", true).parent().parent().css("display", "none");
                break;
            case '@OrderStatus.RestOrder.Val()'://[Sent,Cancelled]
                kendoDropDownHideItems($('#dropNote'), ['@(Html.Raw(fHideStatuses(new[] { OrderStatus.RestOrder, OrderStatus.Sent, OrderStatus.Cancelled })))']);
                //$(editBtnSelector).attr("disabled", true).parent().parent().css("display", "none");
                break;
            case '@OrderStatus.PaymentWaiting.Val()'://[Cancelled,New,Processing]
                kendoDropDownHideItems($('#dropNote'), ['@(Html.Raw(fHideStatuses(new[] { OrderStatus.PaymentWaiting, OrderStatus.Cancelled, OrderStatus.New, OrderStatus.Processing })))']);
                break;
        }
    }

    function DisableCheckNote(disible) {
        $("#demo_box_a,#demo_box_b").prop("disabled", disible).prop("checked", disible);
    }

    $("#dropNote").change(function () {
        DisableCheckNote(false);
        var statusOrder = $(this).val() + '';
        var curentStatus = '@Model.OrderStatus';
        switch (statusOrder) {
            case '@OrderStatus.Sent.Val()':
                if (curentStatus != '@OrderStatus.Sent.Val()') {
                    DisableCheckNote(true);
                }
                break;
            case '@OrderStatus.Cancelled.Val()':
                if (curentStatus != '@OrderStatus.Cancelled.Val()') {
                    DisableCheckNote(true);
                }
                break;
            case '@OrderStatus.Credit.Val()':
                if (curentStatus != '@OrderStatus.Credit.Val()') {
                    DisableCheckNote(true);
                }
                break;
        }
    });

    $('#save-comment').unbind('click').click(function () {
        var holder = $(this).closest('#comment-info-block');

        $('.field-valid-msg .error', holder).show();

        var currentStatus = $('#@Html.IdFor(m => m.OrderStatus)');
        var commentNode = $("#textarea-comment"), statusNode = $("#dropNote");
        var statusKd = statusNode.data("kendoDropDownList"), newStatusVal = statusKd.value() + '';
        var statusValid = statusNode.valid(), commentValid = commentNode.valid();
        var statusChanged = newStatusVal != currentStatus.val();
        if (statusValid && commentValid) {

            switch (currentStatus.val()) {
                case '@OrderStatus.PayBeforeDelivery.Val()':
                case '@OrderStatus.Processing.Val()':
                case '@OrderStatus.New.Val()':
                    switch (newStatusVal) {
                        case '@OrderStatus.Cancelled.Val()':
                            $(".wr_submit_top .btn_cancel:first").click();//action cancelled
                            return;
                        case '@OrderStatus.Sent.Val()':
                            $(".btn_sent:first").click();//action Sent
                            return;
                        case '@OrderStatus.Processing.Val()':
                        case '@OrderStatus.New.Val()':
                            break;
                        default:
                            if(statusChanged) return;
                    }
                    break;
                case '@OrderStatus.Sent.Val()':
                    switch (newStatusVal) {
                        case '@OrderStatus.Credit.Val()':
                            $(".btn_return:first").click();//action Credit
                            return;
                        default:
                            if(statusChanged) return;
                    }
                    break;
                    @*case '@OrderStatus.Hent.Val()':
                        switch (newStatusVal) {
                        case '@OrderStatus.Credit.Val()':
                            $(".btn_return:first").click();//action Credit
                            return;
                        }
                        break;*@
                case '@OrderStatus.PaymentWaiting.Val()':
                    switch (newStatusVal) {
                        case '@OrderStatus.Cancelled.Val()':
                            $(".wr_submit_top .btn_cancel:first").click();//action cancelled
                            return;
                        case '@OrderStatus.New.Val()':
                        case '@OrderStatus.Processing.Val()':
                            break;
                        default:
                            if(statusChanged) return;
                    }
                    break;
                case '@OrderStatus.RestOrder.Val()':
                    switch (newStatusVal) {
                        case '@OrderStatus.Sent.Val()':
                            $(".btn_sent:first").click();//action Sent
                            return;
                        case '@OrderStatus.Cancelled.Val()':
                            $(".wr_submit_top .btn_cancel:first").click();
                            return;
                        default:
                            if(statusChanged) return;
                    }
                    break;
                case '@OrderStatus.Cancelled.Val()':
                case '@OrderStatus.Credit.Val()':
                    if(statusChanged) return;
                default:
                    if(statusChanged) return;
            }

            var isPrivate = $("#demo_box_b").prop("checked");
            var isSendMail = $("#demo_box_a").prop("checked");
            var commentFlags = isSendMail == true ? 1 : 0;

            ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateStatus", Model.Id)',
            { status: statusKd.value(), comment: commentNode.val(), isPrivate: !isPrivate, isSendMail: isSendMail, commentFlags: commentFlags }, function (result) {
                commentNode.val('');
                rebindView(result.Order);
                gridordernote.data('kendoGrid').dataSource.page(1);
            });
        }
    });

    function rebindView(order, holder) {
        if (!order) return;

        var currencyCode = currency.val();

        $('input[id][databind]', holder || '#editForm').each(function () {
            var field = $(this).attr('databind'), value = getObjectProperty(order, field), format = $(this).attr('dataformat');
            //console.log(field, value);
            if (value != null) {
                var kdNode = $(this).data('kendoDropDownList');
                if (kdNode)kdNode.value(value);
                else $(this).val(format == 'omoneymc' ? localizeCurrencyToString(value, currencyCode) : value);
            }
        });

        if (holder)return;

        if (order.BackOrderUrls) {
            var borderholder = $('#backorderids-box').show().removeClass('hidden'), boItems = [];
            order.BackOrderUrls.forEach(function(itm) {
                boItems.push('<span class="field-view-link"><a href="' + itm.Value + '" class="form-link">' + itm.Id + '</a></span>');
            });
            $('.backorder-link-box', borderholder).html(boItems.join(', '));
        }

        $('.order-view .field-view[databind]', '#summary-info-block,#general-block,#customer-block,#payship-info-block').each(function () {
            var field = $(this).attr('databind'), holder = $(this).closest('.field-view-box'), format = $(this).attr('dataformat');
            var value = getObjectProperty(order, field), holderCond = holder.attr('datacondition');
            //console.log(field, value);
            if (value != null) {
                $(this).html(format == 'omoneymc' ? kendo.htmlEncode(localizeCurrencyToString(value, currencyCode)) : value);
                if (holder.is(':visible')) {
                    if (holderCond && !getObjectProperty(order, holderCond))holder.hide().addClass('hidden');
                }
                else if (!holderCond || getObjectProperty(order, holderCond))holder.show().removeClass('hidden');
            }
        });

        var currentStatus = $('#@Html.IdFor(m => m.OrderStatus)');
        var statusNode = $("#dropNote"), statusKd = statusNode.data("kendoDropDownList");

        if(order.OrderStatus != null && statusKd) {
            currentStatus.val(order.OrderStatus);
            statusKd.value(order.OrderStatus);
            LoadButtonAction(order.OrderStatus, order);
            DropDownHideItems(order.OrderStatus, order);

            if(order.OrderStatus == '@OrderStatus.Sent.Val()' || order.OrderStatus == '@OrderStatus.Cancelled.Val()')
                $('.btn_update_tilregnskap,.btn_update_custom0,.btn_update_custom1,.btn_update_dropship').closest('li').hide();
        }

        if (order.TaxStats) {
            var taxList = $('#tax-stat-list'), taxTempl = $('#tax-stat-templ').html();
            taxList.html('');
            order.TaxStats.forEach(function (tax) {
                var per = 0;
                if(tax != null && tax.Item1.Value != -1){
                    per = tax.Item1.Value;
                }
                var ele = $(taxTempl);
                $('.field-view-tax[databind=Name]', ele).html(localizeFloatToString(per * 100, 'n2'));
                $('.field-view-tax[databind=Value]', ele).html(localizeCurrencyToString(tax.Item2.Value, currencyCode));
                taxList.append(ele);
            });
        }

        if(safeProp(order.BackOrderUrls, 'length') || (order.OrderStatus != @OrderStatus.New.Val() && order.OrderStatus != @OrderStatus.Processing.Val()) )
        {
            viewModeOrderDetail = order.OfferEmailSent === null || order.OfferEmailSent === undefined || OfferEmailSent === true;

            if(window.gridorderdetail && gridorderdetail.data('kendoGrid'))
                gridorderdetail.data('kendoGrid').refresh();

            if(window.gridordernote && gridordernote.data('kendoGrid'))
                gridordernote.data('kendoGrid').refresh();
        }
    }

