@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@using Domain = Claw.Modules.Eshop.Domain
@model OrderModel

@{
    Layout = "Layout/Input.cshtml";

    var offer = Html.GetController().InList("Offer");
    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.OrderEdit;
    ViewBag.Title = offer ? StringTable.AddEditOffer(Model.Id) : StringTable.AddEditOrder(Model.Id);
    ViewBag.ShowDeleteBtn = (Model != null && Model.Id > 0);

    ViewBag.UseCKEditor = true;
    ViewBag.UseDatePicker = true;
    ViewBag.UseInlineEdit = true;
    ViewBag.UseImgPreview = true;
    ViewBag.UseUploadFile = true;

    ViewBag.TranslateMaxWidth = 700;
    ViewBag.TranslateMaxHeight = 450;
    ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/offer";
    ViewBag.ParentBreadcrumbTitle = offer ? StringTable.Offer : StringTable.Order;

    var viewMode = Model.Id != 0;
    var settings = (SettingsBiz)ViewBag.Settings;
    var countries = (List<Domain.Country>)ViewBag.Countries;
    var paymentMethods = (List<PaymentMethodModel>)ViewBag.PaymentMethods;
    var shippings = (List<ShippingModel>)ViewBag.Shippings;
    var currencies = (List<Domain.Currency>)ViewBag.Currencies;
    var languages = (List<Language>)ViewBag.Languages;
    var versionSetting = Claw.Modules.Eshop.Helper.VersionHelper.GetVersionSetting();
    if (versionSetting != null)
    {
        if (versionSetting.Languages.Count > 0)
        {
            var lstLangCode = versionSetting.Languages.Select(p => p.Code.ToLower());
            languages = languages.Where(p => lstLangCode.Contains(p.ShortLangCode.ToLower())).ToList();
        }
    }
    var lang = string.IsNullOrEmpty(Model.LangCode) ? LanguageMgr.FocusLangCode : Model.LangCode.ToLower();

    if (offer)
    {
        Model.OrderStatus = (byte)OrderStatus.PaymentWaiting;
    }
    
    var wePack = Type.GetType("Claw.Modules.Eshop.WePack.StringTable,Claw.Modules.Eshop.WePack", false) != null;
    var wePackActive = wePack && Model.GetRaw() != null && Model.GetRaw().PackingData.IsNullOrEmpty();
}
