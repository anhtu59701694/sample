                @if (Model.Recurring != null)
                {
                    var recurs = Model.Recurring.ToList().Where(m => m.OrderId == (Model.OriginalBackOrderId ?? Model.Id) || (Model.OriginalBackOrderId == null && Model.Recurring.Id == m.Id)).ToList();
                    <div class="wr_clo2">
                        @Html.LocalizeNameFor(m => m.Recurring)#:
                        <ul style="display:inline-block;">
                            @for (int i = 0; i < recurs.Count; i++)
                            {
                                <li style="display:inline-block;">
                                    @if (i != 0)
                                    { <span>, </span>}
                                    <a href="@ModuleUrl.AdminUrl(Html.GetController(), "EditRecurring", recurs[i].Id)" class="form-link"><b>@recurs[i].Id</b></a>
                                    @if(SettingsBiz.GetSettings().Hidden.DibsEasyRecurAutoCapture && Model.Id != 0 && Model.GetRaw().SafeProp(m => m.OrderStatus.InList(OrderStatus.PaymentWaiting) && m.Recurring != null && m.Recurring.LastRunOrderId == m.Id && m.PaymentMethod.SafeProp(z=> z.PaymentSystemId.InList(GatewayID.DIBS))))
                                    {
                                        <button class="btn btn_recapture_recur" type="button" style="margin: -2px 5px 0 5px; height: 2.2em; vertical-align: top;">@StringTable.RecaptureRecur</button>
