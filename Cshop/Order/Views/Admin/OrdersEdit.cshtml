    function validPostalCodeBilling() {
        return validPostalCode('@Html.IdFor(m => m.BillingPostnr)', '@Html.IdFor(m => m.BillingPosted)',
            '@Html.IdFor(m => m.BillingCountryId)', 'CheckingBillingPostnr');
    }

    function validPostalCodeDeliver() {
        if (validPostalCode('@Html.IdFor(m => m.DeliverPostnr)', '@Html.IdFor(m => m.DeliverPosted)',
            '@Html.IdFor(m => m.DeliverCountryId)', 'CheckingDeliverPostnr')) {
            orderRefresh();
            return true;
        } else return false;
    }

    function validPostalCode(postnrid, cityid, countryid, waitingId) {

        var postalCode = $('#' + postnrid), postalVal = $.trim(postalCode.val());
        var countryVal = safeProp(dropdownGetData($('#' + countryid)), 'Code');

        if (countryVal == '' || postalVal == '') return true;
        if (!postalCode[0].validPnr) postalCode[0].validPnr = {};

        var key = countryVal + '&' + postalVal;

        if (postalCode[0].validPnr.key == key && postalCode[0].validPnr.value) {
            //console.log('cached:', key, postalCode[0].validPnr);
            if (postalCodeOnResult(postnrid, cityid, postalCode[0].validPnr.value)) return true;
            else {
                postalCode.focus();
                return false;
            }
        }

        ajaxREST('/modules/eshop/BringShippingGuide/GetPostalCode', 'GET',
            { clientUrl: window.location.host, country: countryVal, pnr: postalVal }, waitingId,
