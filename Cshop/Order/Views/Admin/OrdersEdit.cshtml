                                <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Opt.PaymentMethodFee)</div>
                            </div>
                            <div>
                                <input value="Save" class="btn_add" type="button" />
                                <input value="Cancel" class="btn_cancel" type="button" />
                                @Html.LocalizeImageLoading(new { @id = "payment-method-loading" })
                            </div>
                        </section>
                    </div>
                </div>
            }
            <div id="payment-method-input-box">
                <div class="row_content">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.PaymentMethodId) (*)</div>
                    <div class="wr_clo2">
                        <section>
