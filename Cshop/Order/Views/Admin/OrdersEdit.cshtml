            <div class="row_content">
                <div class="wr_clo1">@StringTable.CreatedDate: <b>@Model.CreatedDate.SafeProp(m => m.TextF) </b></div>
                <div class="wr_clo1" style="@(!Model.ExpectedDelivery.IsNull() ? "" : "display:none")">@Html.LocalizeNameFor(m => m.ExpectedDelivery): <b>@Model.ExpectedDelivery </b></div>
                <div class="wr_clo1" style="@(!Model.OfferLastView.IsNull() ? "" : "display:none")">@Html.LocalizeNameFor(m => m.OfferLastView): <b>@Model.OfferLastView</b></div>
                <div class="wr_clo1" style="@(!Model.OfferEmailView.IsNull() ? "" : "display:none")">@Html.LocalizeNameFor(m => m.OfferEmailView): <b>@Model.OfferEmailView</b></div>
                <div class="wr_clo1 field-view-box" style="@(!Model.DeliveredDate.IsNull() ? "" : "display:none")">
                    @StringTable.SentOn:
                    <b><span class="field-view" databind="DeliveredDate.TextF">@Model.DeliveredDate.SafeProp(m => m.TextF)</span></b>
                </div>
            </div>
            <div class="row_content" style="">
                <div class="wr_clo1 field-view-box">
                    @StringTable.OrderStatus:
                    <b><span class="field-view" databind="OrderStatusTxt">@Model.OrderStatusTxt</span></b>
                </div>
            </div>
        </div>
        <div class="order-edit">
            <div class="row_content" style="@(viewMode ? "" : "display:none")">
                <div class="wr_clo2">@Html.LocalizeNameFor(m => m.ReservationId)</div>
                <div class="wr_clo2">
                    <section>
                        @Html.LocalizeTextBoxFor(x => x.ReservationId, new { @style = "float:left", @readonly = "readonly" })
                    </section>
                    <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.ReservationId)</div>
                </div>
            </div>
            <div class="row_content" style="@(offer ? "display:none;" : "")">
                <div class="wr_clo2">@Html.LocalizeNameFor(m => m.OrderStatus) (*)</div>
                <div class="wr_clo2">
                    <section>
                        @Html.LocalizeDropDownListKendoFor(m => m.OrderStatus, typeof(OrderStatus).LocalizeEnumValues<byte>(m => Model.Id != 0 || (offer && m.InList(OrderStatus.PaymentWaiting)) || m.InList(OrderStatus.New, OrderStatus.PayBeforeDelivery)), StringTable.SelectStatus, new { @style = "float:left" })
                    </section>
                    <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.OrderStatus)</div>
                </div>
            </div>

            @if (Model.Id != 0 || SettingsBiz.GetSettings().Hidden.SingleCurrency)
            {
                @Html.HiddenFor(m => m.Currency)
            }
            else
            {
                <div class="row_content">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.Currency)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeDropDownListKendoFor(m => m.Currency, currencies.Where(p => p.Code.ToLower() == "nok").Select(x => new SelectListItem() { Value = x.Code, Text = x.Name }),
                            null, new { @style = "float:left", @onchange = "currencyOnChange($(this))" })
                        </section>
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Currency)</div>
                    </div>
                </div>
            }
            <div class="row_content" style="@(languages.Count <= 1 ? "display:none" : "")">
                <div class="wr_clo2">@Html.LocalizeNameFor(m => m.LangCode)</div>
                <div class="wr_clo2">
                    <section>
                        @Html.LocalizeDropDownListKendoFor(m => m.LangCode, languages.Select(x => new SelectListItem() { Value = x.LanguageCode, Text = x.LanguageName }),
                        null, new { @style = "float:left", @onchange = "" })
                    </section>
                    <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.LangCode)</div>
                </div>
            </div>
        </div>
    </div>
}

@helper RenderCustomer(bool offer)
{
    <div id="customer-block" class="info-section-block">
        @Html.HiddenFor(m => m.Customer.Id)
        <input name="BlockType" value="customer" type="hidden" />
        <div class="row_content order-view">
            @if (!offer)
            {
                <div class="wr_clo1 txt-bold size14 txt-underline">@StringTable.AccountInformation:</div>
            }
            <div class="wr_clo1">@Model.Customer.ContactName.IfNull(Model.Customer.DeliverName)</div>
            @*<div class="wr_clo1">@Model.Customer.Email</div>*@
            <div class="wr_clo1 field-view" databind="Customer.Email">@Model.Customer.Email</div>
            @if (offer)
            {
                <div class="wr_clo1">@Model.DeliverMobile</div>
                <div class="wr_clo1">@Model.DeliverPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.Customer.Mobile))
            {
                <div class="wr_clo1">@Model.Customer.Mobile</div>
            }
            @if (!string.IsNullOrEmpty(Model.Customer.Telephone))
            {
                <div class="wr_clo1">@Model.Customer.Telephone</div>
            }

            @if (!string.IsNullOrEmpty(Model.Customer.CompanyName))
            {
                <div class="wr_clo1">@StringTable.CompanyName: @Model.Customer.CompanyName</div>
            }
            @if (!string.IsNullOrEmpty(Model.Customer.OrgNumber))
            {
                <div class="wr_clo1">@StringTable.OrgNumber: @Model.Customer.OrgNumber</div>
            }
            <div class="wr_clo1">@StringTable.UserID: <a class="form-link" href="@ModuleUrl.AdminUrl("Customer", "Edit", @Model.Customer.Id)">@Model.Customer.Id</a>, @StringTable.RegisteredOn @Model.Customer.CreatedDate.TextF</div>
            @if (Model.Id != 0 && Model.Customer.StatsInfo != null)
            {
                <div class="wr_clo1">
                    @Html.LocalizeNameFor(m => m.Customer.StatsInfo.Orders): <a class="form-link" href="@ModuleUrl.AdminUrl("Order", "Index")?customerid=@(Model.Customer.Id)"><b>@Model.Customer.StatsInfo.Orders</b></a>,
                    @Html.LocalizeNameFor(m => m.Customer.StatsInfo.TotalSales): <b>@Model.Customer.StatsInfo.TotalSales.SafeProp(m => m.Value).ToOMoneyMc(Model)</b>
                </div>
            }
        </div>
        <div class="row_content order-edit">
            <div class="row_content">
                <div class="wr_clo2">@Html.LocalizeNameFor(m => m.Customer.Email) (*)</div>
                <div class="wr_clo2">
                    <section>
                        @Html.LocalizeTextBoxFor(m => m.Customer.Email, new { @class = "js-required", @style = "", @onchange = "orderPrefill()" })
                    </section>
                    <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Customer.Email)</div>
                </div>
            </div>
            @if (offer)
            {
                <div class="row_content wr-offer-prefill">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.DeliverName) (*)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.DeliverName, new { @style = "", @databind = "DeliverName" })
                        </section>
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.DeliverName)</div>
                    </div>
                </div>
                <div class="row_content wr-offer-prefill">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.DeliverMobile)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.DeliverMobile, new { @style = "", @placeholder="+47xxxxxxxx", @databind = "DeliverMobile" })
                        </section>
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.DeliverMobile)</div>
                    </div>
                </div>
                <div class="row_content wr-offer-prefill">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.OfferSendSms)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeCheckBoxFor(m => m.OfferSendSms, new { @style = "", @value = "true", @databind = "OfferSendSms" })
                        </section>
                    </div>
                </div>
                <div class="row_content wr-offer-prefill">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.DeliverPhone)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.DeliverPhone, new { @style = "", @databind = "DeliverPhone" })
                        </section>
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.DeliverPhone)</div>
                    </div>
                </div>
                if ((Model.CartId ?? 0) == 0) 
                {
                    <script>
                        $(function () {

                            $('#OfferSendSms').change(function () {
                                var msg = $('#OfferSmsMsg'), holder = msg.closest('.ui-widget');
                                if ($(this).prop('checked')) {
                                    holder.show(); formDisableValidation(msg, false);
                                }
                                else {
                                    holder.hide(); formDisableValidation(msg, true);
                                }
                            }).change();

                            $('#DeliverMobile').change(function () {
                                var sendMsg = $('#OfferSendSms'), val = $(this).val();
                                if (val) {
                                    if (val.length < 10 && (!val.startsWith('+') && !val.startsWith('00')))
                                        $(this).val(val = '+47' + val);

                                    sendMsg.prop('disabled', false);
                                }
                                else {
                                    sendMsg.prop('checked', false).change().prop('disabled', true);
                                }
                                $('.sms-send-to-number').html(val);
                            }).change();
                        })
                    </script>
                }
            }
            @if (Model.Id == 0 && !offer)
            {
                <div class="row_content">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.Customer.Individual)</div>
                    <div class="wr_clo2">
                        @Html.LocalizeRadioButtonFor(model => model.Customer.Individual, "true", new { @id = "IsCustIndividualTrue", @class = "css-radio js-required" })
                        <label for="IsCustIndividualTrue" class="css-labelradio">@StringTable.CustomerPersonal</label>
                        @Html.LocalizeRadioButtonFor(model => model.Customer.Individual, "false", new { @id = "IsCustIndividualFalse", @class = "css-radio js-required" })
                        <label for="IsCustIndividualFalse" class="css-labelradio">@StringTable.CustomerCompany</label>
                    </div>
                </div>
                <div class="row_content" id="cust-orgnumber" style="display:none">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.Customer.OrgNumber) (*)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.Customer.OrgNumber, new
                            {
                                @class = "",
                                @style = "",
                                @databind = "Customer.OrgNumber",
                                @data_val_required = StringTable.ErrMsgRequiredField.ModErrLocalize()
                            })
                        </section>
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Customer.OrgNumber)</div>
                    </div>
                </div>
                <div class="row_content" id="cust-companyname" style="display:none">
                    <div class="wr_clo2">@Html.LocalizeNameFor(m => m.Customer.CompanyName) (*)</div>
                    <div class="wr_clo2">
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.Customer.CompanyName, new
                            {
                                @class = "",
                                @style = "",
                                @databind = "Customer.CompanyName",
                                @data_val_required = StringTable.ErrMsgRequiredField.ModErrLocalize()
                            })
                        </section>
                        <div class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.Customer.CompanyName)</div>
                    </div>
                </div>
            }
        </div>
        @if (Model.Type == (int)OrderType.Web && !offer)
        {
            <div class="wr-line-edit" style="@(Model.Id != 0 ? "" : "display:none")">
                <div class="wr-btn-table">
                    <input type="button" class="btn_edit" value="@StringTable.Edit">
                    <input type="button" class="btn_cancel" value="@StringTable.Cancel" style="display: none">
                </div>
                <div class="wr-btn-table hide-btn" style="display:none">
                    <input type="button" class="btn_save" value="@StringTable.Save" style="display: none">
                </div>
            </div>
        }
    </div>
    <script type="text/javascript">

        $('#IsCustIndividualTrue,#IsCustIndividualFalse').change(function() {
            var orgNodeHolders = $('#cust-orgnumber,#cust-companyname');

            if ($('#IsCustIndividualTrue').prop('checked')) {
                orgNodeHolders.hide();
                formDisableValidation(orgNodeHolders.find('input[id]'), true);
                setTimeout(function() {
                    formDisableValidation(orgNodeHolders.find('input[id]'), true);
                }, 2000);
            }
            else {
                orgNodeHolders.show();
                formDisableValidation(orgNodeHolders.find('input[id]'), false);
                setTimeout(function() {
                    formDisableValidation(orgNodeHolders.find('input[id]'), false);
                }, 2000);
            }
        });

        setTimeout(function() { $('#IsCustIndividualTrue').change(); }, 1000);

    </script>
}

@helper RenderPayShipInfo(List<PaymentMethodModel> paymentMethods, List<ShippingModel> shippings, SettingsBiz settings)
{
    <div id="payship-info-block">
        <div class="wr_clo1 txt-bold size14 txt-underline">@StringTable.PaymentInformation:</div>
        <div class="row_content none-first-pad order-view" data-count="@Model.SplitPaymentMethods.SafeCount()">
            @if (Model.SplitPaymentMethods.SafeCount() != 0)
            {
                <div class="wr_clo1" style="min-height: 0;">@StringTable.Payment:</div>
                <ul style="margin-left: 20px;">
                    @foreach (var itm in Model.SplitPaymentMethods)
                    {
                        <li> @itm.Item1.Name - @Html.Raw(itm.Item2.Value.ToOMoneyMc(Model))</li>
                    }
                </ul>
            }
            else
            {
                <div class="wr_clo1">@StringTable.Payment: @Model.PaymentName - @Html.Raw(Model.PaymentCost.Value.ToOMoneyMc(Model))</div>
                if (Model.Type.InList(OrderType.Web) && !Model.GiftCardTotal.IsNull() && Model.GiftCardTotal != 0)
                {
                    <ul style="margin-left: 20px;margin-bottom: 10px;">
                        <li>@Model.PaymentName: @Html.Raw(Model.FinalTotal.Value.ToOMoneyMc(Model))</li>
                        <li>@("Giftcard".ModLocalize()): @Html.Raw(Model.GiftCardTotal.Value.ToOMoneyMc(Model))</li>
                    </ul>
                }
            }
            <div class="wr_clo1 field-view-box">
                @StringTable.Transaction#:
                <span class="field-view" databind="CombinedTransactionId">@Model.CombinedTransactionId</span>
            </div>
            @if (Model.Type.InList(OrderType.Pos) && Model.GetRaw() != null && !Model.GetRaw().PaymentData.IsNullOrEmpty())
            {
                <div class="wr_clo1 field-view-box">
                    <span class="field-view">@(Model.GetRaw().PaymentData)</span>
                </div>
            }
            @if (!Model.PaymentResultId.IsNullOrEmpty())
            {
                <div class="wr_clo1 field-view-box">
                    @Html.LocalizeNameFor(m => m.PaymentResultId):
                    <span class="field-view">@Model.PaymentResultId</span>
                </div>
            }
            @if (!Model.PaymentCardMaskedPan.IsNullOrEmpty())
            {
                <div class="wr_clo1 field-view-box">
                    @Html.LocalizeNameFor(m => m.PaymentCardMaskedPan):
                    <span class="field-view">@Model.PaymentCardMaskedPan</span>
                </div>
            }
            <div class="wr_clo1 mt20">@StringTable.Shipping: @Model.ShippingName - @Html.Raw(Model.ShippingCost.Value.ToOMoneyMc(Model))</div>
            @if (Model.ExtraService != null && Model.ExtraService > 0)
            {
                Array extraBringServiceValue = System.Enum.GetValues(typeof(ExtraBringService));
                <div class="wr_clo1">
                    @foreach (byte Value in extraBringServiceValue)
                    {
                        if (((ExtraBringService)Model.ExtraService).HasFlag((ExtraBringService)Value))
                        {
                            string textValue = Enum.GetName(typeof(ExtraBringService), Value);
                            <input type="checkbox" checked="checked" disabled="disabled" id="@textValue" />
                            <label for="@textValue">@textValue</label>
                        }
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.BringInfo))
            {
                <div class="wr_clo1">@Model.BringInfo</div>
            }
            @if (!string.IsNullOrEmpty(Model.ShippingPickupPoint))
            {
                <div class="wr_clo1">@Model.ShippingPickupPointFormated</div>
            }
            <div class="wr_clo1 field-view-box">
                @StringTable.Weight:
                <span class="field-view" databind="TotalWeight.Text">@Model.TotalWeight</span> kg
            </div>
            <div class="wr_clo1 title-tracking">
                @StringTable.ShippingTracking#:
                @{ var trackingUrl = Model.ShippingTrackingId.IsNullOrEmpty() ? null : Model.GetRaw().GetShippingTrackingUrl(); }
                @if (trackingUrl.IsNullOrEmpty() && !Model.ShippingTrackingId.IsNullOrEmpty())
                { @(Model.ShippingTrackingId) }
                else
                {
                    <a target="_blank" href="@trackingUrl">@Model.ShippingTrackingId</a>
