                </div>
            </div>
        </div>
        <div class="wr-line-edit" style="display:none">
            <div class="wr-btn-table">
                <input type="button" class="btn_edit" value="@StringTable.Edit">
                <input type="button" class="btn_cancel" value="@StringTable.Cancel" style="display: none">
            </div>
            <div class="wr-btn-table hide-btn" style="display:none">
                <input type="button" class="btn_save" value="@StringTable.Save" style="display: none">
            </div>
        </div>
    </div>
    <script type="text/javascript">

        setTimeout(function() {
            formDisableValidation($('input[id]','#payment-method-form'), true);
        },1000);

        function onPaymentMethodChange(node) {

            var paymentForm = $('#payment-method-form');

            if (node.val() == '-1') {
                var paymentInputBox = $('#payment-method-input-box'), ddNode = node.data('kendoDropDownList');
                var nameNode = $('.field-name', paymentForm), errNodes = $('span.error', paymentForm);
                var gatewayNode = $('.field-gateway[id]', paymentForm), vatNode = $('.field-vat[id]', paymentForm);
                var feeNode = $('.field-fee[id]', paymentForm);

                if(!feeNode.data("kendoDropDownList"))
                    initKendoNumeric('#' + feeNode.attr('id'), { format: "@settings.Display.Others.GetPriceFormat()", step: '@settings.Display.Others.PriceStep' });

                paymentForm.show().find('input.btn_add')
                    .unbind('click')
                    .click(function() {

                        var name = $.trim(nameNode.val()), langCode = getFocusLang();
                        var valid0 = nameNode.val(name).valid(), valid1 = gatewayNode.valid(), valid2 = vatNode.valid(), valid3 = feeNode.valid();

                        if (!valid0 || !valid1 || !valid2 || !valid3) return;
                        else errNodes.html('');

                        ajaxREST('@ModuleUrl.AdminUrl("PaymentMethod", "Input", 0)', 'POST',
                            {
                                InlineEdit: true, QuickAdd: true, lang: langCode, OnlyUseAdmin: true,
                                name: name, GetwayId: gatewayNode.val(), TaxRateId: vatNode.val(), Fee: feeNode.val(),
                            }, 'payment-method-loading',
                            function(result) {
                                var row = result.Data[0], items = ddNode.dataSource.data();
                                //console.log(result);
                                if (result.Status == 0) {
                                    paymentInputBox.show();
                                    paymentForm.hide();
                                    paymentForm.find('input[id]').val('');
                                    var addItem = items.find(function(itm) { return itm.Value == '-1'; });
                                    items.push({
                                        Value: row.Id.toString(), Text: row.Name, Active: true,
                                        LangVisible: true, CssClass: '', Title: '', Model: row, id: row.Id
                                    });
                                    items.remove(addItem);
                                    items.push(addItem);
                                    ddNode.value(row.Id.toString());
                                    node.change();
                                    formDisableValidation($('input[id]', paymentForm), true);
                                }
                                if(result.Errors && result.Errors.length != 0) {
                                    Object.keys(result.Errors).forEach(function(itm) {
                                        var err = result.Errors[itm], errNode = $('input[id][qaddbind=' + itm + ']', paymentForm);
                                        if(err.errors) formShowErrorMsg(errNode.attr('name'), err.errors[0]);
                                    });
                                }
                            }, function(e) { errNodes.first().html('@StringTable.AjaxCommandErrorMessage'); });
                    });

                paymentForm.show().find('input.btn_cancel')
                    .unbind('click')
                    .click(function() {
                        paymentForm.hide();
                        paymentInputBox.show();
                        ddNode.value(paymentForm.attr('bk-val') || '');
                        paymentForm.find('input[id]').val('');
                        errNodes.html('');
                        formDisableValidation($('input[id]', paymentForm), true);
                    });

                paymentInputBox.hide();
                formDisableValidation($('input[id]', paymentForm), false);
            } else { paymentForm.attr('bk-val', node.val()); paymentmethodOnChange(node); }
        }

    </script>
}

