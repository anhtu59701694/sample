                                            <div class="wr_clo1 field-view">@Model.NextOrder.DeliverPhone</div>
                                            <div class="wr_clo1">
                                                <div class="wr_clo1 field-view" style="float:left; width:auto">@Model.NextOrder.DeliverPostnr</div>
                                                <div style="float:left; width:auto"> - </div>
                                                <div class="wr_clo1 field-view" style="float:left; width:auto">@Model.NextOrder.DeliverPosted</div>
