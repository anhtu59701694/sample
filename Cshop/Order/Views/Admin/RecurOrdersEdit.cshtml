    <section class="wr-line-eshop"></section>
}

<script type="text/javascript">
    var form = $('#editForm')[0];
    var currency = $('#@Html.IdFor(m => m.NextOrder.Currency)');

    form.customValidFields = function () {
        return true;
    };

    form.CustomLangFormSwitch = function (langcode, node, senderuid) {
        var ownerbox = node.closest('.row_content_box');
    };

    function odetailFormatData(dataExp) {

        var ret = [];
        if(dataExp)
            dataExp.forEach(function (itm) {
                if(itm.Key != 'bundlevariantids' && itm.Value) 
                    ret.push('<span class="name">' + dataJsonDic[itm.Key] + ':</span> <span class="value">' + itm.Value + ' </span>');
            });

        return (ret.length == 0 ? '' : '<ul class="data"><li>' + ret.join('</li>, <li>') + '</li></ul>');
    }

    function updatePickupPoint(){
        var pickupPointId = $('#PickupPointId');

        if(!pickupPointId.val()) return;

        var row = pickupPointId.data('kendoDropDownList').dataSource.data().find(function(rw){return rw.Value == pickupPointId.val();})

        if(!row || !row.Model) return;

        ajaxCmdStatus('@ModuleUrl.AdminUrl("Order", "UpdatePickupPoint", Model.OrderId)', {data: JSON.stringify(row.Model)},
            function(){
                $('.pickup-point-text').html(row.Text);
                pickupPointId.data('kendoDropDownList').value(null);
                $('.btn_change_pickuppoint').click();
            });
    }

    function gridOrderDetailCustom(grid) {

        $('.odetail-view a.grid-row-edit', grid.element).each(function () {
            if (parseInt($(this).attr('productid')) < 0) $(this).unbind('mousedown').removeAttr('href').css('cursor', 'default');
        });

        initImagePreview(false, grid.element);

        $('input.quantity[id]', grid.element).change(function(){
            var qty = parseInt($(this).val());
            if(qty >= 0){
                $(this).attr('data-bak', qty);
                $('.od-item[data-key=' + $(this).attr('data-key') + '] .orderdetail-form-field[binding=Quantity]', '#odetail-form').val(qty);

                var row = grid.dataItem($(this).closest('tr'));
                row.Quantity = qty;

                console.log('qty change', row);
            }
            else $(this).val($(this).attr('data-bak'));
        });
    }

    function odetailCurrencyToString(value) {
        return localizeCurrencyToString(value, currency.val());
    }

    function safePropImg(obj, propName) {
        return safeProp(obj, propName) || '@ImageModel.NoImg';
    }

    $(function() {
        $('#@Html.IdFor(m => m.Recurring)').change(function() {
            $('#RecurEachUnit').data('kendoDropDownList').value($(this).val());
        });

        gridorderdetailInit('#gridorderdetail', true);
    });

</script>
<script type='text/javascript'> var currencies = @Html.Raw(Json.Encode(ViewBag.Currencies)); initCurrencies(currencies); </script>

@helper RenderOrdersDetails()
{
    var settings = SettingsBiz.GetSettings();
    var dataJsonDic = new Dictionary<string, string>();

    if (settings.Hidden.OrderDetailDataJson && Model.NextOrder.OrderDetails.Any(m => m.DataExp != null))
    {
        foreach (IDictionary<string, object> itm in Model.NextOrder.OrderDetails.Where(m => m.DataExp != null).Select(m => m.DataExp))
        {
            foreach (var k in itm.Keys)
            {
                if (!dataJsonDic.ContainsKey(k)) { dataJsonDic.Add(k, ("odetail_datajson_" + k).ModLocalize(k)); }
            }
        }
    }
    
    var imgTemplate = "<a href='#:safePropImg(ProductImage,\"FsUrl\")#' class='preview'><img id='thumb_#:Id#' src='#:safePropImg(ProductImage,\"Thumb\")#'/></a>";
    var nameTempl = "<div class='odetail-view'><a class='grid-row-edit #:ProductDeleted ? 'deleted': '' # ' productid='#:ProductId#' href='javascript:void(0)' recontroller='Order' title='" + StringTable.Edit 
        + "' target='_blank'>#:ProductName#</a> <span class='odetail-sku' data-sku='#:(ProductSKU||'')#'>("
        + Html.LocalizeName(new OrderDetailModel(), m => m.ProductSKU)
        + "\\: #:(ProductSKU||'')#)</span><div class='odetail-datajson'>#=odetailFormatData(DataExp)#</div><div class='odetail-coupon'>#:ProductShippingTypeText#</div></div>";
    var priceExcTempl = "<span class='odetail-view'>#:odetailCurrencyToString(safeProp(Price,'Value'))#</span>";
    var totalExcTempl = "<span class='odetail-view'>#:odetailCurrencyToString(safeProp(Total_Exc,'Value'))#</span>";
    var totalIncTempl = "<div class='odetail-view'>#:odetailCurrencyToString(safeProp(Total_Inc,'Value'))#<div class='odetail-coupon' data-val='#:safeProp(CouponTotal,'Value')?1:0#'>#:odetailCurrencyToString(safeProp(CouponTotal,'Value'))#</div></div>";

    @Html.HiddenFor(m => m.NextOrder.Currency)
    <div class="wr_table_all" id="order-details" style="float: left; width: 100%; margin-bottom: 5px;">
        @(Html.LocalizeGridFor<OrderDetailModel>("gridorderdetail", "Product", "Delete", null, null, null, int.MaxValue, null, grid =>
        {
            grid.ButtonDelBigClass += "_odetail";
            grid.ButtonAddNewClass += "_odetail";
            grid.CheckBoxSelAllCss += "_odetail";
            grid.CheckBoxRowCssClass += "_odetail";
        })
        .DataSource(m => m.Id, Model.NextOrder.OrderDetails)
        //.ColumnCheckBox(m => m.Key)
        .Columns(grid => new[]
        {
            grid.Col(m => m.ProductImage, false, 50)
                .SetTemplate(imgTemplate)
                .SetCssClass("txt_align_c image"),

            grid.Col(m => m.ProductName, "Edit", m => m.ProductId)
                .SetTemplate(nameTempl)
                .SetCssClass("name-pro2"),

            grid.Col(m => m.Vat,false,70)
                .SetCssClass("td-right")
                .SetTemplate("<span class='odetail-view'>#:localizeFloatToString(Vat.Value*100,'n2')# %</span>"),

            grid.Col(m => m.Price, false, 120)
                .SetTemplate(priceExcTempl)
                .SetCssClass("td-right"),

            grid.Col(m => m.Quantity,false,80)
                .SetTemplate("<span class='odetail-view'><input name='Quantity' class='quantity' id='quantity-#:Id#' value='#:Quantity#' data-bak='#:Quantity#' data-key='#:ProductId#_#:VariantId||0#' type='number' min='0' max='10000' /></span>"),
            grid.Col(m => m.Total_Exc,false,140)
                .SetTemplate(totalExcTempl)
                .SetCssClass("td-right"),
            grid.Col(m => m.Total_Inc,false,140)
                .SetTemplate(totalIncTempl)
                .SetCssClass("td-right"),
        }.Where(x => x != null).ToArray())
        .Sortable(true)
        .Config(grid => { grid.CustomScript = "gridOrderDetailCustom"; })
        .ToMvcHtmlString())
    </div>
    <div id="odetail-form" style="display:none;">
        @for (var i = 0; i < Model.NextOrder.OrderDetails.Count; i++)
        {
            var idx = i;
            var itm = Model.NextOrder.OrderDetails[i];
            <div class="od-item" data-key="@(itm.ProductId)_@(itm.VariantId ?? 0)">
                @Html.SimpleHiddenFor(m => m.NextOrder.OrderDetails[idx].ProductId, new { @class = "orderdetail-form-field" })
                @Html.SimpleHiddenFor(m => m.NextOrder.OrderDetails[idx].VariantId, new { @class = "orderdetail-form-field" })
                @Html.SimpleHiddenFor(m => m.NextOrder.OrderDetails[idx].Quantity, new { @class = "orderdetail-form-field", @binding = "Quantity" })
            </div>
        }
    </div>
    <script type="text/javascript">var dataJsonDic = @Html.Raw(Json.Encode(dataJsonDic));</script>
}

@if ((Model.Status ?? 0).InList(RecurOrderStatus.Deleted)) 
{  
    <script type="text/javascript">
        formEnable(false);
        $(function () {
            $('.btn_save,.btn_reset', '.wr_submit_top.form-action-menu').closest('li').hide();
        });
    </script>
}