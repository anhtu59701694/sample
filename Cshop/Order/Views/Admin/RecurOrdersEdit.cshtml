                    </section>
                </section>
                <section>
                    <section class="wr_box_cube">
                        <section class="ui-widget">
                            <section class="ui-widget-content wr-box-new">
                                <div class="wr-content-ordt">
                                    <div class="info-section-block">
                                        <div>
                                            <div class="wr_clo1 txt-bold size14 txt-underline">@StringTable.PaymentInformation:</div>
                                            <div class="row_content none-first-pad order-view">
                                                <div class="wr_clo1">@StringTable.Payment: @Model.PaymentName - @Html.Raw(Model.NextOrder.PaymentCost.Value.ToOMoneyMc(Model.NextOrder))</div>
                                                <div class="wr_clo1">@StringTable.Shipping: @Model.ShippingName - @Html.Raw(Model.NextOrder.ShippingCost.Value.ToOMoneyMc(Model.NextOrder))</div>
