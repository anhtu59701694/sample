                                        <div class="order-view">
                                            <div class="wr_clo1 field-view">@Model.NextOrder.DeliverName</div>
                                            @if (!string.IsNullOrEmpty(Model.NextOrder.Customer.CompanyName))
                                            {
                                                <div class="wr_clo1">@StringTable.CompanyName: @Model.NextOrder.Customer.CompanyName</div>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.NextOrder.Customer.OrgNumber))
                                            {
                                                <div class="wr_clo1">@StringTable.OrgNumber: @Model.NextOrder.Customer.OrgNumber</div>
                                            }
                                            <div class="wr_clo1 field-view">@Model.NextOrder.DeliverAddress</div>

                                            @if (!string.IsNullOrEmpty(Model.NextOrder.DeliverMobile))
                                            {
                                                <div class="wr_clo1 field-view">@Model.NextOrder.DeliverMobile</div>
