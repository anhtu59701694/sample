                        <section>
                            @Html.LocalizeDropDownListKendoFor(m => m.Recurring, typeof(RecurringType).LocalizeEnumValues<int>(x => !disRecurs.Contains(x) || recurEaches.Any(z => z.Type == x)),
                                null, new { @class = "", @style = "float:left" })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(x => x.Recurring)</section>
                    </section>
                </section>
                <section class="controls">
                    <span class="text-eshop">@Html.LocalizeNameFor(x => x.RecurEach) (*)</span>
