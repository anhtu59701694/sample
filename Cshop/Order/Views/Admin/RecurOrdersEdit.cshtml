<style type="text/css">
    #editForm .wr_box_cube{width: 98%;}
    #editForm .ui-widget-content.wr-box-new{height: auto;}
    #editForm .ui-widget-content .row_content{min-height: 0;}
    #editForm .wr_clo1.field-view:empty{display: none}
    #editForm .bg-order-sum .row_content.field-view-box > div{margin-bottom: 5px;}
    #gridorderdetail .odetail-view .odetail-sku[data-sku=''] {display: none;}
    #gridorderdetail .odetail-view .odetail-coupon[data-val='0']{display: none;}
    #gridorderdetail input.quantity {width: 100% !important;margin: 0;text-align: center;}
    .btn_update_pickuppoint:disabled{background-color: lightgray;cursor:default;}
 
    .odetail-datajson ul{ list-style:none;}
    .odetail-datajson li{ display:inline-block;}
    .odetail-datajson .name{font-style:italic;font-size:smaller;color:blueviolet;}
    .odetail-datajson .value{font-style:italic;font-size:smaller;color:brown;}
    .odetail-datajson .value{font-style:italic;font-size:smaller;color:brown;word-wrap:anywhere;word-break:break-all;}
 
</style>

@using (@Html.BeginForm("Input", Html.GetController(), FormMethod.Post, new { @id = "editForm", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
