                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(x => x.FromDate)</section>
                    </section>
                </section>
                <section class="controls" style="display: none">
                    <span class="text-eshop">@Html.LocalizeNameFor(x => x.ToDate)</span>
                    <section>
                        <section>
                            @Html.LocalizeDateTextBoxFor(m => m.ToDate, Model.Id, new { @class = "", @style = "float:left" })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(x => x.ToDate)</section>
                    </section>
                </section>
                @{
                    var disRecurs = (settings.Hidden.RecurringTypesDisabled ?? "").Split(new[] {',', ';'}, StringSplitOptions.RemoveEmptyEntries)
                        .Select(x => (int)Enum.Parse(typeof(RecurringType), x)).ToList();
                    var recurEaches = (settings.Hidden.RecurringTypesRecurEach ?? "").Split(new[] { ',', ';' },
                            StringSplitOptions.RemoveEmptyEntries)
