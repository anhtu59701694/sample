@section MainTitleSection {
    @(StringTable.ManageRecurOrders)
}

@section CurrentTitleSection {
    <a href="/admin/modules/eshop/RecurOrder/">@(StringTable.ManageRecurOrders)</a>
}

@section TabTitleSection {
