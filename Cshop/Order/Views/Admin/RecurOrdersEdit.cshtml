                                                <div class="wr-order-left">@StringTable.ShippingHangdingExclVAT: </div>
                                                <div class="wr-order-right txt_align_r field-view">@Model.NextOrder.ShippingCostExc.Value.ToOMoneyMc(Model.NextOrder)</div>
                                            </div>
                                            <div class="row_content field-view-box">
                                                <div class="wr-order-left ">@StringTable.PaymentExclVat: </div>
                                                <div class="wr-order-right txt_align_r field-view">@Model.NextOrder.PaymentCostExc.Value.ToOMoneyMc(Model.NextOrder)</div>
                                            </div>
                                            <div class="row_content field-view-box" style="@(Model.NextOrder.TotalDiscount > 0 ? "" : "display:none")">
                                                <div class="wr-order-left ">@Html.LocalizeNameFor(m => m.NextOrder.TotalDiscount): </div>
                                                <div class="wr-order-right txt_align_r field-view">@Html.Raw(Model.NextOrder.TotalDiscountTxt)</div>
                                            </div>   
                                            <div class="row_content field-view-box" style="@(Model.NextOrder.TotalCoupon > 0 ? "" : "display:none")">
