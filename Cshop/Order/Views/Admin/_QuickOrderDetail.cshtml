@using System.Dynamic
@using Claw.Controls.DifferText
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Order
@model OrderModel
@{
    var raw = Model.GetRaw();
    var ctx = ClawContext.Current;
    var culture = System.Globalization.CultureInfo.GetCultureInfo(ctx.CurrentLanguage.LanguageCode);

    var currency = CurrencyMgr.Default.Code;
}


@if (Model != null) // && Model.OrderDetails.Any())
{
    var trackUrl = Model.GetRaw().GetShippingTrackingUrl();
    if (!trackUrl.IsNullOrEmpty())
    {
        <a id="shippingTrakingUrl" target="_blank" href="@Html.Raw(trackUrl)">@Html.Raw(trackUrl)</a>
    }
    @*
        <div id="order-@(Model.Id)" class="quick-view" style="display: none;">
            <div class="row_content">
                <p>
                    <b>
                        @Html.Raw("eshop_adm_orderdetail_productname, eshop".Localize())
                    </b>
                </p>
                <table border="0" cellpadding="0" cellspacing="0">
                    @foreach (var detail in Model.OrderDetails)
                    {
                        var vat = detail.Vat * 100;
                        var vatText = vat.ToString("N2", culture);
                        var total = detail.Price * detail.Quantity;
                        var totalInc = total * (1 + detail.Vat);
                        <tr>
                            <td>
                                <p>
                                    - @detail.Quantity
                                    @(string.IsNullOrEmpty(detail.ProductSKU) ? "" : string.Format("({0})", detail.ProductSKU))
                                    @detail.ProductName
                                    @if (!string.IsNullOrEmpty(detail.Tags))
                                    {
                                        @Html.Raw("(" + detail.Tags + ")")
                                    }

                                </p>
                            </td>
                            <td>
                                @Html.Raw("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;")
                                @detail.PriceInc.ToString("N2", culture) @currency
                            </td>
                        </tr>

                    }
                </table>
            </div>
            @if (!string.IsNullOrEmpty(Model.Comments))
            {
                <p>&nbsp;</p>
                <div class="row_content" style="min-height: 25px;">
                    <img src="/Claw/Sites/Default/Modules/EShop/Images/admin/icon-new.png" alt="note" />
                    <span>
                        @Html.Raw(Model.Comments)
                    </span>
                </div>
            }
            <p>&nbsp;</p>
        </div>
    *@
}