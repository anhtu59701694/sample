<script type="text/javascript">
    var form = $('#editForm')[0];

    form.customValidFields = function () {
        return true;
    };

    form.CustomLangFormSwitch = function (langcode, node, senderuid) {
        var ownerbox = node.closest('.row_content_box');
    };

    function dropdownGetData(node) {
        return node.data("kendoDropDownList").dataSource.get(node.val());
    }

    var bookingholder = '#editForm';
    var productId = $('#@Html.IdFor(m => m.ProductId)', bookingholder);
    var recNotiBox = $('#@Html.IdFor(m => m.RecipientNoti)', bookingholder).closest('li');
    var serCodBox = $('#@Html.IdFor(m => m.ServiceCod)', bookingholder).closest('li');
    var amountBox = $('#@Html.IdFor(m => m.Amount)', bookingholder).closest('.item');
    var codAccountBox = $('#@Html.IdFor(m => m.CodAccountNumber)', bookingholder).closest('.item');
    var recMobileBox = $('#@Html.IdFor(m => m.RecipientNotiMobile)', bookingholder).closest('.item');

    productId.change(function () {
        var value = $(this).val(), kdNode = $(this).data("kendoDropDownList"), holder = '#editForm';

        //console.log('productid', $(this).val(), kdNode);

        kdNode.dataSource.data().forEach(function (itm) {
            if (itm.Value == value) {

                console.log('product', itm);

                $('#@Html.IdFor(m => m.CustomerNum)', holder).val(itm.Model.CustomerNum);

                $('.service-box', holder).show();
                $('li.booking-service', holder).hide();
                $('.booking-service input[type=checkbox]:checked', holder).prop('check', false);

                if (itm.Model.IsNoti) recNotiBox.show().find('input[type=checkbox]').change();
                else recNotiBox.hide().find('input[type=checkbox]').change();

                if (itm.Model.IsCod) serCodBox.show().find('input[type=checkbox]').change();
                else serCodBox.hide().find('input[type=checkbox]').change();

                if ($('.booking-service:visible', holder).length == 0) $('.service-box', holder).hide();

            }
        });
    });

    recNotiBox.find('input[type=checkbox]').change(function () {
        if ($(this).prop('checked') && recNotiBox.is(':visible')) recMobileBox.show();
        else recMobileBox.hide();
        formDisableValidation(recMobileBox.find('input'), !recMobileBox.is(':visible'));
    });

    serCodBox.find('input[type=checkbox]').change(function () {
        if ($(this).prop('checked') && serCodBox.is(':visible')) { amountBox.show(); codAccountBox.show(); }
        else { amountBox.hide(); codAccountBox.hide(); }

        formDisableValidation(codAccountBox.find('input'), !codAccountBox.is(':visible'));
        formDisableValidation(amountBox.find('input'), !amountBox.is(':visible'));
    });

    setTimeout(function () {
        if (productId.val()) productId.change();
    }, 500);

    function validPostalCodeRecipient() {
        return validPostalCode('@Html.IdFor(m => m.RecipientPostalCode)', '@Html.IdFor(m => m.RecipientCity)',
            '@Html.IdFor(m => m.RecipientCountryCode)', 'CheckingPostnr');
    }

    function validPostalCode(postnrid, cityid, countryid, waitingId) {

        var postalCode = $('#' + postnrid), postalVal = $.trim(postalCode.val());
        var countryVal = safeProp(dropdownGetData($('#' + countryid)), 'Code');

        if (countryVal == '' || postalVal == '') return true;
        if (!postalCode[0].validPnr) postalCode[0].validPnr = {};

        var key = countryVal + '&' + postalVal;

        if (postalCode[0].validPnr.key == key && postalCode[0].validPnr.value) {
            //console.log('cached:', key, postalCode[0].validPnr);
            if (postalCodeOnResult(postnrid, cityid, postalCode[0].validPnr.value)) return true;
            else {
                postalCode.focus();
                return false;
            }
        }

        ajaxREST('/modules/eshop/BringShippingGuide/GetPostalCode', 'GET',
            { country: countryVal, pnr: postalVal }, waitingId,
            function (result) {
                if (result) {
                    if (!result.valid) result.result = '';
                    result.pnr = postalVal;
                    result.country = countryVal;
                    postalCode[0].validPnr = { key: key, value: result };
                    postalCodeOnResult(postnrid, cityid, result);
                }
            }, function (e) { console.log(e); });

        return true;
    }

    function postalCodeOnResult(postnrid, cityid, result) {
        var actCity = $('#' + cityid);
        var curCity = $.trim(actCity.val());

        if (curCity == '' || actCity.attr('bak-val') == curCity) {
            actCity.val(result.result);
            actCity.attr('bak-val', result.result);
            actCity.change();
        }

        formShowErrorMsg(postnrid, result.valid ? null : '@StringTable.ErrMsgInvalidPostalCode');
        return result.valid;
    }

</script>
