<div id="custsel-templ" style="display: none">
    @(Html.LocalizeGridFor<CustomerModel>("gridcustsel", "Customer", null, null, null, null, null, null, grid =>
    {
        grid.ButtonDelBigClass += "_cussel";
        grid.CheckBoxSelAllCss += "_cussel";
        grid.CheckBoxRowCssClass += "_cussel";
        grid.InputSearchId += "_custsel";
        grid.FormSearchId += "_custsel";
    })
    .DataSource(m => m.Id, "List", null, null, "gridCustSelGetParams")
    .Paging(4, new int[] { 10, 20, 30, 50, 100 }, StringTable.Products)
    .ColumnCheckBox(m => m.Id)
    .Columns(grid => new[] {
        grid.Col(m => m.DeliverName, "Edit", m => m.Id, true),
        grid.Col(m => m.DeliverAddress)
            .SetTemplate("#:DeliverAddress##=(DeliverAddress ? \",\" : \"\")# #:DeliverPostnr||\"\"# #:DeliverPosted||\"\"#" ),
        grid.Col(m => m.DeliverMobile, true),
        grid.Col(m => m.Email, true)
            .SetTemplate("<a class='k-grid-link' href='mailto\\:#:Email#'>#:Email#</a>"),
        grid.Col(m => m.CreatedDate.Text, m => m.CreatedDate, true, 130),
    })
    .Sortable(true)
    .Config(grid => { grid.CustomScript = "gridCustSelCustom"; })
    .ToMvcHtmlString(false, false))
</div>
<script type="text/javascript">

    $(function () {
        $('#gridcustsel').attr('id', 'gridcustsel-templ');
    });

    function gridCustSelCustom(grid) {
        
        $('input.row-checkbox_prosel', grid.element).click(function () {
            $('input.row-checkbox_prosel:checked', grid.element).prop('checked', false);
            $(this).prop('checked', true);
        })

        gridAdjustPopup(grid, '.wcontent', '.wr_clo1', 400, null, null, 40);
    }
    
    function gridCustSelGetParams() {
        return {};
    }

    function openAssignCustForm() {
        var width = Math.max(200, Math.min(1000, $(window).width() - 50));
        var height = Math.max(200, Math.min(2048, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#custsel-popup-form-templ").html());
        popTemplate.find('.htmlcontent .wr_table_all').html($('#gridcustsel-templ').clone().attr('id', 'gridcustsel').wrap('<p>').parent().html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.Customers', popTemplate.html(),
            width, height, [], null,
            function (modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');

                $('#gridcustsel #SelectAll', modal).attr('id', 'SelectAll_custsel').closest('div')
                    .find('label').attr('for', 'SelectAll_custsel');

                admincommon.hideMessage();

                gridcustselInit('#gridcustsel', true);

                var gridCustSel = $('#gridcustsel').data('kendoGrid');

                modal.find(".btn_save").click(function () {

                    var selCBox = $('.row-checkbox_cussel:checked', gridCustSel.element);
 
                    selCBox.each(function () {
                        var row = gridCustSel.dataItem($(this).closest('tr'));
                        
                        $('input[databind]', '#editForm').each(function () {
                            $(this).val(row[$(this).attr('databind')]);
                        });

                        $('#@Html.IdFor(m => m.CustomerId)').val(row.Id).change();
                    });
                   
                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close();
                    $(window).scrollTop(scrollTop);
                });
                modal.find(".btn_cancel").click(function () {

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close();
                    $(window).scrollTop(scrollTop);
                });
            });
    }

</script>
