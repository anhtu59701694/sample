@model DisplayModel
@{
    //page size
    IList<SelectListItem> itemsPageSize = new List<SelectListItem>();

    itemsPageSize.Add(new SelectListItem() { Text = "10", Value = "10", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "15", Value = "15", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "20", Value = "20", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "25", Value = "25", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "30", Value = "30", Selected = true });
    itemsPageSize.Add(new SelectListItem() { Text = "35", Value = "35", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "40", Value = "40", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "45", Value = "45", Selected = false });
    itemsPageSize.Add(new SelectListItem() { Text = "50", Value = "50", Selected = false });

    //format datime

    IList<SelectListItem> itemsFormatDate = new List<SelectListItem>();
    itemsFormatDate.Add(new SelectListItem() { Text = "dd.MM.yyyy HH:mm:ss", Value = "dd.MM.yyyy HH:mm:ss", Selected = true });
    itemsFormatDate.Add(new SelectListItem() { Text = "dd/MM/yyyy HH:mm:ss", Value = "dd/MM/yyyy HH:mm:ss", Selected = false });

    //get all font
    var lstFont = (from item in System.Drawing.FontFamily.Families
                   select new SelectListItem()
                   {
                       Value = item.Name,
                       Text = item.Name
                   }).ToList();
    //barcode type
    var barCodeType = (from Claw.Modules.Eshop.Helper.BarCodeType s in Enum.GetValues(typeof(Claw.Modules.Eshop.Helper.BarCodeType))
                       select new SelectListItem { Value = s.ToString(), Text = s.ToString() }).OrderBy(x => x.Text);
    var versionSetting = Claw.Modules.Eshop.Helper.VersionHelper.GetVersionSetting();
    bool usePowerOffice = versionSetting != null ? versionSetting.PowerOffice : false;
}
