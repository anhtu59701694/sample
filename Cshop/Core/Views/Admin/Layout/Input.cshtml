@if (ViewBag.UseImgPreview != null && ViewBag.UseImgPreview)
{
    <script type="text/javascript">

        function initEditImagePreview() {
            $("a.preview").fancybox({ width: 800, height: 600, autoScale: false, fitToView: true });
        }

        function initImagePreview(fancybox, holder) {
            var xOffset = -20, yOffset = 40, wSpace = 30, hSpace = 40;
            var items = $("a.preview[href!=''][href!='@Claw.Modules.Eshop.Models.ImageModel.NoImg']", holder);

            $("a.preview[href=''],a.preview[href='@Claw.Modules.Eshop.Models.ImageModel.NoImg']", holder).click(function () { return false; }).css({ 'cursor': 'default' });

            items.hover(function (e) {
                    this.t = this.title;
                    this.title = "";
                    var c = (this.t != "") ? "<br/>" + this.t : "";
                    $("body").append("<p id='imgPreview'><img src='" + this.href + "' alt='Image preview' />" + c + "</p>");
                    var topP = e.pageY - xOffset, leftP = e.pageX + yOffset;

                    var previewB = $("#imgPreview");
                    var bottomP = topP + previewB.height() - $(window).scrollTop() + wSpace;
                    if (window.innerHeight >= previewB.height() + wSpace) {
                        var remainHeight = bottomP - window.innerHeight;
                        if (remainHeight > 0) topP -= remainHeight;
                    }

                    var rightP = leftP + previewB.width() - $(window).scrollLeft() + hSpace;
                    if (window.innerWidth >= previewB.width() + hSpace) {
                        var remain = rightP - window.innerWidth;
                        if (remain > 0) leftP = e.pageX - yOffset - previewB.width();
                    }

                    $("#imgPreview").css("top", topP + "px").css("left", leftP + "px").fadeIn("slow");
                },
                //handlerOut (leave)
                function () {
                    this.title = this.t;
                    $("#imgPreview").remove();
                }
            );

            items.mousemove(function (e) {
                var topP = e.pageY - xOffset, leftP = e.pageX + yOffset;
                var previewB = $("#imgPreview");
                var bottomP = topP + previewB.height() - $(window).scrollTop() + wSpace;
                if (window.innerHeight >= previewB.height() + wSpace) {
                    var remainHeight = bottomP - window.innerHeight;
                    if (remainHeight > 0) topP -= remainHeight;
                }

                var rightP = leftP + previewB.width() - $(window).scrollLeft() + hSpace;
                if (window.innerWidth >= previewB.width() + hSpace) {
                    var remain = rightP - window.innerWidth;
                    if (remain > 0) leftP = e.pageX - yOffset - previewB.width();
                }

                $("#imgPreview").css("top", topP + "px").css("left", leftP + "px");
            });

            if (fancybox == undefined || fancybox) {
                items.fancybox({ width: 800, height: 600, autoScale: false, fitToView: true });
            } else items.click(function () { return false; }).css({ 'cursor': 'default' });
        };

    </script>

    @Html.CssBundle("~/content/plugin/fancybox/fancybox.css", "~/Content/plugin/fancybox/jquery.fancybox.css")
    <script src="~/Content/plugin/fancybox/jquery.fancybox.pack.js"></script>
}

@if (ViewBag.UseVideoImport != null && ViewBag.UseVideoImport)
{
    <script type="text/javascript">

        function getVideoInfo(url, apiKey, thumbWidth, thumbHeight, loadingImage, dataHandler, errorHandler) {
            if (/[\.\/]youtube\.com[\/\?]/i.test(url)) {
                getYouTubeVideo(url, apiKey, thumbWidth, thumbHeight, loadingImage, dataHandler, errorHandler);
            }
            else getVimeoVideo(url, thumbWidth, thumbHeight, loadingImage, dataHandler, errorHandler);
        }

        function getVimeoVideo(url, thumbWidth, thumbHeight, loadingImage, dataHandler, errorHandler) {

            ajaxREST('http://vimeo.com/api/oembed.json', 'GET', { url: url, width: thumbWidth, height: thumbHeight }, loadingImage,
                function (result, tag) {
                    //console.log(result);
                    if (result) {
                        var embedUrl = getVideoEmbedSrc(result.html), embeddable = true;
                        dataHandler(result.video_id, url, embedUrl, result.thumbnail_url, result.title, tranformVideoText(result.description), embeddable);
                    }
                },
                errorHandler);
        }

        function getYouTubeVideo(url, apiKey, thumbWidth, thumbHeight, loadingImage, dataHandler, errorHandler) {
            var apiUrl = 'https://www.googleapis.com/youtube/v3/videos';

            ajaxREST(apiUrl, 'GET', { id: getVideoId(url), key: apiKey, part: 'snippet,player,status' }, loadingImage,
                function (result) {
                    //console.log(result);
                    if (result && result.items && result.items.length > 0) {
                        var item = result.items[0], image = null, embedUrl = null, embeddable = true;
                        var snippet = item.snippet;

                        if (snippet && snippet.thumbnails) {
                            image = getVideoImgUrl(snippet.thumbnails.maxres, null, thumbWidth, thumbHeight);
                            image = getVideoImgUrl(snippet.thumbnails.standard, image, thumbWidth, thumbHeight);
                            image = getVideoImgUrl(snippet.thumbnails.high, image, thumbWidth, thumbHeight);
                            image = getVideoImgUrl(snippet.thumbnails.medium, image, thumbWidth, thumbHeight);
                            image = getVideoImgUrl(snippet.thumbnails.default, image, thumbWidth, thumbHeight);
                        }

                        if (item.player) embedUrl = getVideoEmbedSrc(item.player.embedHtml);
                        if (item.status) embeddable = item.status.embeddable;

                        dataHandler(item.id, url, embedUrl, image, snippet.title, tranformVideoText(snippet.description), embeddable);
                    }
                },
                errorHandler);
        }

        function getVideoImgUrl(image, url, width, height) {
            if (image && (!url || (image.width >= width && image.height >= height))) {
                return image.url;
            } else return url;
        }

        function getVideoId(url) {
            if (!url) return null;

            var regex = /[\.\/](youtube|vimeo)\.com(\/[a-z]+)*([?][^=]*)?[=\/]((\w|[\-]){4,})/i;
            var result = regex.exec(url);

            if (result && result.length > 4) return result[4];
            else return null;
        }

        function getVideoEmbedSrc(html) {
            if (html) {
                var node = $('<div>'); node.html(html);
                return node.find('[src]').attr('src');
            } else return null;
        }

        function tranformVideoText(text) {
            if (!text) return text;
            else return text.replace(/(\r?\n)/ig, '<br>\r\n');
        }

    </script>
}

@if (ViewBag.UseDropZone != null && ViewBag.UseDropZone)
{
    <script type="text/javascript">

        var dropzoneDragTimestamp = Date.now();

        function dropzoneInit(dzSelector, fileSelector, addSelector, options, resultHandler, errorHandler) {
            var optDefs = {
                url: '@ModuleUrl.AdminUrl(@Html.GetController(), "UploadImage", Model.Id.ToString())',
                clickable: false,
