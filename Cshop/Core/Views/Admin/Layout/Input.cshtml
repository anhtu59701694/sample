<script type="text/javascript">

    function ajaxREST(actionUrl, type, params, imgLoading, resultHandler, errorHandler, tag, dataType, contentType) {
        $.ajax({
            url: urlInjectFocusLang(actionUrl),
            type: type,
            data: params,
            dataType: dataType || 'json',
            contentType: contentType || 'application/x-www-form-urlencoded; charset=UTF-8',
            beforeSend: function () {
                if (imgLoading) $('#' + imgLoading).show();
                else { admincommon.hideMessage(); admincommon.showMask(); }
            },
            success: function (result) {
                resultHandler(result, tag);
            },
            error: function (e) {
                if (errorHandler) errorHandler(e);
                else admincommon.showMessageDefault('@(StringTable.AjaxCommandErrorMessage)', '@(ActionResultStatus.Fail)');
            },
            complete: function () { if (imgLoading) $('#' + imgLoading).hide(); else admincommon.hideMask(); }
        });
    }

    function ajaxCmd(actionUrl, params, resultHandler, tag, method) {
        $.ajax({
            url: (params && params['lang'] ? actionUrl : urlInjectFocusLang(actionUrl)),
            type: method || 'POST',
            data: params,
            beforeSend: function () { admincommon.hideMessage(); admincommon.showMask(); },
            success: function (result) {
                resultHandler(result, tag);
            },
            error: function (e) { admincommon.showMessageDefault('@(StringTable.AjaxCommandErrorMessage)', '@(ActionResultStatus.Fail)'); },
            complete: function () { admincommon.hideMask(); }
        });
    }

    function ajaxCmdStatus(actionUrl, params, resultHandler) {
        ajaxCmd(actionUrl, params, function (result) {
            if (result.Status == 0) {
                if (resultHandler) resultHandler(result);
            }
            if (result.Message != null) admincommon.showMessageDefault(result.Message, result.Status);
        });
    }

    function ajaxCmdHtml(actionUrl, params, resultHandler, tag, method) {
        ajaxCmd(actionUrl, params, resultHandler, tag, method);
    }

    function iconDropDownInit(id, value, items) {
        var templNam = '<table class="ext-icon-img" ><tr><td><img class="ext-icon-img" src="@(ModuleUrl.ExtIconPath.TrimStart('~').TrimEnd('/'))/#:Value#" /></td><td>#:Name#</td></tr></table>';
        var templVal = '<img class="selected-value ext-icon-img-val " src="@(ModuleUrl.ExtIconPath.TrimStart('~').TrimEnd('/'))/#:Value#" /><span>#:Name#</span>';

        $("#" + id).kendoDropDownList({
            dataTextField: "Name",
            dataValueField: "Value",
            headerTemplate: "",
            template: function (item) {
                if (item.Value == '') return item.Name;
                else return templNam.replace("#:Value#", item.Value).replace("#:Name#", item.Name);
            },
            valueTemplate: function (item) {
                if (item.Value == '') return item.Name;
                else return templVal.replace("#:Value#", item.Value).replace("#:Name#", item.Name);
            },
            dataSource: items,
            animation: false,
            index: 0,
            value: value,
            optionLabel: { Name: '@StringTable.SelectIcon', Value: '' },
            change: function (e) { },
            dataBound: function (e) { this.clawDataBound = true; }
        });
    }

    function iconDropDownSelect(id, prefixValues) {
        var dropdown = $("#" + id);

        for (var i = 0; i < prefixValues.length; i++) {
            var item = dropdown.find("option[value^='" + prefixValues[i] + "']");
            if (item.length > 0) {
                dropdown.data('kendoDropDownList').value(item.attr('value'));
                //console.log(id + ':' + dropdown.data('kendoDropDownList').value());
                break;
            }
        }
    }

    function gridMarkLangDisabled(grid, selector, cond) {
        $(selector, grid.element).each(function () {
            var row = grid.dataItem($(this).closest("tr"));
            if (cond(row)) {
                $(this).addClass('item-lang-disabled');
                var title = $(this).attr('title');
                $(this).attr('title', (title ? title + ', ' : '') + '@(StringTable.ItemLanguageDisabled)');
            }
        });
    }

    function gridDisableCheckBox(grid, cond, checkboxSelector) {
        $(checkboxSelector || '.row-checkbox', grid.element).each(function () {
            if (cond(grid.dataItem($(this).closest("tr")))) {
                $(this).removeClass("row-checkbox");
                $(this).closest("div").find('input[type=checkbox]').prop('disabled', true);
            }

            $(this).closest("td").css({ 'padding': '0px', 'min-width': '35px' });
        });
    }

    function gridHideCell(grid, selector, cond) {
        $(selector, grid.element).each(function () {
            var rw = grid.dataItem($(this).closest("tr"));
            if (cond(rw)) $(this).hide();
        });
    }

    function initGridStatusAction(grid, selector, actionUrl, getterStatus, setterStatus, getterCmdParams) {

        var titleEnable = '@(StringTable.ItemEnableTitle)';
        var titleDisable = '@(StringTable.ItemDisableTitle)';

        $(selector, grid.element).each(function () {

            var rdata = grid.dataItem($(this).closest("tr"));
            var ritmA = $(this).find('a');
            var status = getterStatus(rdata);

            ritmA.addClass(status ? 'enable' : 'disable');
            ritmA.attr('title', status ? titleDisable : titleEnable);

            $(this).unbind('click').click(function (e) {
                var row = grid.dataItem($(this).closest("tr"));
                var itm = $(this).find('a');

                setterStatus(row, !getterStatus(row));

                if (typeof (actionUrl) == 'string') ajaxCmd(actionUrl, getterCmdParams(row));
                else actionUrl($(this), row);

                if (getterStatus(row)) {
                    itm.removeClass("disable");
                    itm.addClass("enable");
                    itm.attr('title', titleDisable);
                } else {
                    itm.removeClass("enable");
                    itm.addClass("disable");
                    itm.attr('title', titleEnable);
                }
            });
        });
    }

</script>

@if (ViewBag.UseCKEditor != null && ViewBag.UseCKEditor)
{
    @Html.JsBundle("~/js/editor", true, 100)

    <script type="text/javascript">

        function initEditor(inputNode) {
            if (!$.fn.clawEditor) setTimeout(initEditor, 100);
            else {
                var arr = (inputNode ? inputNode : $('.ckeditor_standard,.ckeditor_simple'));
                arr.each(function () {
                    var ckHeight = $(this).attr('ck_height'), item = $(this);
                    if (!item.hasClass('ckeditor-inst')) {
                        if (item.hasClass('ckeditor_simple') || item.hasClass('sub_ckeditor_simple')) {
                            item.clawEditor('simple', { height: ckHeight ? ckHeight : '120px' });
                        }
                        else item.clawEditor('basic', { height: ckHeight ? ckHeight : '200px' });
                        item.addClass('ckeditor-inst');

                        CKEDITOR.instances[item.attr('id')].on('blur', function (e) {
                            item.val($.trim(e.sender.getData())); item.valid();
                        });
                    }
                });
            }
        }

        function termEditor(inputNodes) {
            if (CKEDITOR && CKEDITOR.instances) {
                inputNodes.each(function () {
                    try {
                        $(this).removeClass('ckeditor-inst');
                        CKEDITOR.instances[$(this).attr("id")].destroy();
                    }
                    catch (e) {
                        console.log(e);
                    }
                });
            }
        }

        $(function () { initEditor(); });

    </script>
}

