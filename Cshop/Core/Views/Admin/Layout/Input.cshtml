        function listViewFormFieldChange(node, type, listViewId, formDataKeyAttr) {
            var keyVal = $(node).closest('.multi-lang-item-form').attr(formDataKeyAttr);
            var data = kendoListViewGetItem(listViewId, 'data-key', keyVal);

            if (data && type == 'Title') {
                data.Model.Title = $.trim($(node).val());
                data.Element.find('.title').html(data.Model.Title + '&nbsp;');
                data.Element.find('img').attr('alt', data.Model.Title);
                data.Element.attr('title', data.Model.Title);
            }
        }

        function kendoListViewOnOffPager(id) {
            var listView = $('#' + id).data('kendoListView');

            if (listView.dataSource.total() <= listView.dataSource.options.pageSize) {
                listView.pager.element.hide();
            } else listView.pager.element.show();

            listView.pager.element.addClass('listview-pager');

            setTimeout(function () {
                $('#' + id + ' .listview-item table .item').each(function () {
                    var par = $(this).parent();
                    if (par.length > 0 && par[0].offsetWidth) {
                        $(par[0]).find('.title').css('width', par[0].offsetWidth);
                    }
                });
            }, 100);
        }

        function kendoListViewRefreshPager(id) {
            var listView = $('#' + id).data('kendoListView');
            if (listView.pager.page() > listView.pager.totalPages()) {
                listView.pager.page(listView.pager.totalPages());
            }
        }

        function kendoListViewAddItem(id, item, argTag, cmdUrl, cmdArgs, formListSelector, itemSelector, itemAttr) {

            ajaxCmd(cmdUrl, cmdArgs,
                function (result, customTag) {
                    if (result && result.length > 0) {
                        var data = $('#' + id).data('kendoListView').dataSource.data();
                        var formLst = $(formListSelector);
                        data.unshift(customTag.item);
                        formLst.append(result);
                        formUpdateValidRules(formLst.find('.multi-lang-item-form').last());
                        $('#' + id + ' li').each(function () {
                            if ($(this).find(itemSelector).attr(itemAttr) == customTag.tag) {
                                $(this).click();
                            }
                        });
                    }
                    else {
                        admincommon.showMessageDefault('@(StringTable.ErrLimitCountMessage)', '@(ActionResultStatus.Fail)');
                    }
                }, { tag: argTag, item: item });
        }

        function kendoListViewBindDelBtn(id, btnTag, formSelector, formKeyAttr, langTabSelector, getKeyHandler) {
            $('#' + id + ' li').each(function () {
                $(this).find(btnTag).unbind('click').click(function () {
                    var listView = $('#' + id).data('kendoListView');
                    var data = listView.dataSource.data();
                    var item = $(this).closest('li');
                    var row = listView.dataSource.getByUid(item.attr('data-uid'));
                    $(formSelector).each(function () {
                        if ($(this).attr('data-id') == row.Id && $(this).attr(formKeyAttr) == getKeyHandler(row)) {
                            data.remove(row);
                            kendoListViewRefreshPager(id);
                            var input = $(this).find('input,textarea');
                            input.val(''); input.attr('datavalid', 0);
                            if ($(this).is(':visible')) {
                                $(langTabSelector).hide();
                            }
                            $(this).hide();
                        }
                    });
                });
            });
        }

        function kendoListViewBindItemClick(id, itemSelector, formSelector, formKeyAttr, langTabSelector, getKeyHandler) {
            $('#' + id + ' li').unbind('click').click(function () {
                var selUId = $(this).attr('data-uid');
                $('#' + id + ' li').each(function () {
                    var itm = $(this).find(itemSelector);
                    if (selUId == $(this).attr('data-uid')) itm.addClass('selected');
                    else itm.removeClass('selected');
                });

                var listView = $('#' + id).data('kendoListView');
                var row = listView.dataSource.getByUid(selUId);
                $(formSelector).each(function () {
                    if ($(this).attr('data-id') == row.Id && $(this).attr(formKeyAttr) == getKeyHandler(row)) {
                        //$(this).show(); $(langTabSelector).show();
                        var langCode = activeLang;//$(langTabSelector).find('.langItem.selected').attr('data-lang');
                        multilangformSetActive($(this), langCode, formSelector, '.lang_form', langTabSelector);
                    }
                    else $(this).hide();
                });
            });
        }

        function multilangformSetActive(itemFormNode, langcode, formListSelector, langFormSelector, langTabSelector) {
            //console.log(itemFormNode);
            if (itemFormNode.length == 0) return;

            $(formListSelector).each(function () { $(this).hide(); });
            var langTabItems = $(langTabSelector).find('.langItem');
            //console.log(itemFormNode.find(langFormSelector));
            itemFormNode.find(langFormSelector).each(function () {
                if ($(this).attr('data-lang') == langcode) {
                    $(this).show();
                    itemFormNode.show();
                    $(langTabSelector).show();
                }
                else {
                    $(this).hide();
                    multilangformMarkDataStatusEx($(this), langTabItems);
                }
            });
        }

        function multilangformMarkDataStatusEx(langForm, langItems) {

            var langCode = langForm.attr('data-lang');

            langItems.each(function () {
                if ($(this).attr('data-lang') == langCode) {
                    if (langFormIsEmpty(langForm)) {
                        $(this).find('i').removeClass('dot_flag');
                    }
                    else $(this).find('i').addClass('dot_flag');
                }
            });
        }

        function kendoListViewGetItem(id, keyAttr, keyValue) {

            var listView = $('#' + id).data('kendoListView'), fItem = null;

            $('#' + id + ' li').each(function () {
                var uId = $(this).attr('data-uid');
                if ($(this).attr(keyAttr) == keyValue) {
                    fItem = { Element: $(this), Model: listView.dataSource.getByUid(uId) };
                }
            });

            return fItem;
        }

    </script>
}

<script type="text/javascript">

    function mapAction(action, autoController) {
        @{ var mapQArgs = new QParam(); }

        if (autoController) {
            @{ mapQArgs.Id = mapQArgs.ReId; mapQArgs.ReId = null;}
            return '@ModuleUrl.AdminUrl(QParam.GetReController() ?? controller, "")/' + action + '@Html.Raw(mapQArgs.ToString(false, true))';;
        }
        else {
            @{ mapQArgs.Id = null;}
            return '@ModuleUrl.AdminUrl(controller, "")/' + action + '@Html.Raw(mapQArgs.ToString(false, true))';
        }
    }

    $().ready(function () {
        initValidateInput();

        $('#editForm').attr('action', $('#editForm').attr('action') + '@Html.Raw(QParam.Args(false, false))');

        $('.btn_save').click(function () {
            focusInputs();

            var retCode = validateSubmit(null, null, function (emptyLForms) {
                var dialog = new ClawDialog('modal-mask');
                var title = '@StringTable.Confirmation';
                var content = $('#popupAutoFillLangForm').html();
                var kendoWindow = dialog.showDialog(title, content, 350, 150);
                var promptMsg = kendoWindow.find('.prompt-mess');

                var langNames = '';
                emptyLForms.each(function () {
                    langNames += (langNames.length == 0 ? '' : ', ') + $(this).attr('data-lang-name');
                });

                promptMsg.html(promptMsg.html().replace('{0}', langNames));

                kendoWindow.find('.btn_yes').click(function () {
                    var activeLForm = $('#lang-form-list .lang_form[active-lang=1]');
                    emptyLForms.each(function () { langFormCopy(activeLForm, $(this)); });
                    dialog.close();

                    if (validateSubmit()) { admincommon.showMask(); $('#editForm')[0].submit(); }
                    else $(this).focus();
                });
                kendoWindow.find('.btn_no').click(function () { dialog.close(); });
            });

            if (retCode == 1) {
                admincommon.showMask(); $('#editForm')[0].submit();
            } else $(this).focus();
        });

        $('.form-action-menu .btn_delete').click(function () {
            var dialog = new ClawDialog("modal-mask");
            var kendoWindow = dialog.showDialog("@(StringTable.Confirmation)", $("#delete-confirmation").html(), 350, 150);

            kendoWindow.find(".delete-cancel").click(function () { dialog.close(); });
            kendoWindow.find(".delete-confirm").click(function () {
                $.ajax({
                    url: mapAction('delete', false),
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify([{ id: $('#Id', '#editForm').val(), grid: '' }]),
                    beforeSend: function () { dialog.close(); admincommon.hideMessage(); admincommon.showMask(); },
                    success: function (result) {
                        if (result.Status == 0) $(location).attr('href', mapAction('index', true));
                        else if (result.Message) admincommon.showMessageDefault(result.Message, result.Status);
                    },
                    error: function (errorResult) { admincommon.showMessageDefault('@(StringTable.AjaxDeleteErrorMessage)', '@(ActionResultStatus.Fail)'); },
                    complete: function () { admincommon.hideMask(); }
                });
            });
        });

        $('.form-action-menu .btn_reset').click(function () {
            var form = $('#editForm')[0], validator = $(form).validate(); form.reset(); focusInputs();

            $(form).getFormFields('textarea').each(function (i, e) {
                var val = $(e).val(); var editor = CKEDITOR.instances[e.id];
                if (editor != null) editor.setData(val);
            });

            var fields = $(form).getFormFields(), arrInputs = [];
            for (var i = 0; i < fields.length; i++) {
                var element = $(fields[i]);
                if (element.is('input:text,input:radio,input:checkbox,textarea,select')) {
                    if (element.attr('id')) arrInputs.push(element.attr('id'));
                }
            }

            setTimeout(function () {
                arrInputs.forEach(function (itm) { $('#' + itm).change(); });
            }, 500);

            $('.field-validation-error:parent').html('');
            focusInputs();

            $(this).focus();

            admincommon.hideMessage();

            if (!$(form).valid()) validator.hideThese(validator.toShow);

            setTimeout(function () {
                for (var i = 0; i < form.length; i++) {
                    var element = $(form[i]);
                    if (element.is('input[type!=hidden],textarea,select')) {
                        showRequireAsterisk(element, false);
                        if (!element.valid()) validator.hideThese(validator.toShow);
                    }
                }
            }, 1000);
        });
       
        
        $('.form-action-menu .btn_cancel').click(function () {
            if ('@(isFrontEnd)' === 'True') {
                if (parent != null && parent.jQuery.fancybox != null) {
                    parent.jQuery.fancybox.close();
                }
            }else $(location).attr('href', mapAction('index', true));
        });

        initFieldLeftCharCountStat();
        initUrlHandle();
    });

    function initUrlHandle(holder) {
        $('input.url-handle', holder).change(function () {
            var urlLangs = JSON.parse(@Html.Raw(Json.Encode(ModuleUrl.GetFrontEndViewUrls(controller, "", Model))));
            var url = location.origin + urlLangs[$(this).attr('lang')];
            url = url.substring(0, url.length - 1) + $.trim($(this).val());
            $('.url-handle', $(this).closest('.lang_form')).each(function() {
                if (!$(this).is('input')) $(this).attr('href', url).text(url);
            });
        }).change();
    }

    function initFieldLeftCharCountStat(owner) {
        $('.text-eshop-ita-2.char-count-stat', owner).each(function () {
            var label = $(this);
            var node = $(this).closest('.controls').find('input[type=text]');

            var updateText = function () {
                var maxlen = node.attr('data-val-length-max'), val = node.val();
                var text = '@StringTable.CharLeftHint';
                label.text(text.replace('{0}', val.length).replace('{1}', maxlen));
            };

            node.keyup(function () { updateText(); });
            updateText();
        });
    }

    function initValidateInput(formNode) {
        var arr = (formNode ? formNode.find('.js-required') : $('.js-required'));
        arr.change(function (event) {
            var ele = $(event.target);
            if (ele.length > 0) {
                var rule = $.validator.staticRules(ele[0]);
                if (rule && rule.required) {
                    var errNode = ele.closest('section').find('.error');
                    if (getInputVal(ele).length == 0) errNode.show();
                    else errNode.hide();
                }
            }
        });
    }

    function validateSubmit(formNode, remoteValid, emptyLangFormHandler) {

        $('.field-validation-error:parent', formNode || $('#editForm')).html('');

        enableRemoteValidate = (remoteValid == null ? true : remoteValid);
        firstErrorInputElement = null;

        var editForm = $('#editForm');
        var arrInputs = (formNode ? formNode.find('input:text,textarea') : editForm.getFormFields('input:text,textarea'));

        arrInputs.each(function () {
            trimInputVal($(this));
            inputCopyValid($(this), true);
        });

        var langFormValid = null, activeForm = null, dataForm = null, emptyLangForms = [];
        var arrForms = (formNode ? formNode : $('#lang-form-list .lang_form'));
        arrForms.each(function () {
            var zeroId = $(this).find('.lang_form_id').val() == '0'; var count = 0;
            var isActiveForm = ($(this).attr('active-lang') == '1');

            $(this).find('.lang_form_field[type!=hidden]').each(function () {
                var value = getInputVal($(this));

                if (($(this).hasClass('bool-def-false') && value == 'false')
                    || ($(this).hasClass('bool-def-true') && value == 'true')) value = '';

                if (!$(this).hasClass('no-empty-check') && value.length != 0) count++;
            });

            $(this).find('.js-required').each(function () {
                $(this).attr('datavalid', count == 0 && !isActiveForm && !formNode ? 0 : (zeroId ? 2 : 1));
            });

            if ($(this).is(':visible')) activeForm = $(this);

            if (count != 0) {
                if (zeroId) dataForm = $(this);
                else langFormValid = $(this);
            } else {
                $(this).find('.field-validation-error:parent').html('');
                if (!formNode) emptyLangForms.push(this);
            }
        });

        if (!langFormValid && (dataForm || activeForm)) {
            (dataForm ? dataForm : activeForm).find('.js-required').each(function () {
                $(this).attr('datavalid', 2);
            });
        }

        var valid = true; var form = editForm[0]; var lastErrInput = null, lastErrRequiredField = false, firstErrInput = null;
        var arrRequire = (formNode ? formNode.find('.js-required') : editForm.getFormFields('.js-required'));
        arrRequire.each(function () {
            var datavalid = $(this).attr('datavalid');
            if (getInputVal($(this)).length == 0 && (!datavalid || datavalid != '0')) {
                showRequireAsterisk($(this), true, false);
                lastErrRequiredField = true; valid = false;
                if (!lastErrInput || $(this).closest('.lang_form').css('display') != 'none') {
                    lastErrInput = $(this); if (!firstErrInput) firstErrInput = $(this);
                }
            } else showRequireAsterisk($(this), false);
        });

        if (!formNode && form.customValidFields) valid = form.customValidFields() && valid;

        var chkForm = (formNode ? formNode : $(form));
        var arrFValidPar = (formNode ? formNode.find('.field-validation-error:parent') : $('.field-validation-error:parent'));

        if (chkForm.length != 0) {
            var fields = chkForm.getFormFields();
            for (var i = 0; i < fields.length; i++) {
                var element = $(fields[i]), datavalid = element.attr('datavalid');
                var optField = !element.hasClass('js-required') && element.is('input:text,textarea,input[type=number]');
                var optFHasVal = optField && element.val().length > 0;
                if (!element.is('form') && (!datavalid || datavalid != '0' || optFHasVal) && !element.valid()) {
                    valid = false; showRequireAsterisk(element, true, false);
                    if (!lastErrInput || element.closest('.lang_form').css('display') != 'none') {
                        lastErrInput = element; if (!firstErrInput) firstErrInput = element;
                    }
                }
            }
        }

        arrInputs.each(function () { inputCopyValid($(this), false); });

        enableRemoteValidate = true;

        if (valid && arrFValidPar.find('span').length == 0) {
            var lfVisibles = $(emptyLangForms).find('.lang_form_visible[value=True]');
            if (lfVisibles.length > 0) {
                if (emptyLangFormHandler) emptyLangFormHandler(lfVisibles.closest('.lang_form'));
                return 2;
            }
            return 1; //true
        }
        else {
            showFailedValidMsg(lastErrRequiredField);
            if (!lastErrInput && arrFValidPar.length > 0) {
                lastErrInput = inputFromErrSpan($(arrFValidPar[0]));
            }
            console.log('valid-failed', lastErrRequiredField, lastErrInput);
            var errLangForm = (lastErrInput ? lastErrInput.closest('.lang_form') : null);
            if (errLangForm && errLangForm.length != 0) langFormFocus(errLangForm);

            firstErrorInputElement = lastErrInput = firstErrInput || lastErrInput;

            if (lastErrInput) setTimeout(function () { focusInput(lastErrInput); }, 2000);

            return 0;//false;
        }
    }

    function focusInputs() {
        //$('#editForm').getFormFields('input:text').each(function () { $(this).focus(); });
    }

    function focusInput(node) {
        if (node.is(':visible')) node.focus();
        else {
            if (node.hasClass('kendo-dropdownlist')) node.closest('.k-dropdown').focus();
            else if (node.hasClass('kendo-numeric'))
                node.closest('.k-numerictextbox').find('input').focus();
            else console.log('focusInput skip hidden input');
        }
    }

    function trimInputVal(node) {

        if (node.is('input:text,textarea')) {
            node.val($.trim(node.val()));
        }
    }

    function inputCopyValid(node, isCopy) {
        if (node.is('textarea') && isNodeCKEditor(node)) {
            if (isCopy) {
                node.attr('valid-origin-val', node.val());
                node.val(getInputVal(node));
            } else node.val(node.attr('valid-origin-val'));
        }
    }

    function getInputVal(node) {
        if (isNodeCKEditor(node)) {
            var ckNode = CKEDITOR.instances[node.attr('id')];
            if (ckNode) {
                return $.trim(ckNode.getData());
            }
        }

        if (node.attr('type') == 'radio') {
            var radio = $("input:radio[name='" + node.attr('name') + "']:checked");
            //console.log('get:' + node.attr('id') + ':' + node.attr('name') + ':' + radio.val());
            return $.trim(radio.val());
        }

        return $.trim(node.val());
    }

    function setInputVal(node, value) {
        if (isNodeCKEditor(node)) {
            var ckNode = CKEDITOR.instances[node.attr('id')];
            if (ckNode) { ckNode.setData(value); return; }
        }

        if (node.attr('type') == 'radio') {
            var radio = $("input:radio[name='" + node.attr('name') + "'][value=" + value + "]");
            //console.log('set:'+node.attr('id') +':'+node.attr('name') + ':' + value);
            radio.prop("checked", true);
            return;
        }

        node.val(value);
    }

    function isNodeCKEditor(node) {
        return window.CKEDITOR && CKEDITOR.instances &&
        (
            node.hasClass('ckeditor_standard') || node.hasClass('sub_ckeditor_standard') ||
                node.hasClass('ckeditor_simple') || node.hasClass('sub_ckeditor_simple')
        );
    }

    function showRequireAsterisk(inputNode, show, focus) {
        var errSpan = inputNode.closest('section').find(".error:contains('*')");
        if (show) {
            errSpan.css('font-weight', 'bold');
            errSpan.show();
            if (focus == null || focus) inputNode.focus();
            console.log('required', inputNode);
        } else errSpan.hide();
    }

    function showFailedValidMsg(requiredField) {
        admincommon.showMessageDefault(requiredField ? '@(StringTable.ErrValidateRequireFieldMsg)' : '@StringTable.ErrValidateFailedMessage', '@(ActionResultStatus.Fail)');
    }

    function showFailedValidMsgText(requiredField, mgs) {
        admincommon.showMessageDefault(requiredField ? '@(StringTable.ErrValidateRequireFieldMsg)' : mgs, '@(ActionResultStatus.Fail)');
    }

    function inputFromErrSpan(node) {
        return $('#' + node.attr('data-valmsg-id'));
    }

    function initKendoNumeric(selector, options) {

        var nodes = $(selector);

        nodes.each(function () {
            
            $(this).kendoNumericTextBox($.extend({
                culture: getFocusLang(),
            }, options || {}));

            var nodeKd = $(this).data('kendoNumericTextBox');

            if (nodeKd) nodeKd.options.originValue = nodeKd.value();

            if ($(this).hasClass('js-required'))
                $(this).closest('.k-numerictextbox')
                    .removeClass('js-required')
                    .find('.js-required:visible').removeClass('js-required');
        });
    }

</script>

<script type="text/javascript">
    var form = $('#editForm')[0];

    form.langFormSwitch = langFormSwitch;

    var uidIseq = 1;
    $('.row_content_box').each(function () {
        $(this).attr('data-uid', uidIseq++);
    });

    $('#lang-form-list').find('.lang_form:visible').each(function () {
        $(this).attr('active-lang', 1); activeLang = $(this).attr('data-lang');
    });

    $(".inputLang .langItem .inline-flag").each(function () {
        var langItem = $(this).closest('.langItem'), contentBox = $(this).closest('.row-content-lang-box');
        var chkBox = langItem.find('input[type=checkbox]'), cmdBox = langItem.find('.lang-cmd-box');

        chkBox.change(function () {
            var checked = $(this).prop('checked'), langCode = langItem.attr('data-lang');
            contentBox.find('.lang_form_visible[lang=' + langCode + ']').val(checked ? 'True' : 'False');
            if (checked && !langItem.is('.active-lang')) cmdBox.show(); else cmdBox.hide();
        });

        if (!langItem.is('.active-lang'))
            $(this).unbind("click").click(function () {
                if ($(this).closest('ul').hasClass("tab-big-2")) {
                    langFormTranslate(langItem.attr('data-lang'), langItem);
                } else langFormTranslate(langItem.attr('data-lang'), langItem);
            });
    });

    var anyErrOwnerVisible = false, lastErrHiddenLangForm = null, lastErrInput = null;

    $('.field-validation-error:parent').each(function () {
        var errLangForms = $(this).closest('.lang_form,.multi-lang-item-form');
        lastErrInput = inputFromErrSpan($(this));
        if (errLangForms.length > 0 && form.langFormSwitch) {
            //$(this).attr('show-err', '1');
            lastErrHiddenLangForm = $(errLangForms[0]);
            //form.langFormSwitch($(errLangForms[0]).attr('data-lang'), $(errLangForms[0]));
        }
        if (errLangForms.length == 0 || errLangForms.is(':visible')) anyErrOwnerVisible = true;
    });

    if (!anyErrOwnerVisible && lastErrHiddenLangForm && lastErrInput) {
        if (lastErrHiddenLangForm.is('.multi-lang-item-form')) lastErrHiddenLangForm.show();
        else langFormFocus(lastErrHiddenLangForm);
        setTimeout(function () {
            lastErrHiddenLangForm.find('input,textarea,select').focus();
            focusInput(lastErrInput);
        }, 3000);
    }
    else if (lastErrInput) setTimeout(function () { focusInput(lastErrInput); }, 3000);

    function langFormFocus(langform) {
        //console.log($('.field-validation-error:parent'));
        var holder = langform.closest('.multi-lang-item-form, #lang-form-list');
        var langTabs = null;
        //console.log(holder, langform.is(':visible'), langform.attr('data-lang'));
        if (holder.length == 0) return;

        if (holder.is('.multi-lang-item-form')) {
            holder.parent().find('.multi-lang-item-form').each(function () { $(this).hide(); });

            holder.show();
            langTabs = holder.closest('.row_content_box').find('.lang-tabs');
            langTabs.show();
        } else langTabs = $('.tab-big-2');

        if (!langform.is(':visible')) {
            var langCode = langform.attr('data-lang');
            var langItem = langTabs.find(".inputLang .langItem[data-lang='" + langCode + "']");
            setTimeout(function () { langItem.click(); }, 2000);
        }
    }

    function langFormMarkDataStatus() {
        $('#lang-form-list').closest('.row-content-lang-box').find('.tab-big-2 .langItem').each(function () {
            var langForm = $('#lang-form-list').find('.lang_form[data-lang=' + $(this).attr('data-lang') + ']');
            var chkBox = $(this).find('input[type=checkbox]'), langVisible = langForm.find('.lang_form_visible');
            var chkChecked, dataValid = langForm.attr('data-valid');
            if (dataValid == '1' || !langFormIsEmpty(langForm)) {
                $(this).find('i').addClass('dot_flag');
            } else $(this).find('i').removeClass('dot_flag');
            //console.log('uuu', langVisible.val(), langVisible, langVisible.val() == 'True');
            chkChecked = (dataValid != '0' || chkBox.prop('disabled') || $(this).is('.active-lang')) && (langVisible.length == 0 || langVisible.val() == 'True');
            //console.log('uuu2', chkChecked, dataValid, $(this).is('.active-lang'), $(this));
            //chkBox.prop('checked', chkChecked); 
            chkBox.change();
        });
    }

    $(function () { langFormMarkDataStatus(); });

    function langFormTranslate(langcode, node) {
        var translateMaxWidth = parseInt('@(ViewBag.TranslateMaxWidth ?? 800)');
        var translateMaxHeight = parseInt('@(ViewBag.TranslateMaxHeight ?? 520)');
        var width = (window.innerWidth - 40 <= translateMaxWidth ? window.innerWidth - 40 : translateMaxWidth);
        var height = (window.innerHeight - 40 <= translateMaxHeight ? window.innerHeight - 40 : translateMaxHeight);

        var ownerbox = node.closest('.row-content-lang-box');
        var formList = null, activeForm = null, langForm = null, initHandler = null, saveHandler = null;

        if (ownerbox.find('#lang-form-list').length != 0) {
            formList = $('#lang-form-list');
            activeForm = formList.find('.lang_form:visible');
            langForm = formList.find('.lang_form[data-lang=' + langcode + ']');
            initHandler = function (modal) { };
            saveHandler = function (modal, formNode) {
                setTimeout(function () { langFormMarkDataStatus(); }, 500);
            };
        }
        else {
            var itembox = ownerbox.find('.multi-lang-item-form:visible');
            activeForm = itembox.find('.lang_form:visible');
            langForm = itembox.find('.lang_form[data-lang=' + langcode + ']');

            width = 500; height = 240; formList = itembox;
            initHandler = function (modal) {
                modal.find(".htmlcontent").css('display', 'inline-block');
                modal.find(".wcontent").css('text-align', 'center');
                modal.find(".lang_form_td_full").css('width', 'inherit');
            };

            closeHandler = function (modal) {
                modal.find(".lang_form_td_full").css('width', '100%');
            };
            saveHandler = function (modal, formNode) {
                multilangformMarkDataStatusEx(formNode, ownerbox.find('.inputLang .langItem'));
            };
        }
        //console.log(activeForm); console.log(langForm);
        if (activeForm.length > 0 && langForm.length > 0) {
            langFormTranslateRaw(formList, activeForm, langForm, width, height, initHandler, saveHandler);
        }
    }

    function langFormTranslateRaw(formList, activeForm, langForm, width, height, initHandler, saveHandler) {

        if (!validateSubmit(activeForm, false)) return;

        if (window.clawInitMsTranslator) window.clawInitMsTranslator();

        langForm.find('.lang_form_field').each(function () {
            $(this).attr('data-init', getInputVal($(this)));
        });

        var popContent = $("<p>").append(langForm);
        var popTemplate = $("<div>").html($("#popupFormTemplate").html());
        popTemplate.find(".htmlcontent").html(popContent.html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", langForm.attr('data-lang-name'), popTemplate.html(),
            width, height, [], null,
            function (modal) {

                if (initHandler) initHandler(modal);

                var scrollTop = $(window).scrollTop();
                var reForm = modal.find(".lang_form");
                var chkForm = reForm.closest('form');
                var ckArr = modal.find(".sub_ckeditor_standard,.sub_ckeditor_simple");
                var msgBox = modal.find('#massage.show_massage');

                var initScript = reForm.find("script[type='text/custom-initializer']").html();

                $(window).scrollTop(10000);

                if (initScript && initScript != '') {
                    try { eval(initScript); }
                    catch (e) { console.log(e); }
                }

                initEditor(ckArr); $.validator.unobtrusive.parse("#popupForm");

                langFormRestore(reForm);

                if (langFormIsEmpty(reForm)) langFormCopy(activeForm, reForm);

                var completeScript = reForm.find("script[type='text/custom-complete']").html();

                if (completeScript && completeScript != '') {
                    try { eval(completeScript); }
                    catch (e) { console.log(e); }
                }

                msgBox.hide();
                //reForm.find("span.error").each(function () {
                //if ($(this).attr('show-err') == '1') $(this).show(); else $(this).hide();
                //});

                initValidateInput(reForm);
                reForm.show(); chkForm.valid();
                setTimeout(function () { validateSubmit(chkForm); }, 2000);

                $('textarea', reForm).each(function () {
                    if (!$(this).attr('adjust-width') && !$(this).hasClass('sub_ckeditor_standard') && !$(this).hasClass('sub_ckeditor_simple')) {
                        var cssWidth = parseInt($(this).css('width'));
                        if (cssWidth) {
                            $(this).css({ 'width': (cssWidth - 12) + 'px', 'min-width': '40%' });
                            $(this).attr('adjust-width', 'true');
                        }
                    }
                });

                modal.find(".btn_save").click(function () {
                    if (!validateSubmit(chkForm)) return;
                    termEditor(ckArr);

                    reForm.hide(); msgBox.hide();
                    reForm.attr('data-valid', langFormIsEmpty(reForm) ? 0 : 1);
                    if (saveHandler) saveHandler(modal, reForm);
                    formList.append(reForm);
                    $('#input-err-msg-box').append(msgBox);

                    //reForm.find("span.error[show-err=1]").attr('show-err', '0');

                    popup.close(); $(window).scrollTop(scrollTop);
                });

                modal.find(".btn_cancel").click(function () {
                    termEditor(ckArr);
                    langFormRestore(reForm);
                    validateSubmit(chkForm, false);
                    reForm.hide(); msgBox.hide();
                    formList.append(reForm);
                    $('#input-err-msg-box').append(msgBox);
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });
    }

    function langFormSwitch(langcode, node) {
        var ownerbox = node.closest('.row_content_box');

        if (ownerbox.find('#lang-form-list').length != 0) return;

        var senderuid = ownerbox.attr('data-uid');
        ownerbox.find(".inputLang .langItem").each(function () {
            if (senderuid == $(this).closest('.row_content_box').attr('data-uid')) {
                if ($(this).attr('data-lang') == langcode) {
                    $(this).addClass('selected');
                    $(this).unbind("click");

                    ownerbox.find('#active-lang-img').attr('src', $(this).find('img').attr('src'));
                    ownerbox.find('#active-lang-img').attr('alt', $(this).attr('title'));
                    ownerbox.find('#active-lang-name').html($(this).attr('title'));
                } else {
                    $(this).removeClass('selected');
                    $(this).unbind("click").click(function () {
                        if ($(this).closest('ul').hasClass("tab-big-2")) {
                            langFormTranslate($(this).attr('data-lang'), $(this));
                        }
                        else langFormSwitch($(this).attr('data-lang'), $(this));
                    });
                }
            }
        });

        if (senderuid == $('#lang-form-list').closest('.row_content_box').attr('data-uid')) {
            $('#lang-form-list').find('.lang_form').each(function () {
                if ($(this).attr('data-lang') == langcode) $(this).show();
                else $(this).hide();
            });
        }

        if (form.CustomLangFormSwitch) form.CustomLangFormSwitch(langcode, node, senderuid);
    }

    function langFormIsEmpty(node) {
        var count = 0;
        node.find('.lang_form_field[type!=hidden]').each(function () {
            var value = getInputVal($(this));

            if (($(this).hasClass('bool-def-false') && value == 'false')
                || ($(this).hasClass('bool-def-true') && value == 'true')) value = '';

            if (!$(this).hasClass('no-empty-check') && value.length != 0) count++;
            //console.log($(this));
        });
        //console.log(count == 0);
        return count == 0;
    }

    function langFormRestore(node) {
        node.find('.lang_form_field[type!=hidden]').each(function () {
            setInputVal($(this), $(this).attr('data-init'));
        });
    }

    function langFormCopy(src, dst) {
        var iseq = 0;
        src.find('.lang_form_field').each(function () { $(this).attr('data-iseq', iseq++); });

        iseq = 0;
        dst.find('.lang_form_field').each(function () {
            if ($(this).attr('type') != 'hidden') {
                var value = getInputVal(src.find('.lang_form_field[data-iseq=' + iseq + ']'));
                setInputVal($(this), value);
            }
            iseq++;
        });
    }

    function langFormValidDependants(node, copySelector, dependantSelector) {

        if (copySelector)
            $(copySelector).val($(node).val());

        //if (navigator.msPointerEnabled == undefined) {
        //var scrollPos = $(window).scrollTop();
        $(dependantSelector).each(function () {
            var dependNode = this;//oVal = $(this).val(), 
            //$(this).val(oVal + ' ');
            //$(this).valid();
            //$(dependNode).val(oVal);
            //$(this).focus();
            formValidateClearOldValue(this);
            setTimeout(function () { $(dependNode).valid(); }, 100);
        });

        //if ($(node).hasClass('kendo-dropdownlist')) $(node).data('kendoDropDownList').focus();
        //else $(node).focus();

        //$(window).scrollTop(scrollPos);
        //}
    }

</script>

