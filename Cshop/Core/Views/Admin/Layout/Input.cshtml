                previewTemplate: '<li><div class="dz-preview dz-file-preview"><div class="dz-preview-menu"><div class="center"><a class="view_fr" title="@StringTable.Detail" target="_blank"></a><a class="image-edit edit_fr" title="@StringTable.Edit">@StringTable.Edit</a> <a class="delete_fr" data-dz-remove title="@StringTable.Delete">X</a></div></div><img data-dz-thumbnail /><div class="dz-details"><div><span data-dz-size></span></div><div><span data-dz-name></span></div></div><div class="dz-progress"><span class="dz-upload" data-dz-uploadprogress></span></div></div></li>',
                acceptedFiles: null,
                dropHandler: null,
                init: function () {
                    var me = this;
                    this.on("success", function (file, result) {
                        dropzoneOnSuccess(me, file, result);
                        if (result.Status == 0) {
                            if (resultHandler) {
                                if (result.Images) {
                                    for (var i = 0; i < result.Images.length; i++) {
                                        resultHandler(result, result.Images[i].file, i);
                                    }
                                }
                                else resultHandler(result, file);
                            }
                        } else if (errorHandler) errorHandler(file, result);
                    });

                    this.on("error", function (file, e) {
                        if (errorHandler) errorHandler(file, typeof (e) == 'string' ? { Message: e } : e);
                        else {
                            console.log('error', e, file);
                            admincommon.hideMessage();
                            admincommon.showMessageDefault('@(StringTable.AjaxCommandErrorMessage)', '@(ActionResultStatus.Fail)');
                        }

                        me.removeFile(file);
                    });

                    this.on("drop", function (e) {
                        dropzoneDragTimestamp = 0; $('.mask-dropzone', me.element).hide();
                        if ($(me.element).is('.single')) me.removeAllFiles();
                        if (me.options.dropHandler) me.options.dropHandler(me);
                    });

                    this.on("dragenter", function (e) {
                        dropzoneDragTimestamp = Date.now();
                        setTimeout(function () { dropzoneTimer(me); }, 500);
                        $('.mask-dropzone', me.element).show();
                    });

                    this.on("dragover", function (e) { dropzoneDragTimestamp = Date.now(); });

                    $(addSelector).click(function () { $(fileSelector).click(); });

                    $(fileSelector).change(function (e) {
                        for (var i = 0; i < this.files.length; i++)
                            me.addFile(this.files[i]);

                        if ($(me.element).is('.single'))
                            while (me.files.length > 1) me.removeFile(me.files[0]);

                        $(this).val(null);
                    });
                },
                dictCancelUpload: 'Cancel upload',
                dictCancelUploadConfirmation: 'Are you sure you want to cancel this upload?',
                dictDefaultMessage: 'Drop files here to upload',
                dictFallbackMessage: "Your browser does not support drag'n'drop file uploads.",
                dictFallbackText: 'File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB.',
                dictInvalidFileType: '@StringTable.ErrMsgFileExtension',
                dictMaxFilesExceeded: 'You can not upload any more files.',
                dictRemoveFile: 'Remove file',
                dictRemoveFileConfirmation: null,
                dictResponseError: 'Server responded with {{statusCode}} code.',
            };

            var opts = $.extend(optDefs, options || {});

            if (opts.enableZipUpload && opts.url)
                opts.url = urlMergeParams(opts.url, { enableZip: true });

            return $(dzSelector).dropzone(opts);
        }

        function dropzoneAdd(dropzone, key, name, url, thumbUrl, mimeType, size) {
            var item = { status: 'success', key: key, name: name, url: url, thumb: thumbUrl, size: size, type: mimeType };
            dropzone.files.push(item);
            dropzone.emit("addedfile", item);
            if (thumbUrl) {
                dropzone.emit("thumbnail", item, thumbUrl);
                $(item.previewElement).find('.dz-details').hide();
            }
            $(item.previewElement).find('.dz-progress').hide();
            $(item.previewElement).find('.dz-preview-menu a.view_fr').attr('href', url);
            //console.log("dropzoneAdd", url, item);

            return item;
        }

        function dropzoneOnSuccess(me, file, result) {
            //console.log("success", result.Image, file.type, file, result);
            if (result.Status == 0) {
                if (result.Images) {
                    for (var i = 0; i < result.Images.length; i++) {
                        var item = result.Images[i];
                        item.file = dropzoneAdd(me, item.FilePath, item.FileName, item.FilePath, item.ThumbUrl, item.MimeType, item.Size);
                    }
                    me.removeFile(file);
                } else {
                    file.key = result.Image.FilePath;
                    file.url = result.Image.FilePath;
                    file.thumb = result.Image.ThumbUrl;
                    me.emit("thumbnail", file, result.Image.ThumbUrl);
                    $(file.previewElement).find('.dz-preview-menu a.view_fr').attr('href', file.url);
                }

                $(file.previewElement).find('.dz-progress').hide();

                if (file.type.indexOf('image', 0) == 0)
                    $(file.previewElement).find('.dz-details').hide();

            } else {
                $(file.previewElement)
                    .removeClass('dz-success').addClass('dz-error')
                    .find('.dz-error-message').html(result.Message).show();

                me.removeFile(file);

                if (result.Message) {
                    admincommon.hideMessage(); admincommon.showMessageDefault(result.Message, result.Status);
                }
            }
        }

        function dropzoneTimer(dzone) {
            if (dzone.maskTimer) clearTimeout(dzone.maskTimer);
            if (dropzoneDragTimestamp + 500 < Date.now()) {
                $('.mask-dropzone', dzone.element).hide();
                Dropzone.instances.forEach(function (dz) {
                    if (dz.options.dropHandler) dz.options.dropHandler(dzone);
                });
                dzone.maskTimer = null;
            } else dzone.maskTimer = setTimeout(function () { dropzoneTimer(dzone); }, 500);
        }

        $(function () {
            Dropzone.autoDiscover = false;

            $('body').addClass('dropzone').dropzone({
                url: '/admin/',
                clickable: false,
                init: function () {
                    var me = this;
                    this.on("dragenter", function (e) {
                        dropzoneDragTimestamp = Date.now();
                        setTimeout(function () { dropzoneTimer(me); }, 500);
                        if (!$('.mask-dropzone', me.element).is(':visible')) $('.mask-dropzone', me.element).show();
                    });
                    this.on("dragover", function (e) { dropzoneDragTimestamp = Date.now(); });
                    this.on("drop", function (e) {
                        e.preventDefault(); dropzoneDragTimestamp = 0; $('.mask-dropzone', me.element).hide();
                    });
                    this.hiddenFileInput = $('<div>')[0];
                    this.addFile = function () { };
                }
            }).removeClass('dropzone');
        });

    </script>

    @Html.CssBundle("~/admin/dropzone.css", ModuleUrl.ContentUrl("Scripts/dropzone/basic.css"), ModuleUrl.ContentUrl("Scripts/dropzone/dropzone.css"))
    <script src="@ModuleUrl.ContentUrl("Scripts/dropzone/dropzone.js", true)"></script>
}

@if (ViewBag.UseInlineEdit != null && ViewBag.UseInlineEdit)
{
    <script type="text/javascript">

        function gridOnInlineEdit(event, displayOrder, refreshRowHandler) {

            var grid = event.sender, validatable = grid.editable.validatable, row = event.container, rwuid = row.attr('data-uid');

            row.find('input:visible')
                .focus(function () {
                    validatable.hideMessages();
                    validatable.validateInput($(this));
                })
                .keyup(function () {
                    validatable.validateInput($(this));
                });

            row.find('.k-grid-Edit')
                .addClass('inline-save')
                .attr('title', '@StringTable.Save')
                .unbind('click').click(function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    //console.log('save',e);
                    gridSaveChanges(grid);
                });;

            row.find('.k-grid-Delete')
                .addClass('inline-cancel')
                .attr('title', '@StringTable.Cancel')
                .show()
                .unbind('click').click(function (e) {
                    grid.cancelRow(); admincommon.hideMessage();

                    var newRw = $('tr[data-uid=' + rwuid + ']', grid.element);

                    newRw.find('.k-grid-Edit').removeClass('inline-save')
                        .addClass('edit_fr').attr('title', '@StringTable.Edit');

                    newRw.find('.k-grid-Delete').removeClass('inline-cancel')
                        .addClass('delete_fr').attr('title', '@StringTable.Delete');

                    newRw.dblclick(function () {
                        if (!grid.editable) grid.editRow($(this));
                    });

                    //console.log('cancel', newRw, row.selector,grid.dataItem(newRw));
                    if (refreshRowHandler) refreshRowHandler(grid, newRw);//gridRefreshRow(grid, rowEle)
                    //grid.refresh({ action: 'rebind', items: [grid.dataItem(newRw)] });
                });

            if (displayOrder) {
                var dorder = row.find(displayOrder);
                dorder.kendoNumericTextBox({
                    format: '####',
                    decimals: 0,
                    upArrowText: '@StringTable.NumTxtBoxUpArrow',
                    downArrowText: '@StringTable.NumTxtBoxDownArrow',
                });

                var numTxtBox = dorder.closest('.k-numerictextbox').find('input');
                numTxtBox.removeClass('text-box');
                numTxtBox.addClass('numeric-text-box sort-order');
            }

            var gridEditTimer = function () {
                var editable = grid.editable;
                if (editable) {
                    if (document.hasFocus() && $('input:focus,a:focus', row).length == 0 && editable.validatable.validate()) {
                        var node = editable.element.find('.k-grid-Edit');
                        setTimeout(function () { node.click(); }, 200);
                    } else setTimeout(gridEditTimer, 100);
                }
            };

            //setTimeout(gridEditTimer, 100);

            setTimeout(function () { row.find('input[type=text]:visible').first().focus(); }, 100);
        }

        function gridCmdInlineEdit(id, uid) {
            var grid = $('#' + id).data('kendoGrid'), editable = grid.editable;
            var row = $('tr[data-uid=' + uid + ']', grid.element);
            if (editable) {
                var node = editable.element.find('.k-grid-Edit');
                if (node.hasClass('inline-save')) {
                    editable.element.find('input[type=text]').each(function () {
                        $(this).val($.trim($(this).val()));
                        $(this).change();
                    });
                    gridSaveChanges(grid);
                }
            }
            else { grid.select(row); grid.editRow(row); }
        }

        function gridSaveChanges(grid) {
            if (!grid.clawReqStartTime || Date.now() - grid.clawReqStartTime > 15000) {
                grid.saveRow();
            } else setTimeout(function () {
                console.log('save row delayed', Date.now(), grid.clawReqStartTime);
                gridSaveChanges(grid);
            }, 500);
        }

    </script>

    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.editable.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.binder.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.validator.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.aspnetmvc.js"></script>
}

