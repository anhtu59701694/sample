@{ var optLang = LanguageMgr.OptLang(Model.Id);}

<script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/cultures/kendo.culture.@(optLang.LanguageCode).js"></script>

<script type="text/javascript">
    var debugMode = false, enableRemoteValidate = true, firstErrorInputElement = null;
    var activeLang = '@(optLang.LanguageCode)';

    if (!location.origin) location.origin = location.protocol + '//' + location.host;

    function getFocusLang() {
        return activeLang;
    }

    function clawSetTimeout(cond, code, timeout, maxSteps) {
        if (cond()) code();
        else {
            if (!maxSteps) maxSteps = 100;
            if (--maxSteps > 0) {
                setTimeout(function () { clawSetTimeout(cond, code, timeout, maxSteps); }, timeout);
            }
            else console.log('clawSetTimeout -> skipped');
        }
    }

    function dropDownListSetStyleLangVisible(id) {
        $('#' + id + ' option').each(function () {
            if ($(this).attr('disabled') == 'disabled') {
                $(this).addClass('item-lang-disabled');
                $(this).attr('title', '@StringTable.ItemLanguageDisabled');
            }
        });
    }

    function translateAlias(srcNode, dstId, override) {
        var dstNode = $('#' + dstId);
        var dstOVal = getInputVal(dstNode);
        var dstBKVal = dstNode.attr('bak-value');
        var srcVal = getInputVal($(srcNode));

        if (!override || !dstBKVal || dstBKVal == dstOVal || dstOVal == '') {
            AutoGenerateAlias($(srcNode).val(), dstId, override);

            if (dstOVal == dstNode.val()) return;

            dstNode.attr('bak-value', dstNode.val());

            function timerValid() {
                var validate = $(dstNode[0].form).validate();
                var aliasLoad = $('.alias-hint-loading', $(srcNode).closest('.lang_form'));
                var newDstVal = getInputVal(dstNode);

                if (!newDstVal && srcVal && dstOVal) {
                    setInputVal(dstNode, dstOVal);
                    return;
                }

                if (validate.pendingRequest > 0) setTimeout(timerValid, 100);
                else {
                    if (!dstNode.valid())
                        ajaxREST('@Html.ActionUrl("GetUniqueFieldHint", null, new { @id = Model.Id })',
                            'POST', { name: 'Alias', value: dstNode.val() },
                            aliasLoad.length != 0 ? aliasLoad.attr('id') : 'alias-hint-loading',
                            function (result) {
                                if (result.Value) {
                                    dstNode.val(result.Value).attr('bak-value', result.Value);
                                    dstNode.change(); dstNode.valid();
                                }
                            }, function (e) { console.log('error', e); });
                }
            };

            dstNode.change(); dstNode.valid();

            setTimeout(timerValid, 100);
        }
    }

    function ckeGenerateAlias(srcId, dstId, maxLen) {
        var node = $(srcId), alias = $(dstId), override = ('@Model.Id' == '0');
        clawSetTimeout(function () { return isNodeCKEditor(node); },
            function () {
                alias.change(function () {
                    var val = $.trim($(this).val());
                    if (val == '') translateAlias(node, alias.attr('id'), override);
                    else if (val.length > maxLen)
                        $(this).val(val.substring(0, maxLen) + '-' + Math.floor(new Date().getTime() / 60000));
                });
                CKEDITOR.instances[node.attr('id')].on('blur', function (e) {
                    translateAlias(node, alias.attr('id'), override);
                });
            }, 500, 20);
    }

    function formEnable(enable) {
        $('#editForm').find('input,textarea,select').prop('disabled', !enable);

        $('#editForm').find('.wr_submit_top li input[type=button]').css(enable
            ? { 'cursor': 'pointer', 'background-color': null }
            : { 'cursor': 'default', 'background-color': '#CCC' });

        $('li input[type=button]', '.wr_submit_top.form-action-menu ').css(enable
            ? { 'cursor': 'pointer', 'background-color': null }
            : { 'cursor': 'default', 'background-color': '#CCC' }).prop('disabled', !enable);
    }

    function formShowErrorMsg(fieldName, errMessage, form) {
        var validObj = $(form || '#editForm').validate();

        if (!validObj.settings.rules[fieldName]) {
            console.log(fieldName + ' not found!'); return;
        }
        else {
            var errors = {}; errors[fieldName] = errMessage;
            validObj.showErrors(errors);
        }
    }

    function formSetRuleMsg(fieldName, method, msg, form) {
        var validObj = $(form || '#editForm').validate();

        if (validObj.settings.messages[fieldName]) {
            validObj.settings.messages[fieldName][method] = msg;
        }
    }

    function inputNoEmpty(node) {
        if ($.trim($(node).val()) == '') $(node).val($(node).attr('value'));
    }

    $.validator.methods.remoteClaw = $.validator.methods.remote;
    $.validator.methods.remote = function (value, element, param) {
        if (!this.clawRemoteValidate) this.clawRemoteValidate = $.validator.methods.remoteClaw;
        if (debugMode) console.log('RemoteValidate:', '[', enableRemoteValidate, this, ']', value, element, param);
        if (this.optional(element) || !enableRemoteValidate) {
            return "dependency-mismatch";
        }
        else return this.clawRemoteValidate(value, element, $.fn.getRemoteValidArgs ? $(element).getRemoteValidArgs(param) : param);
    };

    function formValidateClearOldValue(rawElement, form) {
        $(form || $(rawElement).closest('form')).validate().previousValue(rawElement).old = '';
    }

    function formUpdateValidRules(node) {
        $.validator.unobtrusive.parse(node);

        var form = node.first().closest('form');
        var unobtrusiveValidation = form.data('unobtrusiveValidation');
        var validator = form.validate();

        $.each(unobtrusiveValidation.options.rules, function (elname, elrules) {
            if (!validator.settings.rules[elname]) {
                var args = $.extend({}, elrules);
                args.messages = unobtrusiveValidation.options.messages[elname];
                form.find("[name='" + elname + "']").rules("add", args);
            }
        });
    }

    function localizeParseFloat(value) {
        return kendo.parseFloat(value, '@optLang.LanguageCode');
    }

    function localizeFloatToString(value, format) {
        return kendo.toString(value, format || 'n2', kendo.cultures['@optLang.LanguageCode']);
    }

    function localizeMoneyToString(value, format) {
        format = format || '@SettingsBiz.GetSettings().Display.Others.GetPriceFormat()';
        return kendo.toString(value, format, kendo.cultures['@optLang.LanguageCode']);
    }

    function localizeDateToString(value, format) {
        format = format || '@SettingsBiz.GetSettings().Display.Others.GetDateFormat()';
        return kendo.toString(value, format, kendo.cultures['@optLang.LanguageCode']);
    }

    function localizeCurrencyToString(value, code) {
        if (value == null || value === '') value = 0;
        if (!code) code = '@CurrencyMgr.Default.Code';
        var formatInfo = kendo.currencies[code.toLowerCase()] || {};
        var txtVal = kendo.toString(value, 'n', formatInfo);
        return formatInfo.location ? ((formatInfo.token || '') + ' ' + txtVal) : (txtVal + ' ' + (formatInfo.token || ''));
    }

    function initCurrencies(currencies) {

        kendo.currencies = kendo.currencies || {};

        currencies.forEach(function (itm) {
            var formatInfo = $.extend(true, {}, kendo.cultures.current);

            formatInfo.name = itm.Code;
            formatInfo.location = itm.Location;
            formatInfo.token = itm.Token;
            formatInfo.numberFormat[','] = itm.ThousandSep;
            formatInfo.numberFormat['.'] = itm.DecimalSep;
            formatInfo.numberFormat.decimals = itm.DecimalPlaces;

            kendo.currencies[itm.Code.toLowerCase()] = formatInfo;
        });

    }

    $.fn.clawGetFloat = function (defVal, format) {
        var value = $.trim($(this).val());
        return value == '' ? defVal : localizeParseFloat(value, format);
    };

    $.fn.clawSetFloat = function (value, format) {
        $(this).val(localizeFloatToString(value, format));
        return $(this);
    };

    $.fn.clawGetInt = function (defVal) {
        var value = $.trim($(this).val());
        return value == '' ? defVal : parseInt(value);
    };

    $.fn.clawChangeInt = function (delta) {
        $(this).val($(this).clawGetInt() + delta);
        return $(this);
    };

    $.fn.isEmptyVal = function () {
        var value = $.trim($(this).val());
        return value == '';
    };

    $.fn.getBoolVal = function () {
        var value = $.trim($(this).val()).toLowerCase();
        return value == 'true';
    };

    $.fn.scrollHeight = function () {
        if (this.length > 0) return this[0].scrollHeight;
        else return undefined;
    };

    $.fn.scrollWidth = function () {
        if (this.length > 0) return this[0].scrollWidth;
        else return undefined;
    };

    $.validator.methods.number = function (value, element) {
        if (!value || $.trim(value) == '') return this.optional(element);
        var regex = new RegExp('@(LanguageMgr.GetNumberRegex(optLang).Replace("\\", "\\\\"))');
        return regex.test(value);
    };

    $.validator.methods.range = (function (value, element, param) {
        param[0] = localizeParseFloat($(element).attr('data-val-range-min'));
        param[1] = localizeParseFloat($(element).attr('data-val-range-max'));
        var newval = localizeParseFloat(value);
        //console.log('range', value, element, param, newval, value);
        return this.optional(element) || (newval >= param[0] && newval <= param[1]);
    });

    $.fn.getFormFields = function (selector) {
        if ($(this).is('form')) {
            if (selector) return $(this).find(selector);
            var fields = [], form = $(this)[0];
            for (var i = 0; i < form.length; i++) {
                fields.push(form[i]);
            }
            return $(fields);
        }
        else return $(this).find('input,select,textarea');
    };

    var currentCulture = kendo.cultures["@optLang.LanguageCode"], numberFormat = currentCulture.numberFormat;
    numberFormat[','] = '@optLang.ThousandsSeperator';
    numberFormat['.'] = '@optLang.DecimalSeperator';
    numberFormat.percent[','] = numberFormat[','];
    numberFormat.percent['.'] = numberFormat['.'];
    numberFormat.currency[','] = numberFormat[','];
    numberFormat.currency['.'] = numberFormat['.'];

    kendo.culture('@optLang.LanguageCode');
    //console.log(kendo.cultures["@optLang.LanguageCode"].numberFormat);

    function formDisableValidation(inputs, isDisabled) {
        inputs.each(function () {
            var dataKey = 'backupValidRule';
            var dataVal = $(this).data(dataKey);
            if (isDisabled) {
                formShowErrorMsg($(this).attr('name'), null);
                //$(this).closest('section').find('.error').hide();
                var rule = $(this).rules('remove');
                if (Object.keys(rule).length != 0 || !dataVal) $(this).data(dataKey, rule);
            } else if (dataVal && Object.keys(dataVal).length != 0) $(this).rules('add', dataVal);
        });
    }

    function urlToJSON(url, skipEmpty) {
        if (!url || url.indexOf('?') == -1) return {};

        var result = {}, pairs = url.slice(url.indexOf('?') + 1).split('&');

        pairs.forEach(function (item) {
            var pair = item.split('=');
            if (pair.length > 0 && (pair[1] || !skipEmpty))
                result[pair[0].toLowerCase()] = decodeURIComponent(pair[1] || '');
        });

        return result;
    }

    function urlMergeParams(url, params) {
        if (!url || !params) return url;

        if (typeof (params) == 'string') params = urlToJSON('?' + params, false);

        var idx = url.indexOf('?');

        if (idx == -1) url += '?';
        else {
            params = $.extend(urlToJSON(url, true), params);
            url = url.substr(0, idx + 1);
        }

        for (var key in Object.keys(params)) {
            if (!params[key]) delete params[key];
        }

        return url + $.param(params);
    }

    function urlInjectFocusLang(url) {
        if (!url || /^http(s?):\/\//i.test(url) || /[?&]lang=/i.test(url)) return url;
        return urlMergeParams(url, { lang: getFocusLang() });
    }

    function aviaryInit(node, updateSelector, eventHandler) {
        var aviaryHolder = $('#aviary-holder');
        if (aviaryHolder.length == 0) {
            aviaryHolder = $('<div id="aviary-holder" style="display:none"><img/></div>');
            $('body').append(aviaryHolder);
        }

        var url = node.is('input') ? node.val() : node.attr('src'), imgId = 'aviary-img-' + node.attr('id');

        if (url && url.indexOf('http://') != 0 && url.indexOf('https://') != 0) url = location.origin + url;

        aviaryHolder.find('img').attr({ id: imgId, src: url });

        var aviary = new AviaryPlugin(imgId, url);
        aviary.launch(function (targetId, newUrl) {
            if (node.is('input')) node.val(newUrl);
            else node.attr('src', newUrl);

            if (updateSelector)
                $(updateSelector).each(function () {
                    if ($(this).is('input')) $(this).val(newUrl);
                    else $(this).attr('src', newUrl);
                });

            aviary.hideMask(); aviary.close();

            if (eventHandler) eventHandler(imgId, newUrl);
        });
    }

    //set height auto popup
    function PopUpSetHeight(objGrid, fGridH, treeView) {

        var fullH = $(window).outerHeight();
        var objWin = $('.k-widget.k-window');
        //var objGrid = $(".wr_table_all #gridprodsel");

        var temp = objWin.outerHeight();
        var myVar = setInterval(function () {
            //set height
            if (treeView) {
                objGrid.removeAttr('style');
                objWin.css({ 'height': 'auto', "min-height": "auto" });
            }

            if (fullH > objWin.outerHeight()) {
                objGrid.height() > fGridH ? objGrid.css("max-height", objGrid.height()) : "";
                objWin.css({ "height": (objGrid.height() > fGridH ? objWin.height() : 'auto'), "top": ((fullH - objWin.outerHeight()) / 2) });
            } else {
                objWin.css({ "height": (fullH - 30), "top": 0 });
                objGrid.height() > fGridH ? objGrid.css("max-height", fullH - (treeView ? 80 : 170)) : "";
            }
            //clear Interval
            if (temp < objWin.outerHeight() || treeView) {
                clearInterval(myVar);
            }
        }, 100);
    }

    function gridAdjustPopup(grid, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY) {

        cmdBoxHeight = cmdBoxHeight || 60; adjustY = adjustY || 10;
        minHeight = minHeight || 200; maxHeight = maxHeight || 2048;

        var holderNode = grid.element.closest(holder), scrollNode = holderNode.closest(scrollBox);
        var recHeight = Math.max(minHeight, Math.min(maxHeight, $(window).height() - 50));
        var height = Math.min(recHeight, Math.max(minHeight, holderNode.height() + cmdBoxHeight + 30 + adjustY));

        scrollNode.closest('.k-widget.k-window').css({
            'height': height + 'px',
            'top': ($(window).height() - height - 30) / 2 + 'px',
        });
        scrollNode.css({ 'max-height': (height - cmdBoxHeight - 30) + 'px', 'overflow': 'auto' });
    }

    function treeAdjustPopup(tree, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY) {
        if (tree.adjustPopupTimer) clearTimeout(tree.adjustPopupTimer);
        tree.adjustPopupTimer = setTimeout(function () {
            tree.adjustPopupTimer = null;
            gridAdjustPopup(tree, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY);
        }, 500);
    }

    function ifnull(obj, def) {
        if (obj == null) return def || '';
        return obj;
    }

    function safeProp(obj, propName) {
        if (obj == null) return '';
        if (typeof (obj) != 'object') return obj;
        return obj[propName] || '';
    }

    function getObjectProperty(obj, propPath) {
        if (!obj || !propPath) return null;

        var retVal = null, arrProp = propPath.split('.');

        for (var i = 0; i < arrProp.length; i++) {
            var pVal = (retVal || obj)[arrProp[i]];
            if (pVal != null) retVal = pVal;
            else return null;
        }

        return retVal;
    }

    function kendoHtmlDecode(value) {
        if (!value) return value;
        return value.replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#39;/g, "'");
    }

    admincommon.showMessageDefault = function (message, status, scrollTo) {
        //clearTimeout(timer);
        var msg = $("#massage");
        if (msg.is(":visible")) msg.hide();
        this.resetMessageClass(msg);
        this.addMessageClass(msg, status);
        $("span#show_error", msg).html(message);
        msg.slideDown("slow", function () {
            if (scrollTo != null && $.scrollTo) {
                var scrollToOffset = $(scrollTo).offset();
                $.scrollTo(scrollToOffset.left, scrollToOffset.top, { duration: 1000 });
            }
        }); //timer = setTimeout(this.slideUpMessage, 10000);

        msg.unbind('click').click(function () {
            if (timer) clearTimeout(timer);
            $("span#show_error", msg).html('');
            $(this).slideUp(700);
        });
    };

    admincommon.showMessage = function (message, status, timeout) {
        this.showMessageDefault(message, status);
        if (timeout) timer = setTimeout(function () { admincommon.slideUpMessage(); }, timeout);
    };

    function msTranslatorGetText(text, targetLang, conType, resultHandler, errorHandler, loadingImage) {
        if (window.msTranslatorToken) {
            ajaxREST((location.protocol||'https:') + '//api.microsofttranslator.com/V2/Ajax.svc/Translate', 'GET', {
                appId: 'Bearer ' + window.msTranslatorToken, from: getFocusLang(), to: targetLang, text: text, contentType: conType, oncomplete: '?'
            }, loadingImage, resultHandler, errorHandler);
        } else
            setTimeout(function () {
                msTranslatorGetText(text, targetLang, conType, resultHandler, errorHandler, loadingImage);
            }, 200);
    }

    function initMsTranslator(loadingImage) {
        window.clawInitMsTranslator = function () { if (!window.msTranslatorToken) initMsTranslatorRaw(loadingImage); };
    }

    function initMsTranslatorRaw(loadingImage) {
        console.log('initMsTranslator', Date.now());

        loadingImage = loadingImage || 'no-loading-image';

        ajaxREST('@ModuleUrl.AdminUrl(Html.GetController(), "MsTranslatorToken")', 'POST', {}, loadingImage,
            function () {
                setTimeout(function () { initMsTranslator(loadingImage); }, 1000 * ((window.msTranslatorExpiry || 600) - 120));
            }, function (e) { console.log('initMsTranslator failed'); }, null, 'script');
    }

    function initLangFormTranslator(langForm) {
        $('.field-row .text-translator', langForm).unbind('click').click(function () {
            var inputNode = $(this).closest('.field-row').find('.right-sec .lang_form_field');
            var lang = langForm.attr('data-lang'), conType = isNodeCKEditor(inputNode) ? 'text/html' : 'text/plain';
            msTranslatorGetText(getInputVal(inputNode), lang, conType,
                function (result) {
                    setInputVal(inputNode, result);
                    var translateEvent = inputNode.attr('ontranslate');
                    if (translateEvent) eval(translateEvent.replace('$(this)', 'inputNode'));
                },
                function (e) { formShowErrorMsg(inputNode.attr('name'), '@StringTable.AjaxCommandErrorMessage'); },
                inputNode.attr('loadingimg'));
        });
    }

    function langFormSetOtherActive() {
        $('.tab-big-2 .inputLang .langItem').each(function () {
            if (!$(this).hasClass('active-lang')) {
                var node = $(this).find('input');
                node.prop({ disabled: true, checked: true });
                node.change();
            }
        });
    }

</script>

<script type="text/javascript">

    function gridStringifyAttributes(attributes) {
        var attr, result = " ";

        if (attributes) {
            if (typeof attributes === 'string') {
                return attributes;
            }

            for (attr in attributes) {
                result += attr + '="' + attributes[attr] + '"';
            }
        }
        return result;
    }

    function gridGetRowTemplate(grid, alt, map) {
        var that = grid,
            columns = that.columns,
            settings = $.extend({}, kendo.Template, that.options.templateSettings),
            idx,
            length = columns.length,
            template,
            state = { storage: {}, count: 0 },
            column,
            type,
            hasDetails = that._hasDetails(),
            className = [],
            groups = that._groups(),
            skipGroupCells;

        var rowTemplate = "<tr";

        if (alt) className.push("k-alt");

        if (hasDetails) className.push("k-master-row");

        if (className.length) rowTemplate += ' class="' + className.join(" ") + '"';

        if (length) rowTemplate += ' ' + kendo.attr("uid") + '="#=' + kendo.expr("uid", settings.paramName) + '#"';

        rowTemplate += " role='row'>";

        if (groups > 0 && !skipGroupCells) rowTemplate += groupCells(groups);

        var colTempls = [];

        if (hasDetails) colTempls.push('<td class="k-hierarchy-cell"><a class="k-icon k-plus" href="\\#" tabindex="-1"></a></td>');

        for (idx = 0; idx < length; idx++) {
            column = columns[idx];

            var colTempl = "<td" + gridStringifyAttributes(column.attributes) + " role='gridcell'>";
            colTempl += that._cellTmpl(column, state);
            colTempl += "</td>";
            colTempls.push(colTempl);
        }

        for (var i = 0; i < colTempls.length; i++) {
            if (map && map[i] != null) {
                rowTemplate += colTempls[map[i]];
            } else rowTemplate += colTempls[i];
        }

        rowTemplate += "</tr>";

        return kendo.template(rowTemplate, settings);
    }

    function gridSwapElements(holder, selector, map, transformHandler, moveLast2First) {
        var nodes = holder.find(selector), lst = [], lst0 = [];

        for (var k = 0; k < nodes.length; k++) {
            lst0.push(nodes[k]);
        }

        if (moveLast2First) lst0.unshift(lst0.pop());

        for (var i = 0; i < lst0.length; i++) {
            if (map[i] != null) {
                var node = lst0[map[i]];
                if (transformHandler) transformHandler(i, node);
                lst.push({ node: node, html: $(node).html() });
            } else lst.push({ node: lst0[i], html: $(lst0[i]).html() });
        }

        holder.html('');
        lst.forEach(function (itm) { holder.append($(itm.node).html(itm.html)); });
    }

    function gridChangeColumnTitle(id, index, title) {
        var grid = $('#' + id).data('kendoGrid');
        if (grid.columns.length > index) {
            var col = grid.columns[index];
            col.title = grid.options.columns[index].title = title;
            $('th.k-header[data-field=' + col.field + ']', grid.thead)
                .attr('data-title', title)
                .find('.k-link').html(title);
        }
    }

    function gridInitErrMsgEvent(grid) {
        $('.error[data-valmsg-for]', grid.element).unbind('click').click(function () {
            $(this).html('');
        });
    }

    function kendoGetResultError(result) {

        if (result && result.Status != 0 && !result.Errors) return result.Message;
        if (!result || !result.Errors) return null;

        var keys = Object.keys(result.Errors);

        if (keys.length == 0 || result.Errors[keys[0]].errors.length == 0) return null;

        return result.Errors[keys[0]].errors[0];
    }

    function gridShowMessage(grid, selector, message, status) {
        var msg = $(selector);
        var showMsg = function() {
            admincommon.addMessageClass(msg, status);
            msg.slideDown(700).find('.nNote').html(message);
            //grid.showMessageTimerId = setTimeout(function() {
            //    msg.slideUp(700).find('.nNote');
            //    grid.showMessageTimerId = null;
            //}, 7000);
        };
        msg.unbind('click').click(function () {
            $('.nNote', msg).html("");
            msg.slideUp(700);
        });
        if (grid.showMessageTimerId) clearTimeout(grid.showMessageTimerId);
        if (msg.is(':visible')) msg.slideUp(700, showMsg);
        else showMsg();
    }

</script>

