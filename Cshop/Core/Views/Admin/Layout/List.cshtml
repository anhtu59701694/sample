<script type="text/javascript">

    if (!location.origin) location.origin = location.protocol + '//' + location.host;

    $(document).ready(function () {
        //active menu in tab product
        var patchName = window.location.pathname;
        var obj = $('.wr-menu-icon').find('ul.clo-5').find('a');
        obj.removeClass('active');
        $(obj).each(function () {
            var ahref = $(this).attr("href");
            var arr = ahref.split(/[\s/]+/);
            var outPut = "/" + arr[arr.length - 2];
            if(outPut != null){
                if (patchName.toLowerCase().indexOf(outPut.toLowerCase()) != -1) {
                    $(this).addClass('active');  return false;
                }
            }
        });
    });

    function gridEagerLoadConfig(options, data) {

        var asyncTrans = $.extend(true, {}, options.dataSource.transport);

        options.autoBind = false;
        options.dataSource.transport.clawOffline = true;
        options.dataSource.transport.read.url = null;
        options.dataSource.transport.data = data;

        return {
            transport: asyncTrans,
            dataEvent: {
                skip: 0,
                group: [],
                aggregate: null,
                take: options.dataSource.pageSize,
                page: options.dataSource.page,
                pageSize: options.dataSource.pageSize,
                sort: options.dataSource.sort,
                filter: options.dataSource.filter,
            }
        };
    }

    function localizeCurrencyToString(value, code) {
        if (value == null || value === '') value = 0;
        if (!code) code = '@CurrencyMgr.Default.Code';
        var formatInfo = kendo.currencies[code.toLowerCase()] || {};
        var txtVal = kendo.toString(value, 'n', formatInfo);
        return formatInfo.location ? ((formatInfo.token || '') + ' ' + txtVal) : (txtVal + ' ' + (formatInfo.token || ''));
    }

    function initCurrencies(currencies) {

        kendo.currencies = kendo.currencies || {};

        currencies.forEach(function (itm) {
            var formatInfo = $.extend(true, {}, kendo.cultures.current);

            formatInfo.name = itm.Code;
            formatInfo.location = itm.Location;
            formatInfo.token = itm.Token;
            formatInfo.numberFormat[','] = itm.ThousandSep;
            formatInfo.numberFormat['.'] = itm.DecimalSep;
            formatInfo.numberFormat.decimals = itm.DecimalPlaces;

            kendo.currencies[itm.Code.toLowerCase()] = formatInfo;
        });

    }

    function gridMarkLangDisabled(grid, selector, cond) {
        $(selector, grid.element).each(function () {
            var row = grid.dataItem($(this).closest("tr"));
            if (cond(row)) {
                $(this).addClass('item-lang-disabled');
                var title = $(this).attr('title');
                $(this).attr('title', (title ? title + ', ' : '') + '@(StringTable.ItemLanguageDisabled)');
            }
        });
    }

    function gridDisableCheckBox(grid, cond, selector) {
        $(selector || '.row-checkbox', grid.element).each(function () {
            if (cond(grid.dataItem($(this).closest("tr")))) {
                $(this).removeClass("row-checkbox");
                $(this).closest("div").find('input[type=checkbox]').prop('disabled',true);
            }

            $(this).closest("td").css({ 'padding': '0px', 'min-width': '35px' });
        });
    }

    function gridHideCell(grid, selector, cond) {
        $(selector, grid.element).each(function () {
            var rw = grid.dataItem($(this).closest("tr"));
            if (cond(rw)) $(this).hide();
        });
    }

    function initGridStatusAction(grid, selector, actionUrl, getterStatus, setterStatus, getterCmdParams) {

        var titleEnable = '@(StringTable.ItemEnableTitle)';
        var titleDisable = '@(StringTable.ItemDisableTitle)';

        $(selector, grid.element).each(function () {

            var rdata = grid.dataItem($(this).closest("tr"));
            var ritmA = $(this).find('a');
            var status = getterStatus(rdata);

            ritmA.addClass(status ? 'enable' : 'disable');
            ritmA.attr('title', status ? titleDisable : titleEnable);

            if(actionUrl) {
                $(this).unbind('click').click(function (e) {
                    var row = grid.dataItem($(this).closest("tr"));
                    var itm = $(this).find('a');

                    setterStatus(row, !getterStatus(row));

                    if (row.id > 0) ajaxCmd(actionUrl, getterCmdParams(row));

                    if (getterStatus(row)) {
                        itm.removeClass("disable");
                        itm.addClass("enable");
                        itm.attr('title', titleDisable);
                    } else {
                        itm.removeClass("enable");
                        itm.addClass("disable");
                        itm.attr('title', titleEnable);
                    }
                });
            }
        });
    }

    function initGridDisplayOrderBox(grid, selector, actionUrl) {
        $(selector, grid.element).kendoNumericTextBox({
            format: '####',
            decimals: 0,
            upArrowText: '@StringTable.NumTxtBoxUpArrow',
            downArrowText: '@StringTable.NumTxtBoxDownArrow',
            change: function () {
                var row = grid.dataItem(this.element.closest("tr"));
                ajaxCmd(actionUrl, { id: row.Id, value: this.value() });
            }
        });

        $(selector).change(function() {
            if ($.trim($(this).val()) == '') $(this).val($(this).attr('value'));
        });
    }

    function initGridTextAreaBox(grid, selector, actionUrl) {
        $(selector, grid.element).change(function() {
            var row = grid.dataItem($(this).closest("tr"));
            ajaxCmd(actionUrl, { id: row.Id, value: $(this).val(), lang: getFocusLang() });
        });
    }

    function initGridTextInlineEditBox(grid, selector, member, txtSelector, inputSelector, actionUrl) {
        $(selector, grid.element).each(function() {
            var node = $(this), row = grid.dataItem($(this).closest("tr"));
            var txtNode = node.find(txtSelector), inputNode = node.find(inputSelector);

            $(this).dblclick(function() {
                inputNode.show(); inputNode.val(row[member]); inputNode.focus();
                txtNode.hide(); txtNode.val(row[member]);
            });

            $(this).find(inputSelector).change(function() {
                ajaxCmdHtml(actionUrl, { id: row.Id, value: $(this).val(), lang: getFocusLang() },
                    function(result) {
                        if (result.Status == 0) {
                            row[member] = inputNode.val(); txtNode.html(row[member]);
                        }
                        inputNode.hide(); txtNode.show();
                        if (result.Message != null) admincommon.showMessageDefault(result.Message, result.Status);
                    });
            });

            $(this).focusout(function () { inputNode.hide(); txtNode.show(); });
        });
    }

    function initDatePicker(node, options) {
        (node ? node : $("input.datepicker")).each(function () {

            if (!$(this).hasClass('setKendoDatepicker')) {
                $(this).kendoDatePicker($.extend({
                    culture: '@(langObj.LanguageCode)',
                    format: '@(SettingsBiz.GetSettings().Display.Others.GetDateFormat())',
                    animation: {
                        close: { effects: "fadeOut zoom:out", duration: 300 },
                        open: { effects: "fadeIn zoom:in", duration: 300 }
                    }
                }, options || {}));

                $(this).addClass('setKendoDatepicker');
            }
        });
    }

    function initKendoNumeric(selector, options) {

        var nodes = $(selector);

        nodes.each(function () {
            $(this).kendoNumericTextBox($.extend({
                culture: getFocusLang(),
            }, options || {}));

            var nodeKd = $(this).data('kendoNumericTextBox');

            if (nodeKd) nodeKd.options.originValue = nodeKd.value();

            if ($(this).hasClass('js-required'))
                $(this).closest('.k-numerictextbox')
                    .removeClass('js-required')
                    .find('.js-required:visible').removeClass('js-required');
        });

        return nodes;
    }

    function gridStringifyAttributes(attributes) {
        var attr, result = " ";

        if (attributes) {
            if (typeof attributes === 'string') {
                return attributes;
            }

            for (attr in attributes) {
                result += attr + '="' + attributes[attr] + '"';
            }
        }
        return result;
    }

    function gridGetRowTemplate(grid, alt, map) {
        var that = grid,
            columns = that.columns,
            settings = $.extend({}, kendo.Template, that.options.templateSettings),
            idx,
            length = columns.length,
            template,
            state = { storage: {}, count: 0 },
            column,
            type,
            hasDetails = that._hasDetails(),
            className = [],
            groups = that._groups(),
            skipGroupCells;

        var rowTemplate = "<tr";

        if (alt) className.push("k-alt");

        if (hasDetails) className.push("k-master-row");

        if (className.length) rowTemplate += ' class="' + className.join(" ") + '"';

        if (length) rowTemplate += ' ' + kendo.attr("uid") + '="#=' + kendo.expr("uid", settings.paramName) + '#"';

        rowTemplate += " role='row'>";

        if (groups > 0 && !skipGroupCells) rowTemplate += groupCells(groups);

        var colTempls = [];

        if (hasDetails) colTempls.push('<td class="k-hierarchy-cell"><a class="k-icon k-plus" href="\\#" tabindex="-1"></a></td>');

        for (idx = 0; idx < length; idx++) {
            column = columns[idx];

            var colTempl = "<td" + gridStringifyAttributes(column.attributes) + " role='gridcell'>";
            colTempl += that._cellTmpl(column, state);
            colTempl += "</td>";
            colTempls.push(colTempl);
        }

        for (var i = 0; i < colTempls.length; i++) {
            if (map && map[i] != null) {
                rowTemplate += colTempls[map[i]];
            } else rowTemplate += colTempls[i];
        }

        rowTemplate += "</tr>";

        return kendo.template(rowTemplate, settings);
    }

    function gridSwapElements(holder, selector, map, transformHandler) {
        var nodes = holder.find(selector), lst = [];

        for (var i = 0; i < nodes.length; i++) {
            if (map[i] != null) {
                var node = nodes[map[i]];
                if (transformHandler) transformHandler(i, node);
                lst.push({ node: node, html: $(node).html() });
            } else lst.push({ node: nodes[i], html: $(nodes[i]).html() });
        }

        holder.html('');
        lst.forEach(function (itm) { holder.append($(itm.node).html(itm.html));});
    }

    function initImagePreview(fancybox, holder, autoPreview) {
        $(function() {initImagePreviewRaw(fancybox, holder, autoPreview);});
    }

    function urlToJSON(url, skipEmpty) {
        if (!url || url.indexOf('?') == -1) return {};

        var result = {}, pairs = url.slice(url.indexOf('?') + 1).split('&');

        pairs.forEach(function(item) {
            var pair = item.split('=');
            if (pair.length > 0 && (pair[1] || !skipEmpty))
                result[pair[0].toLowerCase()] = decodeURIComponent(pair[1] || '');
        });

        return result;
    }

    function urlMergeParams(url, params) {
        if (!url || !params) return url;

        if (typeof (params) == 'string') params = urlToJSON('?' + params, false);

        var idx = url.indexOf('?');

        if (idx == -1) url += '?';
        else {
            params = $.extend(urlToJSON(url, true), params);
            url = url.substr(0, idx + 1);
        }

        for(var key in Object.keys(params)) {
            if (!params[key]) delete params[key];
        }

        return url + $.param(params);
    }

    function urlInjectFocusLang(url) {
        if (!url || /^http(s?):\/\//i.test(url) || /[?&]lang=/i.test(url)) return url;
        return urlMergeParams(url, { lang: getFocusLang() });
    }

    function urlReplaceAction(url, action) {
        if (!url || !action) return url;

        var iE = url.indexOf('?'), len = url.length;
        if (iE == -1)iE = len - 1;
        var iB = url.lastIndexOf('/', iE);

        if (iB >= 0 && iB < iE)return url.substr(0, iB + 1) + action + (iE < len - 1 ? url.substr(iE) : '');
        else return url;
    }

    function gridAdjustPopup(grid, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY) {

        cmdBoxHeight = cmdBoxHeight || 30; adjustY = adjustY || 10;
        minHeight = minHeight || 200; maxHeight = maxHeight || 2048;

        var holderNode = grid.element.closest(holder), scrollNode = holderNode.closest(scrollBox);
        var recHeight = Math.max(minHeight, Math.min(maxHeight, $(window).height() - 50));
        var height = Math.min(recHeight, Math.max(minHeight, holderNode.height() + cmdBoxHeight + 30 + adjustY));

        scrollNode.closest('.k-widget.k-window').css({
            'height': height + 'px',
            'top': ($(window).height() - height - 30) / 2 + 'px',
        });
        scrollNode.css({ 'max-height': (height - cmdBoxHeight - 30) + 'px', 'overflow': 'auto' });
    }

    function treeAdjustPopup(tree, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY) {
        if (tree.adjustPopupTimer) clearTimeout(tree.adjustPopupTimer);
        tree.adjustPopupTimer = setTimeout(function () {
            tree.adjustPopupTimer = null;
            gridAdjustPopup(tree, holder, scrollBox, minHeight, maxHeight, cmdBoxHeight, adjustY);
        }, 500);
    }

    function ifnull(obj, def) {
        if (obj == null) return def || '';
        return obj;
    }

    function ifnullImg(obj) {
        if (!obj) return 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
        return obj;
    }

    function safeProp(obj, propName) {
        if (obj == null) return '';
        if (typeof (obj) != 'object')return obj;
        return (obj[propName] || '').replace(/(<([^>]+)>)/ig,"");
    }

    admincommon.showMessageDefault = function (message, status, scrollTo) {
        //clearTimeout(timer);
        var msg = $("#massage");
        if (msg.is(":visible")) msg.hide();
        this.resetMessageClass(msg);
        this.addMessageClass(msg, status);
        $("span#show_error", msg).html(message);
        msg.slideDown("slow", function () {
            if (scrollTo != null && $.scrollTo) {
                var scrollToOffset = $(scrollTo).offset();
                $.scrollTo(scrollToOffset.left, scrollToOffset.top, { duration: 1000 });
            }
        }); //timer = setTimeout(this.slideUpMessage, 10000);

        msg.unbind('click').click(function () {
            if (timer)clearTimeout(timer);
            $("span#show_error", msg).html('');
            $(this).slideUp(700);
        });
    };

    admincommon.showMessage = function (message, status, timeout) {
        this.showMessageDefault(message, status);
        if (timeout) timer = setTimeout(function () { admincommon.slideUpMessage(); }, timeout);
    };

</script>

