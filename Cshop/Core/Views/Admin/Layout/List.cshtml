<script type="text/javascript">

    function ajaxCmdStatus(actionUrl, params, resultHandler) {
        ajaxCmd(actionUrl, params, resultHandler);
    }

    function ajaxCmd(actionUrl, params, resultHandler, showMask, statusMode) {
        $.ajax({
            url: (params && params['lang'] ? actionUrl : urlInjectFocusLang(actionUrl)),
            type: 'POST',
            //contentType: 'application/json; charset=utf-8',
            data: params,
            beforeSend: function() {
                if(showMask || showMask == undefined){ admincommon.hideMessage(); admincommon.showMask(); }
            },
            success: function (result) {
                if(statusMode || statusMode == undefined) {
                    if (result.Status == 0) {
                        if(resultHandler) resultHandler(result);
                    }
                    if (result.Message != null) admincommon.showMessageDefault(result.Message, result.Status);
                }
                else resultHandler(result);
            },
            error: function (e) { admincommon.showMessageDefault('@(StringTable.AjaxCommandErrorMessage)', '@(ActionResultStatus.Fail.ToString())'); },
            complete: function () { admincommon.hideMask(); }
        });
    }

    function ajaxCmdHtml(actionUrl, params, resultHandler, tag) {
        $.ajax({
            url: (params && params['lang'] ? actionUrl : urlInjectFocusLang(actionUrl)),
            type: 'POST',
            data: params,
            beforeSend: function () { admincommon.hideMessage(); admincommon.showMask(); },
            success: function (result) {
                resultHandler(result, tag);
            },
            error: function (e) { admincommon.showMessageDefault('@(StringTable.AjaxCommandErrorMessage)', '@(ActionResultStatus.Fail)'); },
            complete: function () { admincommon.hideMask(); }
        });
    }

</script>

<script type="text/javascript">
    function getFocusLang() {
        return $('#filterLanguage').val();
    }

    function doNavigate(url, optlang, args) {
        var actionargs = $('.js-add-new-selector').attr('actionargs');
        var params = urlToJSON('?' + (actionargs || ''), false);

        if (args) {
            if (typeof(args) == 'string') args = urlToJSON('?' + args, false);
            if (args['action']) {
                url = urlReplaceAction(url, args['action']);
                delete args['action'];
            }
            params = $.extend(params, args);
        }
        params['optlang'] = optlang;

        admincommon.showMask();

        window.location = urlMergeParams(url, params);
    }

    function doAddNew(bChangeItem, controllerName, args) {

        doNavigate('@Html.Raw(ModuleUrl.AdminUrl(controller, (ViewBag.AddAction ?? "").ToString().Equals("Add") ? "Input" : ViewBag.AddAction, 0) + qArgs)', '@lang', args);
        return;

        if ('@listLang.Count' != '0') {

            var popup = new ClawModal("", "modal-mask");
            var formContent = $("#select-input-language-confirmation");
            var formTitle = '@Html.Raw(StringTable.AddNew) ' + controllerName;
            var width = 400;
            if (window.innerWidth <= width) { width = window.innerWidth - 100; }
            var height = 300;
            if (window.innerHeight <= height) { height = window.innerHeight - 100; }
            var windowModal = popup.showModal("#window", formTitle, formContent.html(), 350, 150,
                function (modal) {

                    if ('@(isFrontEnd ? 1 : 0)' == '1') {
                        if (bChangeItem) $("#controllerAdd").kendoDropDownList();
                        else $('#controllerAdd').parent().hide();
                    }

                    modal.find(".add-new-select-lang").click(function () {
                        doNavigate($("#controllerAdd").val(), $(this).data("lang"), args);
                        popup.close(true);
                    });
                });

        }
    }

    $(function() {
        languageFilterInit();
    });

</script>

