@if (ViewBag.UseInlineEdit != null && ViewBag.UseInlineEdit)
{
    <script type="text/javascript">

        function gridOnInlineEdit(event, displayOrder, refreshRowHandler) {

            var grid = event.sender, validatable = grid.editable.validatable, row = event.container, rwuid = row.attr('data-uid');

            grid.select(row);

            row.find('input:visible')
                .focus(function() {
                    validatable.hideMessages();
                    validatable.validateInput($(this));
                })
                .keyup(function() {
                    validatable.validateInput($(this));
                });

            row.find('.k-grid-Edit')
                .addClass('inline-save')
                .attr('title', '@StringTable.Save')
                .unbind('click').click(function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    //console.log('save',e);
                    gridSaveChanges(grid);
                });;

            row.find('.k-grid-Delete')
                .addClass('inline-cancel')
                .attr('title', '@StringTable.Cancel')
                .show()
                .unbind('click').click(function(e) {
                    grid.cancelRow(); admincommon.hideMessage();

                    var newRw = $('tr[data-uid=' + rwuid + ']', grid.element);

                    newRw.find('.k-grid-Edit').removeClass('inline-save')
                        .addClass('edit_fr').attr('title', '@StringTable.Edit');

                    newRw.find('.k-grid-Delete').removeClass('inline-cancel')
                        .addClass('delete_fr').attr('title', '@StringTable.Delete');

                    newRw.dblclick(function() {
                        if (!grid.editable) grid.editRow($(this));
                    });

                    //console.log('cancel', newRw, row.selector,grid.dataItem(newRw));
                    if (refreshRowHandler)refreshRowHandler(grid, newRw);//gridRefreshRow(grid, rowEle)
                    //grid.refresh({ action: 'rebind', items: [grid.dataItem(newRw)] });
                    if (grid.clawRowEditEventHandler)grid.clawRowEditEventHandler(grid, newRw);
                });

            if (displayOrder) {
                var dorder = row.find(displayOrder);
                dorder.kendoNumericTextBox({
                    format: '####',
                    decimals: 0,
                    upArrowText: '@StringTable.NumTxtBoxUpArrow',
                    downArrowText: '@StringTable.NumTxtBoxDownArrow',
                });

                var numTxtBox = dorder.closest('.k-numerictextbox').find('input');
                numTxtBox.removeClass('text-box');
                numTxtBox.addClass('numeric-text-box sort-order');
            }

            var gridEditTimer = function() {
                var editable = grid.editable;
                if (editable) {
                    if (document.hasFocus() && $('input:focus,a:focus', row).length == 0 && editable.validatable.validate()) {
                        var node = editable.element.find('.k-grid-Edit');
                        setTimeout(function() { node.click(); }, 200);
                    } else setTimeout(gridEditTimer, 100);
                }
            };

            //setTimeout(gridEditTimer, 100);

            setTimeout(function() { row.find('input[type=text]:visible').first().focus(); }, 100);

            row.find('input:visible').each(function() {
                if($(this).data('valNumber')) {
                    var data = $(this).data();
                    if (data.valRangeMax) data.valRangeMax = kendo.parseFloat(data.valRangeMax);
                    if (data.valRangeMin) data.valRangeMin = kendo.parseFloat(data.valRangeMin);
                }
            });
        }

        function gridCmdInlineEdit(id, uid) {
            var grid = $('#' + id).data('kendoGrid'), editable = grid.editable;
            var row = $('tr[data-uid=' + uid + ']', grid.element);
            if (editable) {
                var node = editable.element.find('.k-grid-Edit');
                if (node.hasClass('inline-save')) {
                    editable.element.find('input[type=text]').each(function() {
                        $(this).val($.trim($(this).val()));
                        $(this).change();
                    });
                    gridSaveChanges(grid);
                }
            }
            else { grid.select(row); grid.editRow(row);}
        }

        function gridSaveChanges(grid) {
            if (!grid.clawReqStartTime || Date.now() - grid.clawReqStartTime > 15000) {
                grid.saveRow();
            } else setTimeout(function() {
                console.log('save row delayed', Date.now(), grid.clawReqStartTime);
                gridSaveChanges(grid);
            }, 500);
        }

    </script>

    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.editable.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.binder.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.validator.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.aspnetmvc.js"></script>
    <script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/cultures/kendo.culture.@(langObj.LanguageCode).js"></script>

    <script type="text/javascript">
        var currentCulture = kendo.cultures["@langObj.LanguageCode"], numberFormat = currentCulture.numberFormat;
        numberFormat[','] = '@langObj.ThousandsSeperator';
        numberFormat['.'] = '@langObj.DecimalSeperator';
        numberFormat.percent[','] = numberFormat[','];
        numberFormat.percent['.'] = numberFormat['.'];
        numberFormat.currency[','] = numberFormat[','];
        numberFormat.currency['.'] = numberFormat['.'];

        kendo.culture('@langObj.LanguageCode');

        function localizeParseFloat(value) {
            return kendo.parseFloat(value, '@langObj.LanguageCode');
        }

        function localizeFloatToString(value, format) {
            return kendo.toString(value, format || 'n2', kendo.cultures['@langObj.LanguageCode']);
        }

        function localizeMoneyToString(value, format) {
            format = format || '@SettingsBiz.GetSettings().Display.Others.GetPriceFormat()';
            return kendo.toString(value, format, kendo.cultures['@langObj.LanguageCode']);
        }

        function localizeDateToString(value, format) {
            format = format || '@SettingsBiz.GetSettings().Display.Others.GetDateFormat()';
            return kendo.toString(value, format, kendo.cultures['@langObj.LanguageCode']);
        }

        function formUpdateValidRules(node) {
            $.validator.unobtrusive.parse(node);

            var form = node.first().closest('form');
            var unobtrusiveValidation = form.data('unobtrusiveValidation');
            var validator = form.validate();

            $.each(unobtrusiveValidation.options.rules, function (elname, elrules) {
                if (!validator.settings.rules[elname]) {
                    var args = $.extend({}, elrules);
                    args.messages = unobtrusiveValidation.options.messages[elname];
                    form.find("[name='" + elname + "']").rules("add", args);
                }
            });
        }

    </script>
}

@if (ViewBag.UseImgPreview != null && ViewBag.UseImgPreview)
{
    <style type="text/css">
        #imgPreview {
            max-width: 200px;
            max-height: 200px;
            width: 200px;
        }

            #imgPreview img {
                max-width: 200px;
                width: 200px;
            }

        .preview img {
            max-height: 60px;
            box-shadow: 2px 2px 3px #555562;
        }
    </style>

    <script type="text/javascript">

        function initImagePreviewRaw(fancybox, holder, autoPreview) {
            var xOffset = -20, yOffset = 40, wSpace = 30, hSpace = 40;
            var items = $("a.preview[href!=''][href!='@Claw.Modules.Eshop.Models.ImageModel.NoImg']", holder);

            $("a.preview[href=''],a.preview[href='@Claw.Modules.Eshop.Models.ImageModel.NoImg']", holder).click(function () { return false; }).css({ 'cursor': 'default' });

            if (autoPreview == null || autoPreview)
                items.hover(function(e) {
                    this.t = this.title;
                    this.title = "";
                    var c = (this.t != "") ? "<br/>" + this.t : "";
                    $("body").append("<p id='imgPreview'><img src='" + this.href + "' alt='Image preview' />" + c + "</p>");
                    var topP = e.pageY - xOffset, leftP = e.pageX + yOffset;

                    var previewB = $("#imgPreview");
                    var bottomP = topP + previewB.height() - $(window).scrollTop() + wSpace;
                    if (window.innerHeight >= previewB.height() + wSpace) {
                        var remainHeight = bottomP - window.innerHeight;
                        if (remainHeight > 0) topP -= remainHeight;
                    }

                    var rightP = leftP + previewB.width() - $(window).scrollLeft() + hSpace;
                    if (window.innerWidth >= previewB.width() + hSpace) {
                        var remain = rightP - window.innerWidth;
                        if (remain > 0) leftP = e.pageX - yOffset - previewB.width();
                    }

                    $("#imgPreview").css("top", topP + "px").css("left", leftP + "px").fadeIn("slow");
                },
                    //handlerOut (leave)
                    function() {
                        this.title = this.t;
                        $("#imgPreview").remove();
                    }
                );

            if (autoPreview == null || autoPreview)
                items.mousemove(function(e) {
                    var topP = e.pageY - xOffset, leftP = e.pageX + yOffset;
                    var previewB = $("#imgPreview");
                    var bottomP = topP + previewB.height() - $(window).scrollTop() + wSpace;
                    if (window.innerHeight >= previewB.height() + wSpace) {
                        var remainHeight = bottomP - window.innerHeight;
                        if (remainHeight > 0) topP -= remainHeight;
                    }

                    var rightP = leftP + previewB.width() - $(window).scrollLeft() + hSpace;
                    if (window.innerWidth >= previewB.width() + hSpace) {
                        var remain = rightP - window.innerWidth;
                        if (remain > 0) leftP = e.pageX - yOffset - previewB.width();
                    }

                    $("#imgPreview").css("top", topP + "px").css("left", leftP + "px");
                });

            if(fancybox == undefined || fancybox)
                items.fancybox({ width: 800, height: 600, autoScale: false, fitToView: true });
            else items.click(function () { return false; }).css({ 'cursor': 'default' });
        };

    </script>

    @Html.CssBundle("~/content/plugin/fancybox/fancybox.css", "~/Content/plugin/fancybox/jquery.fancybox.css")
    <script src="~/Content/plugin/fancybox/jquery.fancybox.pack.js"></script>
}

