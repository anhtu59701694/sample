    <script type="text/javascript">

        function selfDiscValueChangeFormat(format) {
            var node = $('#@Html.IdFor(m => m.SelfDiscValue)').data('kendoNumericTextBox'), percentHint = $('#selfdisc-percent-label');
            node.options.format = format == 'p' ? 'n2' : format;
            node.options.clawformat = format;
            node.options.min = 1;
            node.options.max = format == 'p' ? 100 : null;
            node.options.step = format == 'p' ? 5 : 1;
            node._update(node.value());

            if (format == 'p') percentHint.show();
            else percentHint.hide();
        }

        $(function(){

            initKendoNumeric('input.kendo-numeric', { format: "n" });

            var selfDiscActive = $('#SelfDiscActiveTrue');

            $('#SelfDiscActiveTrue,#SelfDiscActiveFalse').change(function(){
                var active = selfDiscActive.prop('checked'), discountBox = $('.self-discount-box .self-discount');

                if(active) discountBox.show(); else discountBox.hide();
                console.log('formDisableValidation',!active);
                formDisableValidation($('#@Html.IdFor(m => m.SelfDiscMinQty),#@Html.IdFor(m => m.SelfDiscValue)'), !active);
            });

            $('#SelfDiscTypeTrue,#SelfDiscTypeFalse').change(function(){
                selfDiscValueChangeFormat($('#SelfDiscTypeTrue').prop('checked') ? 'n' : 'p');
            }).first().change();

            if(!window.formUpdateValidRulesBackupSelfDisc){
                formUpdateValidRulesBackupSelfDisc = formUpdateValidRules;
                formUpdateValidRules = function(node){
                    formUpdateValidRulesBackupSelfDisc(node);
                    setTimeout(function(){selfDiscActive.change();},500);
                }
            }

            setTimeout(function(){selfDiscActive.change();},3000);
        })

    </script>
}

