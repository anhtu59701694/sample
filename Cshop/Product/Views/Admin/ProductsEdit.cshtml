@helper RenderTechSVals()
{
    <section class="row_content_box">
        <section class="clo_left txt_align_r">
            <h2>@Html.LocalizeNameFor(m => m.TechSVals)</h2>
            <label></label>
            <div class="clear_fix"></div>
        </section>
        <section class="clo_right col-right-eshop">
            <div class="controls">
                @{
                    var techSpecId = 0;
                    var odDataTechspecId = SettingsBiz.GetSettings().Hidden.OrderDetailDataTechspecId;
                    List<System.Tuple<int, ProductTechSValModel>> tsVals = null;
                    var techSpecs = new List<List<System.Tuple<int, ProductTechSValModel>>>();
                }
                @for (int k = 0; k < Model.TechSVals.Count; k++)
                {
                    var index = k;
                    if (techSpecId != Model.TechSVals[index].TechSpecId)
                    {
                        techSpecs.Add(tsVals = new List<System.Tuple<int, ProductTechSValModel>>());
                    }
                    tsVals.Add(new System.Tuple<int, ProductTechSValModel>(index, Model.TechSVals[index]));
                    techSpecId = Model.TechSVals[index].TechSpecId ?? 0;
                }
                @foreach (var tSpec in techSpecs.OrderBy(m => (m[0].Item2.TechSpecId == odDataTechspecId ? "z_" : "a_") + m[0].Item2.TechSpecName))
                {
                    var index = tSpec[0].Item1;
                    <div class="techspec-box" data-id="@(Model.TechSVals[index].TechSpecId)">
                        <div class="techspec-item @(Model.TechSVals[index].TechSpecActive ? "" : "inactive")">
                            @Model.TechSVals[index].TechSpecName
                        </div>
                        <ul class="techspec-item-list" @*data-items="@tSpec.Count(m => m.Item2.Selected)"*@>
                            @foreach (var tsVal in tSpec@*.Where(m => m.Item2.Selected).Concat(tSpec.Where(m => !m.Item2.Selected))*@)
{
index = tsVal.Item1;
<li class="techspecval-item" data-id=@(Model.TechSVals[index].TechSpecValId ?? 0) data-specid=@(Model.TechSVals[index].TechSpecId ?? 0)>
    @Html.HiddenFor(m => m.TechSVals[index].TechSpecId)
    @Html.HiddenFor(m => m.TechSVals[index].TechSpecValId)
    @Html.LocalizeCheckBoxFor(m => m.TechSVals[index].Selected, new { @class = "css-checkbox", @value = "true" })
    <label for="@Html.IdFor(m => m.TechSVals[index].Selected)" class="css-labelcheck">
        @if (Model.TechSVals[index].TechSpecValId != 0)
        {@Model.TechSVals[index].TechSpecValName}
    </label>
    <input name="@Html.NameFor(m => m.TechSVals[index].Selected)" type="hidden" value="false" />
    @if (Model.TechSVals[index].TechSpecValId == 0)
    {
        @Html.LocalizeTextBoxFor(m => m.TechSVals[index].TechSpecValName, new { })
    }
</li>
}
                        </ul>
                    </div>
                }
            </div>
            @if (odDataTechspecId != 0)
            {
                <div class="controls" id="techspeccostextra-box" style="display:none;">
                    <section>
                        <span class="text-eshop">@Html.LocalizeNameFor(m => m.TechSpecCostExtra)</span>
                    </section>
                    <section>
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.TechSpecCostExtra, new { @class = "custom-price-number kendo-numeric", @style = "", })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.TechSpecCostExtra)</section>
                    </section>
                </div>
            }
        </section>
        <script type="text/javascript">
            $(function() {
                var singleValue = '0';@*'@(SettingsBiz.GetSettings().Hidden.SingleTechSpecValue ? 1 : 0)'*@;

                $('.techspecval-item input[type=checkbox]').change(function() {
                    var sval = $(this).closest('.techspecval-item');
                    if($(this).prop('checked') && singleValue == '1')
                        $('.techspecval-item[data-specid=' + sval.attr('data-specid') + '][data-id!=' + sval.attr('data-id') + '] input[type=checkbox]:checked').prop('checked', false).change();
                });

                $('.techspecval-item[data-id=0] input[type=checkbox]').change(function() {
                    $(this).closest('.techspecval-item').find('input[type=text]').prop('disabled', !$(this).prop('checked'));
                }).change();

				$('.techspec-item').click(function() {
					var lst = $(this).closest('.techspec-box').find('.techspec-item-list');
                    if(lst.is(':visible'))lst.hide();
