                    var qty = parseInt($(this).val()), statusId = statusKd.value();
                    if(qty > 0 && (!statusId || statusId == 3)) { statusKd.value(2); statusKd.element.change();}
                    else if(qty <= 0 && (!statusId || statusId == 2)) { statusKd.value(3); statusKd.element.change();}
                });
            }, 1000);
        </script>

    }
    <script type="text/javascript">
        setTimeout(function(){
            $('#@Html.IdFor(m => m.CostPrice), #@Html.IdFor(m => m.CostPriceInc), #@Html.IdFor(m => m.Price), #@Html.IdFor(m => m.PriceInc), #@Html.IdFor(m => m.SalePrice), #@Html.IdFor(m => m.SalePriceInc)')
                .change(function(){ DisplayProfit();variantPriceUpdate($(this)); }).change();}, 1000);

            function DisplayProfit(){

				if(!window.getPriceValue){
					setTimeout(function(){ DisplayProfit(); }, 500);
					return;
				}

                if(window.DisplayProfitTimer) clearTimeout(window.DisplayProfitTimer);

                window.DisplayProfitTimer = setTimeout(function(){
                    var costPrice = $('#@Html.IdFor(m => m.CostPrice)'), costPriceInc = $('#@Html.IdFor(m => m.CostPriceInc)');
                var price = $('#@Html.IdFor(m => m.Price)'), priceInc = $('#@Html.IdFor(m => m.PriceInc)');
                var saleprice = $('#@Html.IdFor(m => m.SalePrice)'), salepriceInc = $('#@Html.IdFor(m => m.SalePriceInc)');
                var box = $('.profit-box'), costPriceVal = getPriceValue(costPrice);
                var salepriceVal = getPriceValue(saleprice), salepriceIncVal = getPriceValue(salepriceInc);
                var priceVal = salepriceVal != null ? salepriceVal : getPriceValue(price);
                var priceIncVal = salepriceIncVal != null ? salepriceIncVal : getPriceValue(priceInc);
                var profitExc = priceVal - costPriceVal, profitInc = priceIncVal - getPriceValue(costPriceInc);

                if(costPriceVal){
                    $('.profit-exc-money', box).html(localizeMoneyToString(profitExc));
                    $('.profit-exc-percent', box).html(localizeFloatToString(100*profitExc/costPriceVal) + ' %');
                    $('.profit-inc-money', box).html(localizeMoneyToString(profitInc));
                    $('.profit-inc-percent', box).html(localizeFloatToString(100*profitInc/priceIncVal) + ' %');
                    box.show();
                } else box.hide();
            }, 500);
        }

        function variantPriceUpdate(node) {

            if(window.Debug) console.log('variantPriceUpdate', window.event, Date.now(), node);

            if(!node.valid() || !window.event || !window.event.target ||
                (window.event.target.constructor && window.event.target.constructor.name == 'XMLHttpRequest')  ||
                $('#Id').val() == '0' || !$('#grid').is(':visible')) return;

            if(window.variantPriceUpdateTimer) clearTimeout(window.variantPriceUpdateTimer);

            window.variantPriceUpdateTimer = setTimeout(function() {

                if($('#modal.confirm-dlg').length != 0) return;

                showConfirmDialog('@StringTable.Confirmation', '@("cascade update variant price confirm text".ModLocalize("The based price of product has new value. Do you want to apply this new price to all variants also?"))',
                    function(dialog, kendoWindow){

                        var nodeMap = { 'CostPriceInc':'CostPrice', 'Price':'PriceInc', 'SalePrice':'SalePriceInc' };
                        var mapId = nodeMap[node.attr('id')];

                        if(mapId) node = $('#' + mapId);

                        var valNew =  getPriceValue(node), valNew2 = null, doneMap = {}, databindFld = null, databind2Fld = null;
                        var fieldName = node.attr('name'), valNewTxt = localizeMoneyToString(valNew), valNew2Txt = null;

                        $('input.var-cell[data-bind][name$=".' + fieldName + '"]', '#grid').each(function(){
                            var nodeKd = $(this).data('kendoNumericTextBox');

                            if (nodeKd) nodeKd.value(valNew);
                            if (!databindFld) databindFld = $(this).attr('data-bind')

                            $(this).val(valNewTxt).change();

                            doneMap[$(this).attr('id').toLowerCase()] = true;
                        });

                        if(fieldName == 'CostPrice') {
                            valNew2 =  getPriceValue($('#CostPriceInc'));
                            valNew2Txt = localizeMoneyToString(valNew2);
                            $('input.var-cell[data-bind][name$=".CostPriceInc"]', '#grid').each(function(){
                                var nodeKd = $(this).data('kendoNumericTextBox');

                                if (nodeKd) nodeKd.value(valNew2);
                                if (!databind2Fld) databind2Fld = $(this).attr('data-bind')

                                $(this).val(valNew2Txt).change();
                            });
                        }

                        if(databindFld)
                            grid.data('kendoGrid').dataSource.data().forEach(function(rw){
                                if(!doneMap[fieldName.toLowerCase() + '-' + rw.Id]) {
                                    if(!rw.VariantForm)rw.VariantForm = varFormDic[rw.Key];
                                    if(rw.VariantForm){
                                        bindInputField(rw.VariantForm, rw, databindFld.replace(/[_]/g, '.'), valNewTxt);
                                        if(fieldName == 'CostPrice' && valNew2Txt && databind2Fld)
                                            bindInputField(rw.VariantForm, rw, databind2Fld.replace(/[_]/g, '.'), valNew2Txt);
                                    }
                                    else console.log('variantPriceUpdate.Err', node, rw, databindFld, valNewTxt);
                                }
                            });
                        else console.log('variantPriceUpdate.databindFld is null', node);

                        dialog.close();
                    });
            }, 500);
        }

    </script>
}

