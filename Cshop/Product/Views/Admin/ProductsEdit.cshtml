                        <script type="text/javascript">

                            function initTagEvent(id, displayBoxCls, holder) {
                                $('.es-btn-close a', holder || ('.' + displayBoxCls)).unbind('click').click(function () {
                                    DeleteTag(displayBoxCls, id, $(this));
                                });
                            }

                            function DeleteTag(csShowTag, idHidenTags, $this) {
                                var index = $('.' + csShowTag).find('.es-btn-close a').index($this);
                                if (index > -1) {
                                    $('.' + csShowTag).find(".tags-name").eq(index).remove();

                                    var objhdTags = $(this).parent().parent().parent();
                                    var indexBtn = $("." + csShowTag).index(objhdTags);

                                    var item = $('#' + idHidenTags).eq(indexBtn).val();//.slice(0, -1);
                                    if (item != '') {
                                        var Array = item.split(',');
                                        Array.splice(index, 1);
                                        $('#' + idHidenTags).eq(indexBtn).val(Array.join(','));
                                    }
                                }
                            }

                            function LoadFirst(idHidenTags, csShowtagsName) {
                                $('.' + csShowtagsName).html('');
                                $("#" + idHidenTags).each(function (index) {
                                    var result = $(this).val();

                                    if (result != '') {
                                        var arr = result.split(',');
                                        $.each(arr, function (i, value) {
                                            $("." + csShowtagsName).eq(index).append("<div class='tags-name'> " + value + " <span class='es-btn-close' ><a href='javascript:void(0)' title=''>close</a></span> </div>");
                                        });
                                    }
                                });
                            }

                            function AddTags(cstxtTags, idHidenTags, csShowTag) {
                                var objTags = $("." + cstxtTags);
                                var objhdTags = $("#" + idHidenTags);
                                var value = objTags.val().trim();

                                if (value != '') {
                                    var result = objhdTags.val();

                                    var arrHide = result.split(',');
                                    var arrInput = value.replace(/\;/g, ',').replace(/\./g, ',').split(',');
                                    var arrtemp = new Array();

                                    $.each(arrInput, function (i, valueArr) {
                                        if (valueArr.trim() != '') {
                                            var found = $.inArray(valueArr, arrHide) > -1;
                                            var foundTemp = $.inArray(valueArr, arrtemp) > -1;//temp array

                                            if (!found && !foundTemp) {
                                                var newTag = $("<div class='tags-name'> " + valueArr + " <span class='es-btn-close' ><a href='javascript:void(0)' title=''>close</a></span> </div>");
                                                $("." + csShowTag).append(newTag);
                                                arrtemp.push(valueArr);//add temp
                                                initTagEvent(idHidenTags, csShowTag, newTag);
                                            }
                                        }
                                    });
                                    if (arrtemp.length > 0) {
                                        if (result == '')
                                            result = arrtemp.join(',');
                                        else
                                            result += "," + arrtemp.join(',');

                                        objhdTags.val(result);
                                        objTags.val('');
                                        objTags.focus();
                                        objhdTags.valid();

                                    } else {
                                        objTags.focus();
                                        formShowErrorMsg(objhdTags.attr('name'), '@StringTable.ErrMsgDuplicateTag', objhdTags.closest('form'));
                                        setTimeout(function () { objhdTags.valid(); }, 10000);
                                    }
                                }
                            }

                            function initTags(id, displayBoxCls) {
                                LoadFirst(id, displayBoxCls);
                                initTagEvent(id, displayBoxCls);
                            }

                        </script>


                    </div>
                </div>
