                        </div>
                    </section>
                </div>
                <div class="input-col-2 check-price price-ck-variant" data-variants="0">
                    <span class="text-eshop">@Html.LocalizeNameFor(m => m.PriceCkVariant)</span>
                    <section style="vertical-align: top">
                        @Html.LocalizeRadioButtonFor(model => model.PriceCkVariant, "true", new { @id = "PriceCkVariantTrue", @class = "css-radio" })
                        <label for="PriceCkVariantTrue" class="css-labelradio">@StringTable.Yes</label>
                        @Html.LocalizeRadioButtonFor(model => model.PriceCkVariant, "false", new { @id = "PriceCkVariantFalse", @class = "css-radio" })
                        <label for="PriceCkVariantFalse" class="css-labelradio">@StringTable.No</label>
                    </section>
                </div>
            </section>
            <section class="controls">
                <div class="input-col-1 check-price">
                    <span class="text-eshop">@Html.LocalizeNameFor(m => m.PriceCkUrl)</span>
                    <section>
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.PriceCkUrl, new { @style = "width:80% !important" })
                            <input id="btn-apply-checkprice" class="btn" value="@StringTable.PriceCkApply" style="width:15%;margin:0;" type="button">
                            <div id="pricecheck-minprice">
                                <span class="text">@StringTable.PriceCkMinPrice: </span><span class="value"></span>
                                <img id="pricecheck-loading" src="/Areas/admin/styles/images/loading_input.gif" style="display: none;padding-left: 7px;vertical-align: middle;">
                            </div>
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.PriceCkUrl)</section>
                    </section>
                </div>
                <div class="input-col-2 check-price">
                    <span class="text-eshop">@Html.LocalizeNameFor(m => m.PriceCkMinVal)</span>
                    <section>
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.PriceCkMinVal, new { @class = "kendo-numeric", @style = "padding-top: 0;" })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.PriceCkMinVal)</section>
                    </section>
                </div>
            </section>

            <section class="controls">
                <div class="input-col-1 check-price">
                    <span class="text-eshop">@Html.LocalizeNameFor(m => m.PriceCkDateFrom)</span>
                    <section>
                        <section>
                            @Html.LocalizeDateTextBoxFor(m => m.PriceCkDateFrom, Model.Id, new { @style = "" })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.PriceCkDateFrom)</section>
                    </section>
                </div>
                <div class="input-col-2 check-price">
                    <span class="text-eshop">@Html.LocalizeNameFor(m => m.PriceCkDateTo)</span>
                    <section>
                        <section>
                            @Html.LocalizeDateTextBoxFor(m => m.PriceCkDateTo, Model.Id, new { @style = "" })
                        </section>
                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.PriceCkDateTo)</section>
                    </section>
                </div>
            </section>
        </section>
    </section>
    <script type="text/javascript">

    $(function(){

        initKendoNumeric('input.kendo-numeric', { format: "n2" });

        var priceCkActive = $('#PriceCkActiveTrue'), priceCkVariant = $('#PriceCkVariantTrue');
        var priceCkUrl = '@SettingsBiz.GetSettings().Hidden.PriceCheckUrl';

        function priceckSetValue(node, value) {
            var nodeKd = node.data('kendoNumericTextBox');
            if (nodeKd) nodeKd.value(value);
            else node.val(localizeMoneyToString(value));
        }

        function priceCkApply(urlNode, priceNodes, minCkValNode) {

            if(!urlNode.valid() || !urlNode.val()) return;

            ajaxREST(priceCkUrl.replace('{url}', urlNode.val()), 'GET', {}, null, function(result) {
                if(result.status == 'ok' && result.items && result.items.length > 0){
                    var minPrice = null, minCkVal = getPriceValue(minCkValNode);
                    result.items.forEach(function(itm){if(!minPrice || itm.price < minPrice) minPrice = itm.price;});

                    if(minCkVal == null || minCkVal <= minPrice)
                        priceNodes.each(function(){ priceckSetValue($(this), minPrice);$(this).change() });

                } else formShowErrorMsg(urlNode.attr('name'), '@StringTable.PriceCkNotFound');
            });
        }

        $('#btn-apply-checkprice').click(function(){

            var variants = priceCkVariant.closest('.price-ck-variant').attr('data-variants');
            var priceCkUrl = $('#@Html.IdFor(m => m.PriceCkUrl)'), priceCkMinVal = $('#@Html.IdFor(m => m.PriceCkMinVal)');

            if(priceCkVariant.prop('checked') || variants == '0') {
                if(variants == '0') priceCkApply(priceCkUrl, $('#@Html.IdFor(m => m.SalePriceInc)'), priceCkMinVal);
                else priceCkApply(priceCkUrl, $('.var-salepriceinc[data-bind]', '#grid'), priceCkMinVal);
            }
            else {
                $('.var-priceckurl', '#grid').each(function(){
                    var trNode = $(this).closest('tr');
                    if($(this).val()) priceCkApply($(this), $('.var-salepriceinc[data-bind]', trNode), $('input.var-priceckminval[data-bind]', trNode));
                })
            }
        });

        $('#PriceCkActiveTrue,#PriceCkActiveFalse').change(function(){
            var active = priceCkActive.prop('checked'), priceCkBox = $('.check-price-box .check-price');

            if(active) { priceCkBox.show(); $('#PriceCkUrl').change();}
            else priceCkBox.hide();

            priceCkVariant.change();
        });

        $('#@Html.IdFor(m => m.PriceCkUrl)').change(function() {
            if(priceCkActive.prop('checked') && $(this).val()) {

                ajaxREST(priceCkUrl.replace('{url}',$(this).val()), 'GET', {}, 'pricecheck-loading', function(result) {
                    if(result.status == 'ok' && result.items && result.items.length > 0){
                        var minPrice = null;
                        result.items.forEach(function(itm){if(!minPrice || itm.price < minPrice) minPrice = itm.price;});
                        $('#pricecheck-minprice .value').html(localizeMoneyToString(minPrice));
                    } else $('#pricecheck-minprice .value').html('@StringTable.PriceCkNotFound');
                });

                $('#pricecheck-minprice').show();
            }
            else $('#pricecheck-minprice').hide();
        });

        $('#PriceCkVariantTrue,#PriceCkVariantFalse').change(function(){
            var active = priceCkActive.prop('checked') && !priceCkVariant.prop('checked');

            $('.var-priceckurl,.var-priceckminval').attr('data-active', active ? 1 : 0);

            if(active) $('#grid').addClass('price-check');
            else $('#grid').removeClass('price-check');

            var activeValid = priceCkActive.prop('checked') && (priceCkVariant.prop('checked') || priceCkVariant.closest('.price-ck-variant').attr('data-variants') == '0');

            console.log('PriceCkUrl valid active', activeValid, Date.now());

            formDisableValidation($('#@Html.IdFor(m => m.PriceCkUrl),#@Html.IdFor(m => m.PriceCkMinVal)'), !activeValid);
        });

        if(!window.formUpdateValidRulesBackupPriceCk){
            formUpdateValidRulesBackupPriceCk = formUpdateValidRules;
            formUpdateValidRules = function(node){
                formUpdateValidRulesBackupPriceCk(node);
                setTimeout(function(){
                    priceCkActive.change();
                }, 500);
            }
        }

        setTimeout(function(){priceCkActive.change();}, 2000);
    })

    </script>
}

@helper RenderCustomerDiscount()
{
    var settings = SettingsBiz.GetSettings();
    var custGroups = Claw.Modules.Eshop.DAL.CustGroupMgr.GetAll(new DefaultDb()).Where(m => !settings.Hidden.CustomerDiscountByGroup || m.Discount).ToList();
    <section class="wr-line-eshop"></section>
    <section class="row_content_box validable-form-field">
        <section class="clo_left txt_align_r">
            <h2>@Html.LocalizeNameFor(m => m.CGroupDiscounts)</h2>
            <label></label>
            <div class="clear_fix"></div>
        </section>
        <section class="clo_right col-right-eshop">
            <div class="controls" id="cgroup-discount-box">
                <ul style="list-style-type: none;margin-left: 20px;">
                    @for (var i = 0; i < Model.CGroupDiscounts.Count; i++)
                    {
                        var idx = i;
                        <li class="cgroup-discount-item @(Model.CGroupDiscounts[idx].DirDiscount ? "disabled" : "")">
                            <div class="" style="display: inline-block;">
                                <div style="width: auto;display: inline-block;vertical-align: top;margin-right: 30px;min-height:31px;">
                                    @Html.LocalizeCheckBoxFor(m => m.CGroupDiscounts[idx].Active, new { @class = "cgdiscount-active css-checkbox", @value = "true" })
                                    <label for="@Html.IdFor(m => m.CGroupDiscounts[idx].Active)" class="css-labelcheck">@Html.LocalizeNameFor(m => m.CGroupDiscounts[idx].Active)</label>
                                    <input name="@Html.NameFor(m => m.CGroupDiscounts[idx].Active)" value="false" type="hidden">
                                </div>
                                <div class="discount-type">
                                    <span class="text-eshop" style="width: auto;margin-right: 10px;">@Html.LocalizeNameFor(m => m.CGroupDiscounts[idx].Type): </span>
                                    <section style="width: 230px;">
                                        @Html.LocalizeRadioButtonFor(model => model.CGroupDiscounts[idx].Type, "true", new { @id = "CGroupDiscountsTypeTrue" + i, @class = "cgdiscount-type css-radio" })
                                        <label for="CGroupDiscountsTypeTrue@(i)" class="css-labelradio">@StringTable.CustGroupDiscType(true)</label>
                                        @Html.LocalizeRadioButtonFor(model => model.CGroupDiscounts[idx].Type, "false", new { @id = "CGroupDiscountsTypeFalse" + i, @class = "cgdiscount-type css-radio" })
                                        <label for="CGroupDiscountsTypeFalse@(i)" class="css-labelradio">@StringTable.CustGroupDiscType(false)</label>
                                    </section>
                                </div>
                            </div>
                            <div class="discount-values" style="display: inline-block;">
                                @if (Model.CGroupDiscounts[idx].DirDiscount)
                                {
                                    <div class="variant-desc">@(Model.CGroupDiscounts[idx].VariantDesc)</div>
                                }
                                <div>
                                    <div class="discount-group" style="display: inline-block;">
                                        @Html.LocalizeDropDownListKendoFor(m => m.CGroupDiscounts[idx].GroupId, custGroups.Select(m => new SelectListItem()
                                        {
                                            Value = m.Id.ToString(),
                                            Text = m.Name
                                        }), StringTable.SelectGroup, new { @class = "" })
                                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.CGroupDiscounts[idx].GroupId)</section>
                                    </div>
                                    <div class="discount-rate" style="display: inline-block;">
                                        @Html.LocalizeTextBoxFor(m => m.CGroupDiscounts[idx].Rate, new
                                        {
                                            @class = "cgdiscount-rate kendo-numeric",
                                            @style = "width:100px",
                                            @placeholder = Html.LocalizeNameFor(m => m.CGroupDiscounts[idx].Rate),
                                            @onfocus = "cgdiscountRateOnFocus(this)"
                                        })
                                        <section class="field-valid-msg">@Html.LocalizeValidationMessageFor(m => m.CGroupDiscounts[idx].Rate)</section>
                                    </div>
                                    <span class="percent-label" style="display:none;"> %</span>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </section>
        <script type="text/javascript">

            $('.cgroup-discount-item.disabled input', '#cgroup-discount-box').prop('disabled', true);

            setTimeout(function () {
                $('.cgdiscount-active', '#cgroup-discount-box').unbind('change').change(function () {
                    var parent = $(this).closest('li');
                    var box = $('.discount-type, .discount-values', parent);
                    if ($(this).prop('checked')) {
                        box.show(); formDisableValidation($('.discount-values input[id]', parent), false);
                    }
                    else {
                        box.hide(); formDisableValidation($('.discount-values input[id]', parent), true);
                    }
                }).change();

                $('.cgdiscount-type', '#cgroup-discount-box').unbind('change').change(function () {
                    var parent = $(this).closest('li'), _this = $(this);
                    var percentLabel = $('.percent-label', parent);
                    var rateKd = $('.cgdiscount-rate[id]', parent).data('kendoNumericTextBox');

                    if (!rateKd) {
                        setTimeout(function () { _this.change(); }, 500);
                        console.log('cgdiscount delayed');
                        return;
                    }

                    if ($('input[name="' + $(this).attr('name') + '"]:checked', parent).val() == 'true') {
                        percentLabel.hide();
                        rateKd.setOptions({ min: 0.00, max: null, step: 1, format: 'n2' });
                    }
                    else {
                        percentLabel.show();
                        rateKd.setOptions({ min: 0.00, max: 100.00, step: 1, format: 'n2' });
                    }
                }).change();


            }, 1500);

            function cgdiscountRateOnFocus(node) {
                var parent = $(node).closest('li');
                var rateKd = $('.cgdiscount-rate[id]', parent).data('kendoNumericTextBox');
                var percentLabel = $('.percent-label', parent);
                if (!$('.percent-label', parent).is(':visible')) {
                    rateKd.setOptions({ max: getPriceValue($('#SalePriceInc')) || getPriceValue($('#PriceInc')) });
                }
            }

            if (!window.formUpdateValidRulesBackupCgDiscount) {
                formUpdateValidRulesBackupCgDiscount = formUpdateValidRules;
                formUpdateValidRules = function (node) {
                    formUpdateValidRulesBackupCgDiscount(node);
                    setTimeout(function () {
                        $('.cgdiscount-active', '#cgroup-discount-box').change();
                    }, 500);
                }
            }

        </script>
    </section>
}

