                $('#IsAassortmentTrue, #IsAassortmentFalse').change(function () {
                    if ($('#IsAassortmentTrue').prop('checked')) {
                        $(".wr-aassortment-threshold").show();
                    }
                    else $(".wr-aassortment-threshold").hide();
                }).change();

                function emailMUserSend(variantid, sender) {
                    var sendEmail = function(send, subject, body, funcResult) {
                        ajaxCmd('@ModuleUrl.AdminUrl("EmailMarketUser", "SendEmail")', {
                            lang: getFocusLang(), send: send, productid: @(Model.Id), variantid: variantid, subject: subject, body: body
                        }, function(result) {
                            if (result.Message != null) {
                                admincommon.showMessageDefault(result.Message, result.Status);
                                if(result.Status)alert(result.Message);
                            }
                            if(result.Status == 0 && !send) {
                                if(result.Count) showSendEmailDialog('@StringTable.EmailMUserSend', result.ProductImg, result.Subject, result.Body, function(content) {
                                    var ckNode = CKEDITOR.instances['sendemailBody'];
                                    sendEmail(true, content.find('.subject').val(), $.trim(ckNode.getData()), function(){ if(sender) $(sender).closest('.emailmusers').hide(); });
                                });
                                else setTimeout(function(){ var msg; admincommon.showMessage(msg = '@StringTable.EmailMUserListEmpty'); alert(msg); }, 1000);
                            }
                            else if(result.Status == 0 && send && funcResult) funcResult(result);
                        });
                    };

                    sendEmail(false);
                }


                function showSendEmailDialog(title, img, subject, body, okHandler) {

                    var scrollTop = $(window).scrollTop();
                    var dialog = new ClawDialog('modal-mask');
                    var content = $('<div>').html($("#sendemail-dialog-templ").html());

                    //content.find('#err-message-holder').append($('#massage.show_massage'));

                    var kendoWindow = dialog.showDialog(title, content.html(), 750, 600);

                    var imgNode = kendoWindow.find('.image');
                    if(img) imgNode.attr('src', img.Thumb).show(); else imgNode.hide();

                    kendoWindow.find('.subject').val(subject);
                    var bodyNode = kendoWindow.find('.body').html(body);

                    initEditor(bodyNode);
                    CKEDITOR.instances[bodyNode.attr('id')].on('blur', null);
                    formUpdateValidRules(bodyNode);

                    //admincommon.hideMessage();

                    kendoWindow.find('.btn_yes').click(function () {
                        //$('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
                        $(window).scrollTop(scrollTop); //admincommon.hideMessage();
                        dialog.close();
                        okHandler(kendoWindow);
                    });

                    kendoWindow.find('.btn_no').click(function () {
                        //$('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
                        $(window).scrollTop(scrollTop); //admincommon.hideMessage();
                        dialog.close();
                    });
                }

            </script>
            <div class="controls">
                <div class="input-col-1">
                    <span class="text-eshop">@Html.LocalizeNameFor(m => m.MinQuantity)</span>
                    <section>
                        <section>
                            @Html.LocalizeTextBoxFor(m => m.MinQuantity, new { @class = "js-required", @type = "number" })
