<script type="text/javascript">

    $(function() { $('#gridqtyhistory').attr('id', 'gridqtyhistory-templ'); });

    function openEditQtyForm(node, variant, varRw, grid, qtyPos) {
        var width = Math.max(200, Math.min(500, $(window).width() - 50));
        var height = Math.max(200, Math.min(420, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#edit-qty-popup-form-templ").html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        varRw = varRw || (variant ? $('.variant-popup-form').data('dataRow') : null);

        if (varRw && !varRw.Id)return;

        var iSeqVar = -1;
        if (varRw) {
            iSeqVar = varRw.Iseq;
        }
        //if (variantPopup){ variantPopup.close(); variantPopup = null; }
        var productId = '@Model.Id';
        var title = '@Html.Raw(StringTable.AddProductQuantity)';
        if(productId > 0)
        {
            title = '@Html.Raw(StringTable.EditProductQuantity)';
            title = title + (varRw ? ' [' + varRw.PropDesc + ']' : '');
        }

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", title, popTemplate.html(),
            width, height, [], null,
            function (modal) {
                if(productId <=  0)
                {
                    $('#QtyRemove',modal).prop('disabled', true);
                }

                if (qtyPos != null) {
                    if (qtyPos == 2) $('#QtyPos2', modal).prop('checked', true);
                    else $('#QtyPos1', modal).prop('checked', true);
                }

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var reasonTmpl = $('#reason-templ').data('kendoDropDownList');

                admincommon.hideMessage();
                formUpdateValidRules(modal.find('.popupBody'));

                $('#Reason', modal).change(function() {$(this).valid();}).kendoDropDownList(reasonTmpl.options);

                $('#QtyAdd,#QtyRemove', modal).change(function() {
                    var costPriceBox = $('#CostPrice', modal).closest('.controls').hide();
                    if ($(this).valid() && parseInt($(this).val()) > 0) {
                        var itm = $(this);
                        $('#QtyAdd,#QtyRemove', modal).each(function() {
                            if ($(this).attr('id') != itm.attr('id'))
                                $(this).prop('disabled', true).val('0').valid();
                        });

                        if($(this).attr('id') == 'QtyAdd') costPriceBox.show();
                    } else $('#QtyAdd,#QtyRemove', modal).prop('disabled', false);
                });

                modal.find(".btn_save").click(function () {
                    var data = urlToJSON('?' + $('#editQtyForm').serialize());
                    if (($('#editQtyForm').valid() ? 1 : 0) + ($('#Reason', modal).valid() ? 1 : 0) == 2)
                        ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateQuantity")',
                            {
                                id: '@Model.Id',
                                variantid: varRw ? (varRw.Id || 0) : null,
                                delta: parseInt(data.qtyadd || 0) - parseInt(data.qtyremove || 0),
                                costPrice: data.costprice, reason: data.reason, qtyPos: data.qtypos,
                                note: data.note.replace(new RegExp("\\+","g"),' '),
                                iSeq: iSeqVar
                            },
                            function(result) {
                                var needUpdatePrice = '@Model.Type'== '@ProductType.Bundle';
                                if (varRw) {
                                    var varForm = varRw.VariantForm;

                                    varRw.Quantity1 = result.VarQuantity1;
                                    varRw.Quantity2 = result.VarQuantity2;
                                    varRw.ProductStatusId = result.VarProductStatusId;
                                    varRw.ProductStatusName = result.VarProductStatusName;
                                    if(needUpdatePrice) {
                                        varRw.CostPrice = result.VarProductCostPrice;
                                        varRw.CostPriceInc = result.VarProductCostPriceInc;
                                    }

                                    $('#var-BackOrderQty').val(varRw.BackOrderQty = result.VarBackOrderQty);
                                    $('#var-Quantity').val(varRw.Quantity = result.VarQuantity);
                                    $('.variant-form-field[binding="Quantity"]', varForm).val(result.VarQuantity);
                                    $('.variant-form-field[binding="Quantity1"]', varForm).val(result.VarQuantity1);
                                    $('.variant-form-field[binding="Quantity2"]', varForm).val(result.VarQuantity2);
                                    $('.variant-form-field[binding="ProductStatusId"]', varForm).val(result.VarProductStatusId);

                                    if(needUpdatePrice) {
                                        $('.variant-form-field[binding="CostPrice_Text"]', varForm).val(safeProp(result.VarProductCostPrice, 'Text'));
                                        $('.variant-form-field[binding="CostPriceInc_Text"]', varForm).val(safeProp(result.VarProductCostPriceInc, 'Text'));
                                    }

                                    (grid || $('#grid').data('kendoGrid')).refresh({ action: 'rebind', items: [varRw] });
                                }

                                $('#@Html.IdFor(m => m.BackOrderQty)').val(result.BackOrderQty);
                                $('#@Html.IdFor(m => m.Quantity)').val(result.Quantity);
                                $('#quantity-view').val('@qtyViewFormat'.replace('{0}', result.Quantity).replace('{1}', result.Quantity1).replace('{2}', result.Quantity2) + ' ' + ($('#quantity-view').attr('data-shoppingqty') || ''));

                                if(needUpdatePrice) {
                                    var costPriceKn = $('#@Html.IdFor(m => m.CostPrice)').data('kendoNumericTextBox');
                                    costPriceKn.value(safeProp(result.ProductCostPrice, 'Text')); costPriceKn.element.change();
                                }

                                var statusKd = $('#@Html.IdFor(m => m.ProductStatusId)').data('kendoDropDownList');
                                statusKd.value(result.ProductStatusId); statusKd.element.change();

                                inputErrBox.append(msgBox); admincommon.hideMessage();
                                popup.close(); $(window).scrollTop(scrollTop);
                            });
                });
                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });

    }

    function showQtyHistory(node) {
        var width = Math.max(200, Math.min(900, $(window).width() - 50));
        var height = Math.max(200, Math.min(2048, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#qty-history-popup-form-templ").html());
        popTemplate.find('.htmlcontent .wr_table_all').html($('#gridqtyhistory-templ').clone().attr('id', 'gridqtyhistory').wrap('<p>').parent().html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@Html.Raw(StringTable.ProductQtyHistory)', popTemplate.html(),
            width, height, [], null,
            function(modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');

                admincommon.hideMessage();
                gridqtyhistoryInit('#gridqtyhistory', true);

                $('.btn_export_excel', modal).click(function() {
                    window.location = '@ModuleUrl.AdminUrl("ProdQtyLog", "Export")/?productid=@Model.Id';
                });

                modal.find(".btn_cancel").click(function() {

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close();
                    $(window).scrollTop(scrollTop);
                });
            });

    }

    function gridQtyHistoryCustom(grid) {
        gridAdjustPopup(grid, '.wcontent', '.wr_clo1', null, null, null, 40);
    }

    function numberSign(value) {
        if (!value)return value;
        return (value > 0 ? "+ " : "- ") + Math.abs(value);
    }

    function showConfirmDialog(title, confirmMessage, okHandler, initHandler, width, height, moveErMsgHolder) {

        var scrollTop = $(window).scrollTop();
        var dialog = new ClawDialog('modal-mask');
        var content = $('<div>').html($("#confirm-dialog-templ").html());

        moveErMsgHolder = moveErMsgHolder == null ? true : moveErMsgHolder;

        content.find('.prompt-mess').html(confirmMessage.replace('&lt;br&gt;', '<br>'));
        if (moveErMsgHolder) content.find('#err-message-holder').append($('#massage.show_massage'));

        var kendoWindow = dialog.showDialog(title, content.html(), width || 440, height || 200);

        if (moveErMsgHolder) admincommon.hideMessage();

        if (initHandler) initHandler(dialog, kendoWindow, scrollTop);

        if (okHandler) {
            kendoWindow.find('.btn_yes').click(function () {
                okHandler(dialog, kendoWindow, scrollTop);
            });
        }

        kendoWindow.find('.btn_no').click(function () {
            if (moveErMsgHolder) {
                $('#input-err-msg-box').append(kendoWindow.find('#massage.show_massage'));
                $(window).scrollTop(scrollTop); admincommon.hideMessage();
            }
            dialog.close();
        });
    }

    function safePropQty(obj, propName) {
        if (obj == null) return '0';
        if (typeof (obj) != 'object') return obj;
        return obj[propName] || '0';
    }
</script>

