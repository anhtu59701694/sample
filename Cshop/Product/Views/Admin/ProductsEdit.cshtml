        .OrderBy(x => x.DisplayOrder).ThenByDescending(x => x.Id).ToList();

    @Html.Raw("<script type='text/javascript'> var images = " + Json.Encode(images) + "</script>")
}
<script type="text/javascript"> var currencies = @Html.Raw(Json.Encode(currencies)); </script>
<script type="text/javascript">

    var form = $('#editForm')[0];

    form.customValidFields = function () {
        var ret0 = validatePrices(), ret1 = true, ret2 = !$('.acitve-attach-file').is(':visible') || $('#AttachFile').val();
        var visibleWeb = $('#VisibleWebTrue'), publishedDate = $('#@Html.IdFor(m => m.PublishedDate.Value)');

        if (visibleWeb.prop('checked') && publishedDate.val() == '') {
            ret1 = false;
            setTimeout(function() {
                formShowErrorMsg('@Html.NameFor(m => m.PublishedDate.Value)', '@StringTable.ErrMsgRequiredField.ModErrLocalize()');
            }, 1000);
            if (ret0)lastErrInput = publishedDate;
        }

        if(!ret2){
            $('.acitve-attach-file input:visible[type=text]').focus();
            setTimeout(function(){ formShowErrorMsg('AttachFile', '@StringTable.ErrMsgRequiredField.ModErrLocalize()'); }, 1000);
        }

        return ret0 && ret1 && ret2;
    };

    form.CustomLangFormSwitch = function (langcode, node, senderuid) {
        var ownerbox = node.closest('.row_content_box');
    };

    if (images.length == 0) $('.es-noimg-show').show();

    $(function () {
        var imgErrMsg = $('#image-error-msg').click(function () { $(this).html(''); });
        var dzEle = dropzoneInit('#dropzone-form', '#imageUpload', '#add-file',
            {
                acceptedFiles: '@settings.Display.Admin.Image.Extensions.GetFileExtensionDropZone(true)',
                previewTemplate: $('#image-templ').html(), enableZipUpload: true,
            },
            function (result, file, index) {
                //console.log(result, file.id, index,file);
                doAddImage(file, index);
            }, function (file, e) { setImageErrMsg(imgErrMsg, e.Message + ' (' + file.name + ')'); });

        var dropzone = dzEle[0].dropzone; dropzone.idGenerator = 1;

        dropzone.on("addedfile", function (file) {
            clawSetTimeout(function () { return file.key; }, function () { dzImageOnAdd(dropzone, file); }, 200, 50);
            MaskDropZone();//show mask dropzon when have not image
        });

        images.forEach(function (img) {
            var file = dropzoneAdd(dropzone, img.Key, img.FileName, img.FsUrl, img.Url, 'image/*');

            dzImageOnAdd(dropzone, file);
        });

        dropzone.on("removedfile", function (file) {
            //console.log("removedfile", file);
            var imgKey = $('#@Html.IdFor(m => m.ImageKey)');

            $('.multi-lang-image-form[data-img-url="' + file.key + '"] input').each(function () {
                $(this).attr('datavalid', 0); $(this).val('');
            });

            if ($('#image-sel').attr('key') == file.key) $('#image-sel').removeAttr('src').closest('.img-show').find('a').attr('href', null);
            if (imgKey.val() == file.key) imgKey.val('');

            MaskDropZone();//show mask dropzon when have not image

            $('#editform-change-state').val(1).change();
        });

        dropzone.on("reset", function (e) {
            console.log("reset", e);
            $('.es-noimg-show').show();
            setTimeout(function () { imgErrMsg.html(''); }, 10000);
        });

        $('.form-action-menu .btn_clone').click(function () {
            ajaxCmd('@ModuleUrl.AdminUrl(@Html.GetController(), "Clone", Model.Id.ToString())/?lang=' + getFocusLang(), null, function (result) {
                if (result.Status == 0) {
                    var url = '@ModuleUrl.AdminUrl(@Html.GetController(), "Input")/' + result.Id;
                    location.href = urlMergeParams(url, urlToJSON(location.href));
                }
                else admincommon.showMessageDefault(result.Message, result.Status);
            });
        });

        $('.form-action-menu .btn_emailmarketing').click(function () {
            var node = $(this);
            ajaxCmd('@ModuleUrl.AdminUrl(@Html.GetController(), "UpdateEmailMarketing", Model.Id)', { value : node.hasClass('enable') ? true : false }, function (result) {
                if (result.Status == 0) {
                    $('#@Html.IdFor(m => m.EmailMarketing)').val(result.EmailMarketing);
                    if (result.EmailMarketing)node.removeClass('enable').addClass('disable').val("@StringTable.EnableEmailMarketing(false)");
                    else node.removeClass('disable').addClass('enable').val("@StringTable.EnableEmailMarketing(true)");
                }
                else admincommon.showMessageDefault(result.Message, result.Status);
            });
        });

        $('input[name=@Html.NameFor(m => m.VisibleWeb)]').change(function () {
            var box = $('#published-date-box');
            setTimeout(function() { if ($('#VisibleWebTrue').prop('checked'))box.show().find('.field-valid-msg .error').show(); else box.hide();});
        }).change();

        var vatIdNode = $('#@Html.IdFor(m => m.VatId)').data("kendoDropDownList");
        vatIdNode._get(function (row) { return row.Id == '-1'; }).addClass('item-lang-disabled');

        initKendoNumeric('#vat-value', { format: "n2", step: 1 });
        initKendoNumeric('input.custom-price-number', { format: "@settings.Display.Others.GetPriceFormat()", step: '@settings.Display.Others.PriceStep' });
        initKendoNumeric('input.custom-float-number', { format: "n", step: 1 });

        bindPriceHandler();
        bindPriceIncHandler();

        $('#@Html.IdFor(m => m.VatId),#@Html.IdFor(m => m.ProductStatusId),#@Html.IdFor(m => m.ManufacturerId)').change();

        onChangeTax(null, true);
        setTimeout(function () { initSort(dropzone); }, 1000);

        $('#@Html.IdFor(m => m.SupplierId)').focusout(function () { $(this).change(); });
    });

    function bindPriceHandler() {
        $("#@Html.IdFor(m => m.CostPrice),#@Html.IdFor(m => m.Price),#@Html.IdFor(m => m.SalePrice)")
            .bind('keyup mouseup change', function (e) {
                var incId = $(this).attr("id") + "Inc", node = $(this);
                setTimeout(function () { CalIncPrice(getPriceValue(node), incId, e.type == 'change' ? node : null); }, 500);
            });

        $("#@Html.IdFor(m => m.Price),#@Html.IdFor(m => m.CostPrice),#@Html.IdFor(m => m.SalePrice)")
            .bind('change focusout', function (e) {
                setTimeout(function () { validatePrices(); }, 500);
            });
    }

    function bindPriceIncHandler() {
        $("#@Html.IdFor(m => m.CostPriceInc),#@Html.IdFor(m => m.PriceInc),#@Html.IdFor(m => m.SalePriceInc)")
            .bind('keyup mouseup change', function (e) {
                var excId = $(this).attr("id").replace("Inc", ""), node = $(this);
                setTimeout(function() {
                    CalExcPrice(getPriceValue(node), excId, e.type == 'change' ? node : null);
                    if (e.type == 'change')showOtherCurrencies(node);
                }, 500);
            }).each(function (){showOtherCurrencies($(this));});
    }

    function supplierOnChange(node) {
        var supplierName = $('#@Html.IdFor(m => m.SupplierName)');
        var combo = node.data('kendoComboBox');
        supplierName.val(combo.text());
        if (!combo.current()) node.val('');

        $("#@Html.IdFor(m => m.SKU)").data('previousValue', null).valid();
        $('.var-sku','#grid').each(function(){ $(this).data('previousValue', null).valid(); });
    }

    function generateBarCode(node, isVariant, forced) {
        var barCode = node ? $(node) : $('#@Html.IdFor(m => m.BarCode)');

        if(!forced && barCode.val()) {
            showConfirmDialog('@StringTable.Confirmation', '@("generate BarCode confirm text".ModLocalize("Are you sure to override the old barcode"))',
                function(dialog, kendoWindow){ dialog.close(); generateBarCode(node, isVariant, true); });
            return;
        }

        admincommon.showMask();
        ajaxREST('@ModuleUrl.AdminUrl(Html.GetController(), "GenerateBarCode", Model.Id)?variantid=' + (isVariant ? barCode.attr('data_id') : ''), "POST", {}, 'barcode-loading',
            function (result) {
                admincommon.hideMask();
                if (result.BarCode) barCode.val(result.BarCode).change();
                else formShowErrorMsg(barCode.attr('name'), '@StringTable.AjaxCommandErrorMessage');
            },
            function (e) { admincommon.hideMask(); formShowErrorMsg(barCode.attr('name'), '@StringTable.AjaxCommandErrorMessage'); });

    }

    function viewBarCodeImage(lnkNode, qrCode, pdf, node, isVariant) {
        var urlBC = '@ModuleUrl.AdminUrl(Html.GetController(), "ViewBarCode", Model.Id)';
        var urlQR = '@ModuleUrl.AdminUrl(Html.GetController(), "ViewQrCode", Model.Id)';
        var bcNode = node ? $(node) : $('#@Html.IdFor(m => m.BarCode)'), bcValue = $.trim(bcNode.val());
        if (bcNode.valid()) {
            if (bcValue)    {
                if(isVariant && bcNode.attr('data_id') == '0' ) $(lnkNode).attr('href', null);
                else $(lnkNode).attr('href', (qrCode ? urlQR : urlBC) + '?barcode=' + bcValue + (isVariant ? '&variantid=' + bcNode.attr('data_id') : '') +(pdf ? '&pdf=true' : ''));
                return true;
            }
            else {
                if(node) formUpdateValidRules($(node).closest('td'));
                setTimeout(function(){ formShowErrorMsg(bcNode.attr('name'), '@StringTable.ErrMsgRequiredField.ModErrLocalize()');}, node ? 1000 : 100);
            }
        }

        $(lnkNode).attr('href', 'javascript:;');

        return false;
    }

    function dzImageOnAdd(dropzone, file, holder, imageForm) {
        file.id = dropzone.idGenerator++;

        imageForm = imageForm || '.multi-lang-image-form';

        var cbox = $(file.previewElement).find('.wr-check-box input');
        var imgKey = $('#@Html.IdFor(m => m.ImageKey)', holder);

        if (dropzone.files.length == 1 && imgKey.val() == '') imgKey.val(file.key);
        if (file.key == imgKey.val()) cbox.prop('checked', true);

        if (!file.imageForm) file.imageForm = $(imageForm + '[data-img-url="' + file.key + '"]');

        var nodeTitle = file.imageForm.find('.lang_form[data-lang="@(langCode)"] .lang_form_field.txtTitle');

        cbox.attr('id', 'img-cbox-' + file.id);
        $(file.previewElement).find('.wr-check-box label').attr('for', 'img-cbox-' + file.id);
        $(file.previewElement).find('.wr-title').html(nodeTitle.val());

        $(file.previewElement).find('.dz-preview').click(function () {
            //console.log("click", $(this), file);
            $(file.previewElement).closest('ul.dropzone-preview-box').find('.img-check.selected').removeClass('selected');
            $(file.previewElement).find('.img-check').addClass('selected');

            $('#image-sel', holder).attr({ 'src': file.url, 'key': file.key }).closest('.img-show').find('a').attr('href', file.url);
            $('#ImageTitle', holder).change().unbind('change').change(function() {
                if($(this).valid()){ nodeTitle.val($(this).val()); $(file.previewElement).find('.wr-title').html($(this).val()); }
            }).val(nodeTitle.val());

            if ($('.wr-check-box input:checked', $(file.previewElement)).length != 0) imgKey.val(file.key);

            MaskShowFull(holder); //show full image when have imge review
        });

        $(file.previewElement).find('.image-edit').unbind('click').click(function () {
            var imgNode = $(file.previewElement).find('img[data-dz-thumbnail]');
            var imgForm = $(imageForm + '[data-img-url="' + file.key + '"]');
            var fsImg = $('input.lang_form_fsurl', imgForm);

            aviaryInit(fsImg, [$('.image_form_file_name', imgForm), $('.lang_form_thumb', imgForm), imgNode],
                function (imgId, newUrl) {
                    file.url = newUrl;
                    $(file.previewElement).find('.dz-preview').click();
                });
        });

        //console.log("dzImageOnAdd", file.imageForm);
    }

    function uploadFile(node) {

        if (!validFileExtension($(node), 'datavalregex', 'section.clo_right', 'datavalextension')) return;

        doUploadFile('@(ModuleUrl.AdminUrl(Html.GetController(), "UploadFile"))', 'FileUpload', 'LoadingImage',
            { id: '@(Model.Id)' },
            function (result) {
                if (result && result.Status == 0) {
                    //console.log(result);
                    $('.browseText.sub-text-input').val(result.FileName);
                    $('#@Html.IdFor(m => m.AttachFile)').val(result.FilePath);

                    //set tab show name for delete
                    $(".attach-file-name").show().find("a").remove();
                    $('.attach-file-name').append("<a href='" + result.FilePath + "' class='form-link' target='_blank'>" + result.FileName + "</a><a href='javascript:;' onclick='removeAttachFile(this)' class='file-sub'></a>");
                }
            });
    }

    function removeAttachFile(node) {
        $('#@Html.IdFor(m => m.AttachFile)').val("");
        $('.browseText.sub-text-input').val("");
        $(node).closest('.attach-file-name').hide();
    }

    function doAddImage(file, index) {
        var cmdUrl = '@ModuleUrl.AdminUrl(Html.GetController(), "AddImageForm")';
        var formListSelector = '#multi-lang-image-form-list', errMsg = $('#image-error-msg');
        var maxIdx = Math.max(-1, 1 + parseInt($(formListSelector).attr('data-last-maxidx') || '-2'));
        $('.multi-lang-image-form').each(function () {
            maxIdx = Math.max(maxIdx, parseInt($(this).attr('data-index')));
        });

        $(formListSelector).attr('data-last-maxidx', maxIdx /*+ (index || 0)*/);

        var cmdArgs = { id: '@Model.Id', langCode: '@langCode', thumbUrl: file.thumb, fsUrl: file.url, maxIndex: maxIdx /*+ (index || 0)*/ };
        //console.log(cmdArgs);
        ajaxREST(cmdUrl, 'POST', cmdArgs, 'image-loading',
            function (result) {
                if (result && result.length > 0) {
                    var formLst = $(formListSelector), frmNode = $(result);
                    formLst.append(frmNode);
                    //console.log('doAddImage', formLst, frmNode);
                    file.imageForm = frmNode;
                    formUpdateValidRules(formLst.find('.multi-lang-item-form').last());
                } else setImageErrMsg(errMsg, '@(StringTable.ErrLimitCountMessage)');
            },
            function (e) { setImageErrMsg(errMsg, '@(StringTable.AjaxCommandErrorMessage)'); }, null, 'html');
    }

    function setImageErrMsg(node, msg) {
        node.html(msg);
        setTimeout(function () { node.html(''); }, 10000);
    }

    //new 2015.07.10
    $(document).ready(function () {
        MaskDropZone();
    });

    function MaskDropZone(holder) {
        if ($(".dropzone-preview-box li", holder).length > 0) {
            $(".mask-dropzone-show", holder).hide();
        } else {
            $(".mask-dropzone-show", holder).show();
        }
        if ($(".dropzone-preview-box li", holder).length > 1) {
            $(".img-one", holder).hide();
            $(".img-ones", holder).show();
        } else {
            $(".img-one", holder).show();
            $(".img-ones", holder).hide();
        }
        //
        MaskShowFull(holder);
    }
    function MaskShowFull(holder) {
        if (typeof $('#image-sel', holder).attr('src') === "undefined") {
            $('.img-show', holder).css({ "width": "0%", "border": "none", "display": "none" });
            $('.wr-list-img-check', holder).css({ "width": "100%", "border": "none" });
        } else {
            $('.img-show', holder).removeAttr('style');
            $('.wr-list-img-check', holder).removeAttr('style');
        }
    }

    function priceRound(value) {
        var decimals = parseInt('@settings.Display.Others.PriceRound');
        if (decimals > 0) return value;
        else {
            var n = Math.pow(10, Math.abs(decimals));
            return Math.round(value / n) * n;
        }
    }

    function kendoNumSetValue(node, value) {
        var nodeKd = node.data("kendoNumericTextBox"), oldVal = nodeKd.value();
        if ((oldVal == null) ^ (value == null) || Math.abs((oldVal || 0) - (value || 0)) >= 0.0001) {
            //console.log('kendoNumSetValue', nodeKd.value(), value);
            nodeKd.value(value);
            if((oldVal || 0) != (nodeKd.value() || 0)) setTimeout(function () { node.change(); }, 500);
        } //else console.log('kendoNumSetValue ignore', nodeKd.value(), value);
    }

    function CalIncPrice(value, idOut, node) {
        var focusInc = '@(settings.Display.Others.PriceFocusInc ? 1 : 0)';
        var newVal = null;

        if (value != null) {
            newVal = value * (1 + getVatValue());
            if (focusInc == '1') {
                newVal = priceRound(newVal);
                if (node) setTimeout(function () { kendoNumSetValue(node, newVal / (getVatValue() + 1)); }, 100);
            } else {
                value = priceRound(value);
                if (node) setTimeout(function () { kendoNumSetValue(node, value); }, 100);
                newVal = value * (1 + getVatValue());
            }
        }

        kendoNumSetValue($("#" + idOut), newVal);
    }

    function vrowCalIncPrice(row, vat, priceField, priceIncField) {
        var focusInc = '@(settings.Display.Others.PriceFocusInc ? 1 : 0)';
        var newVal = null, value = row[priceField].Value;

        if (value != null) {
            newVal = value * (1 + vat);
            if (focusInc == '1') {
                newVal = priceRound(newVal);
                row[priceField].Value = newVal / (vat + 1);
                row[priceField].Text = localizeMoneyToString(row[priceField].Value);
            } else {
                value = priceRound(value);
                row[priceField].Value = value;
                row[priceField].Text = localizeMoneyToString(value);
                newVal = value * (1 + vat);
            }
        }

        row[priceIncField].Value = newVal;
        row[priceIncField].Text = localizeMoneyToString(newVal);
    }

    //exc vat
    function CalExcPrice(value, idOut, node) {
        var focusExc = '@(settings.Display.Others.PriceFocusInc ? 0 : 1)';
        var newVal = null;

        if (value != null) {
            newVal = value / (getVatValue() + 1);
            if (focusExc == '1') {
                newVal = priceRound(newVal);
                if (node) setTimeout(function () { kendoNumSetValue(node, newVal * (1 + getVatValue())); }, 100);
            } else {
                value = priceRound(value);
                if (node) setTimeout(function () { kendoNumSetValue(node, value); }, 100);
                newVal = value / (getVatValue() + 1);
            }
        }

        kendoNumSetValue($("#" + idOut), newVal);
    }

    function validatePrices(price, salePrice, form, costPrice) {

        costPrice = costPrice || (!price && !salePrice ? $("#@Html.IdFor(m => m.CostPrice)") : null);
        price = price || $("#@Html.IdFor(m => m.Price)");
        salePrice = salePrice || $("#@Html.IdFor(m => m.SalePrice)");

        var mainForm = price.attr('name') == 'Price';
        var priceVal = getPriceValue(price), salePriceVal = getPriceValue(salePrice);
        var costPriceVal = costPrice ? getPriceValue(costPrice) : null;
        //console.log('validatePrices', price, salePrice, priceVal, salePriceVal);
        if (!price.valid() || !salePrice.valid() || (costPrice && !costPrice.valid())) {
            if (mainForm) {
                $([price[0], salePrice[0]]).closest('.input-col-1').removeClass('validate-prices');
            }
            return false;
        }

        var errMsgSale = '@StringTable.ErrPriceMustGreaterSalePrice';
        var errMsgCost = '@StringTable.ErrCostPriceMustLessOrEqSalePrice';
        var errMsgPrice = '@StringTable.ErrCostPriceMustLessOrEqPrice';
        var retSale = priceVal == null || (salePriceVal || 0) == 0 || priceVal > salePriceVal;
        var retCost = true; // costPriceVal == null || (salePriceVal || 0) == 0 || costPriceVal <= salePriceVal;
        var retPrice = true; // costPriceVal == null || priceVal == null || costPriceVal <= priceVal;

        setTimeout(function () {
            if (mainForm) {
                var priceHolder = price.closest('.input-col-1'), salePriceHolder = salePrice.closest('.input-col-1');
                $([priceHolder[0], salePriceHolder[0]]).removeClass('validate-prices');
                if (!retPrice) priceHolder.addClass('validate-prices');
                if (!retSale || !retCost) salePriceHolder.addClass('validate-prices');
            }
            formShowErrorMsg(salePrice.attr('name'), retSale ? (retCost ? '' : errMsgCost) : errMsgSale, form);
            formShowErrorMsg(price.attr('name'), retPrice ? '' : errMsgPrice, form);
        }, 100);

        return retSale && retCost && retPrice;
    }

    function showOtherCurrencies(node, dataOnly) {
        var currentCode = '@settings.General.Currency'.toLowerCase();
        var ret = [], value = getPriceValue(node);
        //console.log('showOtherCurrencies', node);

        if (value != null)
            currencies.forEach(function(itm) {
                if (itm.Code.toLowerCase() != currentCode) {
                    var textPrice = localizeMoneyToString(itm.Rate.Value * value);
                    ret.push('<div class="currency-price">' + itm.Code + ': ' + (itm.Location?(itm.Token + ' ' + textPrice):(textPrice + ' ' + itm.Token)) + '</div>');
                }
            });

        if(!dataOnly) {
            var holder = node.closest('.multi-currency-price-box');
            if (ret.length > 0) {
                var itmW = ($(ret[0]).width() || 110) + 5;
                $('.other-currency-box,.other-currency-title', holder).show();
                $('.other-currency-box', holder).html(ret.join(' ')).closest('.input-col-3')
                    .css({ 'min-width': Math.min(ret.length, 4) * itmW + 'px', 'max-width': 4 * itmW + 'px' });
            } else $('.other-currency-box,.other-currency-title', holder).hide();
        }

        return ret;
    }

    function onChangeTax(e, manual) {
        //product normal
        var costPrice = $("#@Html.IdFor(m => m.CostPrice)");
        if (costPrice.length != 0) CalIncPrice(getPriceValue(costPrice), "@Html.IdFor(m => m.CostPriceInc)", costPrice);

        var price = $("#@Html.IdFor(m => m.Price)");
        CalIncPrice(getPriceValue(price), "@Html.IdFor(m => m.PriceInc)", price);
        var salePrice = $("#@Html.IdFor(m => m.SalePrice)");
        CalIncPrice(getPriceValue(salePrice), "@Html.IdFor(m => m.SalePriceInc)", salePrice);

        if (!manual && window.variantOnChangeTax)
            setTimeout(function () { window.variantOnChangeTax(); }, 500);
    }

    function getPriceValue(node) {
        var nodeKd = node.data("kendoNumericTextBox");
        if (nodeKd) return nodeKd.value();
        if (node.hasClass('var-cell')) return localizeParseFloat(node.val());
        return null;
    }

    function getVatValue() {
        var node = $('#@Html.IdFor(m => m.VatId)').data("kendoDropDownList"), vatId = node.value();
        if (vatId == '-1') vatId = $('#vat-form').attr('bk-val');

        var row = node.dataSource.get(vatId);
        return row ? row.Value : 0;
    }

    function onStatusChange(node) {
        var statusForm = $('#status-form');
        if(node.val() != 3) $('.controls.BackDate').find('.datepicker').val('');
        $('.controls.BackDate').css('display','none');
        if (node.val() == 3) $('.controls.BackDate').css('display','block');
        if (node.val() == '-1') {
            var dropdown = $('#status-ddlist'), ddNode = node.data('kendoDropDownList');
            var nameNode = $('.field-name', statusForm), aliasNode = $('#status-alias'), errNode = $('span.error', statusForm);
            statusForm.show().find('input.btn_add')
                .unbind('click')
                .click(function () {

                    var name = $.trim(nameNode.val()), langCode = getFocusLang();

                    if (!nameNode.val(name).valid()) return;
                    else { errNode.html(''); AutoGenerateAlias(name, 'status-alias', true); }

                    ajaxREST('@ModuleUrl.AdminUrl("Status", "Input")', 'POST',
                        { id: 0, name: name, Code: aliasNode.val(), InlineEdit: true, QuickAdd: true, lang: langCode }, 'status-loading',
                        function (result) {
                            var errMsg = kendoGetResultError(result), row = result.Data[0];
                            var items = ddNode.dataSource.data();
                            console.log(result);
                            if (!errMsg) {
                                dropdown.show(); statusForm.hide(); nameNode.val('');
                                var addItem = items.find(function (itm) { return itm.Value == '-1'; });
                                items.push({
                                    Value: row.Id.toString(), Text: row.Name, Active: true,
                                    LangVisible: true, CssClass: '', Title: ''
                                });
                                items.remove(addItem); items.push(addItem);
                                ddNode.value(row.Id.toString());
                                node.change();
                            } else errNode.html(errMsg);
                        }, function (e) { errNode.html('@StringTable.AjaxCommandErrorMessage'); });
                });

            statusForm.show().find('input.btn_cancel')
                .unbind('click')
                .click(function () {
                    statusForm.hide(); dropdown.show(); ddNode.value(statusForm.attr('bk-val') || '');
                    nameNode.val(''); errNode.html('');
                });

            dropdown.hide();
            return false;
        }
        else statusForm.attr('bk-val', node.val());
        return true;
    }

    function onVatChange(node) {

        var vatForm = $('#vat-form');

        if (node.val() == '-1') {
            var dropdown = $('#vat-ddlist'), ddNode = node.data('kendoDropDownList');
            var valueNode = $('#vat-value', vatForm), errNode = $('span.error', vatForm);
            var knumTxt = valueNode.data('kendoNumericTextBox'), langCode = getFocusLang();
            vatForm.show().find('input.btn_add')
                .unbind('click')
                .click(function () {

                    if (!valueNode.valid()) return;
                    var valTxt = valueNode.val() + ' %';

                    ajaxREST('@ModuleUrl.AdminUrl("Vat", "Input")', 'POST',
                        { id: 0, name: valTxt, value: localizeFloatToString(knumTxt.value()/100.0, 'n4'), InlineEdit: true, QuickAdd: true, lang: langCode }, 'vat-loading',
                        function (result) {
                            var errMsg = kendoGetResultError(result), row = result.Data[0];
                            var items = ddNode.dataSource.data();
                            console.log(result);
                            if (!errMsg) {
                                dropdown.show(); vatForm.hide(); knumTxt.value(null);
                                var addItem = items.find(function (itm) { return itm.Value == '-1'; });
                                items.push({
                                    Id: row.Id, Value: row.Value.Value, ValTxt: row.ValTxt, Active: row.Active
                                });
                                items.remove(addItem); items.push(addItem);
                                ddNode.value(row.Id);
                            } else errNode.html(errMsg);
                        }, function (e) { errNode.html('@StringTable.AjaxCommandErrorMessage'); });
                });

            vatForm.show().find('input.btn_cancel')
                .unbind('click')
                .click(function () {
                    vatForm.hide(); dropdown.show(); ddNode.value(vatForm.attr('bk-val') || '');
                    knumTxt.value(null); errNode.html('');
                });

            dropdown.hide();
            return false;
        }
        else { vatForm.attr('bk-val', node.val()); return node.val(); }
    }

    function onManufacturerChange(node) {

        var manuForm = $('#manu-form');

        if (node.val() == '-1') {
            var dropdown = $('#manu-ddlist'), ddNode = node.data('kendoDropDownList');
            var nameNode = $('.field-name', manuForm), aliasNode = $('#manu-alias'), errNode = $('span.error', manuForm);
            manuForm.show().find('input.btn_add')
                .unbind('click')
                .click(function () {

                    var name = $.trim(nameNode.val()), langCode = getFocusLang();

                    if (!nameNode.val(name).valid()) return;
                    else { errNode.html(''); AutoGenerateAlias(name, 'manu-alias', true); }

                    ajaxREST('@ModuleUrl.AdminUrl("Manufacturer", "Input")', 'POST',
                        { id: 0, name: name, Alias: aliasNode.val(), InlineEdit: true, QuickAdd: true, lang: langCode }, 'manu-loading',
                        function (result) {
                            var errMsg = kendoGetResultError(result), row = result.Data[0];
                            var items = ddNode.dataSource.data();
                            console.log(result);
                            if (!errMsg) {
                                dropdown.show(); manuForm.hide(); nameNode.val('');
                                var addItem = items.find(function (itm) { return itm.Value == '-1'; });
                                items.push({
                                    Value: row.Id.toString(), Text: row.Name, Active: true,
                                    LangVisible: true, CssClass: '', Title: ''
                                });
                                items.remove(addItem); items.push(addItem);
                                ddNode.value(row.Id.toString());
                            } else errNode.html(errMsg);
                        }, function (e) { errNode.html('@StringTable.AjaxCommandErrorMessage'); });
                });

            manuForm.show().find('input.btn_cancel')
                .unbind('click')
                .click(function () {
                    manuForm.hide(); dropdown.show(); ddNode.value(manuForm.attr('bk-val') || '');
                    nameNode.val(''); errNode.html('');
                });

            dropdown.hide();
        }
        else manuForm.attr('bk-val', node.val());
    }

</script>
@if (!isFrontEnd)
{
    <script type="text/javascript">

        function openAssignCates(node) {

            if ('@(ViewBag.PermissionEdit ? 0 : 1)' == '1')return;

            ajaxCmdHtml('@ModuleUrl.AdminUrl("Product", "GetAssignForm")', { id: '@Model.Id', categoryIds: $('#CategoryIds').val() },
                function (result, customTag) {
                    openAssignRelation('@Model.Id', null, result);
                });
        }

        function buildCateList(cates) {
            var holder = $('.assign-cate-box ul');
            holder.html('');
            console.log(cates);
            cates.forEach(function (jsitm) {
                holder.append($('<li>').append($('<a class="form-link" target="_blank" href="@ModuleUrl.AdminUrl("Category", "Edit")/' + jsitm.Id + '">').html(jsitm.HierOrder)));
                console.log(jsitm);
            });

            holder.css('display', 'none');
            if (holder.html() !== '') {
                holder.css('display', 'block');
            }

        }

        function openAssignRelation(id, actionurl, formHtml) {
            var width = Math.max(200, Math.min(600, $(window).width() - 50));
            var height = Math.max(200, Math.min(300, $(window).height() - 50));
            var scrollTop = $(window).scrollTop();

            var popup = new ClawModal("", "modal-mask");
            var popTemplate = $('<div>').html($("#assign-cate-templ").html());
            popTemplate.find('#form-html').html(formHtml);

            var formTitle = '@StringTable.Assigncategory';

            var windowModal = popup.showCustomModal("#window", formTitle, popTemplate.html(), width, height, [], null,
                function (modal) {
                    var treeview = modal.find("#catetree");

                    modal.find(".btn_save").click(function () {
                        var selectedList = getSelectedIds(treeview);
                        console.log(selectedList);
                        $('#@Html.IdFor(m => m.CategoryIds)').val(selectedList.Ids.length == 0 ? ' ' : selectedList.Ids.join(','));

                        buildCateList(selectedList.Jsons);

                        popup.close(); $(window).scrollTop(scrollTop);
                        $('#editform-change-state').val(1).change();
                    });

                    modal.find(".btn_cancel").click(function () { popup.close(); $(window).scrollTop(scrollTop); });
                });
        }

        function initSort(dropzone, holder) {

            holder = holder || '#dropzone-form';

            $('.dropzone-preview-box', holder).sortable({
                connectWith: holder + " .dropzone-preview-box",
                //placeholder: 'placeholder',
                placeholder: {
                    element: function (currentItem) { return $("<li class='placeholder dz-image-preview'><div class='holder'></div></li>")[0]; },
                    update: function (container, p) { return; }
                },
                items: "> li",
                helper: 'original',
                stop: function (event, ui) {
                    //console.log('stop', event, ui);
                    //$(this).css('border', 'solid 1px white');
                    $(this).css('border', 'none');
                    var i = 0;
                    $('.dropzone-preview-box li', holder).each(function () { $(this).attr('data-index', i++); });

                    for (var k = 0; k < dropzone.files.length; k++) {
                        var file = dropzone.files[k], dorder = $(file.previewElement).attr('data-index');
                        var img = file.Image ? file.Image() : null;

                        if (img) img.DisplayOrder = parseInt(dorder);
                        $('.lang_form_displayorder', file.imageForm).val(dorder);
                    }
                },
                start: function (event, ui) {
                    //console.log('start', event, ui);
                    $(this).css('border', 'solid 1px green');
                },
                receive: function (event, ui) {
                    //console.log('receive', event, ui);
                    $(this).css('background-color', 'violet');
                    var me = $(this);
                    setTimeout(function () { me.css('background-color', 'lightgray'); }, 100);
                },
                out: function (event, ui) {
                    //$(this).css('border', 'solid 1px white');
                    $(this).css('border', 'none');
                },
                activate: function (event, ui) {
                    //console.log('activate', event, ui);
                    $(this).css('border', 'solid 1px red');
                },
            });
        }

        $(function () {
            buildCateList(@Html.Raw(Model.CategoryJsons));
        });

    </script>
}

