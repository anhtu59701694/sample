                                <span class="text-eshop ck-editor">@htmlEditQty.LocalizeNameFor(m => m.QtyRemove)</span>
                                <section>
                                    @htmlEditQty.LocalizeTextBoxFor(x => x.QtyRemove, new { })
                                </section>
                                <section class="field-valid-msg">@htmlEditQty.LocalizeValidationMessageFor(m => m.QtyRemove)</section>
                            </section>
                            <section class="controls" style="display:none;">
                                <span class="text-eshop ck-editor">@htmlEditQty.LocalizeNameFor(m => m.CostPrice)</span>
                                <section>
                                    @htmlEditQty.LocalizeTextBoxFor(x => x.CostPrice, new { })
                                </section>
                                <section class="field-valid-msg">@htmlEditQty.LocalizeValidationMessageFor(m => m.CostPrice)</section>
                            </section>
                            <section class="controls">
                                <span class="text-eshop ck-editor">@htmlEditQty.LocalizeNameFor(m => m.Reason)</span>
                                <section>
                                    @htmlEditQty.LocalizeTextBoxFor(x => x.Reason, new { })
                                </section>
                                <section class="field-valid-msg">@htmlEditQty.LocalizeValidationMessageFor(m => m.Reason)</section>
                            </section>
                            <section class="controls">
                                <span class="text-eshop ck-editor">@htmlEditQty.LocalizeNameFor(m => m.Note)</span>
                                <section>
                                    @htmlEditQty.LocalizeTextAreaFor(x => x.Note, new { @rows = "2" })
                                </section>
                                <section class="field-valid-msg">@htmlEditQty.LocalizeValidationMessageFor(m => m.Note)</section>
                            </section>
                        </div>
                    </div>
                </section>
                <section class="clear"></section>
                <ul class="wr_submit_top form-action-menu" style="position:relative; padding:10px 0;">
                    <li><input type="button" value="@StringTable.Done" class="btn_save"></li>
                    <li><input type="button" value="@StringTable.Cancel" class="btn_cancel"></li>
                </ul>
            </section>
        </div>
    </form>
</script>

