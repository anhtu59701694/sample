@using System.Linq
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.DAL.Interfaces
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Product
@using DM = Claw.Modules.Eshop.Domain
@model ProductModel

@{
    Layout = "Layout/Input.cshtml";
    var ctx = ClawContext.Current;
    var isFrontEnd = QParam.IsFontEnd;

    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.CatalogEdit;
    ViewBag.Title = StringTable.AddEditProduct(Model.Id, Model.Type);
    ViewBag.ShowDeleteBtn = (Model != null && Model.Id > 0 && !isFrontEnd);
    ViewBag.UseCKEditor = true;
    ViewBag.UseDatePicker = true;
    ViewBag.UseUploadFile = true;
    ViewBag.UseDropZone = true;
    ViewBag.UseImgPreview = true;
    ViewBag.TranslateMaxWidth = 800;
    ViewBag.TranslateMaxHeight = 1130;
    ViewBag.UseInlineEdit = true;

    var controllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    var linkProduct = "/admin/modules/eshop/product";
    if ("bundleproduct".Equals(controllerName.ToLower()))
    {
        ViewBag.ParentBreadcrumbLink = linkProduct = "/admin/modules/eshop/bundleproduct";
        ViewBag.ParentBreadcrumbTitle = StringTable.Bundle;
    }
    else
    {
        ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/product";
        ViewBag.ParentBreadcrumbTitle = StringTable.Product;
    }

    var settings = (SettingsBiz)ViewBag.Settings;
    var languages = (List<Language>)ViewBag.Languages;
    var langOpt = LanguageMgr.ValidOptLang(Model.Id);
    var langCode = langOpt.LanguageCode;

    var vats = (List<VatModel>)ViewBag.Vats;
    var statuses = (List<StatusModel>)ViewBag.Statuses;
    var manus = (List<ManufacturerModel>)ViewBag.Manufacturers;
    var currencies = (List<CurrencyModel>)ViewBag.Currencies;
    var versionSetting = Claw.Modules.Eshop.Helper.VersionHelper.GetVersionSetting();
    if (versionSetting != null)
    {
        if (versionSetting.Languages.Count > 0)
        {
            var lstLangCode = versionSetting.Languages.Select(p => p.Code.ToLower());
            languages = languages.Where(p => lstLangCode.Contains(p.ShortLangCode.ToLower())).ToList();
        }
        if (versionSetting.Currencies.Count > 0)
        {
            var lstCurrCode = versionSetting.Currencies.Select(p => p.Code.ToLower());
            currencies = currencies.Where(p => lstCurrCode.Contains(p.Code.ToLower())).ToList();
        }
    }
    var percent = EShopHelper.PercentImg(settings.Display.Product.Thumb.Width, 120);
    ViewBag.DZItemWidth = settings.Display.Product.Thumb.Width * (percent * 0.1);//100;
    ViewBag.DZItemHeight = settings.Display.Product.Thumb.Height * (percent * 0.1);//160;
    var qtyViewFormat = settings.Hidden.Storage2Enabled ? string.Format("{{0}} ({0}: {{1}}, {1}: {{2}})", StringTable.GetQtyPosName(DM.QtyPos.Qty1, settings), StringTable.GetQtyPosName(DM.QtyPos.Qty2, settings)) : "{0}";

    if (Model != null)
    {
        Model.WUnit = Model.WUnit ?? (byte)settings.Display.Others.MUnit;
        Model.Weight = Model.Weight ?? new OFloat(0);
        Model.ShippingType = Model.ShippingType ?? (int)ShippingType.RequireShipping;
    }
    if (Model.VatId == null && vats.Any())
    {
        //var vat = vats.Where(x => x.Default).FirstOrDefault();
        var vat = vats.Where(x => x.Default);
        vat = vat.Any() ? vat : vats;
        Model.VatId = vat.FirstOrDefault().Id;
    }
    if (Model.ProductStatusId == null)
    {
        Model.ProductStatusId = statuses.FirstOrDefault(m => m.Code.EqualsIgCase(settings.Hidden.DefaultProductStatus)).SafeProp(m => m.Id, 3).NullIf(m => m == 0);
    }

    if (settings.Hidden.Price4LoginOnly && settings.Hidden.Price4LoginForcedAllProd)
    {
        Model.Price4LoginOnly = true;
    }

    //if (Model.Id == 0 && settings.Hidden.ProductQtyAutoWebVisibilty)
    //{
    //    Model.HideZeroQtyProd = true;
    //}

    if (Model.Type == ProductType.Bundle)
    {
        Model.SKU = Model.BarCode = Model.Location = Model.SupplierName = null;
        Model.SupplierId = null;
    }

    if (Model.Variants.SafeCount() != 0)
    {
        foreach (var itm in Model.Variants.Where(m => m.Quantity < 0))
        {
            itm.BackOrderQty += -1 * itm.Quantity;
            itm.Quantity = 0;
        }
    }

    if (Model.Quantity < 0)
    {
        Model.BackOrderQty += -1 * Model.Quantity;
        Model.Quantity = 0;
    }
}

@section MainTitleSection {
    @(StringTable.ManageProducts)
}

@section CurrentTitleSection {
    <a href="@linkProduct">
        @(StringTable.ManageProducts)
    </a>
}

@section TabTitleSection {
    @StringTable.AddEditProduct(Model.Id, Model.Type)
}

@section ExtraButtonSection{
    @if (Model.Id != 0 && !isFrontEnd)
    {
        <li style="display:none;"><input type="button" value="@Html.Raw(StringTable.EnableEmailMarketing(!Model.EmailMarketing))" class="btn_add btn_emailmarketing @(Model.EmailMarketing ? "disable" : "enable")" /></li>
        <li><input type="button" value="@Html.Raw(StringTable.Clone)" class="btn_add btn_clone" /></li>
    }
}

