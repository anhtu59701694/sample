    function gridHideUnusedColumns(grid) {
        var props = {}, items = grid.dataSource.data();

        if (items.length == 0) return;

        for (var i = 0; i < items[0].Properties.length; i++) {
            var prop = items[0].Properties[i];
            var tmp = varProperties.filter(function (p) { return p.Id == prop.PropId; });
            props[i] = tmp.length == 0 ? null : tmp[0];
        }

        for (var key in props) {
            if (props[key]) grid.showColumn('Properties[' + key + '].PropValId');
            else grid.hideColumn('Properties[' + key + '].PropValId');
        }

        if ('@(settings.Display.Others.PriceFocusInc ? 1 : 0)' == '1') {
            grid.hideColumn('CostPriceInc'); grid.hideColumn('Price'); grid.hideColumn('SalePrice');
        }
        else { grid.hideColumn('CostPriceInc'); grid.hideColumn('PriceInc'); grid.hideColumn('SalePriceInc'); }
