                        inputErrBox.append(msgBox); admincommon.hideMessage();
                        popup.close(); $(window).scrollTop(scrollPos); initRemoteValidate();
                        variantImageFormListData = variantImageJsonListData = null;
                            variantPopup = variantModal = null;

                        if (dzone) { dzone.destroying = true; dzone.destroy(); }

                        $('.variant-image-form input', row.VariantForm).each(function () {
