                function (modal) {
                    var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                    var scrollPos = $(window).scrollTop(), popupForm = $('#popupForm', modal);

                    $('#popupForm .wr_clo1', modal).css('height', height - 60 + 'px');

