    <script type="text/javascript">

    //auto fill empty properties and remove duplicated rows
    function gridSyncProperties() {
        var propsMap = getPropsMap(), varpropDic = {}, removeLst = [], gridData = grid.data('kendoGrid');

        varProperties.forEach(function (itm) { varpropDic[itm.Id] = itm; });

        function updatePropValField(varForm, row, index, newVal) {
            var inputField = varForm.find('.variant-prop-form-field[binding=Properties_' + index + '__PropValId]');
            inputField.val(newVal); //console.log(inputField, index, newVal);
        }

        gridData.dataSource.data().forEach(function (row) {
            var dirty = false;
            varProperties.forEach(function (itm) {
                var idx = propsMap[itm.Id], prop = row.Properties[idx];
                if (!prop.PropValId && itm.PropVals.length != 0) {
                    prop.PropValId = itm.PropVals[0].Id;
                    prop.PropValName = itm.PropVals[0].Name;
                    updatePropValField(varFormDic[row.Key], row, idx, prop.PropValId);
                    dirty = true;
                }
            });

            row.Properties.forEach(function (itm) {
                if (!varpropDic[itm.PropId]) {
                    itm.PropValId = itm.PropValName = null; dirty = true;
                    updatePropValField(varFormDic[row.Key], row, propsMap[itm.PropId], '');
                }
            });

            if (dirty) {
                delete varPropValsDic[row.PropValsKey];
                var propvalsKey = varpropsToKey(row.Properties);
                if (varPropValsDic[propvalsKey]) removeLst.push(row);
                else varPropValsDic[row.PropValsKey = propvalsKey] = row;
            }
        });

        if (removeLst.length != 0) variantRemoveRange(removeLst);
    }

    //[{PropId, PropValId, PropValName}]
    function variantRemoveGroup(propVals) {

        varpropertiesSync();

        var propsMap = getPropsMap(), pvalMap = {}, gridData = grid.data('kendoGrid');

        propVals.forEach(function (pv) {
            var prop = pvalMap[pv.PropId];
            if (!prop) pvalMap[pv.PropId] = prop = { Map: {} };
            prop.Map[pv.PropValId] = true;
        });

        varProperties.forEach(function (itm) {
            var prop = pvalMap[itm.Id];
            if (prop) itm.PropVals = itm.PropVals.filter(function (pv) { return !prop.Map[pv.Id]; });
        });
        varProperties = varProperties.filter(function (itm) { return itm.PropVals.length != 0; });

        var removeLst = [], removeMap = {};
        gridData.dataSource.data().forEach(function (row) {
            propVals.forEach(function (pv) {
                var propIdx = propsMap[pv.PropId];
                if (row.Properties[propIdx].PropValId == pv.PropValId && !removeMap[row.Key]) {
                    row.Properties[propIdx].PropValId = null;
                    delete varPropValsDic[row.PropValsKey];
                    row.PropValsKey = varpropsToKey(row.Properties);
                    var propCount = varpropsCount(row.Properties);
                    if (propCount < varProperties.length || !row.PropValsKey || varPropValsDic[row.PropValsKey]) {
                        removeLst.push(row);
                        removeMap[row.Key] = row;
                    } else {
                        varPropValsDic[row.PropValsKey] = row;
                        var varForm = varFormDic[row.Key], field = 'Properties_' + propIdx + '__PropValId';
                        varForm.find('.variant-prop-form-field[binding=' + field + ']').val('');
                    }
                }
            });
        });

        if (removeLst.length == 0) gridData.dataSource.read();
        else variantRemoveRange(removeLst);

        $('#btn-propsel-update-variants').closest('li').hide();
        $('#btn-propsel-add-variants,#btn-add-one-variant').closest('li').show();
    }

    function variantRemoveRange(rows) {
        var gridData = grid.data('kendoGrid'), transport = gridData.dataSource.transport;
        var delRowMap = {}, qtyTotal = 0;

        //rows = rows.filter(function (rw) { return rw.Deletable; });

        rows.forEach(function (rw) { delRowMap[rw.Key] = rw; });

        transport.data = gridData.dataSource.data().filter(function (itm) {
            return !delRowMap[itm.Key];
        });

        rows.forEach(function (row) {
            row.VariantForm = varFormDic[row.Key];
            qtyTotal += row.Quantity;
            varFormRemove(row);
        });

        quantity.clawChangeInt(-1 * qtyTotal).change();

        gridData.dataSource.read();
    }

    function varpropsToKey(properties) {
        if (!properties) return '';
        return properties.filter(function (prop) { return prop.PropId && prop.PropValId; })
            .map(function (prop) { return 'p:' + prop.PropId + '-v:' + prop.PropValId; })
            .sort().join(',');
    }

    function varpropsCount(properties) {
        if (!properties) return 0;
        return properties.filter(function (prop) { return prop.PropId && prop.PropValId; }).length;
    }

    function variantAddOneNew(grid) {

        var avaiTuples = getAvaiPropValTuples();

        if (avaiTuples.length == 0) return;

        var qtyTotal = 0;
        grid.dataSource.transport.data = [];
        grid.dataSource.data().forEach(function (itm) {
            grid.dataSource.transport.data.push(itm);
            qtyTotal += itm.Quantity;
        });

        quantity.val('0').clawChangeInt(qtyTotal).change();

        variantAdd(avaiTuples[0], true);

        grid.dataSource.transport.data[0].PropEdit = true;
        grid.dataSource.read();
    }

    function variantAdd(properties, insertFirst) {

        if (varPropValsDic[varpropsToKey(properties)]) {
            console.log('variantAdd cancelled', properties);
            return false;
        }

        var costprice = $('#CostPrice').data('kendoNumericTextBox').value();
        var costpriceInc = $('#CostPriceInc').data('kendoNumericTextBox').value();
        var price = $('#Price').data('kendoNumericTextBox').value();
        var priceInc = $('#PriceInc').data('kendoNumericTextBox').value();
        var saleprice = $('#SalePrice').data('kendoNumericTextBox').value();
        var salepriceInc = $('#SalePriceInc').data('kendoNumericTextBox').value();
        var weight = $('#Weight').data('kendoNumericTextBox').value();
        var prodStatus = $('#ProductStatusId').data('kendoDropDownList');
        var location = $('#Location').val();
        var fieldVals = {
            Iseq: null,
            Key: null,
            SKU: '',
            BarCode: '',
            ProductStatusId: 3,//(prodStatus.value() || 2),
            BackDate: '',
            ProductStatusName: '@Html.Raw(defaultStatusName.Replace("'", "\\'"))',//(prodStatus.value() ? prodStatus.text() : '@Html.Raw(defaultStatusName.Replace("'","\\'"))'),
            Active: true,
            DisplayOrder: 1000,
            Quantity: 0,
            Location: location,
            Weight: { Value: weight, Text: localizeMoneyToString(weight) },
            CostPrice: { Value: costprice, Text: localizeMoneyToString(costprice) },
            CostPriceInc: { Value: costpriceInc, Text: localizeMoneyToString(costpriceInc) },
            Price: { Value: price, Text: localizeMoneyToString(price) },
            PriceInc: { Value: priceInc, Text: localizeMoneyToString(priceInc) },
            SalePrice: { Value: saleprice, Text: localizeMoneyToString(saleprice) },
            SalePriceInc: { Value: salepriceInc, Text: localizeMoneyToString(salepriceInc) },
            Properties: properties, //[{ PropId: 1, PropValId: 2,PropValName: '' }]
        };
        //console.log('variantAdd', fieldVals);
        variantAddRaw(fieldVals, insertFirst);
        return true;
    }

    //variantAdd({SKU:'ww',BarCode:'tt',ProductStatusId:2,Active:true,DisplayOrder:1000,Quantity:1,Properties:[{PropId:1,PropValId:2},{PropId:2,PropValId:4}]})
    function variantAddRaw(fieldVals, insertFirst) {

        var gridData = grid.data('kendoGrid');
        var newRow = $.extend(true, {}, templVariant);

        for (var prop in fieldVals) {
            var pval = fieldVals[prop];
            if (typeof (pval) == 'object' && prop == 'Properties') {
                for (var k = 0; k < pval.length; k++) {
                    for (var i = 0; i < newRow.Properties.length; i++) {
                        if (pval[k].PropId == newRow.Properties[i].PropId) {
                            newRow.Properties[i].PropValId = pval[k].PropValId;
                            newRow.Properties[i].PropValName = pval[k].PropValName;
                        }
                    }
                }
            } else newRow[prop] = pval;
        }

        //console.log('variantAdd', newRow);

        var varForm = varFormAdd(fieldVals);
        newRow['Key'] = fieldVals['Key'];
        newRow['Iseq'] = fieldVals['Iseq'];
        varRowSetDic[newRow.Key] = newRow;
        varFormDic[newRow.Key] = varForm;
        newRow.PropValsKey = varpropsToKey(newRow.Properties);
        varPropValsDic[newRow.PropValsKey] = newRow;
        if (insertFirst) gridData.dataSource.transport.data.unshift(newRow);
        else gridData.dataSource.transport.data.push(newRow);

        quantity.clawChangeInt(newRow['Quantity']).change();
    }

    function varFormAdd(fieldVals) {

        var lst = $('#variant-form-list'), idx = parseInt(lst.attr('count'));

        lst.attr('count', idx + 1); fieldVals['Key'] = 'nil_' + idx; fieldVals['Iseq'] = idx;

        var newForm = $('<div>').html($('#var-form-template').html()).find('.variant-form');

        newForm.find('input,textarea,select').each(function () {
            $(this).attr('id', $(this).attr('id').replace('_0_', '_' + idx + '_'));
            $(this).attr('name', $(this).attr('name').replace('[0]', '[' + idx + ']'));

            if ($(this).attr('binding') || $(this).attr('propbind')) {
                if ($(this).is('textarea')) $(this).html('');
                else $(this).val('');
            }
        });

        if (fieldVals) {
            for (var field in fieldVals) {
                var fVal = fieldVals[field];
                if (typeof (fVal) == 'object' && field == 'Properties') {
                    fVal.forEach(function (item) {
                        var propForm = newForm.find('.variant-prop-form[data-id=' + item.PropId + ']');
                        var propVal = propForm.find('.variant-prop-form-field[propbind=PropValId]');
                        propVal.val(item.PropValId);
                    });
                }
            }

            newForm.find('.variant-form-field[binding]').each(function () {
                var bindField = $(this).attr('binding'), fbVal = '';
                if (bindField.indexOf('Properties_') == -1) {
                    if (bindField.indexOf('_') != -1) {
                        eval('fbVal = fieldVals.' + bindField.replace('_', '.'));
                    } else fbVal = fieldVals[bindField];

                    if ($(this).is('textarea')) $(this).html(fbVal);
                    else $(this).val(fbVal);
                    //console.log('prodFormAdd', $(this), fVal);
                }
            });
        }

        newForm.attr({
            'data-id': 0, 'data-valid': 1, 'iseq': idx, 'data-key': fieldVals['Key'],
            'data-prefix-id': 'Variants_' + idx + '_', 'data-prefix-name': 'Variants[' + idx + ']'
        });

        lst.append(newForm);

        //console.log(newForm.html());

        return newForm;
    }

    function propValAdd(id, name) {

        if ($('#prop-val-' + id).length != 0) return null;

        var newItem = $('<div>').html($('#prop-val-templ').html()).find('li');

        newItem.find('.prop-val-name').html(name);
        newItem.find('input').attr('id', 'prop-val-' + id).attr('name', 'prop-val-' + id).val(id);
        newItem.find('label').attr('for', 'prop-val-' + id);

        return newItem;
    }

    function propertyAdd(id, name) {

        var newItem = $('<div>').html($('#prop-templ').html()).find('div.var-property');

        newItem.attr('data-id', id);
        newItem.find('.prop-name').html(name);
        newItem.find('.prop-val-input-form .prop-val-name').attr({ 'id': 'prop-val-name-' + id, 'name': 'prop-val-name-' + id });
        newItem.find('.prop-val-input-form span.error').attr({ 'data-valmsg-for': 'prop-val-name-' + id });

        var tmp = $('<div>')
            .append($('#PropValCBox').clone().attr({
                'id': 'propval-cbox-' + id,
                'name': 'propval-cbox-' + id,
                'data-val-required': '@StringTable.ErrMsgRequiredField.ModErrLocalize()',
                'data-val': true
            }));

        var ddOpts = $('#PropValCBox').data('kendoDropDownList').options;

        ddOpts.dataSource.transport.read.data = function () { return { propertyid: id, lang: getFocusLang() }; };

        var errNode = '<div style="height:20px;"><span style="position:absolute;" class="error field-validation-error" data-validate="false" data-valmsg-for="propval-cbox-'
            + id + '" data-valmsg-replace="true"></span></div>';
        newItem.find('.propval-ddlist').html(tmp.html()).append(errNode);
        newItem.find('.propval-cbox').kendoDropDownList(ddOpts);

        initPropValAddBtn(newItem);
        //console.log('propertyAdd', newItem, id, name);
        return newItem;
    }

    function varFormRemove(row) {
        row.VariantForm.attr('data-valid', 0);
        row.VariantForm.find('input,textarea,select').val('').attr('datavalid', 0);

        delete varRowSetDic[row.Key];
        delete varPropValsDic[row.PropValsKey];
        delete varFormDic[row.Key];

        $('#editform-change-state').val(1).change();
    }

    function bindInputField(varForm, row, field, newVal, noOverride, skipPropvalsKey) {
        var inputField;
        if (field.indexOf('.') != -1) {
            eval('row.' + field + ' = newVal');
            var bindName = field.replace(/[\[\]\.]/g, '_');
            inputField = varForm.find('.variant-form-field[binding=' + bindName + '],.variant-prop-form-field[binding=' + bindName + ']');
            if (!skipPropvalsKey) {
                var propvalsKey = varpropsToKey(row.Properties);
                if (row.PropValsKey != propvalsKey) {
                    var oldRw = varPropValsDic[row.PropValsKey];
                    if (oldRw && oldRw.Key == row.Key) delete varPropValsDic[row.PropValsKey];
                    row.PropValsKey = propvalsKey;
                    if (!varPropValsDic[row.PropValsKey] || !noOverride)
                        varPropValsDic[row.PropValsKey] = row;
                    console.log('bindInputField', row.PropValsKey, row);
                }
            }
        } else {
            if (field == 'Quantity') {
                newVal = parseInt(newVal) || 0;
                if (row[field] != newVal) quantity.clawChangeInt(newVal - row[field]).change();
            }
            row[field] = newVal;
            inputField = varForm.find('.variant-form-field[binding=' + field + ']');
        }
        inputField.val(newVal); console.log(inputField);
    }

    function dropDownCreateNewProp(id, value, optionLabel) {
        var node = $('<input type="text">').attr('id', id), dropdown = $('#temp-prop-0').data('kendoDropDownList');
        $('#dropdown-template-list').append(node);
        node.kendoDropDownList($.extend(dropdown.options, { value: value, optionLabel: { Text: optionLabel } }));
        return node;
    }

    function dropDownClone(selector, dropdownSelector, trNode) {
        var dropdown = $(dropdownSelector).data('kendoDropDownList');
        $(selector, trNode).each(function () {
            $(this).kendoDropDownList($.extend(dropdown.options, { value: $(this).val() }));
            if ($(this).hasClass('var-prop'))
                $(this).data('kendoDropDownList').bind('open', function (e) {
                    varPropMaskItems(e.sender.element, parseInt(e.sender.element.attr('data-propid')));
                });
        });
    }

    function varCrossJoin(arInAr, arr) {
        var retInner = [], ret = [];

        if (arInAr && arInAr.length > 0) {
            var rear = arInAr.pop(); retInner = varCrossJoin(arInAr, rear);
        }

        if (arr) {
            if (retInner.length == 0) retInner.push([]);
            arr.forEach(function (itm) {
                retInner.forEach(function (itmAr) {
                    var tmp = $.extend([], itmAr); tmp.push(itm); ret.push(tmp);
                });
            });
        } else ret = retInner;

        return ret;
    }

    $.fn.getRemoteValidArgs = function (args) {
        var otherItems = [], meId = $(this).attr('data_id'), supplierId = $('#@Html.IdFor(m => m.SupplierId)').val();

        if ($(this).is('.var-sku')) {
            otherItems.push($('#@Html.IdFor(m => m.SKU)').val());
            $('.var-sku').each(function () { if ($(this).attr('data_id') != meId) otherItems.push($(this).val()); });
            args.data = { Id: $(this).attr('data_id') || 0, SKU: $(this).val(), OtherSKUs: otherItems, SupplierId: supplierId };
        }
        if ($(this).is('.var-barcode')) {
            otherItems.push($('#@Html.IdFor(m => m.BarCode)').val());
            $('.var-barcode').each(function () { if ($(this).attr('data_id') != meId) otherItems.push($(this).val()); });
            args.data = { Id: $(this).attr('data_id') || 0, BarCode: $(this).val(), OtherBarcodes: otherItems, SupplierId: supplierId };
        }

        return args;
    };

    </script>
    <div id="variant-form-list" count="@Model.Variants.Count" style="display: none"></div>
    <script id="variant-form-list-template" type="text/var-form-template">
    @for (int i = 0; i < Model.Variants.Count; i++)
    {@RenderVarForm(i, languages, settings.Hidden.VariantMultiImage)}
    </script>
