    function getAvaiPropValTuples(excludedRow) {
        var props = [];

        varProperties.forEach(function (prop) {
            if (prop.PropVals.length > 0) {
                props.push(prop.PropVals.map(function (pval) {
                    return { PropId: prop.Id, PropValId: pval.Id, PropValName: pval.Name };
                }));
            }
        });

        return varCrossJoin(props).filter(function (tuple) {
            var row = varPropValsDic[varpropsToKey(tuple)];
            return !row || (excludedRow && excludedRow.Key == row.Key);
        });
    }

    function varpropertiesSync() {
        var props = []; varProperties = [];

        $('#re-sel-prop-list .var-property').each(function () {
            var pvals = [], propId = $(this).attr('data-id');
            $(this).find('.pval-list li input:hidden').each(function () {
                pvals.push({
                    PropId: propId,
                    PropValId: parseInt($(this).val()),
                    PropValName: $(this).closest('li').find('.prop-val-name').html()
                });
            });
            if (pvals.length > 0) {
                props.push(pvals);
                varProperties.push({
                    Id: propId,
                    Name: $(this).find('.var-prop-cbox .prop-name').html(),
                    PropVals: pvals.map(function (pv) { return { Id: pv.PropValId, Name: pv.PropValName }; })
                });
            }
        });

        return props;
    }

    function propselAddVariant() {

        var dataSource = grid.data('kendoGrid').dataSource, nAdd = 0, prevTotal = dataSource.total();
        var maxVarCount = parseInt('@VariantModel.MaxTotal'), maxVarPerAdd = parseInt('@VariantModel.MaxPerAdd');

        if (prevTotal >= maxVarCount) {
            admincommon.hideMask();
            return;
        }

        var props = varpropertiesSync();
        gridSyncProperties();

        var qtyTotal = 0;
