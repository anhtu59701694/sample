    function varImageAdd(varForm, fieldVals) {

        var lst = $('.variant-image-form-list', varForm), idx = parseInt(lst.attr('count'));
        var prefixId = varForm.attr('data-prefix-id');
        var prefixName = varForm.attr('data-prefix-name');

        lst.attr('count', idx + 1);

        var newForm = $('<div>').html($('#var-image-form-template').html()).find('.variant-image-form');

        newForm.find('input,textarea,select').each(function () {
            //console.log('varImageAdd', varForm, prefixId, prefixName, $(this).attr('id'), $(this).attr('name'));
            var idVal = $(this).attr('id').replace('Variants_0_', prefixId).replace('Images_0_', 'Images_' + idx + '_');
            var nameVal = $(this).attr('name').replace('Variants[0]', prefixName).replace('Images[0]', 'Images[' + idx + ']');
            $(this).attr('id', idVal);
            $(this).attr('name', nameVal);

            //console.log('varImageAdd', idVal, nameVal);
            if ($(this).attr('binding')) {
                if ($(this).is('textarea')) $(this).html(''); else $(this).val('');
            }
        });

        if (fieldVals) {
            newForm.find('.lang_form_field[binding]').each(function () {
                var bindField = $(this).attr('binding'), fbVal = '';
                fbVal = fieldVals[bindField];
                //console.log('varImageAdd', $(this), fVal);
                if ($(this).is('textarea')) $(this).html(fbVal); else $(this).val(fbVal);
            });
        }

        newForm.attr({ 'data-id': 0, 'data-index': idx, 'data-valid': 1, 'data-img-url': fieldVals['Key'] });

        lst.append(newForm);

        //console.log(newForm.html());

        return newForm;
    }

    function initRemoteValidate() {

        $.fn.getRemoteValidArgs = function (args) {
            var otherItems = [], meId = $(this).attr('data_id'), supplierId = $('#@Html.IdFor(m => m.SupplierId)').val();

