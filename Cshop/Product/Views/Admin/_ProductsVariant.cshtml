@using System.Text.RegularExpressions
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Product
@using DM = Claw.Modules.Eshop.Domain
@model ProductModel
@{
    var langCode = (string)ViewData["LangCode"];

    var settings = (SettingsBiz)ViewBag.Settings;
    var languages = (List<Language>)ViewBag.Languages;
    var properties = (List<PropertyModel>)ViewBag.Properties;
    var statuses = (List<StatusModel>)ViewBag.Statuses;
    var templVariant = (VariantModel)ViewBag.TemplVariant;
    var defaultStatusName = statuses.Where(x => x.Id == 3).Select(x => x.Name).FirstOrDefault() ?? "";
}
@{
    Model.Variants.Insert(0, templVariant);

    var qtyTempl = "<div class='var-qty-box' data-backqty='#:(BackOrderQty?1:0)#' data-shoppingqty='#:(ShoppingQty?1:0)#'>" + Html.LocalizeTextBoxFor(m => m.Variants[0].Quantity, new
    {
        @id = "qty-#:Key#",
        @class = "var-cell var-quantity",
        @data_bind = "Quantity",
        @type = Model.Id == 0 ? "number" : "text",
        @style = "",
    }).Replace(new { @name = "_Variants[#:Iseq#].Quantity", @value = "#:Quantity#" })
    + "<input value='- #:BackOrderQty#' class='var-backqty' type='text' disabled=disabled />"
    + string.Format("<div class='var-shoppingqty'>#:ShoppingQty# {0}</div>", Html.LocalizeName(templVariant, m => m.ShoppingQty))
    + (settings.Hidden.Storage2Enabled ? string.Format("<div class='var-qtypos-detail' title='{0}: #:Quantity1#, {1}: #:Quantity2#'>#:Quantity1#/#:Quantity2#</div>", StringTable.GetQtyPosName(DM.QtyPos.Qty1, settings), StringTable.GetQtyPosName(DM.QtyPos.Qty2, settings)) : "")
    + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].Quantity' data-valmsg-replace='true'></span></div>";

    var skuTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].SKU, new
    {
        @id = "sku-#:Key#",
        @class = "var-cell var-sku #: EmailMUsers > 0 ? 'emuser' : '' #",
        @data_bind = "SKU",
        @data_id = "#:Id#",
    }).Replace(new { @name = "_Variants[#:Iseq#].SKU", @value = "#:ifnull(SKU)#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].SKU' data-valmsg-replace='true'></span>"
    /*+ Html.LocalizeTextBoxFor(m => m.Variants[0].NvitCode, new
    {
        @id = "nvitcode-#:Key#",
        @class = "var-cell var-nvitcode",
        @data_bind = "NvitCode",    
        @placeholder = Html.LocalizeName(templVariant, m => m.NvitCode),
        @data_id = "#:Id#",
    }).Replace(new { @name = "_Variants[#:Iseq#].NvitCode", @value = "#:ifnull(NvitCode)#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].NvitCode' data-valmsg-replace='true'></span>"*/
    + (settings.Hidden.PriceCheckEnabled() ? Html.LocalizeTextBoxFor(m => m.Variants[0].PriceCkUrl, new
    {
        @id = "priceckurl-#:Key#",
        @class = "var-cell var-priceckurl",
        @placeholder = Html.LocalizeName(templVariant, m => m.PriceCkUrl),
        @data_bind = "PriceCkUrl",
        @data_id = "#:Id#",
    }).Replace(new { @name = "_Variants[#:Iseq#].PriceCkUrl", @value = "#:ifnull(PriceCkUrl)#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].PriceCkUrl' data-valmsg-replace='true'></span>" : "")
    + "#if (EmailMUsers > 0) { # <div class='emailmusers'><a class='form-link' href='" + ModuleUrl.AdminUrl("EmailMarketUser", "") + "?productId=#:ProductId#&variantId=#:Id#' target='_blank'>#:EmailMUsers#&#128231;</a> | <a class='send' href='javascript:;' onclick='emailMUserSend(#:Id#, this)'>" + StringTable.EmailMUserSend + "</a></div> # }#";

    var barcodeTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].BarCode, new
    {
        @id = "barcode-#:Key#",
        @class = "var-cell var-barcode",
        @data_bind = "BarCode",
        @data_id = "#:Id#",
    }).Replace(new { @name = "_Variants[#:Iseq#].BarCode", @value = "#:ifnull(BarCode)#" })
    + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].BarCode' data-valmsg-replace='true'></span>"
    + (string.Format("<div class='barcode-cmd'><a #:(Id ? \"href=javascript:;\" : \"\")# onclick='viewBarCodeImage(this, false, true, \"\\#barcode-#:Key#\", true)'>{0}</a> | <a href='javascript:;' onclick='generateBarCode(\"\\#barcode-#:Key#\", true)'>{1}</a></div>", StringTable.DownLoadA, StringTable.Generate));

    var backDateTempl = Html.LocalizeDateTextBoxFor(m => m.Variants[0].BackDate, Model.Id, new
    {
        @id = "backdate-#:Key#",
        @class = "var-cell var-backdate",
        @data_bind = "BackDate",
        @data_id = "#:Id#",
        @placeholder = Html.LocalizeName(templVariant, m => m.BackDate),
        @style = "width: 100%;margin-top:px;"
    }).Replace(new { @name = "_Variants[#:Iseq#].BackDate", @value = "#:safeProp(BackDate,'Text')#" });
    var wrapBackDate = "<div class='wBackDate' #:displayTimepicker(ProductStatusId)#>";
    var wrapBackDateEnd = "</div>";
    var statusTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].ProductStatusId, new
    {
        @id = "status-#:Key#",
        @class = "var-cell var-status",
        @data_bind = "ProductStatusId",
        @style = "display:none",
        @onchange = "varPropOnChange($(this),'.var-status-disp')",
    }).Replace(new { @name = "_Variants[#:Iseq#].ProductStatusId", @value = "#:ProductStatusId#" })
    + "<input value='#:ProductStatusName#' class='var-cell-disp var-status-disp' data-bind='ProductStatusName' type='text' />"
    + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].ProductStatusId' data-valmsg-replace='true'></span>";

    var costpriceTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].CostPrice, new
    {
        @id = "costprice-#:Key#",
        @class = "var-cell var-costprice",
        @data_bind = "CostPrice_Text",
        @onchange = "varCalcIncPrice('costprice-#:Key#', 'costpriceinc-#:Key#')",
    }).Replace(new { @name = "_Variants[#:Iseq#].CostPrice", @value = "#:safeProp(CostPrice,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].CostPrice' data-valmsg-replace='true'></span>";

    var costpriceIncTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].CostPriceInc, new
    {
        @id = "costpriceinc-#:Key#",
        @class = "var-cell var-costpriceinc",
        @data_bind = "CostPriceInc_Text",
        @onchange = "varCalcExcPrice('costpriceinc-#:Key#', 'costprice-#:Key#')",
    }).Replace(new { @name = "_Variants[#:Iseq#].CostPriceInc", @value = "#:safeProp(CostPriceInc,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].CostPriceInc' data-valmsg-replace='true'></span>";

    var priceTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].Price, new
    {
        @id = "price-#:Key#",
        @class = "var-cell var-price",
        @data_bind = "Price_Text",
        @onchange = "varCalcIncPrice('price-#:Key#', 'priceinc-#:Key#')",
    }).Replace(new { @name = "_Variants[#:Iseq#].Price", @value = "#:safeProp(Price,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].Price' data-valmsg-replace='true'></span>";

    var priceIncTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].PriceInc, new
    {
        @id = "priceinc-#:Key#",
        @class = "var-cell var-priceinc",
        @data_bind = "PriceInc_Text",
        @onchange = "varCalcExcPrice('priceinc-#:Key#', 'price-#:Key#')",
    }).Replace(new { @name = "_Variants[#:Iseq#].PriceInc", @value = "#:safeProp(PriceInc,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].PriceInc' data-valmsg-replace='true'></span>"
    + (settings.Hidden.PriceCheckEnabled() ? Html.LocalizeTextBoxFor(m => m.Variants[0].PriceCkMinVal, new
    {
        @id = "priceckminval-#:Key#",
        @class = "var-cell var-priceckminval",
        @data_bind = "PriceCkMinVal_Text",
        @placeholder = Html.LocalizeName(templVariant, m => m.PriceCkMinVal),
    }).Replace(new { @name = "_Variants[#:Iseq#].PriceCkMinVal", @value = "#:safeProp(PriceCkMinVal,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].PriceCkMinVal' data-valmsg-replace='true'></span>" : "");

    var salepriceTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].SalePrice, new
    {
        @id = "saleprice-#:Key#",
        @class = "var-cell var-saleprice",
        @data_bind = "SalePrice_Text",
        @onchange = "varCalcIncPrice('saleprice-#:Key#', 'salepriceinc-#:Key#')",
    }).Replace(new { @name = "_Variants[#:Iseq#].SalePrice", @value = "#:safeProp(SalePrice,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].SalePrice' data-valmsg-replace='true'></span>";

    var salepriceIncTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].SalePriceInc, new
    {
        @id = "salepriceinc-#:Key#",
        @class = "var-cell var-salepriceinc",
        @data_bind = "SalePriceInc_Text",
        @onchange = "varCalcExcPrice('salepriceinc-#:Key#', 'saleprice-#:Key#')",
    }).Replace(new { @name = "_Variants[#:Iseq#].SalePriceInc", @value = "#:safeProp(SalePriceInc,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].SalePriceInc' data-valmsg-replace='true'></span>";

    var weightTempl = Html.LocalizeTextBoxFor(m => m.Variants[0].Weight, new
    {
        @id = "weight-#:Key#",
        @class = "var-cell var-weight",
        @data_bind = "Weight_Text",
        @onchange = "",
    }).Replace(new { @name = "_Variants[#:Iseq#].Weight", @value = "#:safeProp(Weight,'Text')#" }) + "<span class='error' data-valmsg-for='_Variants[#:Iseq#].Weight' data-valmsg-replace='true'></span>";

    var imageTempl = "<a href='#:ifnull(ImageFsUrl)#' class='preview'><img id='thumb_#:Id#' src='#:ifnull(ImageThumb)#'/></a><span style='display:#= ifnull(ImageFsUrl) == ''?'none':'block'#;' class=\"es-btn-close image-del\"><a href=\"javascript:void(0)\"> close </a>";
    var templProp = @"<input class='var-cell var-prop var-prop-{0}' style='display:none' onchange='varPropOnChange($(this))'
value='#:ifnull(Properties[{1}].PropValId)#' id='var-prop-{0}-#:Key#' name='var-prop-{0}-#:Key#' data-propid='{0}'
data-bind='Properties[{1}].PropValId' data-val='true' type='text'>"
        + "<span class='var-cell-disp var-prop-disp' data-bind='Properties[{1}].PropValName' />#:ifnull(Properties[{1}].PropValName)#</span>"
        + "<span class='error' data-valmsg-for='var-prop-{0}-#:Key#' data-valmsg-replace='true'></span>";

    Model.Variants.Remove(templVariant);
}

<script src="@(Globals.ResolveClientUrl(LanguageMgr.KendoPath))/kendo.tooltip.js"></script>

<div id="variant-list-box">
    <style type="text/css">
         #grid td.image {
            background: transparent url("@ModuleUrl.ContentUrl("Images/admin/es-img-upload.png", true)") no-repeat scroll center;
            position:relative;
        }
        #grid td.image .es-btn-close.image-del{display: @(settings.Hidden.VariantMultiImage?"none":"block") !important;}
    </style>
    <style type="text/css">
        #grid .k-grid-header .k-header {  white-space: normal !important; }

        #re-sel-prop-list input[type=text] {  height: 24px;  clear: left; }

        #re-sel-prop-list .prop-val-form .prop-val-input-form {  width: 300px; }

        #re-sel-prop-list .var-property .var-prop-cbox {  padding: 4px 3px 6px 3px;  min-width: 50px; }

        #re-sel-prop-list .var-property .pval-list {  width: auto;  max-width: 74%;  padding: 0;  margin-right: 6px;  margin-bottom: 3px; }

        #re-sel-prop-list .var-property .pval-list li {  margin: 0;  padding: 5px 6px; }

        #re-sel-prop-list .var-property .pval-list li .name-color {  min-width: 60px; }

        #re-sel-prop-list .var-property > .wr_submit_top {  margin: 4px 0; }

        #re-sel-prop-list .wr_submit_top li {  margin-right: 0;  height: 21px;  padding-right: 4px; }

        #re-sel-prop-list .wr_submit_top li input {  margin-top: -6px;  padding: 0px 0px 0px 18px;  vertical-align: middle;  line-height: 1em;  height: 24px; }

        #re-sel-prop-list .wr_submit_top li input.btn_add {  background-position: -8px -158px; }

        #re-sel-prop-list .wr_submit_top li input.btn_cancel {  background-position: -8px -272px; }

        #re-sel-prop-list .wr_submit_top li input.btn_save {  background-position: -8px -31px; }

        #re-sel-prop-list .k-dropdown-wrap {  height: 21px;  margin-top: -5px; }

        #re-sel-prop-list .k-dropdown-wrap .k-input {  height: 18px;  line-height: 16px; }

        #variant-list-box .wr_submit_top li:last-child {  margin-right: 0; }

        #grid .table_all td {  padding: 2px;  margin: 0px; }

        #grid.k-grid td.claw-action {  text-align: center; }

        #grid.k-grid td.claw-action > div {  display: inline-block; }

        #grid.k-grid td.claw-action .k-button {  margin: 0 !important;  min-width: 35px !important; }

        #grid td.image:hover {  cursor: pointer; }

        #grid .var-cell.k-numerictextbox {  width: auto !important; }

        #grid .var-cell .k-numeric-wrap {  height: 26px; }

        #grid .var-cell .k-numeric-wrap .k-formatted-value.k-input {  padding: 0px 5px !important; }

        #grid .var-cell:not(.var-priceckminval) .k-numeric-wrap .k-formatted-value.k-input {  margin-top: 2px !important; }

        #grid .var-cell .k-numeric-wrap .k-select .k-link:first-child {  margin-top: -3px; }

        .k-widget.k-dropdown.var-status {  width: 100%; }

        .k-widget.k-dropdown.var-prop {  width: 100%; }

        .var-weight {  text-align: right; }

        .var-sku {  min-width: 100% !important;  margin: 0px !important; }

        .var-sku.emuser {  padding: 1px !important;  height: 1.2em; }

        #grid .emailmusers .send {  color: #6c0b7e; }

        #grid .emailmusers {  font-style: italic;  color: #6c0b7e;  padding: 1px 0 0 0;  margin: 0;  font-size: 11px;  line-height: 11px;  text-align: center; }

        .price-check .var-cell.var-sku {  height: 1.4em !important; }

        #grid.price-check .var-cell.var-priceinc, #grid.price-check .var-cell.var-priceinc .k-numeric-wrap {  height: 1.6em !important;  margin: 0 !important;  font-size: 11px !important; }

        #grid .var-cell.var-priceckurl {  padding: 1px 1px 2px 4px !important;  margin: 0 !important;  width: 100%;  height: 1.4em; }

        #grid .var-cell.var-priceckminval {  width: 100% !important;  height: 1.6em !important;  text-align: right;  font-size: 11px !important;  margin: 0 !important; }

        .var-cell.var-priceckminval .k-numeric-wrap {  height: 1.6em !important;  border-top: none !important; }

        #grid.price-check .var-cell.var-priceckminval .k-input, #grid.price-check .var-cell.var-priceckminval .k-formatted-value.k-input, #grid.price-check .var-cell.var-priceinc .k-input {  height: 1.4em !important;  margin: 0 !important;  font-size: 11px !important; }

        #grid .var-qty-box[data-backqty='0'] {  min-width: 0;  width: 68px !important; }

        #grid .var-qty-box[data-backqty='1'] {  min-width: 0;  width: 68px !important; }

        #grid .var-qty-box[data-backqty='0'] .var-backqty {  display: none; }

        #grid .var-qty-box[data-backqty='1'] .var-backqty {  min-width: 0;  width: 35px;  margin: 0;  border-left: none;  height: 26px; }

        #grid .var-qty-box[data-backqty='1'] .var-quantity {  width: 31px !important;  min-width: 0 !important;  padding-right: 0 !important; }

        .var-cell.var-priceckminval .k-select .k-link:last-child, .price-check .var-cell.var-priceinc .k-select .k-link:last-child {  line-height: 0.8em;  height: 0.8em; }

        .var-priceckurl[data-active="0"], .var-priceckminval[data-active="0"] {  display: none; }

        .var-barcode {  min-width: 100% !important;  margin: 0px !important; }

        .var-status-disp {  min-width: 100% !important; }

        .var-prop-disp {  min-width: 100% !important;  padding: 0 5px !important; }

        .var-quantity {  min-width: 60px !important;  height: 26px !important;  margin: 0 !important;  padding: 0 5px 0px 5px !important; }

        .var-saleprice, .var-price, .var-costprice, .var-salepriceinc, .var-priceinc, .var-costpriceinc {  text-align: right !important;  margin: 0 !important;  min-width: 100% !important; }

        .k-grid-barcode {  vertical-align: bottom; }

        .k-grid-barcode .var-barcode {  padding: 0 !important;  height: 1.2em;  text-align: center; }

        .k-grid-barcode .barcode-cmd {  padding: 1px 0 0 0;  margin: 0;  font-size: 11px;  line-height: 11px;  text-align: center;  vertical-align: bottom; }

        .k-grid-barcode .barcode-cmd a {  color: #6c0b7e;  font-style: italic; }

        .k-grid-barcode .barcode-cmd a[href] {  text-decoration: underline; }

        .k-grid-barcode > span.error {  margin-top: 12px; }

        .remove-format {  position: inherit;  float: inherit; }

        .claw-action {  width: 10px !important; }

        .k-widget.k-calendar {  font-size: 13px !important }

        #grid .var-shoppingqty, .var-qtypos-detail {  font-size: smaller;  margin-left: 5px; }

        #grid .var-qty-box[data-shoppingqty='0'] .var-shoppingqty {  display: none; }

        #grid .var-qtypos-detail {  text-align: right;  margin-right: 3px; }

    </style>

    @if (settings.Hidden.Storage2Enabled)
    {
        <style type="text/css">
            #grid .var-qty-box input {
                max-height: 1.4em !important;
            }
        </style>
    }

    @if (!settings.Hidden.ShoppingProduct)
    {
        <style type="text/css">
            #grid .var-qty-box .var-shoppingqty {
                display: none !important;
            }
        </style>
    }
    else
    {
        <style type="text/css">
            #grid .var-qty-box[data-shoppingqty='1'] input {
                max-height: 1.4em;
            }
        </style>
    }

    <div id="dropdown-template-list" style="display: none">
        @Html.LocalizeDropDownListKendoLang("temp-status", 0, statuses
            .Select(x => new DDListItem() { Value = x.Id.ToString(), Text = x.Name, Active = true, LangVisible = true }),
            StringTable.SelectStatus, new { }, false)

        @foreach (var prop in properties)
        {
            <input id="temp_prop_id_@prop.Id" value="@prop.Id" type="hidden" />
            @Html.LocalizeDropDownListKendoLang("temp-prop-" + prop.Id, 0, "ListPropValDD", "Variant", "temp_prop_id_" + @prop.Id, ("Select " + prop.Name.ToLower()).ModLocalize(), new { }, null, "PropertyId").AutoBind(false)
        }

        @Html.LocalizeDropDownListKendoLang("temp-prop-0", 0, new DDListItem[0], "none", new { }, false).AutoBind(false)
    </div>
    <div class="clo_right col-right-eshop">
        <div class="variant-upload-img-box">
            <section style="display: none">
                @Html.TextBox("variantImageUpload", "",
                    new
                    {
                        @type = "file",
                        @onchange = "variantUploadImg(this)",
                        @accept = "image/*",
                        @datavalextension = StringTable.ErrMsgFileExtension,
                        @datavalregex = settings.Display.Admin.Image.Extensions.GetFileExtensionValidRegEx(false)
                    })
                <div id="variantLoadingImage">
                    <div style="width: 100%; height: 100%; background: #e0e0e0;">@Html.LocalizeImageLoading(new { @style = "display:block" })</div>
                </div>
                @(StringTable.ExtensionAccept) @(settings.Display.Admin.Image.Extensions).
            </section>
            <section><span class="error file-ext-error" style="display: none"></span></section>
        </div>
        <div class="controls">
            <span class="text-eshop bold">@StringTable.SelectVariants</span>
            <div id="re-sel-prop-list"></div>
            <script id="prop-templ" type="text/prop-template">@RenderProperty(new PropertyModel())</script>
            <script id="prop-val-templ" type="text/prop-val-template">@RenderPropVal(new PropValModel())</script>
        </div>
    </div>

    <div class="row_content_box mt_20">
        <ul class="wr_submit_top" style="display:none; top:-37px;">
            <li style="display: none">
                <input id="btn-propsel-update-variants" class="btn_update" value="@StringTable.Update" type="button">
            </li>
            <li>
                <input id="btn-add-one-variant" class="btn_add" value="@StringTable.AddOneVariant" type="button">
            </li>
            <li>
                <input id="btn-propsel-add-variants" class="btn_add" value="@StringTable.AddNewVariant" type="button">
            </li>
        </ul>
        <div class="wr_table_all validable-form-field">
            @(Html.LocalizeGridFor<VariantModel>("grid", "Variant", "Delete")
                  .DataSource(m => m.Id, new List<VariantModel>())
                  .ColumnCheckBox(m => m.Key)
                  .Paging(20, new [] { 20, 30, 50, 100 })
                  .Columns(grid =>
                  {
                      var cols = new[]
                      {
                          grid.Col(m => m.Image)
                              .SetTemplate(imageTempl)
                              .SetCssClass("txt_align_c image"),
                          grid.Col(m => m.SKU)
                              .SetTemplate(skuTempl),
                          grid.Col(m => m.BarCode)
                              .SetTemplate(barcodeTempl)
                              .SetCssClass("k-grid-barcode"),
                          settings.Hidden.ManageVariantWeight ? grid.Col(m => m.Weight, false/*,80*/)
                              .SetTemplate(weightTempl) : null,
                          grid.Col(m => m.Quantity,false/*,80*/)
                              .SetTemplate(qtyTempl),
                          grid.Col(m => m.CostPrice,false/*,80*/)
                              .SetTemplate(costpriceTempl),
                          grid.Col(m => m.CostPriceInc,false/*,80*/)
                              .SetTemplate(costpriceIncTempl),
                          grid.Col(m => m.Price,false/*,80*/)
                              .SetTemplate(priceTempl),
                          grid.Col(m => m.PriceInc,false/*,80*/)
                              .SetTemplate(priceIncTempl),
                          grid.Col(m => m.SalePrice,false/*,80*/)
                              .SetTemplate(salepriceTempl),
                          grid.Col(m => m.SalePriceInc,false/*,90*/)
                              .SetTemplate(salepriceIncTempl),
                          grid.Col(m => m.ProductStatusId,false/*,95*/)
                              .SetTemplate(statusTempl + wrapBackDate + backDateTempl + wrapBackDateEnd),
                          grid.Col(m => m.Active, "", m => m.Id, false/*, 70*/)
                              .SetTemplate("<a href='javascript:void(0);' />")
                              .SetCssClass("k-grid-status td-center"),
                      }.ToList();

                      for (int i = 0; i < properties.Count; i++)
                      {
                          var idx = i;
                          cols.Insert(i + 1, grid.Col(m => m.Properties[idx].PropValId, properties[i].Name, false)
                              .SetTemplate(string.Format(templProp, properties[i].Id, i)));
                      }

                      return cols.Where(m => m != null).ToArray();
                  })
                  .ColumnCommand(grid => new[]
                  {
                      settings.Hidden.VariantMultiImage ? grid.Cmd(m => m.Id, "cmdEditVariant", "Edit", "edit_fr", false, StringTable.Edit, true) : null,
                      grid.Cmd(m => m.Id, "gridOnDelete", "Delete", "delete_fr", false, null,true)
                  }.Where(x => x != null).ToArray(), 70)
                  .Sortable(true)
                  .Config(grid => { grid.CustomScript = "gridCustom"; })
                  .ToMvcHtmlString())
        </div>
        <ul class="wr_submit_top set-relative">
            <li class="mr0 delete_big" style="padding:0;"><input class="btn_delete" value="@StringTable.RemoveVariant" type="button"></li>
        </ul>
    </div>
    @{
        var jsSerializer = new System.Web.Script.Serialization.JavaScriptSerializer() { MaxJsonLength = Int32.MaxValue };
    }
    @Html.Raw("<script type='text/javascript'> variants = " + jsSerializer.Serialize(Model.Variants) + "</script>")
    @Html.Raw("<script type='text/javascript'> varProperties = " + Json.Encode(Model.Variants.GetProperties()) + "</script>")
    <script type="text/javascript">

    var grid = $('#grid'), varFormDic = {}, quantity = $('#@Html.IdFor(m => m.Quantity)');

    function initVariants() {
        gridInit('#grid', true);

        //$('#grid thead th.k-header .k-link').each(function () {
        //    $(this).html($(this).html().replace('(', '<br>('));
        //});

        var gridData = grid.data('kendoGrid').dataSource;
        gridData.bind('change', function(e) {
            if (this.total() == 0) grid.closest(".wr_table_all").hide();
            else grid.closest('.wr_table_all').show();
        });
        gridData.transport.data = variants;
        if (gridData.total() == 0) grid.closest(".wr_table_all").hide();
        else grid.closest('.wr_table_all').show();

        gridBindRowForm(grid.data('kendoGrid'));

        buildPropertyForm(varProperties);

        gridData.read();

        window.variantOnChangeTax = function () {

            var qtyTotal = 0, tax = getVatValue(), gridDs = grid.data('kendoGrid').dataSource;

            gridDs.transport.data = [];
            gridDs.data().forEach(function (row) {
                vrowCalIncPrice(row, tax, 'CostPrice', 'CostPriceInc');
                vrowCalIncPrice(row, tax, 'Price', 'PriceInc');
                vrowCalIncPrice(row, tax, 'SalePrice', 'SalePriceInc');

                bindInputField(row.VariantForm, row, 'CostPrice_Text', row.CostPrice.Text);
                bindInputField(row.VariantForm, row, 'CostPriceInc_Text', row.CostPriceInc.Text);
                bindInputField(row.VariantForm, row, 'Price_Text', row.Price.Text);
                bindInputField(row.VariantForm, row, 'PriceInc_Text', row.PriceInc.Text);
                bindInputField(row.VariantForm, row, 'SalePrice_Text', row.SalePrice.Text);
                bindInputField(row.VariantForm, row, 'SalePriceInc_Text', row.SalePriceInc.Text);

                qtyTotal += row.Quantity;

                gridDs.transport.data.push(row);
            });

            if (gridDs.data().length > 0){
                quantity.val('0').clawChangeInt(qtyTotal).change();

                gridDs.read();
            }
        };
    }

    function varCalcIncPrice(nodeid, targetid) {
        var node = $('#' + nodeid), nodeKd = node.data('kendoNumericTextBox');
        var row = grid.data('kendoGrid').dataItem(node.closest('tr'));
        var binding = node.attr('data-bind').replace('_Text', '');

        if (!nodeKd) return;//reset

        row[binding].Value = nodeKd.value();
        row[binding].Text = localizeMoneyToString(nodeKd.value());
        CalIncPrice(nodeKd.value(), targetid, node);
    }

    function varCalcExcPrice(nodeid, targetid) {
        var node = $('#' + nodeid), nodeKd = node.data('kendoNumericTextBox');
        var row = grid.data('kendoGrid').dataItem(node.closest('tr'));
        var binding = node.attr('data-bind').replace('_Text', '');

        if (!nodeKd) return;//reset

        row[binding].Value = nodeKd.value();
        row[binding].Text = localizeMoneyToString(nodeKd.value());
        CalExcPrice(nodeKd.value(), targetid, node);
    }

    function validProdRequires() {
        var price = $('#@Html.IdFor(m => m.Price)'), saleprice = $('#@Html.IdFor(m => m.SalePrice)');

        if (!price.valid()) {
            price.data('kendoNumericTextBox').focus();
            return false;
        }
        if (!saleprice.valid()) {
            saleprice.data('kendoNumericTextBox').focus();
            return false;
        }

        return true;
    }

    function gridBindRowForm(grid) {
        $('#variant-form-list > .variant-form[data-valid=1]').each(function () {
            var varForm = $(this), row = gridGetRow(grid, varForm.attr('data-id'), varForm.attr('data-key'));
            if (row) {
                varForm.attr('data-uid', row.uid);
                varFormDic[row.Key] = varForm;
            } else console.log('row is null', varForm);
        });
    }

    function qtyViewToggle(show) {
        if (show) { $('#qty-holder').hide(); $('#qty-view-holder').show(); }
        else { $('#qty-holder').show(); $('#qty-view-holder').hide(); }
    }

    function gridCustom(grid) {

        var variantSingleImg = '@(settings.Hidden.VariantMultiImage ? 1 : 0)' == '0';

        if (variantSingleImg) $('td.claw-action .k-button', grid.element).wrap('<div>');

            if (grid.dataSource.total() > 0){
            $('tr', grid.element).each(function () {
                var row = grid.dataItem($(this));
                row.VariantForm = varFormDic[row.Key];
                varRowSetDic[row.Key] = row;
                gridRowEditEvent(grid, $(this), row.PropEdit);
                showValidateErrors(grid, $(this));
            });
            qtyViewToggle(true);
        } else qtyViewToggle(false);

        $('td.image', grid.element).unbind('click').each(function () {
            var previewEmpty = $(this).find('.preview[href=""]');

            function varOnUploadImg() {
                var row = grid.dataItem($(this).closest('tr'));
                $('#variantImageUpload').data({ 'claw-grid-row': row, 'claw-grid-td': $(this).closest('td') }).click();
            }

            if (previewEmpty.length != 0) {
                previewEmpty.hide();
                if (variantSingleImg) $(this).click(varOnUploadImg);
                else $(this).css({ 'cursor': 'default' });
            } else
                if (variantSingleImg) {
                    $(this).find('.es-btn-close.image-del').unbind('click').click(function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var row = grid.dataItem($(this).closest('tr'));
                        row.Image = row.ImageThumb = row.ImageFsUrl = '';
                        bindInputField(row.VariantForm, row, 'Image', '');
                        bindInputField(row.VariantForm, row, 'ImageFsUrl', '');
                        $(this).closest('td').click(varOnUploadImg).html('');
                    });
                }
        });

        $('.delete_big').unbind('click').click(function () {
            var arrRws = [], rows = grid.tbody.find('input:checked').closest('tr');
            rows.each(function () { arrRws.push(grid.dataItem($(this))); });
            variantRemoveRange(arrRws);
        });

        var btnAddOneVar = $('#btn-add-one-variant').unbind('click').click(function () {
            if (validProdRequires()) variantAddOneNew(grid);
        }).closest('li');

        initGridStatusAction(grid, '.k-grid-status',
            function (node, row) { bindInputField(row.VariantForm, row, 'Active', row.Active); },
            function (row) { return row.Active; }, function (row, status) { row.Active = status; });

        gridHideCell(grid, '.k-grid-Delete', function (row) { return row.Deletable == false; });

        gridDisableCheckBox(grid, function (row) { return row.Deletable == false; });

        initImagePreview(true, grid.element);
        gridHideUnusedColumns(grid);

        if (!grid.clawFirstRun && grid.dataSource.total() > 0) {
            grid.clawFirstRun = true;
        }

        if (getAvaiPropValTuples().length == 0) btnAddOneVar.hide();
        else btnAddOneVar.show();

        $('.check-price.price-ck-variant').attr('data-variants', grid.dataSource.total());

        $('#PriceCkActiveTrue').change();

        if ('@(Model.Id)' == '0' ) {
            $('.var-quantity[data-bind]', grid.element).change(function (ev) {
                var status = $(this).closest('tr').find('.var-status[data-bind][id]');
                if (ev && ev.originalEvent && !$(this).is(':focus')) {
                    $(this).focus(); setTimeout(function () { status.change(); }, 1500);
                }
            });
        }

        if (grid.dataSource.total() > 0) {
            $('#ShippingType_w2').closest('.shipping-type-item').hide().find('input').prop('disabled', true);
            if (!$('input[name=ShippingType]:checked:visible').val())
                $('input[name=ShippingType][value=@(ShippingType.RequireShipping.Val())]').prop('checked', true).change();
        }
        else $('#ShippingType_w2').closest('.shipping-type-item').show().prop('disabled', false);
    }

    function variantShowTooltip(node, show) {
        var tooltip = node.data("kendoTooltip") || node.kendoTooltip({
            showAfter: 1000,
            show: function () {
                var me = this;
                if (grid.clawActiveTooltip) grid.clawActiveTooltip.hide();
                grid.clawActiveTooltip = this;
                this.clawTimerId = setTimeout(function () { me.clawTimerId = null; me.hide(); }, 10000);
            },
            hide: function () {
                if (this.clawTimerId) clearTimeout(this.clawTimerId);
                grid.clawActiveTooltip = this.clawTimerId = null;
            }
        }).data("kendoTooltip");
        //console.log('Tooltip', node, tooltip);
        var lst = showOtherCurrencies(node.find('.var-cell[id]'), true);

            if (!lst || lst.length == 0)return;

        var msg = '<div style="text-align:left"><div style="white-space:nowrap">@(StringTable.MultiCurrencyVariantPriceTitle)</div>' + lst.join(' ') + '</div>';

        if (show || show == null) tooltip.show();

        if (tooltip.content)
        {
            tooltip.content.html(msg);
            if (tooltip.content.is(':visible')) setTimeout(function() { variantShowTooltip(node, false); }, 1000);
        }
    }

    function showValidateErrors(grid, trNode) {
        $('.var-sku,.var-barcode,.var-quantity,.var-costprice,.var-costpriceinc,.var-price,.var-priceinc,.var-saleprice,.var-salepriceinc,.var-status', trNode).each(function () {
            var name = ($(this).attr('name') || '').substring(1), msg = modelState[name];
            if (name && msg) {
                $(this).closest('td').find('span.error')
                    .removeClass('field-validation-valid')
                    .addClass('field-validation-error').append($('<span>').html(msg));
                delete modelState[name];
                if (!firstErrorInputElement) {
                    firstErrorInputElement = $(this);
                    setTimeout(function () { firstErrorInputElement.focus(); }, 2000);
                };
            } else $(this).removeClass('input-validation-error');
        });
    }

    function initFormShowErrorMsgEx() {

        if (!window.formShowErrorMsg) setTimeout(initFormShowErrorMsgEx, 500);

		window.formShowErrorMsg = function (fieldName, errMessage, form) {
			var validObj = $(form || '#editForm').validate();

			if (!validObj.settings.rules[fieldName]) {
				console.log(fieldName + ' not found!'); return;
			}
			else if(errMessage) {
				var errors = {}; errors[fieldName] = errMessage;
				validObj.showErrors(errors);
			}
			else {
				var node = $(validObj.currentForm).find('[name][name="' + fieldName + '"]', 'input,select,textarea');
				if(node.length != 0) node.valid();
			}
		}
    }

	setTimeout(initFormShowErrorMsgEx, 100);

    function gridRowEditEvent(grid, trNode, propEdit) {
        var cellNodes = $('.var-cell,.var-cell-disp', trNode);
        $('.var-quantity', trNode).unbind('click').click(function () { openEditQtyForm(this, null, grid.dataItem(trNode), grid); });

        cellNodes.change(function (event) {
            if ($(this).is('input, textarea, select')) {
                var row = grid.dataItem(trNode), bCancel = false;
                if ($(this).valid()) {
                    var field = $(this).attr('data-bind').replace('_', '.'), fVal = $(this).val();
                    if ($(this).hasClass('var-prop')) {
                        var tmpRow = { Properties: row.Properties.map(function (itm) { return $.extend({}, itm); }) };
                        fVal = parseInt(fVal);
                        eval('tmpRow.' + field + ' = ' + fVal);
                        var aRow = varPropValsDic[varpropsToKey(tmpRow.Properties)];
                        if (aRow && aRow.Key != row.Key && !varpropsTryFix($(this), trNode, row)) {
                            bCancel = true;
                            console.log('gridRowEditEvent: change skipped', row, field, fVal, tmpRow);
                        }
                    }
                    if (field && !bCancel) {
                        var statusNode = $('.var-status[data-bind]', trNode), statusKd = statusNode.data('kendoDropDownList'), statusVal = statusNode.val();
                        if ($(this).is('.var-quantity') && ((parseInt(fVal) && statusVal == '3') || (!parseInt(fVal) && statusVal == '2'))) {
                            if (statusKd) statusKd.value(statusVal == '3' ? 2 : 3);
                            statusNode.val(statusVal == '3' ? 2 : 3).change();
                        }
                        if ($(this).is('.var-priceinc,.var-costprice') && event.originalEvent && @(settings.Hidden.ProductVariMainPriceDisabled ? 0 : 1) == 1) {
                            setTimeout(function () {
                                var priceIncNode = $('#PriceInc'), priceInc = null, priceIncKd = priceIncNode.data('kendoNumericTextBox');
                                grid.dataSource.data().forEach(function (rw) {
                                    priceInc = priceInc == null ? rw.PriceInc.Value : Math.min(priceInc, rw.PriceInc.Value);
                                });
                                if (priceIncKd && priceInc) {
                                    priceIncKd.value(priceInc); priceIncNode.change();
                                }
                            }, 1000);
                        }
                        bindInputField(row.VariantForm, row, field, fVal);
                    }
                } else $(this).focus();
            }
        });

        cellNodes.focus(function () {
            @{ var settingOther = settings.Display.Others;}
            if (!trNode[0].clawInitKendoInput) {
                var numNodes = $('.var-costprice,.var-costpriceinc,.var-price,.var-priceinc,.var-saleprice,.var-salepriceinc,.var-weight,.var-priceckminval', trNode);
                var dateNodes = $('.var-backdate', trNode);
                trNode[0].clawInitKendoInput = true;

		trNode.find('.var-sku').focus();
		var node = $(this);

		setTimeout(function () {
                	initKendoNumeric(numNodes, { format: '@settingOther.GetPriceFormat()', step: '@settingOther.PriceStep' });
                	if (dateNodes.length != 0) initDatePicker(dateNodes);

                	$('.var-priceckminval:not([data-bind])', trNode).attr('data-active', $('input.var-priceckminval[data-bind]', trNode).attr('data-active'));

                	var costprice = $('input.var-costpriceinc[name]', trNode), price = $('input.var-priceinc[name]', trNode), saleprice = $('input.var-salepriceinc[name]', trNode);
                	$('input.var-costprice[name],input.var-costpriceinc[name],input.var-price[name],input.var-priceinc[name],input.var-saleprice[name],input.var-salepriceinc[name]', trNode)
                	    .change(function () { validatePrices(price, saleprice, null, costprice); })
                	    .focusout(function () { validatePrices(price, saleprice, null, costprice); });
                	validatePrices(price, saleprice, null, costprice);


                	setTimeout(function () { if (node.data('kendoNumericTextBox')) node.data('kendoNumericTextBox').focus(); }, 500);
		}, 500);
            }

            if ($(this).is('input, textarea, select')) {
                var rwNode = $(this).closest('tr');
                if (!rwNode[0].clawFormUpdateValidRules) {
                    rwNode[0].clawFormUpdateValidRules = true;
                    $('.var-cell-disp', trNode).each(function() {
                        if (!$(this).hasClass('var-prop-disp')) $(this).hide();
                    });
                    formUpdateValidRules(rwNode);
                    gridRowEditControl(grid, trNode);
                }
            }
        });

        if('@(settings.Hidden.SingleCurrency ? "0" : "1")' == '1')
            $('.var-costpriceinc,.var-priceinc,.var-salepriceinc', trNode)
                .closest('td').unbind('hover').hover(function() { variantShowTooltip($(this), true); }, function() {
                    var tooltip = $(this).data("kendoTooltip");
                    if (tooltip) {
                        tooltip.hide();
                        if (tooltip.timeout) clearTimeout(tooltip.timeout);
                        tooltip.timeout = null;
                    }
                });

        if (propEdit) cellNodes.focus();
    }

    //hide unused items
    function varPropMaskItems(node, propId) {
        var nodeD2L = node.data('kendoDropDownList'), propvalDic = {};
        var prop = varProperties.find(function (itm) { return itm.Id == propId; });

        if (!prop || !nodeD2L) return;

        prop.PropVals.forEach(function (pv) { propvalDic[pv.Name] = pv; });

        $('li.k-item', nodeD2L.ul).each(function () {
            var valTxt = $(this).find('div').html();
            if (propvalDic[valTxt]) $(this).show();
            else $(this).hide();
        });
    }

    function gridRowEditControl(grid, trNode) {
        dropDownClone('input.var-status', '#temp-status', trNode);

        var row = grid.dataItem(trNode);
        if (row.PropEdit) {
            @for (int i = 0; i < properties.Count; i++)
                {
                    @Html.Raw(string.Format("dropDownClone('input.var-prop-{0}', '#temp-prop-{0}', trNode);", properties[i].Id))
                }
            row.PropEdit = false;
            trNode.find('.var-prop-disp').hide();
        }
    }

    $('#btn-add-variants').unbind('click').click(function () {
        openSelPropForm();
        return false;
    });

    $('#btn-propsel-add-variants').unbind('click').click(function () {

        if (!validProdRequires()) return;

        admincommon.showMask();
        setTimeout(function () { propselAddVariant(); }, 100);
        return false;
    });

    function varPropOnChange(node, dispSelector) {

        var row = grid.data('kendoGrid').dataItem(node.closest('tr'));
        var nodeDisp = node.closest('td').find(dispSelector || '.var-prop-disp');
        var nodeD2L = node.data('kendoDropDownList'), fieldVal = node.attr('data-bind');

        if (!nodeD2L) return;//reset
        node.closest('td').find('.wBackDate').css('display', 'none');
        if (node.val() == 3) node.closest('td').find('.wBackDate').css('display', 'block');
        var fieldTxt = nodeDisp.attr('data-bind'), valTxt = nodeD2L.text(), nodeName = node.attr('name');

        if (!dispSelector) {
            var fPropValId = null;
            eval('fPropValId = row.' + fieldVal);
            if (fPropValId != nodeD2L.value()) {
                nodeD2L.value(fPropValId);
                formShowErrorMsg(nodeName, '@StringTable.ErrMsgDuplicateVariant');
                setTimeout(function () { formShowErrorMsg(nodeName, ''); }, 5000);
                return; //cancelled
            } else formShowErrorMsg(nodeName, '');
        }

        nodeDisp.val(valTxt);
        bindInputField(row.VariantForm, row, fieldTxt, valTxt, true, true);
    }

    function varpropsTryFix(node, trNode, row) {

        var avaiTuples = getAvaiPropValTuples(row), currentPropId = parseInt(node.attr('data-propid'));
        var nodeD2L = node.data('kendoDropDownList'), valId = nodeD2L.value();
        var mTuples = avaiTuples.filter(function (tuple) {
            return tuple.filter(function (itm) { return itm.PropValId == valId; }).length != 0;
        });

        if (mTuples.length == 0) return false;

        $('.var-prop', trNode).each(function () {
            var propD2L = $(this).data('kendoDropDownList'), propId = parseInt($(this).attr('data-propid'));
            if (propD2L && propId != currentPropId) {
                var nodeDisp = $(this).closest('td').find('.var-prop-disp');
                var fieldTxt = nodeDisp.attr('data-bind').replace('_', '.');
                var mItem = mTuples[0].find(function (itm) { return itm.PropId == propId; });
                var field = $(this).attr('data-bind').replace('_', '.');
                if (mItem) {
                    propD2L.value(mItem.PropValId);
                    bindInputField(row.VariantForm, row, field, mItem.PropValId, true, true);
                    bindInputField(row.VariantForm, row, fieldTxt, mItem.PropValName, true, true);
                    //console.log('varpropsTryFix', propId, mItem);
                }
            }
        });

        return true;
    }

    function openSelPropForm() {
        ajaxCmdHtml('@ModuleUrl.AdminUrl("Variant", "GetSelPropForm")/?lang=' + getFocusLang(), { id: '@Model.Id' }, function (result) { doOpenSelPropForm(result); });
    }

    function doOpenSelPropForm(html) {
        var width = Math.max(200, Math.min(900, $(window).width() - 50));
        var height = Math.max(200, Math.min(500, $(window).height() - 50));
        var popTemplate = $("<div>").html($("#selprop-popup-form-templ").html());
        popTemplate.find('.htmlcontent').html(html);
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.AddVariants', popTemplate.html(),
            width, height, [], null,
            function (modal) {
                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var scrollPos = $(window).scrollTop();

                $('#popupForm .wr_clo1', modal).css('height', height - 60 + 'px');

                var propList = $('#sel-prop-list');
                varProperties.forEach(function (prop) {
                    var propNode = propList.find('.var-property[data-id=' + prop.Id + ']');
                    propNode.find('.var-prop-cbox input[type=checkbox]').click();
                    propNode.find('.pval-list li input[type=checkbox]').each(function () {
                        var propValId = parseInt($(this).val());
                        if (prop.PropVals.some(function (pv) { return pv.Id == propValId; })) $(this).prop('checked', true);
                    });
                });

                modal.find(".btn_save").click(function () {

                    var props = [];
                    $('#sel-prop-list .var-property').each(function () {
                        if ($(this).find('.var-prop-cbox input').prop('checked')) {
                            var propId = $(this).attr('data-id'), name = $(this).attr('data-name');
                            var prop = { Id: propId, Name: name, PropVals: [] };

                            $(this).find('.pval-list li').each(function () {
                                if ($(this).find('input').prop('checked')) {
                                    prop.PropVals.push({ Id: $(this).attr('data-id'), Name: $(this).attr('data-name') });
                                }
                            });
                            if (prop.PropVals.length) props.push(prop);
                        }
                    });
                    //console.log('model', props);
                    if (!selpropAddCounter) buildPropertyForm(props);
                    else variantListBoxReload(props);

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close();
                    $(window).scrollTop(scrollPos);
                });

                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close();
                    $(window).scrollTop(scrollPos);
                });
            });
    }

    function buildPropertyForm(properties) {

        var maxProps = parseInt('@VariantModel.MaxProps');

        while (properties.length > maxProps) properties.pop();

        //console.log('buildPropertyForm', properties);
        var listBox = $('#re-sel-prop-list').html(''), gridData = grid.data('kendoGrid');
        var propsels = {}, columns = gridData.columns;
        for (var i = 0; i < properties.length; i++) {
            var prop = properties[i];
            var propEle = propertyAdd(prop.Id, prop.Name);
            listBox.append(propEle);
            for (var k = 0; k < prop.PropVals.length; k++) {
                var pval = prop.PropVals[k];
                var pvalEle = propValAdd(pval.Id, pval.Name);
                if (pvalEle) propEle.find('.pval-list').append(pvalEle);
            }
            propsels[prop.Name] = prop;
        }

        varProperties = properties;

        propvalInitDeleteEvent(listBox);

        $('#btn-propsel-update-variants').unbind('click').click(function () {

            if (!validProdRequires()) return;

            var propVals = $(this).data('prop-vals') || [];
            variantRemoveGroup(propVals);
            $(this).data('prop-vals', null);
            $('.btn-add-prop-val', listBox).closest('li').show();
        }).data('prop-vals', null);

        var btnObj = $('#btn-propsel-add-variants,#btn-add-one-variant').closest('li').hide();
        if ($('#re-sel-prop-list:parent').length != 0) { btnObj.show().closest('ul').show(); }

        formUpdateValidRules(listBox);
    }

    function propvalInitDeleteEvent(holder) {
