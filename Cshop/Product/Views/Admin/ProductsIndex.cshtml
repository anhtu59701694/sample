    function openEditQtyForm(row, tdNode, qtyPos) {
        var width = Math.max(200, Math.min(500, $(window).width() - 50));
        var height = Math.max(200, Math.min(420, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#edit-qty-popup-form-templ").html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@Html.Raw(StringTable.EditProductQuantity)', popTemplate.html(),
            width, height, [], null,
            function (modal) {

                if (qtyPos != null) {
                    if (qtyPos == 2) $('#QtyPos2', modal).prop('checked', true);
                    else $('#QtyPos1', modal).prop('checked', true);
                }

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');
                var reasonTmpl = $('#reason-templ').data('kendoDropDownList');

                admincommon.hideMessage();
                formUpdateValidRules(modal.find('.popupBody'));

                $('#Reason', modal).change(function() {$(this).valid();}).kendoDropDownList(reasonTmpl.options);

                $('#QtyAdd,#QtyRemove', modal).change(function() {
                    var costPriceBox = $('#CostPrice', modal).closest('.controls').hide();
                    if ($(this).valid() && parseInt($(this).val()) > 0) {
                        var node = $(this);
                        $('#QtyAdd,#QtyRemove', modal).each(function() {
                            if ($(this).attr('id') != node.attr('id'))
                                $(this).prop('disabled', true).val('0').valid();
                        });

                        if($(this).attr('id') == 'QtyAdd') costPriceBox.show();
                    } else $('#QtyAdd,#QtyRemove', modal).prop('disabled', false);
                });

                modal.find(".btn_save").click(function () {
                    var data = urlToJSON('?' + $('#editQtyForm').serialize());
                    if (($('#editQtyForm').valid() ? 1 : 0) + ($('#Reason', modal).valid() ? 1 : 0) == 2)
                        ajaxCmdStatus('@ModuleUrl.AdminUrl(Html.GetController(), "UpdateQuantity")',
                        { id: row.Id, delta: parseInt(data.qtyadd || 0) - parseInt(data.qtyremove || 0), reason: data.reason, qtyPos: data.qtypos, CostPrice: data.costprice, note: data.note, iSeq: -1 },
                        function(result) {
                            row.Quantity1 = result.Quantity1; 
                            row.Quantity2 = result.Quantity2;
                            row.ProductStatusId = result.ProductStatusId;
                            row.ProductStatusName = result.ProductStatusName;
                            if (row.Information)row.Information.InStock = result.Quantity;
                            $('.qty-view-combined', tdNode).val('- ' + (row.BackOrderQty = result.BackOrderQty));
                            $('.qty-view', tdNode).val(row.Quantity = result.Quantity); 
                            $('.qtypos-detail', tdNode)
                                .attr('title', '@StringTable.GetQtyPosName(DM.QtyPos.Qty1, settings): {0}, @StringTable.GetQtyPosName(DM.QtyPos.Qty2, settings): {1}'.replace('{0}', result.Quantity1).replace('{1}', result.Quantity2))
                                .val('{0}/{1}'.replace('{0}', result.Quantity1).replace('{1}', result.Quantity2));

                            grid.data('kendoGrid').refresh({ action: 'rebind', items: [row] });

                            inputErrBox.append(msgBox);
                            popup.close(); $(window).scrollTop(scrollTop);
                        });
                });
                modal.find(".btn_cancel").click(function () {
                    inputErrBox.append(msgBox); admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });

    }

    function initGridLocationBox(grid, selector, actionUrl) {
        $(selector, grid.element).unbind('click').click(function() {
            if (!$(this).attr('valid-init')) {
                $(this).attr({
                    'data-val': 'true', 'maxlength':'210', 'data-val-length-max':'200',
                    'data-val-length': '@string.Format(StringTable.ErrMsgLengthLimit.ModErrLocalize(), "", 200)'
                });

                formUpdateValidRules($(this).closest('td'));
                $(this).attr('valid-init', '1');
            }
        }).change(function () {
            var row = grid.dataItem($(this).closest("tr")), newVal = $(this).val();
            if ($(this).valid()) ajaxCmd(actionUrl, { id: row.Id, value: newVal }, function (result) {
                row.Location = newVal;
                grid.refresh({ action: 'rebind', items: [row] });
            });
        }).show();
    }

</script>
