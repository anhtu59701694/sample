    <input class='qty-view combined' data-type='#:Type#' value='#:Quantity#' #:(Type == 1 ? 'disabled' : '')# data-backval='#:BackOrderQty#' type='text'>
    <input class='qty-edit combined' id='quantity_#:Id#' name='quantity_#:Id#' value='#:Quantity#' type='number' >
    <input value='- #:BackOrderQty#' data-val='#:BackOrderQty#' class='qty-view-combined' disabled='disabled' type='text'>
    <div class='shoppingqty' data-shoppingqty='#:(ShoppingQty?1:0)#'>#:ShoppingQty# {0}</div>
    <div class='qtypos-detail' title='{1}: #:Quantity1#, {2}: #:Quantity2#'>#:Quantity1#/#:Quantity2#</div>
    <div class='cmd-box'></div>
    <span class='field-validation-valid error' data-valmsg-for='quantity_#:Id#' data-valmsg-replace='true'></span>", Html.LocalizeNameFor(m => m.ShoppingQty), StringTable.GetQtyPosName(DM.QtyPos.Qty1, settings), StringTable.GetQtyPosName(DM.QtyPos.Qty2, settings));

    var infoTempl = string.Format(@"
    <span class='text-es-table'>#:Information.InStock# {0} #:Information.Variants# {1}</span>
    <span class='text-es-table'>#:Information.OrderLines# {2}</span>",
    Html.LocalizeNameFor(m => m.Information.InStock), Html.LocalizeNameFor(m => m.Information.Variants), Html.LocalizeNameFor(m => m.Information.OrderLines));

    var salePricetmp = @"
    <span class='price_1 line-through'>#:safeProp(PriceInc,'Text')#</span>
    <span class='price_2'>#:safeProp(SalePriceInc,'Text')#</span>";

    var priceTempl = @"<span class='price_1 size18'>#:safeProp(PriceInc,'Text')#</span>";

    var hiddenTempl = "";//string.Format("<span class='link-hiden-es'>{0}</span>", StringTable.HiddenWeb);

    var imgTempl = @"<a alt='#:Name#' href='#:safePropImg(Image,'FsUrl')#' class='preview'><img src='#:safePropImg(Image,'Thumb')#'/></a>";
    var imgBundle = "<span class='icon-bundle-grid'><img src='" + ModuleUrl.ContentUrl("Images/admin/bundle.png", true) + "'/></span>";
}
<form id="list-form">
    @*@Html.AntiForgeryToken()*@
    @{ KendoGrid<ProductModel> kgrid = null; }
    @(Html.LocalizeGridFor("grid", Html.GetController(), "Delete", null, null, null, settings.Display.Admin.ProductPageSize)
    .DataSource(m => m.Id, "List", null, null, "gridGetParams")
    .Paging(10, new int[] { 10, 20, 30, 50, 100 }, StringTable.Products)
    .ColumnCheckBox(m => m.Id)
    .Columns(grid => new[]
    {
        grid.Col(m => m.Image)
            .SetTemplate(imgTempl)
            .SetCssClass("txt_align_c product-img"),

        grid.Col(m => m.Name, "Edit", m => m.Id, true)
            .SetDefaultSort(true)
            .SetCssClass("k-grid-name name-pro")
            .SetTemplate("<a class='grid-row-edit'>#:Name#</a> #if (IsBundle) { # " + imgBundle + " # }#  #if (EmailMUsers > 0) { # <div class='emailmusers'><a href='" + ModuleUrl.AdminUrl("EmailMarketUser", "") + "?productId=#:Id#&s302=~' target='_blank'>#:EmailMUsers# " + Html.LocalizeNameFor(m => m.EmailMUsers) + "</a></div> # }#"),

       grid.Col(m => m.PriceInc,m => m.SalePriceInc, true, 70)
            .SetTemplate("# if (SalePriceInc.Value > 0) { # "+salePricetmp+" # }  else{#" + priceTempl + "#} #"),

        grid.Col(m => m.Information, false, 180)
            .SetTemplate(infoTempl),

       grid.Col(m => m.Quantity, true, 100)
            .SetCssClass("td-center k-grid-quantity")
            .SetTemplate(ViewBag.PermissionEdit ? qtyTemp : "#:Quantity#"),
       
       grid.Col(m => m.DisplayOrder, true, 100)
            .SetCssClass("td-center k-grid-displayorder")
            .SetTemplate(ViewBag.PermissionEdit ? "<input value='#:DisplayOrder#' type='text'>":"#:DisplayOrder#"),
       
       controllerName.InList("bundleproduct") 
        ? null 
        : grid.Col(m => m.Location, true, 100)
            .SetCssClass("k-grid-location")
            .SetTemplate(ViewBag.PermissionEdit ? "<textarea id='Location_#:Id#' style='display:none;' prodtype='#:Type#' name='Location_#:Id#'lines='3'>#:(Location||'')#</textarea><span class='error' data-valmsg-for='Location_#:Id#' data-valmsg-replace='true'></span>":"#:(Location||'')#"),

       grid.Col(m => m.IsAccessory, true, 70)
            .SetTemplate(StringTable.BoolTempl)
            .SetCssClass("k-grid-IsAccessory"),
                     
       grid.Col(m => m.VisibleWeb, false, 70)
            .SetTemplate(StringTable.BoolTempl)
            .SetCssClass("k-grid-VisibleWeb"),
            
       grid.Col(m => m.ProductStatusName, true, 80)
            .SetTemplate("<span class='status-es-table'>#:ProductStatusName#</span>")
            .SetCssClass("last txt_align_l"),
            
       grid.Col(m => m.ModifiedDate, true, 90)
            .SetTemplate("#:ModifiedDate.TextF#"),

                                
    }.Where(m => m != null).ToArray())
    .ColumnCommand(grid => new[]
    {
        grid.Cmd(m => m.Id, "Edit","Edit", "edit_fr"),
        ViewBag.PermissionEdit ? grid.Cmd(m => m.Id, "Delete","Delete", "delete_fr", true) : null
    }.Where(x => x != null).ToArray(), 60)
    .Sortable(true)
    .Config(grid => { grid.CustomScript = "gridCustom"; kgrid = grid; })
    .ToMvcHtmlString())
</form>
<script type='text/javascript'> var gridEagerItems = @Html.Raw(Json.Encode(kgrid.GetEagerData(ViewBag.EagerData))); </script>
<script type="text/javascript">

    $.validator.methods.number = function (value, element) {
        if (!value || $.trim(value) == '') return this.optional(element);
        var regex = new RegExp('@(LanguageMgr.GetNumberRegex(LanguageMgr.FocusLang).Replace("\\", "\\\\"))');
        return regex.test(value);
    };

    $.validator.methods.range = (function (value, element, param) {
        param[0] = localizeParseFloat($(element).attr('data-val-range-min'));
        param[1] = localizeParseFloat($(element).attr('data-val-range-max'));
        var newval = localizeParseFloat(value);
        //console.log('range', value, element, param, newval, value);
        return this.optional(element) || (newval >= param[0] && newval <= param[1]);
    });

    var advSearchFrm = $('#search-form .wr-search-adv');
    var grid = $('#grid'), permEdit = '@(ViewBag.PermissionEdit ? 1 : 0)' == '1';

    if ('@(searchInfo.IsDataModelEmpty ? 1 : 0)' == '1') {
        advSearchFrm.show();
        $('#formSearch').hide();
        if ('@(searchInfo.IsSpecial ? 1 : 0)' == '1') $('#search-form').hide();
    }

    gridInit('#grid', true, function(params) {return gridEagerLoadConfig(params, gridEagerItems);});

    function gridCustom(grid) {

        if(permEdit)
            $('.k-grid-quantity .qty-view[data-type="0"]', grid.element).unbind('click').click(function() {
                var row = grid.dataItem($(this).closest('tr'));
                openEditQtyForm(row, $(this).closest('td'));
            }).each(function() {
                var row = grid.dataItem($(this).closest('tr'));
                if (row && ((row.Information && row.Information.Variants > 0) /*|| row.IsBundle*/))
                    $(this).prop('disabled', true);
            });

        initImagePreview();

        gridMarkLangDisabled(grid, '.k-grid-name', function(row) { return !row.LangVisible; });

        gridHideCell(grid, '.k-grid-Delete', function(row) { return row.Id == 1 || row.AnyBundleRef; });

        gridDisableCheckBox(grid, function (row) { return row.Id == 1 || row.AnyBundleRef; });

        initGridDisplayOrderBox(grid, '.k-grid-displayorder input', '@ModuleUrl.AdminUrl(Html.GetController(), "ChangeDisplayOrder")');

        initGridLocationBox(grid, '.k-grid-location textarea:not([prodtype=1])', '@ModuleUrl.AdminUrl(Html.GetController(), "ChangeLocation")');

        initGridStatusAction(grid, '.k-grid-IsAccessory', permEdit ? '@(ModuleUrl.AdminUrl(Html.GetController(), "SetAccessory"))' : '',
            function (row) { return row.IsAccessory; }, function (row, status) { row.IsAccessory = status; },
            function (row) { return { id: row.Id, value: row.IsAccessory }; });

