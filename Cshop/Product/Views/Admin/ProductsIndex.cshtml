@using Claw.Modules.Eshop;
@using Claw.Modules.Eshop.Controllers.Admin
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Product
@using DM=Claw.Modules.Eshop.Domain
@model IEnumerable<ProductModel>

@{
    Layout = "Layout/List.cshtml";

    ViewBag.PermissionEdit = PermissionMgr.CurrentPerm.CatalogEdit;
    ViewBag.Title = StringTable.ManageProducts;
    ViewBag.AddAction = "Add";
    ViewBag.UseImgPreview = true;
    ViewBag.ShowFilterBox = true;
    ViewBag.UseInlineEdit = true;
    ViewBag.UseUploadFile = true;
    ViewBag.SearchPlaceHolder = StringTable.ProductNameOrSku;
    var prodNormal = true;
    var controllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    if ("bundleproduct".Equals(controllerName.ToLower()))
    {
        ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/bundleproduct";
        ViewBag.ParentBreadcrumbTitle = StringTable.Bundle;
        prodNormal = false;
    }
    else
    {
        ViewBag.ParentBreadcrumbLink = "/admin/modules/eshop/product";
        ViewBag.ParentBreadcrumbTitle = StringTable.Product;
    }

    var settings = (SettingsBiz)ViewBag.Settings;
    var searchInfo = (ProductModel.AdvSearchModel)ViewBag.SearchInfo;
    var category = (CategoryModel)ViewBag.Category;
    var cateid = category == null ? 0 : category.Id;
    var status = (StatusModel)ViewBag.Status;
    var statusid = status == null ? null : (int?)status.Id;

    ViewBag.ShowSearchBox = !searchInfo.IsSpecial;

    //search
    var Categories = (List<CategoryModel>)ViewBag.Categories;
    var Statuses = (List<StatusModel>)ViewBag.Statuses;
    var Manufactureres = (List<ManufacturerModel>)ViewBag.Manufactureres;

    var htmlAdvSearch = Html.GetHtmlHelper(searchInfo);
}

<style type="text/css">
    .grid-info-stat .num {color: #636262;}
    .controls .row_content_box .clo_left {padding-bottom: 15px;}
    #special-search {font-size: medium;font-weight: bold;color: #6C0B7E;}
    #special-search .close-2 {color: black;font-size: small;}
    #special-search .close-2:hover {color: red;cursor: pointer;}
    .k-grid td .preview {line-height: 0;vertical-align: bottom;}
    .k-grid td .preview img {float: none;}
    .k-grid .k-grid-quantity .qty-edit, .k-grid .k-grid-displayorder .disorder-edit {display: none;}
    .k-grid .k-grid-displayorder input {min-width: 0;margin: 0;width: 90%;}
    .k-grid .k-grid-displayorder .k-numerictextbox{ width: 90%}
    .k-grid .k-grid-displayorder .k-numeric-wrap{ height: 26px;}
    .k-grid .k-grid-displayorder .k-numeric-wrap .k-input{ height: 24px;}

    /*.k-grid .k-grid-quantity .qty-view {width: 133px;margin: 0;text-align: right;}
    .k-grid .k-grid-quantity input[type=number] {padding: 0 7px !important;margin: 0 -7px !important;width: 116px !important;}*/

    .k-grid td .cmd-box {position: absolute;text-align: right !important;display: none;margin-top: 2px;}
    .k-grid td .cmd-box .wr_submit_top {width: 160px;}
    .k-grid td .cmd-box .wr_submit_top li {height: 25px;width: 60px;margin: 3px 4px;float: right;border: 1px #999f9d solid;}
    .k-grid td .cmd-box .wr_submit_top li input {height: 23px;margin: -5px 0px 0px -5px;text-indent: -8px;}
    .k-grid td .error.field-validation-error {margin-top: 30px;}
    #grid .k-grid-quantity { text-align: left !important; }
    #grid .qty-view-combined{width: 40px;min-width: 0;height: 30px;float: right;display: inline-block;}
    #grid .qty-view-combined[data-val='0']{display: none !important;}
    #grid .qty-edit.combined{width: 60px !important;margin: 0;}
    #grid .qty-view.combined{width: 50px !important;min-width: 0;height: 30px;margin: 0 0 0 4px;}
    #grid .qty-view.combined[data-backval='0']{width: 93% !important;}
    #grid .k-grid-location textarea {padding: 0px !important; resize: none;margin: 0;height: 60px; }
    #grid .k-grid-location .error { margin-top: 0 }
    #grid .shoppingqty {margin-left: 11px;font-size: small;margin-top: 2px;height:1.3em;}
    #grid .shoppingqty[data-shoppingqty='0'] {display:none;}
    #grid .k-grid-name.name-pro {min-width:0 !important;}
    #grid .k-header[data-field="DisplayOrder"] .k-link {width:70px;}
    #grid .k-header[data-field="VisibleWeb"] .k-link {width:70px;}
    #grid .k-header[data-field="ModifiedDate"] .k-link {width:70px;}
    #grid .k-header[data-field="Quantity"] .k-link {width:80px;}
    #grid .k-header[data-field="Image"] .k-link {width:60px;}
    #grid .k-header[data-field="Location"] .k-link {width:80px;}
    #grid .k-header:not([data-field]) .k-link {width:43px;}
    #grid .claw-action{width:40px;}
    #grid .product-img{width:60px;}
    #grid .emailmusers{float: right;font-size: smaller;text-align: right;font-style: italic;margin-top: 3px;}
    #grid .emailmusers a{color: #390f3d;}
    #grid .qtypos-detail {font-size: smaller; margin-left: 5px; text-align: right; margin-right: 3px; color: darkgray;}
</style>

@if (!ViewBag.PermissionEdit)
{
    <style type="text/css">
        #grid .k-grid-quantity {text-align: center !important; }
    </style>
}

@if (!settings.Hidden.ShoppingProduct)
{
    <style type="text/css">
        #grid .shoppingqty {display:none !important;}
    </style>
}

@if (!settings.Hidden.ProductNotifyMe)
{
    <style type="text/css">
        #grid .emailmusers { display: none !important; }
    </style>
}
 
@if (!settings.Hidden.Storage2Enabled)
{
    <style type="text/css">
        #grid .qtypos-detail { display: none !important; }
    </style>
}

