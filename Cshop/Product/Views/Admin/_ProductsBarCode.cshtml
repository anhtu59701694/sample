@using System.Globalization
@using System.Linq
@using System.Text
@using System.Web.UI.WebControls
@using Claw.Core.Domain
@using Claw.Modules.Eshop
@using Claw.Modules.Eshop.DAL
@using Claw.Modules.Eshop.Helper
@using Claw.Modules.Eshop.Models
@using Claw.Modules.Eshop.Product
@using Domain=Claw.Modules.Eshop.Domain
@model System.Tuple<System.Drawing.Image, Domain.ProductBase, Domain.Variant>

@{
    Layout = null;

    const decimal m2ToPx = 2.8346456692913385826771653543307m;
    var settings = (SettingsBiz)ViewBag.Settings;
    var config = settings.Display.BarCode;
    var width = (int)ViewBag.Width;
    var height = (int)ViewBag.Height;
    var img = Model.Item1;
    var ratio = img == null ? 0 : (img.Width*1.0m)/width;
    var fontSize = (int)(ratio * 0.6667m * config.FontSize);
    var logoH = fontSize;
    var action = (string)ViewContext.RouteData.Values["action"];
    var isViewQrCode = action.InList("viewqrcode");

    var propDesc = new StringBuilder();
    var langCode = LanguageMgr.FocusLangCode;

    if (Model.Item3 != null)
    {
        foreach (var val in Model.Item3.VariantPropVals.OrderBy(x => x.PropVal.Property.DisplayOrder).ThenBy(x => x.Id))
        {
            if (propDesc.Length != 0)
            {
                propDesc.Append(", ");
            }
            propDesc.AppendFormat("{0}", val.PropVal.GetName(langCode));
        }
    }

    if (logoH != 0 && img != null && !isViewQrCode)
    {
        var h = logoH * 2 + logoH/2 + fontSize / 4;
        img = Claw.Modules.Eshop.Controllers.Admin.BaseController.CropImage(img, 0, h, img.Width, Math.Max(0, img.Height - h));
    }

    var maxLength = (35 * config.Image.Width * 12) / (25 * config.FontSize);
    var leftMargin = (int)(ratio * m2ToPx * config.LeftMargin);
    var topMargin = (int)(ratio * m2ToPx * config.TopMargin);
    var rightMargin = (int)(ratio * m2ToPx * config.RightMargin);
    var bottomMargin = (int)(ratio * m2ToPx * config.BottomMargin);
}
<html>
<head>
    <title></title>
</head>
    <body style="width:@(img == null ? 0 : img.Width)px;height:@(img == null || width == 0 ? 0 : (int)(height * ratio))px;">
        <table style="border-collapse:collapse;width:100%;height:100%;padding-left:@(leftMargin)px;padding-top:@(topMargin)px;padding-right:@(rightMargin)px;">
            @if (!isViewQrCode)
            {
                <tr><td style="height:100%;"></td></tr>
                if (logoH != 0)
                {
                    <tr>
                        <td style="text-align: center;vertical-align: middle;">
                            <img style="height:@(logoH * 3 / 2)px;" src=" data:image/png;base64," />
                        </td>
                    </tr>
                }
                <tr>
                    <td style="font-size:@(fontSize)px;text-align: center;line-height:@(fontSize)px;height: @(2 * fontSize)px;vertical-align: middle;padding-bottom: @(fontSize / 4)px;">
                        @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(string.Format("{0} {1}{2}{3}", Model.Item2.GetName(), propDesc.Length == 0 ? "" : "(", propDesc, propDesc.Length == 0 ? "" : ")").TrimLength(maxLength).ToLower())
                    </td>
                </tr>
            }
            <tr>
                <td style="text-align:center;"><img src="@(img == null ? null : img.ToBase64())" /></td>
            </tr>           
            @if (!isViewQrCode)
            {
                <tr>
                    <td style="font-size:@(fontSize)px;text-align: center;font-weight: bold;">
                        @*@{
                        var currencySetting = new OMoneyMc.Setting() { ShowInCart = false, ShowOriginal = false, ShowUnit = false, Roundable = true };
                        var priceFEInc = new OMoneyMc(Model.Item3 == null ? Model.Item2.PriceFEInc : Model.Item3.PriceFEInc, currencySetting).Text;
                        var priceInc = new OMoneyMc(Model.Item3 == null ? Model.Item2.PriceInc : Model.Item3.PriceInc, currencySetting).Text;
                    }
                    @if (priceInc != priceFEInc)
                    {
                        <span style="font-size:@(fontSize/2)px;font-weight: normal;">Før: @(priceInc)</span>
                        <span style="text-decoration: underline;">Nå: @(priceFEInc)</span>
                    }
                    else
                    {
                        <span>@(priceFEInc)</span>
                    }*@
                        @(new OMoneyMc(Model.Item3 == null ? Model.Item2.PriceFEInc : Model.Item3.PriceFEInc))
                    </td>
                </tr>
                if (logoH != 0)
                {
                    <tr>
                        <td style="text-align: center;vertical-align: middle;padding-top:@(fontSize / 4)px">
                            <img style="height:@(logoH)px;" src=" data:image/png;base64," />
                        </td>
                    </tr>
                }
                <tr>
                    <td style="height:@Math.Max(fontSize / 4, bottomMargin)px;text-align: center;font-weight: bold;">&nbsp;</td>
                </tr>
            }
         </table>
    </body>
</html>