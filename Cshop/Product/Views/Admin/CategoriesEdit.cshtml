<script type="text/javascript">
    var form = $('#editForm')[0];

    form.customValidFields = function () {
        return true;
    };

    form.CustomLangFormSwitch = function (langcode, node, senderuid) {
        var ownerbox = node.closest('.row_content_box');
    };

    function InitImageUpload(url, img, imgThumb, imgFsUrl, imgErrMsg, dropzoneForm, imageUpload, addFile, previewsContainer) {

        imgErrMsg.click(function () { $(this).html(''); });

        var dzEle = dropzoneInit(dropzoneForm, imageUpload, addFile,
            {
                acceptedFiles: '@settings.Display.Admin.Image.Extensions.GetFileExtensionDropZone(false)',
                previewsContainer: previewsContainer,
                url: url
            },
            function (result) {
                $(".mask-dropzone-show", dropzoneForm).hide();
                img.val(result.Image.FileName);
                imgThumb.val(result.Image.ThumbUrl);
                imgFsUrl.val(result.Image.FilePath);
            }, function (file, e) {
                img.val(''); imgThumb.val(''); imgFsUrl.val('');
                setImageErrMsg(imgErrMsg, e.Message + ' (' + file.name + ')');
            });

        //remove file
        var dropzone = dzEle[0].dropzone;
        dropzone.on("removedfile", function (file) {
            if (file.status == "success") {
                $(".mask-dropzone-show", dropzoneForm).show();
                img.val("");
                imgThumb.val("");
                imgFsUrl.val("");
                $('#editform-change-state').val(1).change();
            }
        });

        dropzone.on("addedfile", function (file) {
            var node = $(file.previewElement).find('img[data-dz-thumbnail]');
            $(file.previewElement).find('.image-edit').unbind('click').click(function () {
                //console.log('click', node, file);
                aviaryInit(imgFsUrl, [img, imgThumb, node]);
            });
            //console.log('addedfile', node,node.attr('id'), file, $(file.previewElement).find('.image-edit'));
        });

        if ($.trim(img.val()) != '') {
            $(".mask-dropzone-show", dropzoneForm).hide();
            dropzoneAdd(dzEle[0].dropzone, imgFsUrl.val(), img.val(), imgFsUrl.val(), imgThumb.val(), 'image/*');
        }
    }

    function setImageErrMsg(node, msg) {
        node.html(msg);
        setTimeout(function () { node.html(''); }, 10000);
    }

    $(document).ready(function () {

        $('input[name=@Html.NameFor(m => m.VisibleWeb)]').change(function () {
            var box = $('#published-date-box');
            if ($('#VisibleWebTrue').prop('checked')) box.show(); else box.hide();
        }).change();

        @*$('#view-in-your-store').unbind('click').click(function () {
            location.href = window.open('@ModuleUrl.CategoryUrl(Model.Alias)', '_blank');
            return true;
        });*@

        $('#@Html.IdFor(m => m.Sorting)').change();

        setTimeout(function () { initMsTranslator('no-loading-image'); }, 1000);

        setTimeout(function () { $('.inputLang li.langItem input[disabled]').prop('disabled', false); }, 1000);

        InitImageUpload('@ModuleUrl.AdminUrl(Html.GetController(), "uploadimage", Model.Id)',$('#@Html.IdFor(m => m.Image)'), $('#@Html.IdFor(m => m.ImageThumb)'),
            $('#@Html.IdFor(m => m.ImageFsUrl)'), $('#image-error-msg'), '#dropzone-form', '#imageUpload', '#add-file', '.dropzone-preview-box');

        for(var i = 0; i < 3; i++)
            InitImageUpload('@ModuleUrl.AdminUrl(Html.GetController(), "uploadimage", Model.Id)'.replace('/@Html.GetController()/', '/CateBanner' + i + '/'),
                $('#Banner' + i), $('#Banner' + i + 'Thumb'), $('#Banner' + i + 'FsUrl'), $('#image-error-msg-' + i),
                '#dropzone-form-' + i, '#imageUpload' + i, '#add-file-' + i, '.dropzone-preview-box-' + i);
    });

</script>

@if (!isFrontEnd)
{
    <script type="text/javascript">

    function openSelectParent(node) {

        if ('@(ViewBag.PermissionEdit ? 0 : 1)' == '1') return;

        ajaxCmdHtml('@ModuleUrl.AdminUrl("Category", "GetBrowseForm")', { id: '@Model.Id', parentId: $('#@Html.IdFor(m => m.ParentId)').val() },
            function (result, customTag) {
                openBrowseCate('@Model.Id', null, result);
            });
    }

    function openBrowseCate(id, actionurl, formHtml) {
        var width = Math.max(200, Math.min(600, $(window).width() - 50));
        var height = Math.max(200, Math.min(300, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popup = new ClawModal("", "modal-mask");
        var popTemplate = $('<div>').html($("#browse-cate-templ").html());
        popTemplate.find('#form-html').html(formHtml);

        var formTitle = '@StringTable.SelectCategory';

        var windowModal = popup.showCustomModal("#window", formTitle, popTemplate.html(), width, height, [], null,
            function (modal) {
                var treeview = modal.find("#catetree");

                modal.find(".btn_save").click(function () {
                        var selected = getSelected(treeview);
                        console.log(selected);
                        //$('#@Html.IdFor(m => m.ParentId)').data('kendoDropDownList').value(selected.id);
                        $('#@Html.IdFor(m => m.ParentId)').val(selected.id).change();// 
                        $('#ParentText').val(selected.hierOrder);

                        popup.close(); $(window).scrollTop(scrollTop);
                        $('#editform-change-state').val(1).change();
                    });

                    modal.find(".btn_cancel").click(function () { popup.close(); $(window).scrollTop(scrollTop); });
                });
        }

    </script>
}

<script id="browse-cate-templ" type="text/kendo-template">
    <div class="popupBody">
        <section id="err-message-holder"></section>
        <section class="row_content_box kpopup-content">
            <section class="wr_clo1" style="margin: 20px 20px 10px 20px;background-color: #f7f7f7;border: 1px solid #ccc;">
                <div class="wcontent">
                    <div class="htmlcontent">
                        <div id="form-html"></div>
                    </div>
                </div>
            </section>
            <section class="clear"></section>
            <ul class="wr_submit_top form-action-menu" style="position:relative; padding:5px 0;">
                <li><input type="button" value="@StringTable.Done" class="btn_save"></li>
                <li style="margin-right:20px;"><input type="button" value="@StringTable.Cancel" class="btn_cancel"></li>
            </ul>

        </section>
    </div>
</script>

@helper RenderLangMedTabs(List<Language> languages, Language actLang, List<ILanguage2> modelLangs)
{
    <div class="tab-big-2">
        <ul class="inputLang">
            @foreach (var lang in languages.OrderBy(x => x.LanguageCode.EqualsIgCase(actLang.LanguageCode) ? 0 : 1))
            {
                var active = lang.LanguageCode.EqualsIgCase(actLang.LanguageCode);
                var itmChecked = modelLangs.Any(x => x.Visible && x.LangCode.EqualsIgCase(lang.LanguageCode));
                <li class="controls langItem @(active ? "active-lang" : "")" data-lang="@lang.LanguageCode"
                    title="@lang.LanguageName">
                    <input id="med_lang_@lang.Id" class="css-checkbox" name="med_lang_@lang.Id" @Html.Raw(Model.AllLangForcedActive ? "disabled='disabled'" : "") @Html.Raw(itmChecked ? "checked='checked'" : "") type="checkbox">
                    <label for="med_lang_@lang.Id" class="css-labelcheck">@lang.LanguageName</label>
                    <div class="lang-cmd-box" style="display: none">

                        <span class="inline-flag">
                            <i></i>
                            <a href="javascript:void(0)">
                                <span class="es-show-tranglate">@StringTable.TranslateInfo</span>
                                <img src="@ModuleUrl.LangIcon(lang.LanguageCode)" alt="@lang.LanguageCode" />
                            </a>
                        </span>
                    </div>
                </li>
            }
        </ul>
    </div>
}

