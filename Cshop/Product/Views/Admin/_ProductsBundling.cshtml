{
    if (settings.Hidden.ProdBundleGroupAccessory)
    {
        <div>
            <ul class="">
                <li><input type="button" value="@StringTable.Save" onclick="doSaveReload()" style="margin: 0;" class="btn"></li>
            </ul>
        </div>
        <script>
            function doSaveReload() {
                var form = $('#editForm');
                form.attr('action', urlMergeParamsEx(form.attr('action'), { selfreload: true, refpartid:'bundle-groups' }, true));
                $('.wr_submit_top.form-action-menu #btn_save').first().click();
            }

            function urlMergeParamsEx(url, params, lowercase) {
                if (!url || !params) return url;

                if (typeof (params) == 'string') params = urlToJSON('?' + params, false);

                var idx = url.indexOf('?');

                if (idx == -1) url += '?';
                else {
                    params = $.extend(urlToJSON(url, true), params);
                    url = url.substr(0, idx + 1);
                }

                Object.keys(params).forEach(function(key) {
                    if (!params[key]) delete params[key];
                });

                if (lowercase) {
                    var params2 = {};
                    Object.keys(params).forEach(function(key) {
                        params2[key.toLowerCase()] = params[key];
                    });
                    return url + $.param(params2);
                }
                else return url + $.param(params);
            }

        </script>
    }  
}
