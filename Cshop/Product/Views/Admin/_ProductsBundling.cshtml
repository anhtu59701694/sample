                e.model.InlineEdit = e.model.QuickAdd = true;
                e.model.ProductId = @(Model.Id);
                e.model.MinPrice = null;
                e.model.Accessories = null;

                if(e.model.ShowVariant == null) e.model.ShowVariant = true;
