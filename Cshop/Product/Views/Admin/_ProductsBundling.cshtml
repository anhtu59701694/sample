            $('#gridbundlegroup').find('#SelectAll')
                .attr('id', 'SelectAll_bundle_group')
                .closest('th').find('label')
                .attr('for', 'SelectAll_bundle_group');

            $(function() {
                gridbundlegroupInit('#gridbundlegroup', true);
            });

            function gridBundleGroupCustom(grid) {

                if (permEdit)
                    $('tr', grid.element).each(function() {
                        $(this).dblclick(function(e) {
                            if (!grid.editable) grid.editRow($(this));
                        });
                    });

                if (permEdit)
                    setTimeout(function() {
                        $('.js-add-new-bundle-group')
                            .unbind('click')
                            .click(function() { grid.addRow(); }).attr('type', 'button');
                    }, 1);

                setTimeout(function() {
                    var bundleGroup = $('#BundleGroupId').data('kendoDropDownList');
                    if (bundleGroup) bundleGroup.dataSource.read();
                }, 10);

                initGridStatusAction(grid, '.k-grid-ShowVariant', function(node, rw) {
                        if (rw && rw.id) ajaxCmd(showVariantActUrl, { id: rw.Id, value: rw.ShowVariant }, function() {});
                    },
                    function(row) { return row.ShowVariant; }, function(row, status) { row.ShowVariant = status; },
                    function(row) { return { id: row.Id, value: row.ShowVariant }; });

            }

            function gridBundleGroupRefreshRow(grid, rowEle) {

                if (permEdit)
                    rowEle.dblclick(function(e) {
                        if (!grid.editable) grid.editRow($(this));
                    });
            }

            function gridBundleGroupGetParams(gridOwner, e) {
                return { productid: @(Model.Id) };
