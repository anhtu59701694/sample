<script type="text/javascript">

    var grid = $('#gridbundling'), updateBundlingPriceTimer = 0;

    $(function () {

        $('#gridprodsel').attr('id', 'gridprodsel-templ'); $('#qty-holder').hide();

        gridbundlingInit('#gridbundling', true);

        grid.data('kendoGrid').dataSource.bind('change', function (e) { });

        $('#@Html.IdFor(m => m.Quantity)').change(function () {
            if ($(this).valid() && parseInt($(this).val()) >= 0) grid.data('kendoGrid').refresh();
        });
    });

    function updateBundleQty() {

        var qty = null, weight = 0, statusNode = $('#@Html.IdFor(m => m.ProductStatusId)'), qtyNode = $('#@Html.IdFor(m => m.Quantity)');

        if (!statusNode.data('kendoDropDownList')) {
            setTimeout(updateBundleQty, 1000); return;
        }

        grid.data('kendoGrid').dataSource.data().forEach(function (rw) {
            var rwQty = parseInt(rw.Quantity); console.log('updateBundleQty', rw);
            var tmp = !rwQty || rw.ProductAllowBackorder ? (rw.ProductAllowBackorder ? 10000 : 0) : Math.floor(rw.ProductQty / rwQty);
            qty = qty == null ? tmp : Math.min(qty, tmp);

            var rwWeight = (safeProp(rw.Weight, 'Value') || 0);
            switch (rw.WUnit) {
            case @WeightUnit.Gram.Val():
                weight += rwQty*(rwWeight / 1000);
                break;
            case @WeightUnit.Lbs.Val():
                weight += rwQty*(rwWeight * 0.453592);
                break;
            case @WeightUnit.Kg.Val():
                weight += rwQty*rwWeight;
                break;
            }
        });

        qty = qty || 0;

        var statusId = parseInt(statusNode.val()), oldQty = parseInt(qtyNode.val());

        qtyNode.val(qty);
        $('#quantity-view').val(qty);

        var weightNode = $('#@Html.IdFor(m => m.Weight)'), weightKd = weightNode.data('kendoNumericTextBox');
        weightNode.val(localizeFloatToString(weight)).change();
        if(weightKd) weightKd.value(weight);

        var wunitNode = $('#@Html.IdFor(m => m.WUnit)'), wunitKd = weightNode.data('kendoDropDownList');
        wunitNode.val('@WeightUnit.Kg.Val()').change();
        if(wunitKd) wunitKd.value(wunitNode.val());

        if ((qty > 0 ^ oldQty > 0) && ((statusId == 2 && qty == 0) || (statusId == 3 && qty > 0)))
        {
            var statusKd = statusNode.data('kendoDropDownList');
            statusKd.value(qty > 0 ? 2 : 3); statusKd.element.change();
        }

        console.log('updateBundleQty', weight, qty, oldQty, qty > 0 ^ oldQty > 0, (statusId == 2 && qty == 0) || (statusId == 3 && qty > 0));
    }

    function updateBundlingPrice() {

        if (updateBundlingPriceTimer) clearTimeout(updateBundlingPriceTimer);

        updateBundlingPriceTimer = setTimeout(function () {

            updateBundlingPriceTimer = 0;

            var priceIncNode = $('#@Html.IdFor(m => m.PriceInc)'), priceIncVal = 0;
            var costpriceIncNode = $('#@Html.IdFor(m => m.CostPriceInc)'), costpriceIncVal = 0;
            var salepriceIncNode = $('#@Html.IdFor(m => m.SalePriceInc)'), salepriceIncVal = 0;
            var bundleDiscountRateNode = $('#@Html.IdFor(m => m.BundleDiscountRate)'), bundleDiscountRateVal = localizeParseFloat(bundleDiscountRateNode.val()) / 100.0;
            var bundleDiscProfit = $('#BundleDiscProfitTrue').prop('checked');

            grid.data('kendoGrid').dataSource.data().forEach(function (rw) {
                priceIncVal += (/*(rw.ProductSalePriceInc.Value != null) ? rw.ProductSalePriceInc.Value : */rw.ProductPriceInc.Value) * rw.Quantity;
                var cVal = safeProp(rw.ProductCostPriceInc, 'Value');
                if (bundleDiscProfit && !cVal) cVal = 0.8 * rw.ProductPriceInc.Value;
                if(!cVal || costpriceIncVal == null)costpriceIncVal = null;
                else costpriceIncVal += cVal * rw.Quantity;
            });

            priceIncNode.data('kendoNumericTextBox').value(priceIncVal);
            priceIncNode.change();

            costpriceIncNode.data('kendoNumericTextBox').value(costpriceIncVal);
            costpriceIncNode.change();
            
            var newSalePriceInc = bundleDiscountRateVal ? (bundleDiscProfit ? (costpriceIncVal*(1 + bundleDiscountRateVal)) : (priceIncVal * (1 - bundleDiscountRateVal))) : null;

            salepriceIncNode.data('kendoNumericTextBox').value(newSalePriceInc);
            salepriceIncNode.change();
        }, 1000);
    }

    function gridVariantSelCustom(grid) {

        initImagePreview(false, grid.element);

        gridAdjustPopup($('#gridprodsel').data('kendoGrid'), '.wcontent', '.wr_clo1', null, null, null, 30);
    }

    function gridVariantSelGetParams(gridOwner, e) {
        var productid = gridOwner.element.attr('data-id'), data = grid.data('kendoGrid').dataSource.data(), exceptids = [];
        data.forEach(function (row) { if (row.VariantId && row.ProductId == productid) exceptids.push(row.VariantId); });
        return { productid: productid, exceptids: exceptids.join(','), minQty: 1, active: true, fullMode: true };
    }

    function gridProdSelFirstRun() {
        var grid = $('#gridprodsel'), headerRow = grid.find('thead > tr');

        headerRow.append('<th class="k-hierarchy-cell k-header" style="display:none"></th>');
        // { 0: 0, 2: 5, 3: 2, 4: 3, 5: 4 }
        gridSwapElements(headerRow, 'th', { 0: 0, 2: 5, 3: 2, 4: 3, 5: 4 },
            function (i, node) { if (i == 3) $(node).attr('colspan', '2'); });
        grid.attr('data-deep', '0');

        var gridTempl = grid.clone();

        gridTempl.attr('id', '');
        gridprodselInit('#gridprodsel', true);

        var gridColGroup = grid.find('colgroup');
        gridSwapElements(gridColGroup, 'col', { 0: 1, 1: 2, 2: 0 }, function (i, node) { if (i == 0) $(node).css('width', '56px'); });

        var cols = gridColGroup.html(), gridData = grid.data('kendoGrid');

        gridData.rowTemplate = gridGetRowTemplate(gridData, false, { 0: 1, 1: 2, 2: 0 });
        gridData.altRowTemplate = gridGetRowTemplate(gridData, true, { 0: 1, 1: 2, 2: 0 });

        grid.data({ 'clawGridTempl': gridTempl, 'clawGridCols': cols });
    }

    function gridProdSelInitDetail(e) {
        var gridTempl = $('#gridvariantsel');
        var gridDiv = gridTempl.clone(), selAll = gridDiv.find('#SelectAll');

        gridDiv.attr('id', 'grid-' + e.data.id);
        gridDiv.attr('data-id', e.data.id);
        gridDiv.attr('data-deep', parseInt(e.sender.element.attr('data-deep')) + 1);

        selAll.attr('id', 'SelectAll-' + e.data.id);
        selAll.closest('div').find('label').attr('for', 'SelectAll-' + e.data.id);

        e.detailCell.append(gridDiv);
        e.detailRow.find('.k-hierarchy-cell').remove();
        e.detailRow.find('.k-detail-cell').attr('colspan', '7');

        gridvariantselInit('#' + gridDiv.attr('id'), false);
    }

    function gridProdSelCustom(grid) {
        gridHideCell(grid, '.k-hierarchy-cell .k-icon.k-plus', function (row) { return row.VariantCount == 0; });

        //if($('#BundleHideSubItemsTrue').prop('checked'))
        //    gridDisableCheckBox(grid, function (row) { return row.VariantCount > 0; }, '.row-checkbox_prosel');

        gridAdjustPopup(grid, '.wcontent', '.wr_clo1', null, null, null, 30);

        initImagePreview(false, grid.element);
    }

    function gridProdSelGetParams() {
        var data = grid.data('kendoGrid').dataSource.data(), exceptids = [1, '@Model.Id'], exceptVariantIds = [];
        data.forEach(function (row) {
            exceptids.push(row.ProductId);
            if (row.VariantId) exceptVariantIds.push(row.VariantId);
        });
        
        if(window.gridaccessory)
            window.gridaccessory.data('kendoGrid').dataSource.data().forEach(function (row) { exceptids.push(row.AccessoryId); });

        return { exceptids: exceptids.join(','), type: '@((int)ProductType.Normal)', countVariant: 'true', minQty: 1, VisibilityWeb: true, exceptVariantids: exceptVariantIds.join(','), download: false };
    }

    function gridBundlingCustom(grid) {
        //$('.preview[href=""]', grid.element).hide();

        $('.delete_big').unbind('click').click(function () {
            var arrRws = [], rows = grid.tbody.find('input:checked').closest('tr');
            rows.each(function () { arrRws.push(grid.dataItem($(this))); });

            arrRws.forEach(function (item) {
                prodFormRemove(item);
                grid.dataSource.data().remove(item);
            });
            if (arrRws.length != 0) updateBundlingPrice();
        });

        $('#bundling-form-list > .bundling-form[data-valid=1]').each(function () {
            var prodForm = $(this), row = gridGetRow(grid, $(this).attr('data-id'), $(this).attr('data-key'));
            if (row) {
                $('tr[data-uid=' + row.uid + '] .bundling-cell', grid.element).change(function () {
                    if ($(this).is('input,textarea,select')) {
                        if ($(this).valid()) {
                            var field = $(this).attr('data-bind');
                            if (field) bindInputField(prodForm, row, field, $(this).val());

                            //console.log('tests')
                            updateBundlingPrice();

                            if ($(this).is('.bundling-quantity')) updateBundleQty();
                        } else $(this).focus();
                    }
                });
                $(this).attr('data-uid', row.uid);
                row.ProductForm = prodForm;
            } else console.log('databound: row is null', $(this).attr('data-key'), prodForm);
        });

        var quantity = parseInt($('#@Html.IdFor(m => m.Quantity)').val()), bundleHideSubItemsErrs = 0;
        $('.bundling-quantity', grid.element).each(function () {
            var row = grid.dataItem($(this).closest('tr'));
            var maxVal = quantity > 0 ? Math.floor(Math.max(row.ProductQty || 0, 1) @*/ quantity *@) : null;
            var errMsg = maxVal > 0 ?
                '@StringTable.ErrMsgRangeLimit.ModErrLocalize()' :
                (maxVal == 0 ? '@StringTable.ErrMsgNotEnoughQuantity' : '@StringTable.ErrMsgMinLimit.ModErrLocalize()');
            $(this).attr({
                'data-val-range-max': maxVal >= 0 ? maxVal : '@int.MaxValue',
                'data-val-range': errMsg.replace('{1}', '1').replace('{2}', maxVal || '')
            }).rules('remove');
            
            if(!row.VariantId && row.ProductVariantNum) bundleHideSubItemsErrs++;
        });
        
        window.BundleHideSubItemsErrs = bundleHideSubItemsErrs;

        if((bundleHideSubItemsErrs && window.AcceHideSubItemsErrs != null) || window.AcceHideSubItemsErrs){
            //$('#BundleHideSubItemsFalse').prop('checked', true);
            //$('#bundle-groups,#accessory-bundle').show();
            //$('#BundleHideSubItemsTrue').prop('disabled', true);
        } //else $('#BundleHideSubItemsTrue').prop('disabled', false);

        initImagePreview(false, grid.element);

        formUpdateValidRules(grid.element);

        if (grid.dataSource.total() == 0) {
            grid.element.closest(".wr_table_all").hide();
        } else {
            grid.element.closest(".wr_table_all").show();
            setTimeout(function () {
                $('.bundling-quantity', grid.element).each(function () {
                    if ($(this).length > 0) $(this).valid();
                });
                bundleShowValidateErrors(grid);
            }, 500);

            if ($('.bundling-quantity', grid.element).valid()) updateBundleQty();
        }
    }

    function bundleShowValidateErrors(grid, trNode) {
        $('.bundling-quantity', trNode || grid.element).each(function () {
            var name = ($(this).attr('name') || '').substring(1), msg = modelState[name];
            if (name && msg) {
                $(this).closest('td').find('span.error')
                    .removeClass('field-validation-valid')
                    .addClass('field-validation-error').html('').append($('<span>').html(msg));
                delete modelState[name];
                if (!firstErrorInputElement) {
                    firstErrorInputElement = $(this);
                    setTimeout(function () { firstErrorInputElement.focus(); }, 2000);
                };
            } else $(this).removeClass('input-validation-error');
        });
    }

    function openAssignForm() {
        var width = Math.max(200, Math.min(770, $(window).width() - 50));
        var height = Math.max(200, Math.min(2048, $(window).height() - 50));
        var scrollTop = $(window).scrollTop();

        var popTemplate = $("<div>").html($("#bundling-popup-form-templ").html());
        popTemplate.find('.htmlcontent .wr_table_all').html($('#gridprodsel-templ').clone().attr('id', 'gridprodsel').wrap('<p>').parent().html());
        popTemplate.find('#err-message-holder').append($('#massage.show_massage'));

        var popup = new ClawModal("", "modal-mask");
        var windowModal = popup.showCustomModal("#window", '@StringTable.AddProducts', popTemplate.html(),
            width, height, [], null,
            function (modal) {

                var msgBox = modal.find('#massage.show_massage'), inputErrBox = $('#input-err-msg-box');

                $('#gridprodsel #SelectAll', modal).attr('id', 'SelectAll_prodsel').closest('div')
                    .find('label').attr('for', 'SelectAll_prodsel');

                //gridprodselInit('#gridprodsel', true);
                gridProdSelFirstRun();

                var gridProdSel = $('#gridprodsel').data('kendoGrid');

                modal.find(".btn_save").click(function () {

                    var selCBox = $('.row-checkbox_prosel:checked,.row-checkbox_varsel:checked', gridProdSel.element);

                    selCBox.each(function () {
                        var owner = $(this).closest('div.k-grid').data('kendoGrid');
                        var row = owner.dataItem($(this).closest('tr'));
                        //console.log(row);
                        if (row.ProductId) productAdd(row.ProductId, row.ProductName, row.Image ? { Thumb: row.ImageThumb, FsUrl: row.ImageFsUrl } : row.CombinedImage,
                            row.Id, row.PropDesc, row.Quantity, row.SKU, row.ProdVat, row.Price, row.PriceInc, row.SalePrice, row.SalePriceInc, row.Weight, row.ProductWUnit, row.CostPrice, row.CostPriceInc, null, row.AllowBackorder);
                        else productAdd(row.Id, row.Name, row.Image, row.VariantId, null, row.Quantity, row.SKU, row.Vat, row.Price, row.PriceInc, row.SalePrice, row.SalePriceInc, row.Weight, row.WUnit, row.CostPrice, row.CostPriceInc, row.VariantCount, row.AllowBackorder);
                    });

                    if (selCBox.length != 0) updateBundlingPrice();

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
                modal.find(".btn_cancel").click(function () {

                    inputErrBox.append(msgBox);
                    admincommon.hideMessage();
                    popup.close(); $(window).scrollTop(scrollTop);
                });
            });
    }

    function productAdd(id, name, image, variantId, propDesc, productQty, sku, vat, price, priceInc, salePrice, salePriceInc, weight, wUnit, costPrice, costPriceInc, variantNum, allowBackorder) {
        productAddRaw({
            ProductId: id, VariantId: variantId, Quantity: 1, ProductQty: productQty, ProductAllowBackorder: allowBackorder,
            BundleId: '@Model.Id', ProductName: name, ProductImage: image, PropDesc: propDesc,
            ProductSKU: sku, ProductVat: vat, ProductPrice: price, ProductPriceInc: priceInc,
            ProductSalePrice: salePrice, ProductSalePriceInc: salePriceInc, Weight: weight, WUnit: wUnit,
            ProductCostPrice: costPrice, ProductCostPriceInc: costPriceInc, ProductVariantNum: variantNum,
            Key: id + '-' + (variantId || 0)
        });
    }

    function productAddRaw(fieldVals) {

        var gridData = grid.data('kendoGrid');
        var newRow = $.extend(true, {}, templBundling);

        for (var prop in fieldVals) {
            var pval = fieldVals[prop];
            newRow[prop] = pval;
        }

        //console.log('productAdd', newRow);

        var newForm = prodFormAdd(fieldVals);
        newRow.Iseq = fieldVals['Iseq'];
        newForm.attr('data-key', newRow.Key);
        gridData.dataSource.data().push(newRow);
    }

    function prodFormAdd(fieldVals) {

        var lst = $('#bundling-form-list'), idx = parseInt(lst.attr('count'));

        fieldVals['Iseq'] = idx;

        lst.attr('count', idx + 1);

        var newForm = $('<div>').html($('#bundling-form-template').html()).find('.bundling-form');

        newForm.find('input,textarea,select').each(function () {
            $(this).attr('id', $(this).attr('id').replace('_0_', '_' + idx + '_'));
            $(this).attr('name', $(this).attr('name').replace('[0]', '[' + idx + ']'));

            if ($(this).attr('binding')) {
                if ($(this).is('textarea')) $(this).html('');
                else $(this).val('');
            }
        });

        if (fieldVals)
            for (var field in fieldVals) {
                var fVal = fieldVals[field];

                var node = newForm.find('.bundling-form-field[binding=' + field + ']');
                if (node.is('textarea')) $(this).html(fVal);
                else node.val(fVal);
            }

        newForm.attr({ 'data-id': 0, 'data-valid': 1 });

        lst.append(newForm);

        //console.log(newForm.html());

        return newForm;
    }

    function prodFormRemove(row) {
        console.log('prodFormRemove', row, row.ProductForm);
        row.ProductForm.attr('data-valid', 0);
        row.ProductForm.find('input,textarea,select').val('').attr('datavalid', 0);
        $('#editform-change-state').val(1).change();
    }

    function bindInputField(prodForm, row, field, newVal) {
        var inputField;

        row[field] = newVal;
        inputField = prodForm.find('.bundling-form-field[binding=' + field + ']');
        inputField.val(newVal); console.log(inputField);
    }

    function gridGetRow(grid, id, key) {

        if (id != null && id != 0) return grid.dataSource.get(id);
        else return grid.dataSource.data().find(function (item) { return item.Key == key; });
    }

    function safePropImg(obj, propName) {
        if (obj == null) return '@ImageModel.NoImg';
        return obj[propName] || '';
    }

</script>

<div id="bundling-form-list" count="@Model.Bundlings.Count" style="display: none">
    @for (int i = 0; i < Model.Bundlings.Count; i++)
    {@RenderBundlingForm(i)}
</div>
<script id="bundling-form-template" type="text/bundling-form-template">
    @{ Model.Bundlings.Insert(0, templBundling); }
    @RenderBundlingForm(0)
</script>
@Html.Raw("<script type='text/javascript'> var templBundling = " + Json.Encode(templBundling) + ";</script>")

@helper RenderBundlingForm(int idx)
{
    <div class="bundling-form" data-id="@Model.Bundlings[idx].Id" data-key="@Model.Bundlings[idx].Key" data-valid="1">
        @Html.SimpleHiddenFor(m => m.Bundlings[idx].Id, new { @class = "bundling-form-field" })
        @Html.SimpleHiddenFor(m => m.Bundlings[idx].ProductId, new { @class = "bundling-form-field", @binding = "ProductId" })
        @Html.SimpleHiddenFor(m => m.Bundlings[idx].VariantId, new { @class = "bundling-form-field", @binding = "VariantId" })
        @Html.SimpleHiddenFor(m => m.Bundlings[idx].Quantity, new { @class = "bundling-form-field", @binding = "Quantity" })
    </div>
}

