        @type = "number",
    }).Replace(new { @name = "_Bundlings[#:Iseq#].Quantity", @value = "#:Quantity#" }) + "<span class='error' data-valmsg-for='_Bundlings[#:Iseq#].Quantity' data-valmsg-replace='true'></span>";

